+fn derive_coordinate_dependencies(
+    implicit_rhs: &ComputeBlock,
+    solve_layout: &crate::SolveLayout,
+    algebraic: &RefreshPlan,
+    derivative: &RefreshPlan,
+    root: &RefreshPlan,
+    event: &RefreshPlan,
+    clock_events: &[RefreshPlan],
+) -> Result<Vec<RefreshCoordinateDependencyCertificate>, ContinuousRefreshConstructionError> {
+    let mut certificates = Vec::with_capacity(clock_events.len().saturating_add(4));
+    for (purpose, plan) in [
+        (ContinuousRefreshPurpose::AlgebraicValue, algebraic),
+        (ContinuousRefreshPurpose::Derivative, derivative),
+        (ContinuousRefreshPurpose::Root, root),
+        (ContinuousRefreshPurpose::Event, event),
+    ] {
+        certificates.push(derive_owner_coordinate_dependencies(
+            implicit_rhs,
+            solve_layout,
+            purpose,
+            plan,
+        )?);
+    }
+    for (clock, plan) in clock_events.iter().enumerate() {
+        let clock = u32::try_from(clock).map_err(|_| ContinuousRefreshConstructionError {
+            reason: "continuous refresh clock count exceeds u32".to_string(),
+        })?;
+        certificates.push(derive_owner_coordinate_dependencies(
+            implicit_rhs,
+            solve_layout,
+            ContinuousRefreshPurpose::ClockEvent { clock },
+            plan,
+        )?);
+    }
+    Ok(certificates)
+}
+
+fn derive_owner_coordinate_dependencies(
+    implicit_rhs: &ComputeBlock,
+    solve_layout: &crate::SolveLayout,
+    purpose: ContinuousRefreshPurpose,
+    plan: &RefreshPlan,
+) -> Result<RefreshCoordinateDependencyCertificate, ContinuousRefreshConstructionError> {
+    let mut builder = RefreshCoordinateDependencyBuilder::new(purpose, solve_layout);
+    let sources = plan
+        .rows
+        .iter()
+        .map(AlgebraicRefreshRow::source)
+        .collect::<BTreeSet<_>>();
+    for source in sources {
+        let (program, _) = scalar_source_program(implicit_rhs, source)?.ok_or_else(|| {
+            ContinuousRefreshConstructionError {
+                reason: "continuous refresh coordinate certificate source is missing".to_string(),
+            }
+        })?;
+        builder.visit_program(program)?;
+    }
+    if !plan.simultaneous_plan.blocks.is_empty() {
+        // Projection blocks may retain compact tensor nodes that have no
+        // scalar-row source identity. Scan their canonical ComputeBlock
+        // owners directly; no tensor coordinate or expression is expanded.
+        builder.visit_compute_block(implicit_rhs)?;
+    }
+    builder.finish()
+}
+
+struct RefreshCoordinateDependencyBuilder<'layout> {
+    purpose: ContinuousRefreshPurpose,
+    solve_layout: &'layout crate::SolveLayout,
+    y_ranges: Vec<RefreshCoordinateRange>,
+    p_ranges: Vec<RefreshCoordinateRange>,
+    reads_time: bool,
+    reads_event_generation: bool,
+    reads_pre_generation: bool,
+    reads_previous_generation: bool,
+    reads_history_generation: bool,
+    reads_external_table_state: bool,
+    reads_impure_state: bool,
+    reads_ad_mode: bool,
+}
+
+impl<'layout> RefreshCoordinateDependencyBuilder<'layout> {
+    fn new(purpose: ContinuousRefreshPurpose, solve_layout: &'layout crate::SolveLayout) -> Self {
+        Self {
+            purpose,
+            solve_layout,
+            y_ranges: Vec::new(),
+            p_ranges: Vec::new(),
+            reads_time: false,
+            reads_event_generation: matches!(
+                purpose,
+                ContinuousRefreshPurpose::Event | ContinuousRefreshPurpose::ClockEvent { .. }
+            ),
+            reads_pre_generation: false,
+            reads_previous_generation: false,
+            reads_history_generation: false,
+            reads_external_table_state: false,
+            reads_impure_state: false,
+            reads_ad_mode: false,
+        }
+    }
+
+    fn finish(
+        self,
+    ) -> Result<RefreshCoordinateDependencyCertificate, ContinuousRefreshConstructionError> {
+        Ok(RefreshCoordinateDependencyCertificate {
+            purpose: self.purpose,
+            y_ranges: coalesce_coordinate_ranges(self.y_ranges)?,
+            p_ranges: coalesce_coordinate_ranges(self.p_ranges)?,
+            reads_time: self.reads_time,
+            reads_event_generation: self.reads_event_generation,
+            reads_pre_generation: self.reads_pre_generation,
+            reads_previous_generation: self.reads_previous_generation,
+            reads_history_generation: self.reads_history_generation,
+            reads_external_table_state: self.reads_external_table_state,
+            reads_impure_state: self.reads_impure_state,
+            reads_arithmetic_profile: true,
+            reads_ad_mode: self.reads_ad_mode,
+        })
+    }
+
+    fn visit_compute_block(
+        &mut self,
+        block: &ComputeBlock,
+    ) -> Result<(), ContinuousRefreshConstructionError> {
+        for node in &block.nodes {
+            match node {
+                ComputeNode::ScalarPrograms(programs) => {
+                    for program in programs.programs() {
+                        self.visit_program(program)?;
+                    }
+                }
+                ComputeNode::MatMul {
+                    lhs_ops, rhs_ops, ..
+                } => {
+                    self.visit_program(lhs_ops)?;
+                    self.visit_program(rhs_ops)?;
+                }
+                ComputeNode::LinSolve { setup_ops, .. } => self.visit_program(setup_ops)?,
+                ComputeNode::Map {
+                    domain,
+                    base_ops,
+                    load_strides,
+                    ..
+                }
+                | ComputeNode::AffineStencil {
+                    domain,
+                    base_ops,
+                    load_strides,
+                    ..
+                } => {
+                    self.visit_program(base_ops)?;
+                    self.visit_affine_load_ranges(domain, base_ops, load_strides)?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn visit_program(
+        &mut self,
+        program: &[LinearOp],
+    ) -> Result<(), ContinuousRefreshConstructionError> {
+        for operation in program {
+            match operation {
+                LinearOp::LoadTime { .. } => self.reads_time = true,
+                LinearOp::LoadY { index, .. } => self.add_y_range(*index, 1)?,
+                LinearOp::LoadP { index, .. } => self.add_p_range(*index, 1)?,
+                LinearOp::LoadIndexedP { base, count, .. } => {
+                    self.add_p_range(*base, *count)?
+                }
+                LinearOp::TensorLoad {
+                    input,
+                    input_start,
+                    count,
+                    seed_start,
+                    ..
+                } => {
+                    match input {
+                        crate::TensorInputKind::Y => self.add_y_range(*input_start, *count)?,
+                        crate::TensorInputKind::P => self.add_p_range(*input_start, *count)?,
+                    }
+                    self.reads_ad_mode |= seed_start.is_some();
+                }
+                LinearOp::LoadSeed { .. } | LinearOp::LoadIndexedSeed { .. } => {
+                    self.reads_ad_mode = true;
+                }
+                LinearOp::TableBounds { .. }
+                | LinearOp::TableLookup { .. }
+                | LinearOp::TableLookupSlope { .. }
+                | LinearOp::TableNextEvent { .. } => {
+                    self.reads_external_table_state = true;
+                }
+                LinearOp::ImpureRandomInit { .. }
+                | LinearOp::ImpureRandom { .. }
+                | LinearOp::ImpureRandomInteger { .. } => {
+                    self.reads_impure_state = true;
+                }
+                LinearOp::FunctionFold { program, .. }
+                | LinearOp::GuardedFunctionFold { program, .. }
+                | LinearOp::StoreOutputFunctionFold { program, .. } => {
+                    self.visit_program(&program.update)?;
+                }
+                LinearOp::FunctionConditional { program, .. } => {
+                    for arm in &program.arms {
+                        self.visit_program(&arm.condition)?;
+                        self.visit_program(&arm.result)?;
+                    }
+                    self.visit_program(&program.fallback)?;
+                }
+                LinearOp::PureCallDirectional { .. } => self.reads_ad_mode = true,
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+
+    fn visit_affine_load_ranges(
+        &mut self,
+        domain: &rumoca_core::StructuredIndexDomain,
+        base_ops: &[LinearOp],
+        load_strides: &[crate::AffineStencilLoadStride],
+    ) -> Result<(), ContinuousRefreshConstructionError> {
+        let extents = domain
+            .extents()
+            .map_err(|error| ContinuousRefreshConstructionError {
+                reason: format!("continuous refresh affine domain is invalid: {error}"),
+            })?;
+        for stride in load_strides {
+            let (minimum, maximum) = affine_adjustment_bounds(&extents, &stride.terms)?;
+            let Some(operation) = base_ops.get(stride.op_position) else {
+                return refresh_error(
+                    "continuous refresh affine dependency refers to a missing operation"
+                        .to_string(),
+                );
+            };
+            match operation {
+                LinearOp::LoadY { index, .. } => {
+                    let (start, count) = adjusted_coordinate_range(*index, minimum, maximum)?;
+                    self.add_y_range(start, count)?;
+                }
+                LinearOp::LoadP { index, .. } => {
+                    let (start, count) = adjusted_coordinate_range(*index, minimum, maximum)?;
+                    self.add_p_range(start, count)?;
+                }
+                LinearOp::LoadSeed { .. } => self.reads_ad_mode = true,
+                _ => {
+                    return refresh_error(
+                        "continuous refresh affine dependency is not attached to a compact load"
+                            .to_string(),
+                    );
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn add_y_range(
+        &mut self,
+        start: usize,
+        count: usize,
+    ) -> Result<(), ContinuousRefreshConstructionError> {
+        push_coordinate_range(&mut self.y_ranges, start, count)?;
+        if storage_range_has_event_value(self.solve_layout, true, start, count)? {
+            self.reads_event_generation = true;
+        }
+        Ok(())
+    }
+
+    fn add_p_range(
+        &mut self,
+        start: usize,
+        count: usize,
+    ) -> Result<(), ContinuousRefreshConstructionError> {
+        push_coordinate_range(&mut self.p_ranges, start, count)?;
+        if storage_range_has_event_value(self.solve_layout, false, start, count)? {
+            self.reads_event_generation = true;
+        }
+        for binding in &self.solve_layout.pre_param_bindings {
+            if coordinate_range_contains(start, count, binding.dest_p_index)? {
+                if binding.clock_schedule.is_some() {
+                    self.reads_previous_generation = true;
+                } else {
+                    self.reads_pre_generation = true;
+                }
+                self.reads_history_generation = true;
+            }
+        }
+        if self
+            .solve_layout
+            .relation_memory_parameter_indices
+            .iter()
+            .copied()
+            .any(|index| coordinate_range_contains(start, count, index).unwrap_or(true))
+        {
+            self.reads_event_generation = true;
+            self.reads_history_generation = true;
+        }
+        for index in [
+            self.solve_layout.initial_event_parameter_index,
+            self.solve_layout.terminal_event_parameter_index,
+            self.solve_layout.initial_homotopy_parameter_index,
+        ]
+        .into_iter()
+        .flatten()
+        {
+            if coordinate_range_contains(start, count, index)? {
+                self.reads_event_generation = true;
+            }
+        }
+        Ok(())
+    }
+}
+
+fn affine_adjustment_bounds(
+    extents: &[usize],
+    terms: &[crate::AffineStencilIndexStrideTerm],
+) -> Result<(i128, i128), ContinuousRefreshConstructionError> {
+    let mut minimum = 0i128;
+    let mut maximum = 0i128;
+    for term in terms {
+        let extent = extents.get(term.dimension).copied().ok_or_else(|| {
+            ContinuousRefreshConstructionError {
+                reason: "continuous refresh affine dependency dimension is out of bounds"
+                    .to_string(),
+            }
+        })?;
+        let steps = i128::try_from(extent.saturating_sub(1)).map_err(|_| {
+            ContinuousRefreshConstructionError {
+                reason: "continuous refresh affine dependency extent overflows".to_string(),
+            }
+        })?;
+        let adjustment = (term.stride as i128).checked_mul(steps).ok_or_else(|| {
+            ContinuousRefreshConstructionError {
+                reason: "continuous refresh affine dependency adjustment overflows".to_string(),
+            }
+        })?;
+        if adjustment < 0 {
+            minimum = minimum.checked_add(adjustment).ok_or_else(|| {
+                ContinuousRefreshConstructionError {
+                    reason: "continuous refresh affine dependency minimum overflows".to_string(),
+                }
+            })?;
+        } else {
+            maximum = maximum.checked_add(adjustment).ok_or_else(|| {
+                ContinuousRefreshConstructionError {
+                    reason: "continuous refresh affine dependency maximum overflows".to_string(),
+                }
+            })?;
+        }
+    }
+    Ok((minimum, maximum))
+}
+
+fn adjusted_coordinate_range(
+    base: usize,
+    minimum: i128,
+    maximum: i128,
+) -> Result<(usize, usize), ContinuousRefreshConstructionError> {
+    let base = i128::try_from(base).map_err(|_| ContinuousRefreshConstructionError {
+        reason: "continuous refresh affine dependency base overflows".to_string(),
+    })?;
+    let start = base
+        .checked_add(minimum)
+        .and_then(|value| usize::try_from(value).ok())
+        .ok_or_else(|| ContinuousRefreshConstructionError {
+            reason: "continuous refresh affine dependency starts outside storage".to_string(),
+        })?;
+    let end = base
+        .checked_add(maximum)
+        .and_then(|value| value.checked_add(1))
+        .and_then(|value| usize::try_from(value).ok())
+        .ok_or_else(|| ContinuousRefreshConstructionError {
+            reason: "continuous refresh affine dependency ends outside storage".to_string(),
+        })?;
+    Ok((start, end - start))
+}
+
+fn push_coordinate_range(
+    ranges: &mut Vec<RefreshCoordinateRange>,
+    start: usize,
+    count: usize,
+) -> Result<(), ContinuousRefreshConstructionError> {
+    if count == 0 {
+        return Ok(());
+    }
+    start
+        .checked_add(count)
+        .ok_or_else(|| ContinuousRefreshConstructionError {
+            reason: "continuous refresh coordinate range overflows".to_string(),
+        })?;
+    ranges.push(RefreshCoordinateRange { start, count });
+    Ok(())
+}
+
+fn coalesce_coordinate_ranges(
+    mut ranges: Vec<RefreshCoordinateRange>,
+) -> Result<Box<[RefreshCoordinateRange]>, ContinuousRefreshConstructionError> {
+    ranges.sort_unstable_by_key(|range| range.start);
+    let mut coalesced: Vec<RefreshCoordinateRange> = Vec::with_capacity(ranges.len());
+    for range in ranges {
+        let range_end = range.start.checked_add(range.count).ok_or_else(|| {
+            ContinuousRefreshConstructionError {
+                reason: "continuous refresh coordinate range overflows".to_string(),
+            }
+        })?;
+        if let Some(previous) = coalesced.last_mut() {
+            let previous_end = previous.start.checked_add(previous.count).ok_or_else(|| {
+                ContinuousRefreshConstructionError {
+                    reason: "continuous refresh coordinate range overflows".to_string(),
+                }
+            })?;
+            if range.start <= previous_end {
+                previous.count = previous_end.max(range_end) - previous.start;
+                continue;
+            }
+        }
+        coalesced.push(range);
+    }
+    Ok(coalesced.into_boxed_slice())
+}
+
+fn coordinate_range_contains(
+    start: usize,
+    count: usize,
+    index: usize,
+) -> Result<bool, ContinuousRefreshConstructionError> {
+    let end = start
+        .checked_add(count)
+        .ok_or_else(|| ContinuousRefreshConstructionError {
+            reason: "continuous refresh coordinate range overflows".to_string(),
+        })?;
+    Ok((start..end).contains(&index))
+}
+
+fn storage_range_has_event_value(
+    solve_layout: &crate::SolveLayout,
+    y_storage: bool,
+    start: usize,
+    count: usize,
+) -> Result<bool, ContinuousRefreshConstructionError> {
+    let end = start
+        .checked_add(count)
+        .ok_or_else(|| ContinuousRefreshConstructionError {
+            reason: "continuous refresh coordinate range overflows".to_string(),
+        })?;
+    Ok(solve_layout.variable_storage_runs.iter().any(|run| {
+        let (run_start, same_storage) = match run.base {
+            crate::ScalarSlot::Y { index, .. } => (index, y_storage),
+            crate::ScalarSlot::P { index, .. } => (index, !y_storage),
+            crate::ScalarSlot::Time | crate::ScalarSlot::Constant(_) => (0, false),
+        };
+        if !same_storage {
+            return false;
+        }
+        let Some(run_end) = run_start.checked_add(run.scalar_count) else {
+            return true;
+        };
+        start < run_end
+            && run_start < end
+            && matches!(
+                run.role,
+                crate::SolveVariableStorageRole::DiscreteReal
+                    | crate::SolveVariableStorageRole::DiscreteValue
+            )
+    }))
+}
