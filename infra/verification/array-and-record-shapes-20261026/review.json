  "scope": [
    "Recompute whole-array equation cardinalities and row-major family domains after resolving component member projections.",
    "Retain empty record declarations, zero extents, source identity and effective types without instantiating absent elements.",
    "Use record container axes in function shape analysis and project record fields across array construction and concatenation.",
    "Evaluate structural Integer record bindings in their owning scopes and distribute non-each array-expression modifiers per element.",
    "Evaluate omitted trailing array subscripts as whole axes, matching checked DAE semantics."
  ],
  "first_divergent_owners": [
    {
      "failure": "Projected vector and matrix equations reported 1/4 scalar rows instead of 3/24.",
      "owner": "rumoca-phase-flatten::postprocess::index_collapse",
      "fix": "Rebuild the equation cardinality and authoritative array family after resolving exact occurrences."
    },
    {
      "failure": "Empty record declarations were absent from instance components and could become untyped primitive placeholders.",
      "owner": "rumoca-phase-instantiate::component_loop",
      "fix": "Retain the typed declaration header and skip the absent record body; flatten honors the retained record owner."
    },
    {
      "failure": "Record shape analysis rejected retained containers as unresolved references.",
      "owner": "rumoca-phase-dae::construction::function_shapes",
      "fix": "Register exact declared container dimensions, rejecting invalid negative extents."
    },
    {
      "failure": "cat record arguments were inferred as Integer from the concatenation axis.",
      "owner": "rumoca-phase-typecheck::expression_types",
      "fix": "Infer and unify cat result types from its value operands."
    },
    {
      "failure": "Record constructor counts were absent or replaced by stale defaults; array modifiers reached DAE with the wrong rank.",
      "owner": "rumoca-eval-ast::eval_instantiate and rumoca-phase-instantiate::array_expansion",
      "fix": "Evaluate bound record fields in scope; share modifier selection with the homogeneity gate."
    },
    {
      "failure": "After compile-time fixes, row modifiers failed at runtime because omitted trailing subscripts were rejected.",
      "owner": "rumoca-eval-dae::numeric",
      "fix": "Treat omitted trailing axes as Whole, as proven by checked DAE construction."
    }
  ],
  "specs": [
    "SPEC_0007",
    "SPEC_0021",
    "SPEC_0022: MLS 7.2.5, 10.1, 10.4.4, 10.5, 10.6.1, 10.6.9, 10.7, 12.2, 12.6",
    "SPEC_0029",
    "SPEC_0032 section 1 / SPEC_0043 section 17",
    "SPEC_0033 section 6a"
  ],
  "adaptations_to_main": [
    "Omit function-shape value propagation and structured-template analysis already supported on main.",
    "Update the empty redeclared-record regression to require one correctly typed zero-extent header and no elements or fields.",
    "Port the empty-record declaration contract to the active construction catalog instead of its historical parent location."
  ],
  "risk_notes": {
    "correctness": "Projection rewrites must preserve exact occurrence identity, every container and field axis, and zero-length domains. Modifier distribution must agree with the compaction decision.",
