@@ -2735,6 +2735,45 @@
           (fun (c, name) -> (c.clause_id, name))
           (List.combine trait_decl.parent_clauses info.parent_clauses)
   in
+  (* Fields may share names across records, never within one record. Other
+     members are registered first so parent clauses cannot shadow them. *)
+  let span = trait_decl.item_meta.span in
+  let decl_id = trait_decl.def_id in
+  let reserved =
