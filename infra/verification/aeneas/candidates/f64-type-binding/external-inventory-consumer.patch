+    #[test]
+    fn a_manifest_without_float_dependencies_cannot_be_checked() {
+        let mut manifest = accepted();
+        manifest
+            .as_object_mut()
+            .expect("object")
+            .remove("float_dependencies");
+        assert!(serde_json::from_value::<Manifest>(manifest).is_err());
+    }
+
+    #[test]
+    fn the_reviewed_float_width_must_be_listed() {
+        let mut manifest = accepted();
+        manifest["float_dependencies"] = serde_json::json!([]);
+        let error = verdict(manifest).expect_err("an unlisted reviewed width must refuse");
+        assert!(error.to_string().contains("Aeneas.Std.F64"), "{error}");
+    }
+
+    #[test]
+    fn a_duplicate_float_width_refuses() {
+        let mut manifest = accepted();
+        let first = manifest["float_dependencies"][0].clone();
+        manifest["float_dependencies"]
+            .as_array_mut()
+            .expect("floats")
+            .push(first);
+        let error = verdict(manifest).expect_err("a duplicate width must refuse");
+        assert!(error.to_string().contains("more than once"), "{error}");
+    }
+
+    #[test]
+    fn an_unreviewed_float_width_refuses() {
+        let mut manifest = accepted();
+        manifest["float_dependencies"].as_array_mut().expect("floats").push(serde_json::json!({
+            "width": 32, "lean_name": "Aeneas.Std.F32", "lean_file": "TypesExternal_Template.lean"
+        }));
+        let error = verdict(manifest).expect_err("f32 has no reviewed model");
+        assert!(error.to_string().contains("32"), "{error}");
+    }
+
+    #[test]
+    fn a_renamed_float_refuses() {
+        let mut manifest = accepted();
+        manifest["float_dependencies"][0]["lean_name"] = serde_json::json!("Float");
+        let error = verdict(manifest).expect_err("the emitted name is part of the decision");
+        assert!(error.to_string().contains("Aeneas.Std.F64"), "{error}");
+    }
+
+    #[test]
+    fn a_relocated_float_refuses() {
+        let mut manifest = accepted();
+        manifest["float_dependencies"][0]["lean_file"] = serde_json::json!("Types.lean");
+        let error = verdict(manifest).expect_err("the template file is part of the decision");
+        assert!(
+            error.to_string().contains("TypesExternal_Template.lean"),
+            "{error}"
+        );
+    }
+
+    #[test]
