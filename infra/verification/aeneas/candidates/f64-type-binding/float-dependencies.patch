--- a/extract/ExtractTypes.ml	2026-09-08 10:09:43.009896003 -0400
+++ b/extract/ExtractTypes.ml	2026-09-08 10:13:45.510511161 -0400
@@ -2177,3 +2177,24 @@
         if backend () = Lean then
           extract_type_decl_record_field_projectors_simp_lemmas ctx fmt kind
             decl)
+
+(** Emit, into the external-types template, one required-model placeholder per
+    floating-point width the crate references. The backend prints the width as
+    a bare name (see [ExtractBase.float_name]) and defines it nowhere, so the
+    model file replacing this template must supply it under [Aeneas.Std]. The
+    placeholder is an axiom of the same shape the template uses for opaque
+    types; whether an unfilled placeholder may be admitted is the consumer's
+    decision, not the translator's. *)
+let extract_float_dependency_placeholders (fmt : F.formatter)
+    (floats : Pure.float_type list) : unit =
+  List.iter
+    (fun (f : Pure.float_type) ->
+      let name = ExtractBase.float_name f in
+      F.pp_print_string fmt
+        ("/-- [" ^ String.lowercase_ascii name
+       ^ "]: floating-point storage primitive referenced by this crate.\n\
+         \    The translator names it and does not define it; the model \
+          file must supply\n\
+         \    `Aeneas.Std." ^ name ^ "`. -/\n" ^ "axiom Aeneas.Std." ^ name
+       ^ " : Type\n\n"))
+    floats
diff -ru a/pure/PureUtils.ml b/pure/PureUtils.ml
--- a/pure/PureUtils.ml	2026-09-08 10:09:43.012374113 -0400
+++ b/pure/PureUtils.ml	2026-09-08 10:13:45.491511092 -0400
@@ -2857,3 +2857,49 @@
   in
   let app1 = { e = App (binop, b0); ty = TArrow (bool_ty, bool_ty) } in
   { e = App (app1, b1); ty = bool_ty }
+
+(** Float widths referenced anywhere in a set of translated declarations.
+
+    The walk is typed: it visits every [TFloat] in type declarations, function
+    signatures and bodies, globals and trait constants through the pure
+    visitors, so a width is found whether it appears in a field, a parameter,
+    a local or a literal, and never by inspecting emitted text. The result is
+    sorted and duplicate-free. *)
+let crate_float_types (types : type_decl list) (funs : fun_decl list)
+    (globals : global_decl list) (trait_decls : trait_decl list) :
+    float_type list =
+  let found : float_type list ref = ref [] in
+  let record (f : float_type) = if not (List.mem f !found) then found := f :: !found in
+  let ty_visitor =
+    object
+      inherit [_] iter_ty
+      method! visit_TFloat _ f = record f
+    end
+  in
+  let expr_visitor =
+    object
+      inherit [_] iter_expr
+      method! visit_TFloat _ f = record f
+    end
+  in
+  List.iter
+    (fun (d : type_decl) ->
+      match d.kind with
+      | Struct fields -> List.iter (fun (fd : field) -> ty_visitor#visit_ty () fd.field_ty) fields
+      | Enum variants ->
+          List.iter
+            (fun (v : variant) -> List.iter (fun (fd : field) -> ty_visitor#visit_ty () fd.field_ty) v.fields)
+            variants
+      | _ -> ())
+    types;
+  List.iter
+    (fun (f : fun_decl) ->
+      List.iter (ty_visitor#visit_ty ()) f.signature.inputs;
+      ty_visitor#visit_ty () f.signature.output;
+      Option.iter (fun (b : fun_body) -> expr_visitor#visit_texpr () b.body) f.body)
+    funs;
+  List.iter (fun (g : global_decl) -> ty_visitor#visit_ty () g.ty) globals;
+  List.iter
+    (fun (d : trait_decl) -> List.iter (fun (_, _, ty) -> ty_visitor#visit_ty () ty) d.consts)
+    trait_decls;
+  List.sort compare !found
