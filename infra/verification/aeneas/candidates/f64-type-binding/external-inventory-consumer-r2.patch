+/// Floating-point widths: each listed width must be the one reviewed, under
+/// the name the translator emits, in the template the model replaces; and the
+/// reviewed width must be listed, or its model would apply to nothing.
+fn check_float_dependencies(manifest: &Manifest) -> Result<()> {
+    let mut float_seen: BTreeSet<u32> = BTreeSet::new();
+    for dependency in &manifest.float_dependencies {
+        ensure!(
+            float_seen.insert(dependency.width),
+            "float width {} is listed more than once",
+            dependency.width
+        );
+        let Some((_, name, file)) = PERMITTED_FLOAT
+            .iter()
+            .find(|(width, _, _)| *width == dependency.width)
+        else {
+            bail!(
+                "float width {} has no reviewed storage model; a model for it \
+                 would enlarge the trusted base without review",
+                dependency.width
+            );
+        };
+        ensure!(
+            *name == dependency.lean_name,
+            "float width {} is named `{}`, expected `{name}`",
+            dependency.width,
+            dependency.lean_name
+        );
+        ensure!(
+            *file == dependency.lean_file,
+            "float width {} moved to {}, expected {file}",
+            dependency.width,
+            dependency.lean_file
+        );
+    }
+    for (width, name, file) in PERMITTED_FLOAT {
+        ensure!(
+            float_seen.contains(width),
+            "permitted float width {width} (`{name}`) is missing from {file}; the \
+             model would apply to nothing"
+        );
+    }
+    Ok(())
+}
