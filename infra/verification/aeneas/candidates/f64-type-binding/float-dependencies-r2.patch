+
+(** Record the floating-point widths the translated crate depends on. Each is
+    a primitive the backend names but never defines, so the model file listed
+    here must supply it; the entry is what lets a consumer decide that. *)
+let record_float_dependencies_if_enabled (floats : Pure.float_type list)
+    ~(lean_file : string) : unit =
+  if !Config.emit_json then
+    state.float_dependency_entries <-
+      List.map
+        (fun (f : Pure.float_type) ->
+          let width =
+            match f with F16 -> 16 | F32 -> 32 | F64 -> 64 | F128 -> 128
+          in
+          { width; lean_name = "Aeneas.Std." ^ ExtractBase.float_name f; lean_file })
+        floats
+      @ state.float_dependency_entries
