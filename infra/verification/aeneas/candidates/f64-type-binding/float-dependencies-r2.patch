@@ -2177,3 +2177,24 @@
         if backend () = Lean then
           extract_type_decl_record_field_projectors_simp_lemmas ctx fmt kind
             decl)
+
+(** Emit, into the external-types template, one required-model placeholder per
+    floating-point width the crate references. The backend prints the width as
+    a bare name (see [ExtractBase.float_name]) and defines it nowhere, so the
+    model file replacing this template must supply it under [Aeneas.Std]. The
+    placeholder is an axiom of the same shape the template uses for opaque
+    types; whether an unfilled placeholder may be admitted is the consumer's
+    decision, not the translator's. *)
+let extract_float_dependency_placeholders (fmt : F.formatter)
+    (floats : Pure.float_type list) : unit =
+  List.iter
+    (fun (f : Pure.float_type) ->
+      let name = ExtractBase.float_name f in
+      F.pp_print_string fmt
+        ("/-- [" ^ String.lowercase_ascii name
+       ^ "]: floating-point storage primitive referenced by this crate.\n\
+         \    The translator names it and does not define it; the model \
+          file must supply\n\
+         \    `Aeneas.Std." ^ name ^ "`. -/\n" ^ "axiom Aeneas.Std." ^ name
+       ^ " : Type\n\n"))
+    floats
diff -ru a/pure/PureUtils.ml b/pure/PureUtils.ml
--- a/pure/PureUtils.ml	2026-09-08 10:09:43.012374113 -0400
+++ b/pure/PureUtils.ml	2026-09-08 10:57:24.393738534 -0400
@@ -2857,3 +2857,185 @@
   in
   let app1 = { e = App (binop, b0); ty = TArrow (bool_ty, bool_ty) } in
   { e = App (app1, b1); ty = bool_ty }
+
+(** Float widths referenced anywhere in a set of translated declarations.
+
+    The walk is typed and complete: every declaration record is destructured
+    exhaustively (warning 9 is an error inside this module, so a field added
+    later must be classified here before the module compiles), and each typed
+    field is visited through the derived pure visitors. A width is found
+    whether it appears in a field, a generic argument, a predicate, a
+    signature, an associated type, a constant, a body or a literal, and never
+    by inspecting emitted text. The result is sorted and duplicate-free. *)
+module FloatTypes = struct
+  [@@@warning "@9"]
+
+  let collect (types : type_decl list) (funs : fun_decl list)
+      (globals : global_decl list) (trait_decls : trait_decl list)
+      (trait_impls : trait_impl list) : float_type list =
+    let found : float_type list ref = ref [] in
+    let record (f : float_type) =
+      if not (List.mem f !found) then found := f :: !found
+    in
+    let tys =
+      object
+        inherit [_] iter_type_decl
+        method! visit_TFloat _ f = record f
+      end
+    in
+    let exprs =
+      object
+        inherit [_] iter_expr
+        method! visit_TFloat _ f = record f
+      end
+    in
+    let visit_generics (generics : generic_params) (preds : predicates) =
+      tys#visit_generic_params () generics;
+      tys#visit_predicates () preds
+    in
+    let visit_binder : 'a. ('a -> unit) -> 'a binder -> unit =
+     fun visit_value b ->
+      let {
+        binder_value;
+        binder_generics;
+        binder_preds;
+        binder_llbc_generics = _;
+        binder_explicit_info = _;
+      } =
+        b
+      in
+      visit_generics binder_generics binder_preds;
+      visit_value binder_value
+    in
+    let visit_sig (s : fun_sig) =
+      let {
+        generics;
+        explicit_info = _;
+        known_from_trait_refs = _;
+        llbc_generics = _;
+        preds;
+        inputs;
+        output;
+        fwd_info = _;
+        back_effect_info = _;
+      } =
+        s
+      in
+      visit_generics generics preds;
+      List.iter (tys#visit_ty ()) inputs;
+      tys#visit_ty () output
+    in
+    let visit_fun_body ({ inputs; body } : fun_body) =
+      List.iter (exprs#visit_tpat ()) inputs;
+      exprs#visit_texpr () body
+    in
+    let visit_fun (f : fun_decl) =
+      let {
+        def_id = _;
+        item_meta = _;
+        builtin_info = _;
+        src = _;
+        backend_attributes = _;
+        num_loops = _;
+        loop_id = _;
+        loop_pos = _;
+        name = _;
+        signature;
+        is_global_decl_body = _;
+        body;
+      } =
+        f
+      in
+      visit_sig signature;
+      Option.iter visit_fun_body body
+    in
+    let visit_global (g : global_decl) =
+      let {
+        def_id = _;
+        span = _;
+        item_meta = _;
+        builtin_info = _;
+        name = _;
+        llbc_generics = _;
+        generics;
+        explicit_info = _;
+        preds;
+        ty;
+        output_ty;
+        can_fail = _;
+        src = _;
+        body_id = _;
+      } =
+        g
+      in
+      visit_generics generics preds;
+      tys#visit_ty () ty;
+      tys#visit_ty () output_ty
+    in
+    let visit_trait_method (m : trait_method) =
+      let { method_id = _; item_name = _; item_meta = _; signature; default } =
+        m
+      in
+      visit_sig signature;
+      visit_binder (Option.iter (tys#visit_fun_decl_ref ())) default
+    in
+    let visit_trait_decl (d : trait_decl) =
+      let {
+        def_id = _;
+        name = _;
+        item_meta = _;
+        builtin_info = _;
+        generics;
+        explicit_info = _;
+        llbc_generics = _;
+        preds;
+        parent_clauses;
+        llbc_parent_clauses = _;
+        consts;
+        types = _;
+        methods;
+      } =
+        d
+      in
+      visit_generics generics preds;
+      List.iter (tys#visit_trait_param ()) parent_clauses;
+      List.iter (fun (_, _, ty) -> tys#visit_ty () ty) consts;
+      List.iter visit_trait_method methods
+    in
+    let visit_trait_impl (i : trait_impl) =
+      let {
+        def_id = _;
+        name = _;
+        item_meta = _;
+        builtin_info = _;
+        impl_trait;
+        llbc_impl_trait = _;
+        generics;
+        explicit_info = _;
+        llbc_generics = _;
+        preds;
+        parent_trait_refs;
+        consts;
+        types;
+        methods;
+      } =
+        i
+      in
+      tys#visit_trait_decl_ref () impl_trait;
+      visit_generics generics preds;
+      List.iter (tys#visit_trait_ref ()) parent_trait_refs;
+      List.iter (fun (_, _, r) -> tys#visit_global_decl_ref () r) consts;
+      List.iter (fun (_, _, ty) -> tys#visit_ty () ty) types;
+      List.iter
+        (fun (_, _, m) -> visit_binder (tys#visit_fun_decl_ref ()) m)
+        methods
+    in
+    List.iter (tys#visit_type_decl ()) types;
+    List.iter visit_fun funs;
+    List.iter visit_global globals;
+    List.iter visit_trait_decl trait_decls;
+    List.iter visit_trait_impl trait_impls;
+    List.sort compare !found
+end
+
+let crate_float_types = FloatTypes.collect
