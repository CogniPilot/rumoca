+let match_name_find_opt (ctx : trans_ctx) (name : Types.name)
+    (m : 'a NameMatcher.NameMatcherMap.t) : 'a option =
+  let mctx = NameMatcher.ctx_from_crate ctx.crate in
+  match instantiated_name_generics name with
+  | None -> ExtractBuiltin.NameMatcherMap.find_opt mctx name m
+  | Some (_, args) ->
+      ExtractBuiltin.NameMatcherMap.find_with_generics_opt mctx name args m
