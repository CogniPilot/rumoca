+import Aeneas.Std.Slice
+
+namespace Aeneas.Std
+
+@[rust_fun
+  "alloc::boxed::convert::{core::convert::From<Box<[@T]>, &'0 [@T]>}::from"]
+def alloc.boxed.FromBoxSliceSharedSlice.from {T : Type}
+    (cloneInst : core.clone.Clone T) (s : Slice T) : Result (Slice T) :=
+  Slice.clone cloneInst.clone s
+
+@[step]
+theorem alloc.boxed.FromBoxSliceSharedSlice.from_spec {T : Type}
+    (cloneInst : core.clone.Clone T) (s : Slice T)
+    (h : ∀ x ∈ s.val, cloneInst.clone x = Result.ok x) :
+    alloc.boxed.FromBoxSliceSharedSlice.from cloneInst s ⦃ s' => s = s' ⦄ := by
+  exact Slice.clone_spec h
+
+end Aeneas.Std
