+import SharedLoanAlias
+
+open Aeneas Aeneas.Std shared_loan_alias
+
+def aliasChoicePayload : Choice → U32
+  | .Left value => value
+  | .Right value => value
+
+theorem distinct_loans_preserve_independent_payloads (pair : Pair) :
+    distinct pair = Result.ok (aliasChoicePayload pair.left, aliasChoicePayload pair.right) := by
+  rcases pair with ⟨left, right⟩
+  cases left <;> cases right <;> rfl
+
+theorem local_aliases_preserve_payload (choice : Choice) (select : Bool) :
+    «local» choice select = Result.ok (aliasChoicePayload choice) := by
+  cases select <;> cases choice <;> rfl
+
+theorem mutable_branch_preserves_update (value : U32) (select : Bool) :
+    mutable value select = Result.ok (if select then 1#u32 else 2#u32) := by
+  cases select <;> rfl
+
+theorem nested_selection_projects_expected_fields
+    (pair : NestedPair) (chooseLeft : Bool) :
+    select_nested pair chooseLeft =
+      Result.ok (pair.left.value,
+        if chooseLeft then pair.left.value else pair.right.value,
+        pair.right.value) := by
+  cases chooseLeft <;> rfl
+
+/-- info: 'distinct_loans_preserve_independent_payloads' does not depend on any axioms -/
+#guard_msgs in
+#print axioms distinct_loans_preserve_independent_payloads
+
+/-- info: 'local_aliases_preserve_payload' does not depend on any axioms -/
+#guard_msgs in
+#print axioms local_aliases_preserve_payload
+
+/-- info: 'mutable_branch_preserves_update' depends on axioms: [propext, Classical.choice, Quot.sound] -/
+#guard_msgs in
+#print axioms mutable_branch_preserves_update
+
+/-- info: 'nested_selection_projects_expected_fields' does not depend on any axioms -/
+#guard_msgs in
+#print axioms nested_selection_projects_expected_fields
