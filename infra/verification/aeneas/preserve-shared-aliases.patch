+//@ [!lean] skip
+//@ charon-args=--mir optimized
+#![feature(register_tool)]
+#![register_tool(verify)]
+
+pub enum Choice {
+    Left(u32),
+    Right(u32),
+}
+
+pub struct Pair<'a> {
+    pub left: &'a Choice,
+    pub right: &'a Choice,
+}
+
+pub fn single(choice: &Choice) -> u32 {
+    match choice {
+        Choice::Left(value) | Choice::Right(value) => *value,
+    }
+}
+
+pub fn distinct(pair: Pair<'_>) -> (u32, u32) {
+    let left = match pair.left {
+        Choice::Left(value) | Choice::Right(value) => *value,
+    };
+    let right = match pair.right {
+        Choice::Left(value) | Choice::Right(value) => *value,
+    };
+    (left, right)
+}
+
+pub fn local(choice: Choice, select: bool) -> u32 {
+    let first = &choice;
+    let second = first;
+    if select {
+        match first {
+            Choice::Left(value) | Choice::Right(value) => *value,
+        }
+    } else {
+        match second {
+            Choice::Left(value) | Choice::Right(value) => *value,
+        }
+    }
+}
+
+pub fn mutable(value: &mut u32, select: bool) {
+    if select {
+        *value = 1;
+    } else {
+        *value = 2;
+    }
+}
+
+pub struct Nested<'a> {
+    pub value: &'a u32,
+}
+
+pub struct NestedPair<'a> {
+    pub left: &'a Nested<'a>,
+    pub right: &'a Nested<'a>,
+}
+
+pub fn select_nested(pair: NestedPair<'_>, choose_left: bool) -> (u32, u32, u32) {
+    let alias = pair.left;
+    let selected = if choose_left { pair.left } else { pair.right };
+    (*alias.value, *selected.value, *pair.right.value)
+}
+
+#[verify::test]
+pub fn distinct_loan_regression() {
+    let left = Choice::Left(11);
+    let right = Choice::Right(29);
+    let (first, second) = distinct(Pair {
+        left: &left,
+        right: &right,
+    });
+    assert!(first == 11);
+    assert!(second == 29);
+}
+
+#[verify::test]
+pub fn nested_loan_regression() {
+    let left_value = 11;
+    let right_value = 29;
+    let left = Nested { value: &left_value };
+    let right = Nested {
+        value: &right_value,
+    };
+    let (first, selected, second) = select_nested(
+        NestedPair {
+            left: &left,
+            right: &right,
+        },
+        true,
+    );
+    assert!(first == 11);
+    assert!(selected == 11);
+    assert!(second == 29);
+    let (first, selected, second) = select_nested(
+        NestedPair {
+            left: &left,
+            right: &right,
+        },
+        false,
+    );
+    assert!(first == 11);
+    assert!(selected == 29);
+    assert!(second == 29);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn independent_values_and_local_aliases() {
+        distinct_loan_regression();
+        nested_loan_regression();
+        let left = Choice::Left(11);
+        let right = Choice::Right(29);
+        assert_eq!(
+            distinct(Pair {
+                left: &left,
+                right: &right
+            }),
+            (11, 29)
+        );
+        assert_eq!(
+            distinct(Pair {
+                left: &right,
+                right: &left
+            }),
+            (29, 11)
+        );
+        assert_eq!(local(Choice::Left(11), true), 11);
+        assert_eq!(local(Choice::Right(29), false), 29);
+    }
+
+    #[test]
+    fn independent_mutation() {
+        let mut value = 0;
+        mutable(&mut value, true);
+        assert_eq!(value, 1);
+        mutable(&mut value, false);
+        assert_eq!(value, 2);
+    }
+}
