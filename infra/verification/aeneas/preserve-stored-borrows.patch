+++ b/tests/lean/StoredBorrowShapeProperties.lean
@@ -0,0 +1,78 @@
+import StoredBorrowShape
+
+open Aeneas Aeneas.Std stored_borrow_shape
+
+theorem branded_payload (value : Branded) (message : Str) :
+    unwrap_branded (some value) message = Result.ok value.raw := by rfl
+
+theorem branded_absence (message : Str) :
+    unwrap_branded none message = Result.fail Error.panic := by rfl
+
+theorem wrapped_payload (value : Wrapped) (message : Str) :
+    unwrap_wrapped (some value) message = Result.ok value.raw := by rfl
+
+theorem wrapped_absence (message : Str) :
+    unwrap_wrapped none message = Result.fail Error.panic := by rfl
+
+theorem branded_equality_observes_payload (left right : Branded) :
+    same left right = Result.ok (decide (left.raw = right.raw)) := by
+  by_cases h : left.raw = right.raw <;>
+    simp [same, Branded.Insts.CoreCmpPartialEqBranded.eq,
+      core.marker.PhantomData.Insts.CoreCmpPartialEqPhantomData.eq, h]
+
+theorem empty_equality (left right : stored_borrow_shape.Empty) :
+    same_empty left right = Result.ok true := by rfl
+
+theorem shared_marker_equality (left right : Marked) :
+    same_marked left right = Result.ok true := by rfl
+
+theorem mixed_equality_observes_referents (left right : Mixed) :
+    same_mixed left right = Result.ok (decide (left.inner = right.inner)) := by
+  by_cases h : left.inner = right.inner <;>
+    simp [same_mixed, Mixed.Insts.CoreCmpPartialEqMixed.eq,
+      core.marker.PhantomData.Insts.CoreCmpPartialEqPhantomData.eq, h] <;> rfl
+
+theorem mixed_reads_preserved_after_comparison (left right : Mixed) :
+    compare_then_read left right =
+      Result.ok (decide (left.inner = right.inner), left.inner, right.inner) := by
+  simp [compare_then_read, mixed_equality_observes_referents]
+
+theorem generic_shared_reference_reads_payload (holder : Holder U32) :
+    read_shared holder = Result.ok holder.value := by rfl
+
+theorem generic_mutable_reference_write_survives_call (initial replacement : U32) :
+    write_then_observe initial replacement = Result.ok replacement := by rfl
+
+/-- info: 'branded_payload' depends on axioms: [propext] -/
+#guard_msgs in
+#print axioms branded_payload
+/-- info: 'branded_absence' depends on axioms: [propext] -/
+#guard_msgs in
+#print axioms branded_absence
+/-- info: 'wrapped_payload' depends on axioms: [propext] -/
+#guard_msgs in
+#print axioms wrapped_payload
+/-- info: 'wrapped_absence' depends on axioms: [propext] -/
+#guard_msgs in
+#print axioms wrapped_absence
+/-- info: 'branded_equality_observes_payload' depends on axioms: [propext] -/
+#guard_msgs in
+#print axioms branded_equality_observes_payload
+/-- info: 'empty_equality' does not depend on any axioms -/
+#guard_msgs in
+#print axioms empty_equality
+/-- info: 'shared_marker_equality' does not depend on any axioms -/
+#guard_msgs in
+#print axioms shared_marker_equality
+/-- info: 'mixed_equality_observes_referents' depends on axioms: [propext, Quot.sound] -/
+#guard_msgs in
+#print axioms mixed_equality_observes_referents
+/-- info: 'mixed_reads_preserved_after_comparison' depends on axioms: [propext, Quot.sound] -/
+#guard_msgs in
+#print axioms mixed_reads_preserved_after_comparison
+/-- info: 'generic_shared_reference_reads_payload' does not depend on any axioms -/
+#guard_msgs in
+#print axioms generic_shared_reference_reads_payload
+/-- info: 'generic_mutable_reference_write_survives_call' does not depend on any axioms -/
+#guard_msgs in
+#print axioms generic_mutable_reference_write_survives_call
