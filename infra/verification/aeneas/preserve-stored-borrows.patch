+//@ [!lean] skip
+//@ charon-args=--include=core::marker
+#![feature(register_tool)]
+#![register_tool(verify)]
+
+use std::marker::PhantomData;
+
+#[derive(PartialEq)]
+pub struct Branded<'a> {
+    pub raw: u32,
+    pub marker: PhantomData<&'a mut &'a ()>,
+}
+
+pub struct Marker<'a, T> {
+    pub marker: PhantomData<&'a mut T>,
+}
+
+pub struct Wrapped<'a> {
+    pub raw: u32,
+    pub marker: Marker<'a, &'a ()>,
+}
+
+pub fn unwrap_branded(value: Option<Branded<'_>>, message: &str) -> u32 {
+    value.expect(message).raw
+}
+
+pub fn unwrap_wrapped(value: Option<Wrapped<'_>>, message: &str) -> u32 {
+    value.expect(message).raw
+}
+
+pub fn same<'a>(left: &Branded<'a>, right: &Branded<'a>) -> bool {
+    left == right
+}
+
+#[derive(PartialEq)]
+pub struct Empty;
+
+#[derive(PartialEq)]
+pub struct Marked<'a>(pub PhantomData<&'a ()>);
+
+pub fn same_empty(left: &Empty, right: &Empty) -> bool {
+    left == right
+}
+
+pub fn same_marked<'a>(left: &Marked<'a>, right: &Marked<'a>) -> bool {
+    left == right
+}
+
+#[derive(PartialEq)]
+pub struct Mixed<'a> {
+    pub inner: &'a u32,
+    pub marker: PhantomData<&'a mut &'a ()>,
+}
+
+pub fn same_mixed<'a>(left: &Mixed<'a>, right: &Mixed<'a>) -> bool {
+    left == right
+}
+
+pub fn compare_then_read<'a>(left: &Mixed<'a>, right: &Mixed<'a>) -> (bool, u32, u32) {
+    let equal = same_mixed(left, right);
+    (equal, *left.inner, *right.inner)
+}
+
+pub struct Holder<T> {
+    pub value: T,
+    pub marker: PhantomData<T>,
+}
+
+pub fn read_shared(holder: Holder<&u32>) -> u32 {
+    *holder.value
+}
+
+pub fn write(holder: Holder<&mut u32>, replacement: u32) {
+    *holder.value = replacement;
+}
+
+pub fn write_then_observe(initial: u32, replacement: u32) -> u32 {
+    let mut value = initial;
+    write(
+        Holder {
+            value: &mut value,
+            marker: PhantomData,
+        },
+        replacement,
+    );
+    value
+}
+
+#[verify::test]
+pub fn equality_regression() {
+    let left = Branded {
+        raw: 11,
+        marker: PhantomData,
+    };
+    let right = Branded {
+        raw: 29,
+        marker: PhantomData,
+    };
+    assert!(same(&left, &left));
+    assert!(!same(&left, &right));
+    assert!(same_empty(&Empty, &Empty));
+    assert!(same_marked(&Marked(PhantomData), &Marked(PhantomData)));
+}
+
+#[verify::test]
+pub fn stored_reference_regression() {
+    let left = 11;
+    let right = 29;
+    let first = Mixed {
+        inner: &left,
+        marker: PhantomData,
+    };
+    let second = Mixed {
+        inner: &right,
+        marker: PhantomData,
+    };
+    let (equal, left_read, right_read) = compare_then_read(&first, &second);
+    assert!(!equal);
+    assert!(left_read == 11);
+    assert!(right_read == 29);
+    assert!(
+        read_shared(Holder {
+            value: &right,
+            marker: PhantomData
+        }) == 29
+    );
+    assert!(write_then_observe(11, 29) == 29);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn generated_regressions_also_execute_natively() {
+        equality_regression();
+        stored_reference_regression();
+    }
+
+    #[test]
+    fn arbitrary_payloads_and_messages_survive() {
+        for raw in [0, 11, 29, u32::MAX] {
+            for message in ["", "brand", "nested marker"] {
+                let direct = Branded {
+                    raw,
+                    marker: PhantomData,
+                };
+                let nested = Wrapped {
+                    raw,
+                    marker: Marker {
+                        marker: PhantomData,
+                    },
+                };
+                assert_eq!(unwrap_branded(Some(direct), message), raw);
+                assert_eq!(unwrap_wrapped(Some(nested), message), raw);
+            }
+            assert_eq!(write_then_observe(raw, !raw), !raw);
+        }
+    }
+
+    #[test]
+    #[should_panic(expected = "absence")]
+    fn absent_brand_panics() {
+        unwrap_branded(None, "absence");
+    }
+
+    #[test]
+    #[should_panic(expected = "absence")]
+    fn absent_wrapped_brand_panics() {
+        unwrap_wrapped(None, "absence");
+    }
+}
