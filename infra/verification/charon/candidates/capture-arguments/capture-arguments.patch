+use crate::ast::*;
+use crate::ids::IndexVec;
+use std::ops::ControlFlow::{Break, Continue};
+
+impl GenericParams {
+    /// Substitute all non-region arguments and an initial region-argument
+    /// prefix, binding the remaining regions in declaration order. Supplied
+    /// arguments are in the caller's scope, outside the returned binder.
+    pub fn bind_remaining_regions<T: TyVisitable>(
+        &self,
+        supplied: &GenericArgs,
+        value: T,
+    ) -> Result<RegionBinder<T>, GenericsMismatch> {
+        if supplied.regions.len() > self.regions.len() {
+            return Err(GenericsMismatch);
+        }
+        let regions: IndexVec<RegionId, RegionParam> = self
+            .regions
+            .iter()
+            .skip(supplied.regions.len())
+            .cloned()
+            .enumerate()
+            .map(|(index, mut param)| {
+                param.index = RegionId::from(index);
+                param
+            })
+            .collect();
+        let mut arguments = supplied.clone().move_under_binder();
+        arguments
+            .regions
+            .extend(regions.map_ref_indexed(|id, _| Region::Var(DeBruijnVar::new_at_zero(id))));
+        if !arguments.matches(self) {
+            return Err(GenericsMismatch);
+        }
+        Ok(RegionBinder {
+            regions,
+            skip_binder: value.try_substitute(&arguments)?,
+        })
+    }
+}
+
+/// Solves only the regions bound by one explicit binder. Ambient variables and
+/// variables under nested binders are never inference parameters here.
+struct RegionInstantiation {
+    depth: DeBruijnId,
+    arguments: IndexVec<RegionId, Option<Region>>,
+}
+
+impl Visitor for RegionInstantiation {
+    type Break = ();
+}
+
+impl ZipAst for RegionInstantiation {
+    fn visit_region(&mut self, pattern: &Region, value: &Region) -> ControlFlow<()> {
+        if let Region::Var(var) = pattern
+            && let Some(DeBruijnVar::Bound(depth, id)) = var.move_out_from_depth(self.depth)
+            && depth.is_zero()
+        {
+            let Some(argument) = (*value).move_from_under_binders(self.depth.incr()) else {
+                return Break(());
+            };
+            let Some(slot) = self.arguments.get_mut(id) else {
+                return Break(());
+            };
+            match slot {
+                Some(previous) if *previous != argument => return Break(()),
+                Some(_) => {}
+                None => *slot = Some(argument),
+            }
+            return Continue(());
+        }
+        if pattern == value {
+            Continue(())
+        } else {
+            Break(())
+        }
+    }
+
+    fn visit_region_binder<T: AstVisitable>(
+        &mut self,
+        pattern: &RegionBinder<T>,
+        value: &RegionBinder<T>,
+    ) -> ControlFlow<()> {
+        self.depth = self.depth.incr();
+        let result = self.visit_inner(pattern, value);
+        self.depth = self.depth.decr();
+        result
+    }
+
+    fn visit_binder<T: AstVisitable>(
+        &mut self,
+        pattern: &Binder<T>,
+        value: &Binder<T>,
+    ) -> ControlFlow<()> {
+        self.depth = self.depth.incr();
+        let result = self.visit_inner(pattern, value);
+        self.depth = self.depth.decr();
+        result
+    }
+}
+
+impl<T: TyVisitable + Clone + PartialEq> RegionBinder<T> {
+    /// Find a complete region instantiation yielding exactly `value`.
+    /// Structural search is followed by equality using ordinary substitution;
+    /// unassigned parameters, conflicts, and escaping bound regions refuse.
+    pub fn infer_region_arguments(&self, value: &T) -> Option<IndexVec<RegionId, Region>> {
+        let mut inference = RegionInstantiation {
+            depth: DeBruijnId::zero(),
+            arguments: self.regions.map_ref_indexed(|_, _| None),
+        };
+        if inference
+            .visit(&self.skip_binder, &value.clone().move_under_binder())
+            .is_break()
+        {
+            return None;
+        }
+        let arguments: IndexVec<RegionId, Region> =
+            inference.arguments.into_iter().collect::<Option<_>>()?;
+        (self.clone().apply(arguments.clone()) == *value).then_some(arguments)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn region(depth: usize, id: usize) -> Region {
+        Region::Var(DeBruijnVar::bound(
+            DeBruijnId::new(depth),
+            RegionId::from(id),
+        ))
+    }
+
+    fn binder<T>(count: usize, value: T) -> RegionBinder<T> {
+        RegionBinder {
+            regions: (0..count)
+                .map(|id| RegionParam::new(RegionId::from(id), None, Variance::Unknown))
+                .collect(),
+            skip_binder: value,
+        }
+    }
+
+    fn reference(lifetime: Region, value: Ty) -> Ty {
+        TyKind::Ref(lifetime, value, RefKind::Shared).into_ty()
+    }
+
+    fn byte() -> Ty {
+        TyKind::Literal(LiteralTy::UInt(UIntTy::U8)).into_ty()
+    }
+
+    #[test]
+    fn matches_root_region_and_preserves_distinct_arguments() {
+        assert_eq!(
+            binder(1, region(0, 0)).infer_region_arguments(&region(0, 3)),
+            Some(vec![region(0, 3)].into())
+        );
+        let pattern = binder(2, vec![region(0, 1), region(0, 0)]);
+        assert_eq!(
+            pattern.infer_region_arguments(&vec![region(0, 5), region(0, 2)]),
+            Some(vec![region(0, 2), region(0, 5)].into())
+        );
+    }
+
+    #[test]
+    fn rejects_incomplete_and_conflicting_arguments() {
+        assert!(
+            binder(2, vec![region(0, 0)])
+                .infer_region_arguments(&vec![Region::Static])
+                .is_none()
+        );
+        let repeated = binder(1, vec![region(0, 0), region(0, 0)]);
+        assert!(
+            repeated
+                .infer_region_arguments(&vec![region(0, 1), region(0, 2)])
+                .is_none()
+        );
+        assert_eq!(
+            repeated.infer_region_arguments(&vec![Region::Static, Region::Static]),
+            Some(vec![Region::Static].into())
+        );
+    }
+
+    #[test]
+    fn rejects_field_count_type_and_reference_kind_mismatches() {
+        let pattern = binder(1, vec![reference(region(0, 0), byte())]);
+        assert!(pattern.infer_region_arguments(&Vec::new()).is_none());
+        assert!(
+            pattern
+                .infer_region_arguments(&vec![reference(Region::Static, byte()); 2])
+                .is_none()
+        );
+        let boolean = TyKind::Literal(LiteralTy::Bool).into_ty();
+        assert!(
+            pattern
+                .infer_region_arguments(&vec![reference(Region::Static, boolean)])
+                .is_none()
+        );
+        let mutable = TyKind::Ref(Region::Static, byte(), RefKind::Mut).into_ty();
+        assert!(pattern.infer_region_arguments(&vec![mutable]).is_none());
+    }
+
+    #[test]
+    fn does_not_solve_ambient_variables_with_same_numeric_id() {
+        let pattern = binder(1, vec![region(1, 0), region(0, 0)]);
+        assert_eq!(
+            pattern.infer_region_arguments(&vec![region(0, 0), region(0, 7)]),
+            Some(vec![region(0, 7)].into())
+        );
+        assert!(
+            pattern
+                .infer_region_arguments(&vec![region(0, 1), region(0, 7)])
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn matches_under_nested_binder_without_capturing_its_variables() {
+        let pattern = binder(1, binder(1, vec![region(0, 0), region(1, 0)]));
+        let value = binder(1, vec![region(0, 0), region(1, 4)]);
+        assert_eq!(
+            pattern.infer_region_arguments(&value),
+            Some(vec![region(0, 4)].into())
+        );
+        let escaping = binder(1, vec![region(0, 0), region(0, 0)]);
+        assert!(pattern.infer_region_arguments(&escaping).is_none());
+    }
+
+    #[test]
+    fn parent_type_substitution_does_not_introduce_inference_parameters() {
+        let fields = vec![reference(
+            region(0, 0),
+            TyKind::TypeVar(DeBruijnVar::new_at_zero(TypeVarId::from(0))).into_ty(),
+        )];
+        let parent_type = reference(region(0, 2), byte());
+        let mut arguments = GenericArgs::empty();
+        arguments
+            .types
+            .push(parent_type.clone().move_under_binder());
+        arguments.regions.push(region(0, 0));
+        let pattern = binder(1, fields.try_substitute(&arguments).unwrap());
+        assert_eq!(
+            pattern.infer_region_arguments(&vec![reference(region(0, 3), parent_type)]),
+            Some(vec![region(0, 3)].into())
+        );
+        let wrong_parent = reference(region(0, 9), byte());
+        assert!(
+            pattern
+                .infer_region_arguments(&vec![reference(region(0, 3), wrong_parent)])
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn empty_binder_requires_exact_identity() {
+        assert_eq!(
+            binder(0, byte()).infer_region_arguments(&byte()),
+            Some(IndexVec::new())
+        );
+        assert!(
+            binder(0, region(1, 0))
+                .infer_region_arguments(&region(0, 1))
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn declaration_prefix_and_capture_slots_survive_construction() {
+        let mut params = GenericParams::empty();
+        params.regions = binder(3, ()).regions;
+        let fields = vec![region(0, 0), region(0, 2), region(0, 1)];
+        let mut supplied = GenericArgs::empty();
+        supplied.regions.push(region(0, 8));
+        let pattern = params
+            .bind_remaining_regions(&supplied, fields.clone())
+            .unwrap();
+        let actual = vec![region(0, 8), region(0, 4), region(0, 6)];
+        let captures = pattern.infer_region_arguments(&actual).unwrap();
+        assert_eq!(captures, vec![region(0, 6), region(0, 4)].into());
+        supplied.regions.extend(captures);
+        assert_eq!(fields.try_substitute(&supplied).unwrap(), actual);
+    }
+
+    #[test]
+    fn partial_construction_refuses_wrong_generic_arities() {
+        let params = GenericParams::empty();
+        let mut supplied = GenericArgs::empty();
+        supplied.regions.push(Region::Static);
+        assert!(params.bind_remaining_regions(&supplied, byte()).is_err());
+        supplied.regions.clear();
+        supplied.types.push(byte());
+        assert!(params.bind_remaining_regions(&supplied, byte()).is_err());
+    }
+
+    #[test]
+    fn self_identity_reproduces_the_declaration_under_nested_binders() {
+        let mut params = GenericParams::empty();
+        params.regions = binder(2, ()).regions;
+        let fields = vec![reference(region(0, 0), reference(region(0, 1), byte()))];
+        for depth in 0..4 {
+            let depth = DeBruijnId::new(depth);
+            let arguments = params.identity_args_at_depth(depth);
+            assert_eq!(
+                fields.clone().try_substitute(&arguments).unwrap(),
+                fields.clone().move_under_binders(depth)
+            );
+        }
+    }
+
+    #[test]
+    fn generic_binders_preserve_bound_and_ambient_variables() {
+        let mut params = GenericParams::empty();
+        params.regions = binder(1, ()).regions;
+        let pattern = binder(
+            1,
+            Binder::new(
+                BinderKind::Other,
+                params.clone(),
+                vec![region(0, 0), region(1, 0)],
+            ),
+        );
+        let actual = Binder::new(
+            BinderKind::Other,
+            params.clone(),
+            vec![region(0, 0), region(1, 7)],
+        );
+        assert_eq!(
+            pattern.infer_region_arguments(&actual),
+            Some(vec![region(0, 7)].into())
+        );
+        let escaping = Binder::new(BinderKind::Other, params, vec![region(0, 0), region(0, 0)]);
+        assert!(pattern.infer_region_arguments(&escaping).is_none());
+    }
+}
