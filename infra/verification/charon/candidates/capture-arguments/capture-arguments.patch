diff --git a/tests/closure_capture_regions.rs b/tests/closure_capture_regions.rs
new file mode 100644
index 00000000..24edb994
--- /dev/null
+++ b/tests/closure_capture_regions.rs
@@ -0,0 +1,55 @@
+use charon_lib::ast::*;
+
+mod util;
+
+#[test]
+fn closure_capture_fields_keep_the_selected_input_lifetime() -> anyhow::Result<()> {
+    let krate = util::translate_rust_text(
+        r#"
+        pub fn first<'a, 'b>(x: &'a u8, _y: &'b u8) -> impl Fn() -> u8 + 'a {
+            move || *x
+        }
+        pub fn second<'a, 'b>(_x: &'a u8, y: &'b u8) -> impl Fn() -> u8 + 'b {
+            move || *y
+        }
+        pub fn generic<'a, 'b, T>(_x: &'a u8, y: &'b T) -> impl Fn() -> &'b T {
+            move || y
+        }
+        "#,
+        &["--mir=optimized"],
+    )?;
+    for (name, input) in [("first", 0), ("second", 1), ("generic", 1)] {
+        let function = krate
+            .fun_decls
+            .iter()
+            .find(|function| {
+                util::repr_name(&krate, &function.item_meta.name) == format!("test_crate::{name}")
+            })
+            .expect("selected source function is present");
+        let TyKind::Ref(expected, _, _) = function.signature.inputs[input].kind() else {
+            panic!("selected source input must be a reference")
+        };
+        let TyKind::Adt(reference) = function.signature.output.kind() else {
+            panic!("source output must be its closure ADT")
+        };
+        let declaration = krate
+            .type_decls
+            .get(reference.id)
+            .expect("closure declaration is present");
+        let TypeDeclKind::Struct(fields) = &declaration.kind else {
+            panic!("closure declaration must expose its capture fields")
+        };
+        assert_eq!(fields.len(), 1);
+        let capture = fields[FieldId::from(0)]
+            .ty
+            .clone()
+            .try_substitute(&reference.generics)
+            .expect("closure reference instantiates its declaration");
+        let TyKind::Ref(actual, _, _) = capture.kind() else {
+            panic!("closure must retain its borrowed capture")
+        };
+        assert_eq!(actual, expected, "wrong input lifetime in {name}");
+        assert!(!matches!(actual, Region::Erased | Region::Body(_)));
+    }
+    Ok(())
+}
