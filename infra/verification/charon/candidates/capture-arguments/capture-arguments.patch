+/// A closure reference includes its instantiated captures, not just its parent
+/// generics. Dropping those types loses the arguments of the closure ADT's extra
+/// lifetime parameters.
+#[derive(Clone, Copy)]
+pub(crate) enum ItemInstantiation<'a> {
+    Item(&'a hax::ItemRef),
+    Closure(&'a hax::ClosureArgs),
+}
+
+impl<'a> ItemInstantiation<'a> {
+    pub(crate) fn item(self) -> &'a hax::ItemRef {
+        match self {
+            Self::Item(item) => item,
+            Self::Closure(args) => &args.item,
+        }
+    }
+}
+
+impl<'a> From<&'a hax::ItemRef> for ItemInstantiation<'a> {
+    fn from(item: &'a hax::ItemRef) -> Self {
+        Self::Item(item)
+    }
+}
+
+impl<'a> From<&'a hax::ClosureArgs> for ItemInstantiation<'a> {
+    fn from(args: &'a hax::ClosureArgs) -> Self {
+        Self::Closure(args)
+    }
+}
