+#[cfg(test)]
+mod demand_tests {
+    use super::*;
+
+    #[test]
+    fn repeated_associated_type_demand_uses_one_parameter() {
+        let mut modifications =
+            ItemModifications::from_constraint_set(TypeConstraintSet::default(), true);
+        let path = TraitRefPath::self_ref(TraitDeclId::ZERO).with_assoc_type(AssocTypeId::ZERO);
+        modifications.replace_path(path.clone());
+        modifications.replace_path(path.clone());
+        assert_eq!(modifications.required_extra_paths, vec![path]);
+    }
+
+    #[test]
+    fn distinct_associated_types_keep_distinct_parameters() {
+        let mut modifications =
+            ItemModifications::from_constraint_set(TypeConstraintSet::default(), true);
+        let first = TraitRefPath::self_ref(TraitDeclId::ZERO).with_assoc_type(AssocTypeId::ZERO);
+        let second = TraitRefPath::self_ref(TraitDeclId::ZERO).with_assoc_type(AssocTypeId::new(1));
+        modifications.replace_path(first.clone());
+        modifications.replace_path(second.clone());
+        assert_eq!(modifications.required_extra_paths, vec![first, second]);
+    }
+
+    #[test]
+    fn distinct_clause_witnesses_keep_distinct_parameters() {
+        let mut modifications =
+            ItemModifications::from_constraint_set(TypeConstraintSet::default(), true);
+        let first = TraitRefPath::local_clause(TraitClauseId::ZERO, TraitDeclId::ZERO)
+            .with_assoc_type(AssocTypeId::ZERO);
+        let second = TraitRefPath::local_clause(TraitClauseId::new(1), TraitDeclId::ZERO)
+            .with_assoc_type(AssocTypeId::ZERO);
+        modifications.replace_path(first.clone());
+        modifications.replace_path(second.clone());
+        assert_eq!(modifications.required_extra_paths, vec![first, second]);
+    }
