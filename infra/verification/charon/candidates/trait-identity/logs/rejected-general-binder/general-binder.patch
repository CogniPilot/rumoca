+    /// Whether this binder records an in-place extension of an item's generics rather than a
+    /// copy: its arguments are exactly the identity of a prefix of its parameters. Name matching
+    /// treats both kinds the same; printing and identity do not.
+    pub fn binder_is_generics_extension(binder: &Binder<GenericArgs>) -> bool {
+        let args = &binder.skip_binder;
+        let identity = binder.params.identity_args();
+        args.regions.len() <= identity.regions.len()
+            && args.types.len() <= identity.types.len()
+            && args.const_generics.len() <= identity.const_generics.len()
+            && args.regions.iter().zip(identity.regions.iter()).all(|(a, b)| a == b)
+            && args.types.iter().zip(identity.types.iter()).all(|(a, b)| a == b)
+            && args
+                .const_generics
+                .iter()
+                .zip(identity.const_generics.iter())
+                .all(|(a, b)| a == b)
+    }
