+#[test]
+fn cargo_owns_its_namespace_and_preserves_target_directory_precedence() -> Result<()> {
+    let fixture = Fixture::new()?;
+    fs::create_dir(fixture.directory.path().join("dep"))?;
+    fs::write(
+        fixture.directory.path().join("Cargo.toml"),
+        "[package]\nname='root'\nversion='0.0.0'\nedition='2024'\n[lib]\npath='root.rs'\n[dependencies]\ndep={path='dep'}\n[workspace]\nexclude=['dep']\n",
+    )?;
+    fs::write(
+        fixture.directory.path().join("dep/Cargo.toml"),
+        "[package]\nname='dep'\nversion='0.0.0'\nedition='2024'\n[lib]\npath='../dep.rs'\n[workspace]\n",
+    )?;
+    fs::create_dir(fixture.directory.path().join(".cargo"))?;
+    fs::write(
+        fixture.directory.path().join(".cargo/config.toml"),
+        "[build]\ntarget-dir='configured'\n",
+    )?;
+    succeeds(
+        Command::new("cargo")
+            .current_dir(fixture.directory.path())
+            .env_remove("CARGO_TARGET_DIR")
+            .env_remove("RUSTC_WRAPPER")
+            .env_remove("RUSTC_WORKSPACE_WRAPPER")
+            .args(["build", "--offline"])
+            .output()?,
+    )?;
+    let base = fixture.directory.path();
+    for (choice, env_dir, cli_dir) in [
+        ("configured", None, None),
+        ("environment", Some("environment"), None),
+        ("command-line", Some("environment"), Some("command-line")),
+    ] {
+        for attempt in 0..2 {
+            let mut command = Command::new(env!("CARGO_BIN_EXE_charon"));
+            command
+                .current_dir(base)
+                .env_remove("CARGO_TARGET_DIR")
+                .args([
+                    "cargo",
+                    "--sysroot=default",
+                    "--mir=optimized",
+                    "--error-on-warnings",
+                    "--abort-on-error",
+                    "--include=dep",
+                    "--dest-file=cargo.llbc",
+                    "--",
+                    "--offline",
+                    "--lib",
+                ]);
+            if let Some(directory) = env_dir {
+                command.env("CARGO_TARGET_DIR", base.join(directory));
+            }
+            if let Some(directory) = cli_dir {
+                command.arg("--target-dir").arg(base.join(directory));
+            }
+            let output = command.output()?;
+            let stderr = String::from_utf8_lossy(&output.stderr).into_owned();
+            succeeds(output)?;
+            ensure!(
+                base.join(choice).join("charon-closure-facts").is_dir(),
+                "wrong directory for {choice}"
+            );
+            ensure!(
+                stderr.contains("Compiling dep ") == (attempt == 0),
+                "dependency cache reuse at {choice}/{attempt}: {stderr}"
+            );
+            ensure!(
+                stderr.contains("Compiling root "),
+                "requested translation must rerun"
+            );
+        }
+    }
+    Ok(())
+}
