+        "link failure must retain its Rust exit class"
+    );
+    refuses(output, "charon_fact_test_missing_native_library")?;
+    ensure!(
+        fs::read(&fixture.dependency)? != previous_metadata,
+        "new metadata emission was not reached"
+    );
+    ensure!(
+        fs::read(&fixture.sidecar)? == previous,
+        "post-analysis failure replaced previous facts"
+    );
+    ensure!(
+        !fixture
+            .directory
+            .path()
+            .join("libdep.so.charon-closure-regions.json")
+            .exists()
+    );
+    Ok(())
+}
