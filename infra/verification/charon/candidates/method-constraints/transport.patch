@@ -0,0 +1,104 @@
+//! Keep dependency facts in a compiler/collector-owned Cargo artifact namespace.
+
+use anyhow::{Context, Result, bail, ensure};
+use serde::Deserialize;
+use std::path::PathBuf;
+
+use crate::toolchain;
+
+#[derive(Deserialize)]
+struct Metadata {
+    target_directory: PathBuf,
+}
+
+/// Cargo itself resolves environment/configuration/manifest-relative paths. An
+/// explicit build --target-dir is supplied as metadata's target-directory input,
+/// then replaced with one authoritative path for the actual build.
+pub(super) fn target_directory(cargo_args: &mut Vec<String>) -> Result<(PathBuf, String)> {
+    let (metadata_args, cli_target) = metadata_arguments(cargo_args)?;
+    let mut metadata = toolchain::in_toolchain("cargo")?;
+    metadata.args(["metadata", "--no-deps", "--format-version=1"]);
+    metadata.args(metadata_args);
+    if let Some(target) = cli_target {
+        // metadata has no --target-dir flag. Its equivalent environment input
+        // must replace the inherited value, not sit below it as a config key.
+        metadata.env("CARGO_TARGET_DIR", target);
+    }
+    let output = metadata
+        .output()
+        .context("cannot resolve Cargo target directory")?;
+    ensure!(
+        output.status.success(),
+        "Cargo metadata failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let metadata: Metadata = serde_json::from_slice(&output.stdout)?;
+
+    let output = toolchain::in_toolchain(toolchain::driver_path())?
+        .arg("--print-closure-fact-cache-key")
+        .output()
+        .context("cannot identify closure fact collector")?;
+    ensure!(
+        output.status.success(),
+        "collector identity failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let key = String::from_utf8(output.stdout)?;
+    let Some(hash) = key.trim_end().strip_prefix("sha256=") else {
+        bail!("invalid collector cache identity");
+    };
+    ensure!(
+        hash.len() == 64
+            && hash
+                .bytes()
+                .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()),
+        "invalid collector cache digest"
+    );
+    let directory = metadata
+        .target_directory
+        .join("charon-closure-facts")
+        .join(hash);
+    Ok((directory, key.trim_end().to_owned()))
+}
+
+fn metadata_arguments(cargo_args: &mut Vec<String>) -> Result<(Vec<String>, Option<String>)> {
+    let mut metadata = Vec::new();
+    let mut build = Vec::new();
+    let mut target = None;
+    let mut args = cargo_args.iter();
+    while let Some(arg) = args.next() {
+        if arg == "--target-dir" || arg.starts_with("--target-dir=") {
+            ensure!(target.is_none(), "--target-dir may only be supplied once");
+            let value = if let Some(value) = arg.strip_prefix("--target-dir=") {
+                value.to_owned()
+            } else {
+                args.next().context("--target-dir requires a path")?.clone()
+            };
+            ensure!(!value.is_empty(), "--target-dir requires a nonempty path");
+            target = Some(value);
+            continue;
+        }
+        build.push(arg.clone());
+        if ["--manifest-path", "--config", "--lockfile-path", "-Z", "-C"].contains(&arg.as_str()) {
+            let value = args
+                .next()
+                .with_context(|| format!("{arg} requires a value"))?;
+            metadata.extend([arg.clone(), value.clone()]);
+            build.push(value.clone());
+        } else if [
+            "--manifest-path=",
+            "--config=",
+            "--lockfile-path=",
+            "-Z",
+            "-C",
+        ]
+        .iter()
+        .any(|prefix| arg.starts_with(prefix))
+            || ["--offline", "--locked", "--frozen"].contains(&arg.as_str())
+        {
+            metadata.push(arg.clone());
+        }
+    }
+    *cargo_args = build;
+    Ok((metadata, target))
+}
