@@ -0,0 +1,402 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output};
+
+use anyhow::{Context, Result, ensure};
+use charon_lib::ast::{OutlivesPred, PathElem, RegionBinder, TyKind};
+use charon_lib::export::CrateData;
+use charon_lib::options::SerializationFormat;
+use serde_json::Value;
+
+struct Fixture {
+    directory: tempfile::TempDir,
+    dependency: PathBuf,
+    sidecar: PathBuf,
+    source: PathBuf,
+}
+
+impl Fixture {
+    fn new() -> Result<Self> {
+        let directory = tempfile::tempdir()?;
+        let source = directory.path().join("dep.rs");
+        fs::write(
+            &source,
+            "pub fn named<'a>() -> impl Fn(&'a u32) -> &'a u32 { |x| x }\n",
+        )?;
+        fs::write(
+            directory.path().join("root.rs"),
+            "pub fn call(x: &u32) -> &u32 { dep::named()(x) }\n",
+        )?;
+        Ok(Self {
+            dependency: directory.path().join("libdep.rmeta"),
+            sidecar: directory
+                .path()
+                .join("libdep.rmeta.charon-closure-regions.json"),
+            source,
+            directory,
+        })
+    }
+
+    fn command(&self) -> Command {
+        let mut command = Command::new(env!("CARGO_BIN_EXE_charon"));
+        command.current_dir(self.directory.path());
+        command.args([
+            "rustc",
+            "--sysroot=default",
+            "--error-on-warnings",
+            "--abort-on-error",
+        ]);
+        command.env_remove("CARGO_PRIMARY_PACKAGE");
+        command.env_remove("CHARON_USING_CARGO");
+        command.env_remove("CHARON_CLOSURE_FACT_CACHE_KEY");
+        command
+    }
+
+    fn produce(&self) -> Result<Output> {
+        Ok(self
+            .command()
+            .env("CHARON_USING_CARGO", "1")
+            .args([
+                "--",
+                "--edition=2024",
+                "--crate-type=rlib",
+                "--crate-name=dep",
+                "--emit=metadata",
+            ])
+            .arg("-o")
+            .arg(&self.dependency)
+            .arg(&self.source)
+            .output()?)
+    }
+
+    fn consume(&self) -> Result<Output> {
+        Ok(self
+            .command()
+            .args([
+                "--mir=optimized",
+                "--include=dep",
+                "--translate-all-methods",
+                "--lift-associated-types=*",
+                "--hide-marker-traits",
+                "--hide-allocator",
+                "--remove-unused-self-clauses",
+                "--remove-adt-clauses",
+                "--no-gen-tuple-structs",
+                "--dest-file=root.llbc",
+                "--",
+                "--edition=2024",
+                "--crate-type=rlib",
+                "--crate-name=root",
+                "--extern",
+            ])
+            .arg(format!("dep={}", self.dependency.display()))
+            .arg("root.rs")
+            .output()?)
+    }
+}
+
+fn succeeds(output: Output) -> Result<()> {
+    ensure!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    Ok(())
+}
+
+fn refuses(output: Output, reason: &str) -> Result<()> {
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    ensure!(!output.status.success(), "unexpected success for {reason}");
+    ensure!(stderr.contains(reason), "expected {reason}: {stderr}");
+    Ok(())
+}
+
+fn write_json(path: &Path, value: &Value) -> Result<()> {
+    fs::write(path, serde_json::to_vec(value)?)?;
+    Ok(())
+}
+
+fn imported_contract_contains_the_required_direction(fixture: &Fixture) -> Result<()> {
+    let data = CrateData::deserialize_from_file(
+        &fixture.directory.path().join("root.llbc"),
+        SerializationFormat::Json,
+    )?;
+    let mut checked = 0;
+    for function in &data.translated.fun_decls {
+        if function.item_meta.is_local
+            || !function
+                .item_meta
+                .name
+                .name
+                .iter()
+                .any(|part| matches!(part, PathElem::Impl(_)))
+        {
+            continue;
+        }
+        let Some(PathElem::Ident(name, _)) = function.item_meta.name.name.last() else {
+            continue;
+        };
+        if !["call", "call_mut", "call_once"].contains(&name.as_str()) {
+            continue;
+        }
+        ensure!(
+            function.signature.inputs.len() == 2,
+            "imported callable must have receiver and tuple"
+        );
+        let TyKind::Adt(tuple) = function.signature.inputs[1].kind() else {
+            anyhow::bail!("expected callable tuple")
+        };
+        let TyKind::Ref(input, _, _) = tuple.generics.types[0].kind() else {
+            anyhow::bail!("expected input reference")
+        };
+        let TyKind::Ref(output, _, _) = function.signature.output.kind() else {
+            anyhow::bail!("expected output reference")
+        };
+        ensure!(
+            input != output,
+            "free occurrences were incorrectly identified"
+        );
+        let predicates = &function.generics.regions_outlive;
+        ensure!(
+            predicates.contains(&RegionBinder::empty(OutlivesPred(*input, *output))),
+            "missing imported required path"
+        );
+        ensure!(
+            !predicates.contains(&RegionBinder::empty(OutlivesPred(*output, *input))),
+            "invented reverse path"
+        );
+        checked += 1;
+    }
+    ensure!(
+        checked == 3,
+        "expected all three imported callable contracts, got {checked}"
+    );
+    Ok(())
+}
+
+#[test]
+fn exact_artifact_facts_reject_missing_stale_and_malformed_records() -> Result<()> {
+    let fixture = Fixture::new()?;
+    succeeds(fixture.produce()?)?;
+    succeeds(fixture.consume()?)?;
+    imported_contract_contains_the_required_direction(&fixture)?;
+    let original = fs::read(&fixture.sidecar)?;
+    let artifact: Value = serde_json::from_slice(&original)?;
+    ensure!(artifact["records"].as_array().context("records")?.len() == 1);
+    let hidden = fixture.directory.path().join("saved-sidecar.json");
+    fs::rename(&fixture.sidecar, &hidden)?;
+    refuses(fixture.consume()?, "Closure region facts unavailable")?;
+    fs::rename(hidden, &fixture.sidecar)?;
+    for field in [
+        "schema",
+        "compiler",
+        "driver_digest",
+        "target_digest",
+        "stable_crate_id",
+        "crate_hash",
+    ] {
+        let mut changed = artifact.clone();
+        changed["identity"][field] = if field == "schema" || field == "stable_crate_id" {
+            serde_json::json!(0)
+        } else {
+            serde_json::json!("wrong identity")
+        };
+        write_json(&fixture.sidecar, &changed)?;
+        refuses(fixture.consume()?, "stale or mismatched dependency facts")?;
+    }
+    let mut changed = artifact.clone();
+    changed["artifact_digest"] = serde_json::json!("wrong artifact");
+    write_json(&fixture.sidecar, &changed)?;
+    refuses(fixture.consume()?, "stale or mismatched dependency facts")?;
+    let mut changed = artifact.clone();
+    changed["records"] = serde_json::json!([]);
+    write_json(&fixture.sidecar, &changed)?;
+    refuses(fixture.consume()?, "MissingDeclaration")?;
+    let mut changed = artifact.clone();
+    changed["records"][0]["facts"] = serde_json::json!({"Err": "MissingFacts"});
+    write_json(&fixture.sidecar, &changed)?;
+    refuses(fixture.consume()?, "MissingFacts")?;
+    let mut changed = artifact.clone();
+    changed["records"][0]["facts"]["Ok"]["slots"][0]["occurrence"] = serde_json::json!(99);
+    write_json(&fixture.sidecar, &changed)?;
+    refuses(fixture.consume()?, "noncanonical region slots")?;
+    let mut changed = artifact.clone();
+    let record = changed["records"][0].clone();
+    changed["records"]
+        .as_array_mut()
+        .context("records")?
+        .push(record);
+    write_json(&fixture.sidecar, &changed)?;
+    refuses(fixture.consume()?, "duplicate declaration record")?;
+    fs::write(&fixture.sidecar, b"{truncated")?;
+    refuses(fixture.consume()?, "Decode")?;
+    fs::write(&fixture.sidecar, original)?;
+    succeeds(fixture.consume()?)?;
+    imported_contract_contains_the_required_direction(&fixture)?;
+    Ok(())
+}
+
+#[test]
+fn rejected_rust_compilation_cannot_publish_a_sidecar() -> Result<()> {
+    let fixture = Fixture::new()?;
+    fs::write(
+        &fixture.source,
+        "pub fn bad() -> impl Fn() -> &'static u32 { let x = 1; move || &x }\n",
+    )?;
+    let output = fixture.produce()?;
+    ensure!(
+        output.status.code() == Some(2),
+        "Rust rejection must retain its exit class"
+    );
+    refuses(output, "lifetime")?;
+    ensure!(!fixture.sidecar.exists(), "rejected source published facts");
+    Ok(())
+}
