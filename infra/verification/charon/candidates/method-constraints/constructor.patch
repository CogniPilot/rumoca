index 00000000..c949ea20
--- /dev/null
+++ b/src/bin/charon-driver/translate/closure_constraints.rs
@@ -0,0 +1,113 @@
+//! Construct callable predicates from declaration-owned source occurrences.
+
+use closure_region_facts::{RegionPart, RegionSlot};
+
+use super::translate_ctx::*;
+use crate::hax;
+use charon_lib::ast::*;
+
+struct DeclarationRegions {
+    parent_arguments: Vec<Region>,
+    signature: Vec<Region>,
+    captures: Vec<Region>,
+}
+
+impl DeclarationRegions {
+    fn part(&self, part: RegionPart) -> &[Region] {
+        match part {
+            RegionPart::ParentArguments => &self.parent_arguments,
+            RegionPart::Signature => &self.signature,
+            RegionPart::Captures => &self.captures,
+        }
+    }
+
+    fn get(&self, slot: RegionSlot) -> Region {
+        self.part(slot.part())[slot.occurrence()]
+    }
+}
+
+impl ItemTransCtx<'_, '_> {
+    pub(crate) fn translate_closure_constraints(
+        &mut self,
+        span: Span,
+        args: &hax::ClosureArgs,
+    ) -> Result<(), Error> {
+        let hax::DefIdBase::Real(owner) = args.item.def_id.base else {
+            raise_error!(self, span, "Closure contract has no Rust declaration owner")
+        };
+        let Some(local) = owner.as_local() else {
+            raise_error!(
+                self,
+                span,
+                "Cross-crate closure region facts are not available for this artifact"
+            )
+        };
+        let ClosureFactSource::Checked(collection) = &self.t_ctx.closure_regions else {
+            raise_error!(
+                self,
+                span,
+                "Closure contract extraction requires Rust borrow checking"
+            )
+        };
+        let facts = match collection.local(self.t_ctx.tcx, local) {
+            Ok(facts) => facts,
+            Err(error) => raise_error!(self, span, "Closure region facts unavailable: {error:?}"),
+        };
+        let regions = DeclarationRegions {
+            parent_arguments: args
+                .region_occurrences
+                .parent_arguments
+                .iter()
+                .map(|region| self.translate_region(span, region))
+                .collect::<Result<_, _>>()?,
+            signature: args
+                .region_occurrences
+                .signature
+                .iter()
+                .map(|region| self.translate_region(span, region))
+                .collect::<Result<_, _>>()?,
+            captures: self.the_only_binder().closure_upvar_occurrences.clone(),
+        };
+        for part in [
+            RegionPart::ParentArguments,
+            RegionPart::Signature,
+            RegionPart::Captures,
+        ] {
+            let source_count = facts
+                .slots()
+                .iter()
+                .filter(|slot| slot.part() == part)
+                .count();
+            if regions.part(part).len() != source_count {
+                raise_error!(
+                    self,
+                    span,
+                    "Closure contract occurrence mismatch in {part:?}"
+                )
+            }
+            for (occurrence, region) in regions.part(part).iter().enumerate() {
+                if !matches!(region, Region::Static | Region::Var(_)) {
+                    raise_error!(
+                        self,
+                        span,
+                        "Unresolved closure contract {part:?}[{occurrence}]: {region:?}"
+                    )
+                }
+            }
+        }
+        let predicates = facts
+            .required_outlives()
+            .iter()
+            .filter_map(|required| {
+                let longer = regions.get(required.longer());
+                let shorter = regions.get(required.shorter());
+                (longer != shorter).then(|| RegionBinder::empty(OutlivesPred(longer, shorter)))
+            })
+            .collect::<Vec<_>>();
+        self.the_only_binder_mut()
+            .params
+            .regions_outlive
+            .extend(predicates);
+        Ok(())
+    }
+}
