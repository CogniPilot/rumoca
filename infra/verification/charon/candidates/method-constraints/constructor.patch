diff --git a/tests/closure_required_regions.rs b/tests/closure_required_regions.rs
new file mode 100644
index 00000000..67a82e34
--- /dev/null
+++ b/tests/closure_required_regions.rs
@@ -0,0 +1,94 @@
+use charon_lib::ast::*;
+
+mod util;
+
+#[test]
+fn callable_contracts_keep_direction_and_genuine_binders() -> anyhow::Result<()> {
+    let krate = util::translate_rust_text(
+        r#"
+        pub fn named<'a>() -> impl Fn(&'a u32) -> &'a u32 {
+            |value| value
+        }
+        pub fn higher_ranked() -> impl for<'a> Fn(&'a u32) -> &'a u32 {
+            |value| value
+        }
+        pub fn named_call(value: &u32) -> &u32 { named()(value) }
+        pub fn higher_ranked_call(value: &u32) -> &u32 { higher_ranked()(value) }
+        "#,
+        &[
+            "--mir=optimized",
+            "--error-on-warnings",
+            "--translate-all-methods",
+            "--lift-associated-types=*",
+            "--hide-marker-traits",
+            "--hide-allocator",
+            "--remove-unused-self-clauses",
+            "--remove-adt-clauses",
+            "--no-gen-tuple-structs",
+        ],
+    )?;
+    for (source, expected_predicates) in [("named", 1), ("higher_ranked", 0)] {
+        let mut checked = 0;
+        for function in &krate.fun_decls {
+            let name = util::repr_name(&krate, &function.item_meta.name);
+            if !name.starts_with(&format!("test_crate::{source}::"))
+                || !["::call", "::call_once", "::call_mut"]
+                    .iter()
+                    .any(|suffix| name.ends_with(suffix))
+            {
+                continue;
+            }
+            let TyKind::Adt(arguments) = function.signature.inputs[1].kind() else {
+                panic!("callable input must be a tuple in {name}");
+            };
+            let TyKind::Ref(input, _, _) = arguments.generics.types[0].kind() else {
+                panic!("tuple's source argument must be a reference in {name}");
+            };
+            let TyKind::Ref(output, _, _) = function.signature.output.kind() else {
+                panic!("source output must be a reference in {name}");
+            };
+            let predicates = &function.generics.regions_outlive;
+            if expected_predicates == 0 {
+                assert!(
+                    predicates.is_empty(),
+                    "genuine binders need no invented constraints: {name}"
+                );
+                assert_eq!(input, output, "genuine HRTB identity in {name}");
+            } else {
+                assert_ne!(input, output, "free occurrences remain separate in {name}");
+                let forward = RegionBinder::empty(OutlivesPred(*input, *output));
+                let reverse = RegionBinder::empty(OutlivesPred(*output, *input));
+                assert_eq!(
+                    predicates.iter().filter(|p| **p == forward).count(),
+                    1,
+                    "required path in {name}"
+                );
+                assert!(
+                    !predicates.contains(&reverse),
+                    "invented converse in {name}"
+                );
+                let borrowed_receiver =
+                    matches!(function.signature.inputs[0].kind(), TyKind::Ref(..));
+                assert_eq!(
+                    predicates.len(),
+                    1 + usize::from(borrowed_receiver),
+                    "only the required path and receiver well-formedness in {name}"
+                );
+            }
+            assert!(matches!(input, Region::Var(_)));
+            assert!(matches!(output, Region::Var(_)));
+            checked += 1;
+        }
+        assert_eq!(
+            checked,
+            3,
+            "all three callable methods in {source}; emitted names: {:?}",
+            krate
+                .fun_decls
+                .iter()
+                .map(|f| util::repr_name(&krate, &f.item_meta.name))
+                .collect::<Vec<_>>()
+        );
+    }
+    Ok(())
+}
