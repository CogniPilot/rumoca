diff --git a/src/ast/type_level/substitute.rs b/src/ast/type_level/substitute.rs
--- a/src/ast/type_level/substitute.rs
+++ b/src/ast/type_level/substitute.rs
@@ -114,6 +114,9 @@ impl VarsVisitor for SubstVisitor<'_> {
         }
     }
