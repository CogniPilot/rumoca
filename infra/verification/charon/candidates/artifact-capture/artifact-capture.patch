+/// What a successful compiler run publishes. Only `PendingArtifact::capture`
+/// can issue one: the state is private, so no other module can declare that a
+/// crate has nothing to publish. A crate that emits metadata, an rlib or a
+/// dylib carries its pending artifact; a crate that emits nothing a dependent
+/// could consume, such as an executable, carries no artifact and no identity.
+pub(crate) struct Capture(Option<PendingArtifact>);
+
+impl Capture {
+    pub(crate) fn publish(self) -> Result<(), TransportError> {
+        match self.0 {
+            Some(pending) => pending.publish(),
+            None => Ok(()),
+        }
+    }
