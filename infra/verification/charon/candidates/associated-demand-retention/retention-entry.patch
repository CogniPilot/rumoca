+    /// Find the active recursive entry reached by this demand, excluding unrelated active cycles.
+    fn active_cycle_entry(&self, root: &TraitDecl, path: &AssocTypePath) -> Option<TraitDeclId> {
+        let mut id = match path.tref.base {
+            BaseClause::SelfClause => root.def_id,
+            BaseClause::Local(var) => {
+                root.generics
+                    .trait_clauses
+                    .get(var.bound_at_depth(DeBruijnId::zero())?)?
+                    .trait_
+                    .skip_binder
+                    .id
+            }
+        };
+        let mut clauses = path.tref.parent_path.iter();
+        loop {
+            if matches!(
+                self.trait_modifications.get(id),
+                Some(CycleDetector::Cyclic)
+            ) {
+                return Some(id);
+            }
+            let clause = clauses.next()?;
+            id = self
+                .ctx
+                .translated
+                .trait_decls
+                .get(id)?
+                .implied_clauses
+                .get(*clause)?
+                .trait_
+                .skip_binder
+                .id;
+        }
+    }
