+/// Keep the source edge that changes Self inside the unresolved cycle explicit.
+/// A non-growing supertrait edge need not retain unrelated associated parameters.
+pub(super) fn retention_owner(
+    krate: &TranslatedCrate,
+    root: &TraitDecl,
+    path: &AssocTypePath,
+) -> Option<TraitDeclId> {
+    let mut ancestors = vec![base_ref(root, path.tref.base)?];
+    let mut constraints = source_constraints(&root.generics);
+    for clause_id in &path.tref.parent_path {
+        let next = parent_ref(krate, ancestors.last()?, *clause_id, &mut constraints)?;
+        if let Some(start) = ancestors
+            .iter()
+            .position(|prior| prior.trait_id() == next.trait_id())
+        {
+            let mut cycle = ancestors[start..].iter().chain(std::iter::once(&next));
+            let mut previous = cycle.next()?;
+            for current in cycle {
+                let before = normalized_predicate(previous, &constraints)?;
+                let after = normalized_predicate(current, &constraints)?;
+                if before.skip_binder.generics.types.get(TypeVarId::ZERO)?
+                    != after.skip_binder.generics.types.get(TypeVarId::ZERO)?
+                {
+                    return Some(previous.trait_id());
+                }
+                previous = current;
+            }
+            // Other generic arguments may vary when Self is unchanged. Keeping this cycle
+            // entry's associated form does not assert equality between those predicates.
