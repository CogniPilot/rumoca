+    let mut rewrites = Vec::new();
+    for (assign_loc, use_loc, owner, place, ptr_metadata) in pending {
+        let StatementKind::Assign(destination, _) = &body[use_loc].kind else {
+            unreachable!()
+        };
+        let destination = destination.clone();
+        let local = destination
+            .as_local()
+            .expect("each capture destination is a local");
+        assert_eq!(
+            &body.locals.locals[local].ty, &reference_ty,
+            "the destination declaration must be retyped"
+        );
+        assert_eq!(
+            destination.ty(),
+            &reference_ty,
+            "the destination place must be retyped"
+        );
+        body[use_loc].kind = StatementKind::Assign(
+            destination,
+            Rvalue::Ref {
+                place,
+                kind: BorrowKind::Shared,
+                ptr_metadata,
+            },
+        );
+        rewrites.push(IndexedRewrite {
+            assign_loc,
+            use_loc,
+            owner,
+        });
+    }
+    Ok(TwoIndexed {
+        ctx,
+        body,
+        rewrites,
+    })
+}
+
+#[test]
+fn two_indexed_rewrites_compose() -> anyhow::Result<()> {
+    // Composition evidence: two rewrites in one body must both fire and disturb
+    // nothing else. This does NOT detect an erroneous extra owner-counter
+    // increment in the indexed branch; that specific mutation is inert for this
+    // shape. Other wrong updates, a decrement or a substitution, are outside
+    // that argument and are not tested here.
+    let TwoIndexed {
+        mut ctx,
+        mut body,
+        rewrites,
+    } = two_indexed_fixture()?;
+    let mut expected = body.body.clone();
+    for IndexedRewrite {
+        assign_loc,
+        use_loc,
+        owner,
+    } in &rewrites
+    {
+        let StatementKind::Assign(
+            destination,
+            Rvalue::Ref {
+                place,
+                kind,
+                ptr_metadata,
+            },
+        ) = expected[use_loc.block].statements[use_loc.statement]
+            .kind
+            .clone()
+        else {
+            unreachable!()
+        };
+        expected[use_loc.block].statements[use_loc.statement].kind = StatementKind::Assign(
+            destination,
+            Rvalue::Ref {
+                place: rebased(&place, owner),
+                kind,
+                ptr_metadata,
+            },
+        );
+        expected[assign_loc.block].statements[assign_loc.statement].kind = StatementKind::Nop;
+    }
+    Transform.transform_body(&mut ctx, &mut body);
+    assert_eq!(body.body, expected, "both rewrites, and nothing else");
+    Ok(())
+}
