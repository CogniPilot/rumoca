+/// One boxed copy and the indexed use immediately after it.
+struct IndexedRewrite {
+    assign_loc: StmtLoc,
+    use_loc: StmtLoc,
+    owner: Place,
+}
+
+/// A body carrying two independent indexed captures, ready for the pass.
+struct TwoIndexed {
+    ctx: TransformCtx,
+    body: ExprBody,
+    rewrites: Vec<IndexedRewrite>,
+}
+
+/// Two independent boxed fields, each indexed. The measured extraction puts the
+/// two captures in different blocks, each immediately after its own box copy.
+///
+/// Destination identities are preserved. Only the captured thin raw-pointer type
+/// is rewritten, body-wide, so the local declarations, the tuple aggregate and
+/// the return type stay consistent with each other. The bounds checks capture
+/// fat `*const [u32]` pointers, a different type, and are therefore untouched.
+fn two_indexed_fixture() -> anyhow::Result<TwoIndexed> {
+    let translated = util::translate_rust_text(
+        "pub struct Storage { pub values: Box<[u32]>, pub other: Box<[u32]> }
+         pub fn capture_two(storage: &Storage, i: usize, j: usize, _replacement: Box<[u32]>)
+             -> (*const u32, *const u32) {
+             (&raw const storage.values[i], &raw const storage.other[j])
+         }",
+        &["--mir", "optimized", "--treat-box-as-builtin", "--ullbc"],
+    )?;
+    let mut body = translated
+        .fun_decls
+        .iter()
+        .find(|decl| {
+            util::repr_name(&translated, &decl.item_meta.name) == "test_crate::capture_two"
+        })
+        .unwrap()
+        .body
+        .as_unstructured()
+        .unwrap()
+        .clone();
+    let mut errors = ErrorCtx::new();
+    let ctx = TransformCtx {
+        options: TranslateOptions::new(&mut errors, &translated.options),
+        translated,
+        errors: errors.into(),
+    };
+
+    let captures = indexed_captures(&body);
+    assert_eq!(captures.len(), 2, "expected two indexed element captures");
+
+    let mut pending = Vec::new();
+    let mut pointer_ty = None;
+    let mut element_ty = None;
+    for use_loc in captures {
+        let assign_loc = StmtLoc::new(use_loc.block, use_loc.statement - 1);
+        let StatementKind::Assign(temporary, Rvalue::Use(Operand::Copy(owner), WithRetag::No)) =
+            &body[assign_loc].kind
