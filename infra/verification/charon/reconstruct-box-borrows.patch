+//! Recover boxed pointer temporaries without duplicating Box ownership.
+use std::ops::ControlFlow;
+
+use crate::transform::TransformCtx;
+use crate::transform::ctx::UllbcPass;
+use crate::ullbc_ast::*;
+
+struct CopyUseCounts(IndexVec<LocalId, usize>);
+
+impl Visitor for CopyUseCounts {
+    type Break = std::convert::Infallible;
+}
+
+impl VisitBody for CopyUseCounts {
+    fn enter_local_id(&mut self, local: &LocalId) {
+        self.0[*local] += 1;
+    }
+
+    fn visit_ullbc_statement(&mut self, statement: &Statement) -> ControlFlow<Self::Break> {
+        // Storage markers do not read pointer values, but they do affect
+        // lifetime. The separate adjacency scan must still stop at them.
+        match statement.kind {
+            StatementKind::StorageLive(_) | StatementKind::StorageDead(_) => {
+                ControlFlow::Continue(())
+            }
+            _ => self.visit_inner(statement),
+        }
+    }
+}
+
+/// Optimized MIR separates a nested Box dereference into a no-retag pointer
+/// copy. It is not a duplication of the Box's ownership. Reconstruct the original
+/// shared access only when no other use or intervening effect is present.
+/// A definition-only temporary left by bounds-check reconstruction is dead.
+fn reconstruct_box_copy_borrows(body: &mut ExprBody) {
+    let mut uses = CopyUseCounts(body.locals.locals.map_ref(|_| 0));
+    let _ = uses.visit(&body.body);
+    for block in body.body.iter_mut() {
+        for index in 0..block.statements.len() {
+            let StatementKind::Assign(temporary, Rvalue::Use(Operand::Copy(owner), WithRetag::No)) =
+                &block.statements[index].kind
+            else {
+                continue;
+            };
+            let Some(local) = temporary.as_local() else {
+                continue;
+            };
+            if body.locals.is_return_or_arg(local)
+                || !temporary.ty().is_box()
+                || temporary.ty() != owner.ty()
+            {
+                continue;
+            }
+            if uses.0[local] == 1 {
+                // Exactly the definition, not a read or a drop: removing this
+                // no-retag pointer copy cannot duplicate or destroy ownership.
+                // Keep the shared census exact for subsequent reconstructions.
+                owner.dyn_visit_in_body(|local: &LocalId| uses.0[*local] -= 1);
+                uses.0[local] = 0;
+                block.statements[index].kind = StatementKind::Nop;
+                continue;
+            }
+            if !matches!(uses.0[local], 2 | 3) {
+                continue;
+            }
+            // Only Nops may intervene: the use census alone cannot establish
+            // that the original owner has not changed since the pointer copy.
+            let Some(next) = (index + 1..block.statements.len())
+                .find(|next| !matches!(block.statements[*next].kind, StatementKind::Nop))
+            else {
+                continue;
+            };
+            if uses.0[local] == 2 {
+                let temporary = temporary.clone();
+                let owner = owner.clone();
+                if let StatementKind::Assign(_, rvalue) = &mut block.statements[next].kind
+                    && rewrite_indexed_box_use(&temporary, &owner, rvalue)
+                {
+                    // One owner read becomes one indexed projection. Every other
+                    // local's occurrence count stays unchanged, including indices.
+                    uses.0[local] = 0;
+                    block.statements[index].kind = StatementKind::Nop;
+                }
+                continue;
+            }
+            let StatementKind::Assign(
+                _,
+                Rvalue::Ref {
+                    place,
+                    kind: BorrowKind::Shared,
+                    ptr_metadata: Operand::Copy(metadata),
+                },
+            ) = &block.statements[next].kind
+            else {
+                continue;
+            };
+            if place.as_projection() != Some((temporary, &ProjectionElem::Deref))
+                || metadata.as_projection() != Some((temporary, &ProjectionElem::PtrMetadata))
+                || !metadata.ty().is_usize()
+            {
+                continue;
+            }
+            let owner = owner.clone();
+            let pointee = owner
+                .clone()
+                .project(ProjectionElem::Deref, place.ty().clone());
+            let metadata = owner
+                .clone()
+                .project(ProjectionElem::PtrMetadata, metadata.ty().clone());
+            // Replacing the one owner read with its two projections adds one
+            // occurrence of each local in that place. Keep the census exact.
+            owner.dyn_visit_in_body(|local: &LocalId| uses.0[*local] += 1);
+            uses.0[local] = 0;
+            if let StatementKind::Assign(
+                _,
+                Rvalue::Ref {
+                    place,
+                    ptr_metadata,
+                    ..
+                },
+            ) = &mut block.statements[next].kind
+            {
+                *place = pointee;
+                *ptr_metadata = Operand::Copy(metadata);
+            }
+            block.statements[index].kind = StatementKind::Nop;
+        }
+    }
+}
+
+fn rewrite_indexed_box_use(temporary: &Place, owner: &Place, rvalue: &mut Rvalue) -> bool {
+    let place = match rvalue {
+        Rvalue::Ref {
+            place,
+            kind: BorrowKind::Shared,
+            ptr_metadata,
+        } if *ptr_metadata == Operand::mk_const_unit() => place,
+        // Retag belongs to the indexed read and remains verbatim on that use.
+        Rvalue::Use(Operand::Copy(place), _) => place,
+        _ => return false,
+    };
+    let Some((base, projection @ ProjectionElem::Index { .. })) = place.as_projection() else {
+        return false;
+    };
+    if base.as_projection() != Some((temporary, &ProjectionElem::Deref)) {
+        return false;
+    }
+    *place = owner
+        .clone()
+        .project(ProjectionElem::Deref, base.ty().clone())
+        .project(projection.clone(), place.ty().clone());
+    true
+}
+
+pub struct Transform;
+
+impl UllbcPass for Transform {
+    fn should_run(&self, options: &crate::options::TranslateOptions) -> bool {
+        options.treat_box_as_builtin
+    }
+
+    fn transform_body(&self, _ctx: &mut TransformCtx, body: &mut ExprBody) {
+        reconstruct_box_copy_borrows(body);
+    }
+}
