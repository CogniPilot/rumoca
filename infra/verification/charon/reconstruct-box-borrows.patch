+    let TyKind::Ref(region, _, RefKind::Shared) =
+        body.locals.locals[LocalId::from_usize(1)].ty.kind()
+    else {
+        panic!("expected borrowed Storage")
+    };
+    let reference_ty = TyKind::Ref(*region, element_ty, RefKind::Shared).into_ty();
+    // The body visitor group skips `Ty` (visitor.rs:180-201, "does not recurse
+    // into types"), so it retypes the local declarations but leaves the return
+    // tuple's element types untouched. The AST group drives `Ty` and `TyKind`,
+    // so it reaches nested types.
+    body.dyn_visit_mut(|ty: &mut Ty| {
+        if *ty == pointer_ty {
+            *ty = reference_ty.clone();
+        }
+    });
+    assert_eq!(
+        body.locals.locals[LocalId::ZERO]
+            .ty
+            .as_tuple_fields(&ctx.translated),
+        vec![reference_ty.clone(), reference_ty.clone()],
+        "the returned tuple fields must be retyped"
+    );
