+        // substitution retypes every mention of them.
+        let captured = destination.ty().clone();
+        assert!(
+            pointer_ty.get_or_insert(captured.clone()) == &captured,
+            "the two captures must share one pointer type"
+        );
+        element_ty.get_or_insert(place.ty().clone());
