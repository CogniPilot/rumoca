+
+    let raw_body = body.clone();
+
+    let StatementKind::Assign(
+        destination,
+        Rvalue::RawPtr {
+            place,
+            kind: RefKind::Shared,
+            ptr_metadata,
+        },
+    ) = body[use_loc].kind.clone()
+    else {
+        panic!("expected shared raw pointer")
+    };
+    assert_eq!(destination.as_local(), Some(LocalId::ZERO));
+    assert_eq!(place.as_projection().unwrap().0, &pointer);
