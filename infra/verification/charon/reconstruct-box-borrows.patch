+/// Indexed element shapes: `Ref(Index(Deref(temp), i))` and
+/// `Copy(Index(Deref(temp), i))`, with unit metadata rather than the box's own.
+/// Extracted as a raw pointer: the deref pass has already rewritten this one to
+/// index the boxed temporary, and the copy pass excludes `RawPtr` uses, so the
+/// shape survives translation and is still present against a repaired binary.
+/// Only the rvalue and the return-local type are adapted; the place, offset,
+/// owner, metadata, types and region all come from the extraction.
+fn indexed_fixture(copy_element: bool) -> anyhow::Result<Fixture> {
+    let translated = util::translate_rust_text(
+        "pub struct Storage { pub values: Box<[u32]> }
+         pub fn capture_element(storage: &Storage, index: usize, _replacement: Box<[u32]>)
+             -> *const u32 {
+             &raw const storage.values[index]
+         }",
+        &["--mir", "optimized", "--treat-box-as-builtin", "--ullbc"],
+    )?;
+    let mut body = translated
+        .fun_decls
+        .iter()
+        .find(|decl| {
+            util::repr_name(&translated, &decl.item_meta.name) == "test_crate::capture_element"
+        })
+        .unwrap()
+        .body
+        .as_unstructured()
+        .unwrap()
+        .clone();
+    let mut errors = ErrorCtx::new();
+    let ctx = TransformCtx {
+        options: TranslateOptions::new(&mut errors, &translated.options),
+        translated,
+        errors: errors.into(),
+    };
+
+    let captures = indexed_captures(&body);
+    let [use_loc] = captures.as_slice() else {
+        panic!("expected one indexed element capture")
+    };
+    let use_loc = *use_loc;
+    let assign_loc = StmtLoc::new(use_loc.block, use_loc.statement - 1);
+    let StatementKind::Assign(temporary, Rvalue::Use(Operand::Copy(owner), WithRetag::No)) =
+        &body[assign_loc].kind
+    else {
+        panic!("expected the boxed copy immediately before the capture")
+    };
+    assert!(temporary.ty().is_box());
+    let temporary = temporary.clone();
+    let owner = owner.clone();
+    let StatementKind::Assign(
+        _,
+        Rvalue::RawPtr {
+            place,
+            ptr_metadata,
+            ..
+        },
+    ) = &body[use_loc].kind
+    else {
+        unreachable!()
+    };
+    assert_eq!(
+        place.as_projection().map(|(base, _)| base.as_projection()),
+        Some(Some((&temporary, &ProjectionElem::Deref))),
+        "the capture must index the boxed temporary"
+    );
+    let indexed = place.clone();
+    let element_ty = indexed.ty().clone();
+    let ptr_metadata = ptr_metadata.clone();
+
+    let TyKind::Ref(region, _, RefKind::Shared) =
+        body.locals.locals[LocalId::from_usize(1)].ty.kind()
+    else {
+        panic!("expected borrowed Storage")
+    };
+    let (return_ty, rvalue) = if copy_element {
+        (
+            element_ty,
+            Rvalue::Use(Operand::Copy(indexed), WithRetag::No),
+        )
+    } else {
+        (
+            TyKind::Ref(*region, element_ty, RefKind::Shared).into_ty(),
+            Rvalue::Ref {
+                place: indexed,
+                kind: BorrowKind::Shared,
+                ptr_metadata,
+            },
+        )
+    };
+    body.locals.locals[LocalId::ZERO].ty = return_ty.clone();
+    body[use_loc].kind = StatementKind::Assign(Place::new(LocalId::ZERO, return_ty), rvalue);
+
+    Ok(Fixture {
+        ctx,
+        body,
+        assign_loc,
+        use_loc,
+        owner,
+        temporary,
+    })
+}
