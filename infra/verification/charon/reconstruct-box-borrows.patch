+/// Rebase `place`'s boxed base from the temporary onto the owner, leaving every
+/// other component of the place alone.
+fn rebased(place: &Place, owner: &Place) -> Place {
+    let Some((base, index)) = place.as_projection() else {
+        panic!("expected an index projection")
+    };
+    let Some((_, ProjectionElem::Deref)) = base.as_projection() else {
+        panic!("expected a dereferenced base")
+    };
+    owner
+        .clone()
+        .project(ProjectionElem::Deref, base.ty().clone())
+        .project(index.clone(), place.ty().clone())
+}
+
+/// The rewrite must change the owner and nothing else. Comparing the whole
+/// statement catches a flipped `from_end`, a `Copy` that became a `Ref`, a
+/// dropped metadata operand, an added retag and a moved destination, none of
+/// which an owner-and-offset check would see.
+fn indexed_rewrite_only_rebases_the_owner(mut f: Fixture) {
+    let StatementKind::Assign(destination, before) = f.body[f.use_loc].kind.clone() else {
+        unreachable!()
+    };
+    let expected = match &before {
+        Rvalue::Ref {
+            place,
+            kind,
+            ptr_metadata,
+        } => Rvalue::Ref {
+            place: rebased(place, &f.owner),
+            kind: *kind,
+            ptr_metadata: ptr_metadata.clone(),
+        },
+        Rvalue::Use(Operand::Copy(place), retag) => {
+            Rvalue::Use(Operand::Copy(rebased(place, &f.owner)), retag.clone())
+        }
+        _ => unreachable!(),
+    };
+    Transform.transform_body(&mut f.ctx, &mut f.body);
+    assert!(
+        matches!(f.body[f.assign_loc].kind, StatementKind::Nop),
+        "boxed temporary must be eliminated"
+    );
+    assert_eq!(
+        f.body[f.use_loc].kind,
+        StatementKind::Assign(destination, expected),
+        "only the owner may change"
+    );
+}
