+            }
+        }
+    }
+    let [use_loc] = captures.as_slice() else {
+        panic!("expected one pointer capture")
+    };
+    let use_loc = *use_loc;
+    let pointer_loc = StmtLoc::new(use_loc.block, use_loc.statement - 1);
+    let assign_loc = StmtLoc::new(use_loc.block, use_loc.statement - 2);
+    let StatementKind::Assign(temporary, Rvalue::Use(Operand::Copy(owner), WithRetag::No)) =
+        &body[assign_loc].kind
+    else {
+        panic!("expected the optimized boxed copy")
+    };
+    assert!(temporary.ty().is_box());
+    let temporary = temporary.clone();
+    let owner = owner.clone();
+    let StatementKind::Assign(
+        _,
+        Rvalue::UnaryOp(UnOp::Cast(CastKind::Transmute(_, _)), Operand::Copy(hidden)),
+    ) = &body[pointer_loc].kind
+    else {
+        panic!("expected hidden-pointer transmute")
+    };
+    assert_eq!(
+        hidden.as_projection(),
+        Some((&temporary, &ProjectionElem::Deref))
+    );
+    let StatementKind::Assign(
+        _,
+        Rvalue::RawPtr {
+            place,
+            ptr_metadata,
+            ..
+        },
+    ) = &body[use_loc].kind
+    else {
+        panic!("expected raw pointer")
+    };
+    let slice_ty = place.ty().clone();
+    let metadata_ty = ptr_metadata.ty().clone();
+    let TyKind::Ref(region, _, RefKind::Shared) =
+        body.locals.locals[LocalId::from_usize(1)].ty.kind()
+    else {
+        panic!("expected borrowed Storage")
+    };
+    let reference_ty = TyKind::Ref(*region, slice_ty.clone(), RefKind::Shared).into_ty();
+    body.locals.locals[LocalId::ZERO].ty = reference_ty.clone();
+    body[pointer_loc].kind = StatementKind::Nop;
+    body[use_loc].kind = StatementKind::Assign(
+        Place::new(LocalId::ZERO, reference_ty),
+        Rvalue::Ref {
+            place: temporary.clone().project(ProjectionElem::Deref, slice_ty),
+            kind: BorrowKind::Shared,
+            ptr_metadata: Operand::Copy(
+                temporary
+                    .clone()
+                    .project(ProjectionElem::PtrMetadata, metadata_ty),
+            ),
+        },
+    );
+    Ok(Fixture {
+        ctx,
+        body,
+        assign_loc,
+        use_loc,
+        owner,
+        temporary,
+    })
+}
