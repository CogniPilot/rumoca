+/// The indexed element captures in `body`. The bounds checks capture whole-slice
+/// raw pointers of their own, so select on the shape rather than on being the
+/// only capture: an element pointer indexes a dereferenced boxed local.
+fn indexed_captures(body: &ExprBody) -> Vec<StmtLoc> {
+    let mut captures = Vec::new();
+    for (block, data) in body.body.iter_enumerated() {
+        for (index, statement) in data.statements.iter().enumerate() {
+            let StatementKind::Assign(_, Rvalue::RawPtr { place, .. }) = &statement.kind else {
+                continue;
+            };
+            let Some((base, ProjectionElem::Index { .. })) = place.as_projection() else {
+                continue;
+            };
+            let Some((boxed, ProjectionElem::Deref)) = base.as_projection() else {
+                continue;
+            };
+            if boxed.is_local() && boxed.ty().is_box() {
+                captures.push(StmtLoc::new(block, index));
+            }
+        }
+    }
+    captures
+}
