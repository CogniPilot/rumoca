+        .unwrap()
+        .clone();
+    let mut errors = ErrorCtx::new();
+    let ctx = TransformCtx {
+        options: TranslateOptions::new(&mut errors, &translated.options),
+        translated,
+        errors: errors.into(),
+    };
+    assert!(Transform.should_run(&ctx.options));
+
+    let capture = body
+        .body
+        .iter_enumerated()
+        .flat_map(|(block, data)| {
+            data.statements
+                .iter()
+                .enumerate()
+                .filter_map(move |(index, statement)| {
+                    matches!(
+                        statement.kind,
+                        StatementKind::Assign(_, Rvalue::RawPtr { .. })
+                    )
+                    .then_some(StmtLoc::new(block, index))
+                })
+        })
+        .collect::<Vec<_>>();
+    let [use_loc] = capture.as_slice() else {
+        panic!("expected one raw-pointer construction")
