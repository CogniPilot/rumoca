<div class="stats"><div><b id="steps">—</b><span>training transitions</span></div><div><b id="episodes">—</b><span>episodes</span></div><div><b id="finishes">—</b><span>finishes</span></div><div><b id="distance">—</b><span>last 50 mean distance</span></div></div>
