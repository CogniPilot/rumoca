model TensorStateContact
  parameter Real radius = 1;
  parameter Real theta0 = 0.2;
  Real theta(start=theta0, fixed=true, stateSelect=StateSelect.always);
  Real x(start=0.2, fixed=true, stateSelect=StateSelect.always);
  Real y(start=0.3, fixed=true, stateSelect=StateSelect.always);
  Real z(start=radius*cos(theta0));
  Real r[3](start={0.2,0.3,radius*cos(theta0)});
  Real v[3](start={0,0,-radius*sin(theta0)});
  Real force[3];
  Real normal[3];
  Real axis[3];
  Real auxiliary[3];
  Real longitudinal[3];
  Real road[3];
  Real delta[3];
  Real s;
  Real w;
equation
  der(theta) = 1;
  der(x) = 0;
  der(y) = 0;
  r = {x,y,z};
  der(r) = v;
  der(v) = force;
  normal = {0,0,1};
  axis = {0, cos(theta), sin(theta)};
  auxiliary = cross(normal, axis);
  longitudinal = auxiliary/sqrt(auxiliary*auxiliary);
  road = {s,w,0};
  delta = road - r;
  0 = delta*axis;
  0 = delta*longitudinal;
  radius = delta*cross(longitudinal,axis);
  assert(abs(axis[3]) < 0.99, "Contact basis is singular");
end TensorStateContact;
