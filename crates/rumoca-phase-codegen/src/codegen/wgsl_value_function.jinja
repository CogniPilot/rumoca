{{ real_extremum_prelude("wgsl") }}
fn rumoca_evaluate(p: array<f32, {{ p_count }}>, time: f32) -> array<f32, {{ y_count }}> {
    var y: array<f32, {{ y_count }}>;
    {%- set cfg = {"time": "time", "y": "y[{}]", "p": "p[{}]"} %}
    {%- for stage in stages %}
    {
        var next: array<f32, {{ stage.block.output_count }}>;
        {%- for family in stage.block.native_families %}
        for (var r = 0u; r < {{ family.count }}u; r++) {
            {{ render_solve_native_family_wgsl_statements(family, "next[" ~ render_solve_native_family_output_index_wgsl(family) ~ "]", cfg) }}
        }
        {%- endfor %}
        {{ render_solve_fallback_wgsl_statements(stage.block.fallback_programs, stage.block.scalar_fallback_rows, cfg) }}
        for (var i = 0u; i < {{ stage.block.output_count }}u; i++) {
            y[{{ stage.start }}u + i] = next[i];
        }
    }
    {%- endfor %}
    return y;
}
