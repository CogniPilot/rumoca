FMI_EXPORT fmi2Status fmi2GetIntegerStatus(fmi2Component c, const fmi2StatusKind kind, fmi2Integer* value) { (void)c; (void)kind; (void)value; return fmi2Discard; }
FMI_EXPORT fmi2Status fmi2GetBooleanStatus(fmi2Component c, const fmi2StatusKind kind, fmi2Boolean* value) { if (!c || !value || kind != fmi2Terminated) return fmi2Discard; *value = fmi2False; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2GetStringStatus(fmi2Component c, const fmi2StatusKind kind, fmi2String* value) { (void)c; (void)kind; (void)value; return fmi2Discard; }
