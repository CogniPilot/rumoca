static fmi2Status evaluate_derivatives(ModelInstance* m) {
    if (settle_derivative_values(m) != fmi2OK) return fmi2Error;
{%- set plan = solve_blocks.continuous.derivative_rhs.scalar_plan %}
{%- for program in plan.programs %}
    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}];
    (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "m->derivative", "fmi2Error") }}
{%- endfor %}
    }
{%- endfor %}
    for (size_t i = 0; i < {{ solve.solve_layout.state_scalar_count }}; ++i) {
        if (!isfinite(m->derivative[i])) return fmi2Error;
    }
    return fmi2OK;
}

static fmi2Status integrate_rk4(ModelInstance* m, fmi2Real start, fmi2Real step) {
    double initial[STATE_LEN];
    double k1[STATE_LEN];
    double k2[STATE_LEN];
    double k3[STATE_LEN];
    double k4[STATE_LEN];
    size_t count = {{ solve.solve_layout.state_scalar_count }};
    for (size_t i = 0; i < count; ++i) initial[i] = m->y[i];
    m->time = start;
    if (evaluate_derivatives(m) != fmi2OK) return fmi2Error;
    for (size_t i = 0; i < count; ++i) { k1[i] = m->derivative[i]; m->y[i] = initial[i] + 0.5 * step * k1[i]; }
    m->time = start + 0.5 * step;
    if (evaluate_derivatives(m) != fmi2OK) return fmi2Error;
    for (size_t i = 0; i < count; ++i) { k2[i] = m->derivative[i]; m->y[i] = initial[i] + 0.5 * step * k2[i]; }
    if (evaluate_derivatives(m) != fmi2OK) return fmi2Error;
    for (size_t i = 0; i < count; ++i) { k3[i] = m->derivative[i]; m->y[i] = initial[i] + step * k3[i]; }
    m->time = start + step;
    if (evaluate_derivatives(m) != fmi2OK) return fmi2Error;
    for (size_t i = 0; i < count; ++i) {
        k4[i] = m->derivative[i];
        m->y[i] = initial[i] + step * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]) / 6.0;
        if (!isfinite(m->y[i])) return fmi2Error;
    }
    return settle_assertion_event(m);
}

{#- One row per FMI 2 value reference, indexed by the reference itself: time
    is 0, then every variable scalar in inventory order, then every state
    derivative scalar. Integer and enumeration values are Integer and Boolean
    values Boolean, all held in the numeric storage run; String values live in
    the instance text table. -#}
enum RmcColumn { RMC_COLUMN_TIME, RMC_COLUMN_Y, RMC_COLUMN_P, RMC_COLUMN_DERIVATIVE, RMC_COLUMN_TEXT };
enum RmcKind { RMC_KIND_FLOAT64, RMC_KIND_INT32, RMC_KIND_BOOLEAN, RMC_KIND_STRING };
enum RmcAccess { RMC_ACCESS_FIXED, RMC_ACCESS_STATE, RMC_ACCESS_INPUT, RMC_ACCESS_PARAMETER, RMC_ACCESS_TUNABLE_PARAMETER };
typedef struct { unsigned char column; unsigned char kind; unsigned char access; unsigned char marks_parameters; size_t index; } RmcValueReference;
static const RmcValueReference rmc_value_references[] = {
    {RMC_COLUMN_TIME, RMC_KIND_FLOAT64, RMC_ACCESS_FIXED, 0, 0},
{%- set row = namespace(count=0, text=0) %}
{%- for variable in fmi.variables %}
{%- set column %}{% if variable.value_kind == "String" %}RMC_COLUMN_TEXT{% elif variable.storage.column == "y" %}RMC_COLUMN_Y{% elif variable.storage.column == "p" %}RMC_COLUMN_P{% else %}{{ fail("unsupported-feature:fmi.c.value-reference-column " ~ variable.storage.column) }}{% endif %}{% endset %}
{%- set access %}{% if variable.role == "State" %}RMC_ACCESS_STATE{% elif variable.causality == "input" %}RMC_ACCESS_INPUT{% elif variable.causality == "parameter" %}{% if variable.tunable %}RMC_ACCESS_TUNABLE_PARAMETER{% else %}RMC_ACCESS_PARAMETER{% endif %}{% else %}RMC_ACCESS_FIXED{% endif %}{% endset %}
{%- for scalar in range(variable.storage.scalar_count) %}{% if row.count % 6 == 0 %}
   {% endif %} { {{- column }}, {{ rmc_kind(variable) }}, {{ access }}, {{ 1 if variable.causality == "parameter" and variable.value_kind != "String" else 0 }}, {% if variable.value_kind == "String" %}{{ row.text }}{% set row.text = row.text + 1 %}{% else %}{{ variable.storage.base + scalar }}{% endif -%} },
{%- set row.count = row.count + 1 %}
{%- endfor %}
{%- endfor %}
{%- for scalar in range(solve.solve_layout.state_scalar_count) %}{% if row.count % 6 == 0 %}
   {% endif %} {RMC_COLUMN_DERIVATIVE, RMC_KIND_FLOAT64, RMC_ACCESS_FIXED, 0, {{ scalar }}},
{%- set row.count = row.count + 1 %}
{%- endfor %}
};
#define RMC_VALUE_REFERENCES (sizeof(rmc_value_references) / sizeof(rmc_value_references[0]))

static const RmcValueReference* rmc_reference(fmi2ValueReference vr, unsigned char kind) {
    return vr < RMC_VALUE_REFERENCES && rmc_value_references[vr].kind == kind ? &rmc_value_references[vr] : NULL;
}
/* One settled numeric value. */
static fmi2Status rmc_get_numeric(ModelInstance* m, const RmcValueReference* ref, double* value) {
    if (settle_values(m) != fmi2OK) return fmi2Error;
    switch (ref->column) {
    case RMC_COLUMN_TIME: *value = m->time; return fmi2OK;
    case RMC_COLUMN_Y: *value = m->y[ref->index]; return fmi2OK;
    case RMC_COLUMN_P: *value = m->p[ref->index]; return fmi2OK;
    case RMC_COLUMN_DERIVATIVE: if (evaluate_derivatives(m) != fmi2OK) return fmi2Error; *value = m->derivative[ref->index]; return fmi2OK;
    default: return fmi2Error;
    }
}

static fmi2Boolean rmc_can_set(const ModelInstance* m, const RmcValueReference* ref) {
    switch (ref->access) {
    case RMC_ACCESS_STATE:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION
            || (m->type == fmi2ModelExchange && m->state == MODEL_CONTINUOUS);
    case RMC_ACCESS_INPUT:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION
            || (m->type == fmi2ModelExchange && (m->state == MODEL_EVENT || m->state == MODEL_CONTINUOUS))
            || (m->type == fmi2CoSimulation && m->state == MODEL_STEP);
    case RMC_ACCESS_PARAMETER:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION;
    case RMC_ACCESS_TUNABLE_PARAMETER:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION
            || (m->type == fmi2ModelExchange && m->state == MODEL_EVENT)
            || (m->type == fmi2CoSimulation && m->state == MODEL_STEP);
    default: return fmi2False;
    }
}

#define RMC_GET_NUMERIC(Name, Type, KIND, CONVERT) \
FMI_EXPORT fmi2Status fmi2Get##Name(fmi2Component c, const fmi2ValueReference vr[], size_t n, Type values[]) { \
    ModelInstance* m = c; \
    if (!m || (!vr && n) || (!values && n) || m->state == MODEL_INSTANTIATED) return fmi2Error; \
    for (size_t i = 0; i < n; ++i) { \
        const RmcValueReference* ref = rmc_reference(vr[i], KIND); double value = 0.0; \
        if (!ref || rmc_get_numeric(m, ref, &value) != fmi2OK) return fmi2Error; \
        values[i] = CONVERT; \
    } \
    return fmi2OK; \
}
#define RMC_SET_NUMERIC(Name, Type, KIND, VALID, STORE) \
FMI_EXPORT fmi2Status fmi2Set##Name(fmi2Component c, const fmi2ValueReference vr[], size_t n, const Type values[]) { \
    ModelInstance* m = c; \
    if (!m || (!vr && n) || (!values && n)) return fmi2Error; \
    for (size_t i = 0; i < n; ++i) { const RmcValueReference* ref = rmc_reference(vr[i], KIND); Type value = values[i]; (void)value; if (!ref || !rmc_can_set(m, ref) || !(VALID)) return fmi2Error; } \
    for (size_t i = 0; i < n; ++i) { \
        const RmcValueReference* ref = &rmc_value_references[vr[i]]; Type value = values[i]; \
        (ref->column == RMC_COLUMN_Y ? m->y : m->p)[ref->index] = STORE; \
        if (ref->marks_parameters) m->parameters_dirty = true; \
    } \
    return fmi2OK; \
}
FMI_EXPORT const char* fmi2GetTypesPlatform(void) { return "default"; }
FMI_EXPORT const char* fmi2GetVersion(void) { return "2.0"; }
FMI_EXPORT fmi2Status fmi2SetDebugLogging(fmi2Component c, fmi2Boolean loggingOn, size_t n, const fmi2String categories[]) { (void)loggingOn; if (!c || (!categories && n)) return fmi2Error; return fmi2OK; }
FMI_EXPORT fmi2Component fmi2Instantiate(fmi2String name, fmi2Type type, fmi2String guid, fmi2String resources, const fmi2CallbackFunctions* callbacks, fmi2Boolean visible, fmi2Boolean loggingOn) {
    (void)name; (void)resources; (void)visible; (void)loggingOn;
    if ((type != fmi2ModelExchange && type != fmi2CoSimulation) || !guid || strcmp(guid, "{ {{- artifact.identities.fmu -}} }") != 0 || !callbacks || !callbacks->allocateMemory || !callbacks->freeMemory) return NULL;
    ModelInstance* m = callbacks->allocateMemory(1, sizeof(ModelInstance));
    if (!m) return NULL;
    m->callbacks = *callbacks; m->type = type; m->state = MODEL_INSTANTIATED; initialize_values(m); return m;
}
FMI_EXPORT void fmi2FreeInstance(fmi2Component c) { if (c) { ModelInstance* m = c; rmc_release_text(m); m->callbacks.freeMemory(m); } }
FMI_EXPORT fmi2Status fmi2SetupExperiment(fmi2Component c, fmi2Boolean td, fmi2Real tol, fmi2Real start, fmi2Boolean sd, fmi2Real stop) { ModelInstance* m = c; if (!m || m->state != MODEL_INSTANTIATED || !isfinite(start) || (td && (!isfinite(tol) || tol < 0.0)) || (sd && (!isfinite(stop) || stop < start))) return fmi2Error; m->time = start; m->tolerance = td ? tol : 0.0; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2EnterInitializationMode(fmi2Component c) { ModelInstance* m = c; if (!m || m->state != MODEL_INSTANTIATED) return fmi2Error; m->state = MODEL_INITIALIZATION; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2ExitInitializationMode(fmi2Component c) { ModelInstance* m = c; if (!m || m->state != MODEL_INITIALIZATION || {% if me_refresh.init.rows > 0 %}rmc_initialize(m, m->tolerance) != fmi2OK || {% endif %}initialize_assertions(m) != fmi2OK || evaluate_derivatives(m) != fmi2OK) return fmi2Error; m->state = m->type == fmi2ModelExchange ? MODEL_EVENT : MODEL_STEP; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2Terminate(fmi2Component c) { ModelInstance* m = c; if (!m || (m->state != MODEL_EVENT && m->state != MODEL_CONTINUOUS && m->state != MODEL_STEP)) return fmi2Error; m->state = MODEL_TERMINATED; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2Reset(fmi2Component c) { ModelInstance* m = c; if (!m) return fmi2Error; initialize_values(m); m->state = MODEL_INSTANTIATED; return fmi2OK; }
RMC_GET_NUMERIC(Real, fmi2Real, RMC_KIND_FLOAT64, value)
RMC_SET_NUMERIC(Real, fmi2Real, RMC_KIND_FLOAT64, isfinite(value), value)
RMC_GET_NUMERIC(Integer, fmi2Integer, RMC_KIND_INT32, (fmi2Integer)value)
RMC_SET_NUMERIC(Integer, fmi2Integer, RMC_KIND_INT32, true, (double)value)
RMC_GET_NUMERIC(Boolean, fmi2Boolean, RMC_KIND_BOOLEAN, value != 0.0 ? fmi2True : fmi2False)
RMC_SET_NUMERIC(Boolean, fmi2Boolean, RMC_KIND_BOOLEAN, true, value ? 1.0 : 0.0)
FMI_EXPORT fmi2Status fmi2GetString(fmi2Component c, const fmi2ValueReference vr[], size_t n, fmi2String values[]) {
    ModelInstance* m = c;
    if (!m || (!vr && n) || (!values && n)) return fmi2Error;
    for (size_t i = 0; i < n; ++i) { const RmcValueReference* ref = rmc_reference(vr[i], RMC_KIND_STRING); if (!ref) return fmi2Error; values[i] = rmc_text(m, ref->index); }
    return fmi2OK;
}
FMI_EXPORT fmi2Status fmi2SetString(fmi2Component c, const fmi2ValueReference vr[], size_t n, const fmi2String values[]) {
    ModelInstance* m = c;
    if (!m || (!vr && n) || (!values && n)) return fmi2Error;
    for (size_t i = 0; i < n; ++i) { const RmcValueReference* ref = rmc_reference(vr[i], RMC_KIND_STRING); if (!ref || !rmc_can_set(m, ref) || !values[i]) return fmi2Error; }
    for (size_t i = 0; i < n; ++i) if (!rmc_set_text(m, rmc_value_references[vr[i]].index, values[i])) return fmi2Error;
    return fmi2OK;
}
FMI_EXPORT fmi2Status fmi2SetTime(fmi2Component c, fmi2Real time) { ModelInstance* m = c; if (!m || m->type != fmi2ModelExchange || m->state != MODEL_CONTINUOUS || !isfinite(time)) return fmi2Error; m->time = time; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2SetContinuousStates(fmi2Component c, const fmi2Real x[], size_t nx) { ModelInstance* m = c; if (!m || m->type != fmi2ModelExchange || m->state != MODEL_CONTINUOUS || nx != {{ solve.solve_layout.state_scalar_count }} || (!x && nx)) return fmi2Error; for (size_t i = 0; i < nx; ++i) if (!isfinite(x[i])) return fmi2Error; for (size_t i = 0; i < nx; ++i) m->y[i] = x[i]; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2GetContinuousStates(fmi2Component c, fmi2Real x[], size_t nx) { ModelInstance* m = c; if (!m || m->type != fmi2ModelExchange || m->state == MODEL_INSTANTIATED || m->state == MODEL_STEP || nx != {{ solve.solve_layout.state_scalar_count }} || (!x && nx)) return fmi2Error; for (size_t i = 0; i < nx; ++i) x[i] = m->y[i]; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2GetDerivatives(fmi2Component c, fmi2Real dx[], size_t nx) { ModelInstance* m = c; if (!m || m->type != fmi2ModelExchange || m->state == MODEL_INSTANTIATED || m->state == MODEL_STEP || nx != {{ solve.solve_layout.state_scalar_count }} || (!dx && nx) || evaluate_derivatives(m) != fmi2OK) return fmi2Error; for (size_t i = 0; i < nx; ++i) dx[i] = m->derivative[i]; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2GetNominalsOfContinuousStates(fmi2Component c, fmi2Real values[], size_t nx) { ModelInstance* m = c; if (!m || m->type != fmi2ModelExchange || nx != {{ solve.solve_layout.state_scalar_count }} || (!values && nx)) return fmi2Error; for (size_t i = 0; i < nx; ++i) values[i] = 1.0; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2GetEventIndicators(fmi2Component c, fmi2Real values[], size_t ni) { ModelInstance* m = c; (void)values; return m && m->type == fmi2ModelExchange && m->state != MODEL_INSTANTIATED && m->state != MODEL_STEP && ni == 0 ? fmi2OK : fmi2Error; }
FMI_EXPORT fmi2Status fmi2EnterEventMode(fmi2Component c) { ModelInstance* m = c; if (!m || m->type != fmi2ModelExchange || (m->state != MODEL_EVENT && m->state != MODEL_CONTINUOUS)) return fmi2Error; m->state = MODEL_EVENT; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2NewDiscreteStates(fmi2Component c, fmi2EventInfo* info) { ModelInstance* m = c; if (!m || !info || m->state != MODEL_EVENT) return fmi2Error; if (settle_assertion_event(m) != fmi2OK) return fmi2Error; memset(info, 0, sizeof(*info)); return fmi2OK; }
FMI_EXPORT fmi2Status fmi2EnterContinuousTimeMode(fmi2Component c) { ModelInstance* m = c; if (!m || m->state != MODEL_EVENT) return fmi2Error; m->state = MODEL_CONTINUOUS; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2CompletedIntegratorStep(fmi2Component c, fmi2Boolean noSetState, fmi2Boolean* enterEventMode, fmi2Boolean* terminate) { ModelInstance* m = c; (void)noSetState; if (!m || m->type != fmi2ModelExchange || m->state != MODEL_CONTINUOUS || !enterEventMode || !terminate) return fmi2Error; *enterEventMode = 0; *terminate = 0; return fmi2OK; }
