{{ refresh_values(solve, me_refresh, "fmi2") }}
{{ assertion_lifecycle("fmi2") }}

static fmi2Status evaluate_derivatives(ModelInstance* m) {
    if (settle_derivative_values(m) != fmi2OK) return fmi2Error;
{%- set plan = solve_blocks.continuous.derivative_rhs.scalar_plan %}
{%- for program in plan.programs %}
    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}];
    (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "m->derivative", "fmi2Error") }}
{%- endfor %}
    }
{%- endfor %}
    for (size_t i = 0; i < {{ solve.solve_layout.state_scalar_count }}; ++i) {
        if (!isfinite(m->derivative[i])) return fmi2Error;
    }
    return fmi2OK;
}

static fmi2Status integrate_rk4(ModelInstance* m, fmi2Real start, fmi2Real step) {
    double initial[STATE_LEN];
    double k1[STATE_LEN];
    double k2[STATE_LEN];
    double k3[STATE_LEN];
    double k4[STATE_LEN];
    size_t count = {{ solve.solve_layout.state_scalar_count }};
    for (size_t i = 0; i < count; ++i) initial[i] = m->y[i];
    m->time = start;
    if (evaluate_derivatives(m) != fmi2OK) return fmi2Error;
    for (size_t i = 0; i < count; ++i) { k1[i] = m->derivative[i]; m->y[i] = initial[i] + 0.5 * step * k1[i]; }
    m->time = start + 0.5 * step;
    if (evaluate_derivatives(m) != fmi2OK) return fmi2Error;
    for (size_t i = 0; i < count; ++i) { k2[i] = m->derivative[i]; m->y[i] = initial[i] + 0.5 * step * k2[i]; }
    if (evaluate_derivatives(m) != fmi2OK) return fmi2Error;
    for (size_t i = 0; i < count; ++i) { k3[i] = m->derivative[i]; m->y[i] = initial[i] + step * k3[i]; }
    m->time = start + step;
    if (evaluate_derivatives(m) != fmi2OK) return fmi2Error;
    for (size_t i = 0; i < count; ++i) {
        k4[i] = m->derivative[i];
        m->y[i] = initial[i] + step * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]) / 6.0;
        if (!isfinite(m->y[i])) return fmi2Error;
    }
    return settle_assertion_event(m);
}

{#- One row per FMI 2 value reference, indexed by the reference itself: time
    is 0, then every variable scalar in inventory order, then every state
    derivative scalar. -#}
enum RmcColumn { RMC_COLUMN_TIME, RMC_COLUMN_Y, RMC_COLUMN_P, RMC_COLUMN_DERIVATIVE };
enum RmcAccess { RMC_ACCESS_FIXED, RMC_ACCESS_STATE, RMC_ACCESS_INPUT, RMC_ACCESS_PARAMETER, RMC_ACCESS_TUNABLE_PARAMETER };
typedef struct { unsigned char column; unsigned char access; unsigned char marks_parameters; size_t index; } RmcValueReference;
static const RmcValueReference rmc_value_references[] = {
    {RMC_COLUMN_TIME, RMC_ACCESS_FIXED, 0, 0},
{%- set row = namespace(count=0) %}
{%- for variable in fmi.variables %}
{%- set column %}{% if variable.storage.column == "y" %}RMC_COLUMN_Y{% elif variable.storage.column == "p" %}RMC_COLUMN_P{% else %}{{ fail("unsupported-feature:fmi.c.value-reference-column " ~ variable.storage.column) }}{% endif %}{% endset %}
{%- set access %}{% if variable.role == "State" %}RMC_ACCESS_STATE{% elif variable.causality == "input" %}RMC_ACCESS_INPUT{% elif variable.causality == "parameter" %}{% if variable.tunable %}RMC_ACCESS_TUNABLE_PARAMETER{% else %}RMC_ACCESS_PARAMETER{% endif %}{% else %}RMC_ACCESS_FIXED{% endif %}{% endset %}
{%- for scalar in range(variable.storage.scalar_count) %}{% if row.count % 6 == 0 %}
   {% endif %} { {{- column }}, {{ access }}, {{ 1 if variable.causality == "parameter" else 0 }}, {{ variable.storage.base + scalar -}} },
{%- set row.count = row.count + 1 %}
{%- endfor %}
{%- endfor %}
{%- for scalar in range(solve.solve_layout.state_scalar_count) %}{% if row.count % 6 == 0 %}
   {% endif %} {RMC_COLUMN_DERIVATIVE, RMC_ACCESS_FIXED, 0, {{ scalar }}},
{%- set row.count = row.count + 1 %}
{%- endfor %}
};
#define RMC_VALUE_REFERENCES (sizeof(rmc_value_references) / sizeof(rmc_value_references[0]))

static fmi2Status get_real(ModelInstance* m, fmi2ValueReference vr, fmi2Real* value) {
    if (settle_values(m) != fmi2OK) return fmi2Error;
    if (vr >= RMC_VALUE_REFERENCES) return fmi2Error;
    const RmcValueReference* ref = &rmc_value_references[vr];
    switch (ref->column) {
    case RMC_COLUMN_TIME: *value = m->time; return fmi2OK;
    case RMC_COLUMN_Y: *value = m->y[ref->index]; return fmi2OK;
    case RMC_COLUMN_P: *value = m->p[ref->index]; return fmi2OK;
    default: if (evaluate_derivatives(m) != fmi2OK) return fmi2Error; *value = m->derivative[ref->index]; return fmi2OK;
    }
}

static fmi2Boolean can_set_real(const ModelInstance* m, fmi2ValueReference vr) {
    if (vr >= RMC_VALUE_REFERENCES) return fmi2False;
    switch (rmc_value_references[vr].access) {
    case RMC_ACCESS_STATE:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION
            || (m->type == fmi2ModelExchange && m->state == MODEL_CONTINUOUS);
    case RMC_ACCESS_INPUT:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION
            || (m->type == fmi2ModelExchange && (m->state == MODEL_EVENT || m->state == MODEL_CONTINUOUS))
            || (m->type == fmi2CoSimulation && m->state == MODEL_STEP);
    case RMC_ACCESS_PARAMETER:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION;
    case RMC_ACCESS_TUNABLE_PARAMETER:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION
            || (m->type == fmi2ModelExchange && m->state == MODEL_EVENT)
            || (m->type == fmi2CoSimulation && m->state == MODEL_STEP);
    default: return fmi2False;
    }
}

static fmi2Status set_real(ModelInstance* m, fmi2ValueReference vr, fmi2Real value) {
    if (!isfinite(value)) return fmi2Error;
    if (vr >= RMC_VALUE_REFERENCES) return fmi2Error;
    const RmcValueReference* ref = &rmc_value_references[vr];
    switch (ref->column) {
    case RMC_COLUMN_Y: m->y[ref->index] = value; break;
    case RMC_COLUMN_P: m->p[ref->index] = value; break;
    default: return fmi2Error;
    }
    if (ref->marks_parameters) m->parameters_dirty = true;
    return fmi2OK;
}

FMI_EXPORT const char* fmi2GetTypesPlatform(void) { return "default"; }
FMI_EXPORT const char* fmi2GetVersion(void) { return "2.0"; }
FMI_EXPORT fmi2Status fmi2SetDebugLogging(fmi2Component c, fmi2Boolean loggingOn, size_t n, const fmi2String categories[]) { (void)loggingOn; if (!c || (!categories && n)) return fmi2Error; return fmi2OK; }
FMI_EXPORT fmi2Component fmi2Instantiate(fmi2String name, fmi2Type type, fmi2String guid, fmi2String resources, const fmi2CallbackFunctions* callbacks, fmi2Boolean visible, fmi2Boolean loggingOn) {
    (void)name; (void)resources; (void)visible; (void)loggingOn;
    if ((type != fmi2ModelExchange && type != fmi2CoSimulation) || !guid || strcmp(guid, "{ {{- artifact.identities.fmu -}} }") != 0 || !callbacks || !callbacks->allocateMemory || !callbacks->freeMemory) return NULL;
    ModelInstance* m = callbacks->allocateMemory(1, sizeof(ModelInstance));
    if (!m) return NULL;
    m->callbacks = *callbacks; m->type = type; m->state = MODEL_INSTANTIATED; initialize_values(m); return m;
}
FMI_EXPORT void fmi2FreeInstance(fmi2Component c) { if (c) { ModelInstance* m = c; m->callbacks.freeMemory(m); } }
FMI_EXPORT fmi2Status fmi2SetupExperiment(fmi2Component c, fmi2Boolean td, fmi2Real tol, fmi2Real start, fmi2Boolean sd, fmi2Real stop) { ModelInstance* m = c; if (!m || m->state != MODEL_INSTANTIATED || !isfinite(start) || (td && (!isfinite(tol) || tol < 0.0)) || (sd && (!isfinite(stop) || stop < start))) return fmi2Error; m->time = start; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2EnterInitializationMode(fmi2Component c) { ModelInstance* m = c; if (!m || m->state != MODEL_INSTANTIATED) return fmi2Error; m->state = MODEL_INITIALIZATION; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2ExitInitializationMode(fmi2Component c) { ModelInstance* m = c; if (!m || m->state != MODEL_INITIALIZATION || initialize_assertions(m) != fmi2OK || evaluate_derivatives(m) != fmi2OK) return fmi2Error; m->state = m->type == fmi2ModelExchange ? MODEL_EVENT : MODEL_STEP; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2Terminate(fmi2Component c) { ModelInstance* m = c; if (!m || (m->state != MODEL_EVENT && m->state != MODEL_CONTINUOUS && m->state != MODEL_STEP)) return fmi2Error; m->state = MODEL_TERMINATED; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2Reset(fmi2Component c) { ModelInstance* m = c; if (!m) return fmi2Error; initialize_values(m); m->state = MODEL_INSTANTIATED; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2GetReal(fmi2Component c, const fmi2ValueReference vr[], size_t n, fmi2Real values[]) { ModelInstance* m = c; if (!m || (!vr && n) || (!values && n) || m->state == MODEL_INSTANTIATED) return fmi2Error; for (size_t i = 0; i < n; ++i) if (get_real(m, vr[i], &values[i]) != fmi2OK) return fmi2Error; return fmi2OK; }
FMI_EXPORT fmi2Status fmi2SetReal(fmi2Component c, const fmi2ValueReference vr[], size_t n, const fmi2Real values[]) { ModelInstance* m = c; if (!m || (!vr && n) || (!values && n)) return fmi2Error; for (size_t i = 0; i < n; ++i) if (!can_set_real(m, vr[i]) || !isfinite(values[i])) return fmi2Error; for (size_t i = 0; i < n; ++i) if (set_real(m, vr[i], values[i]) != fmi2OK) return fmi2Error; return fmi2OK; }
