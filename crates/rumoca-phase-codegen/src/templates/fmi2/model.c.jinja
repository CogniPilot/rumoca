static void initialize_values(ModelInstance* m) {
{{- value_array("initial_y", "Y_LEN", fmi.initial_y) }}
{{- value_array("initial_p", "P_LEN", fmi.initial_parameters) }}
    m->assertions_initialized=false; m->assertion_failed=false; m->parameters_dirty=true; m->tolerance=0.0; rmc_release_text(m);{{ workspace_reset(me_refresh) }}
