enum ModelState { MODEL_INSTANTIATED, MODEL_INITIALIZATION, MODEL_EVENT, MODEL_CONTINUOUS, MODEL_STEP, MODEL_TERMINATED };
#define Y_LEN {{ solve.layout.y_scalars if solve.layout.y_scalars > 0 else 1 }}
#define P_LEN {{ solve.layout.p_scalars if solve.layout.p_scalars > 0 else 1 }}
#define STATE_LEN {{ solve.solve_layout.state_scalar_count if solve.solve_layout.state_scalar_count > 0 else 1 }}
typedef struct {
    bool assertions_initialized; bool assertion_failed; bool parameters_dirty;
    double time;
    double y[Y_LEN];
    double p[P_LEN];
    double derivative[STATE_LEN];
    enum ModelState state;
    fmi2Type type;
    fmi2CallbackFunctions callbacks;
   {{ workspace_fields(me_refresh) }}
} ModelInstance;
{{ functions(typed_pure_calls, typed_directional_calls if me_refresh.blocks|length > 0 else []) }}

static void initialize_values(ModelInstance* m) {
{{- value_array("initial_y", "Y_LEN", fmi.initial_y) }}
{{- value_array("initial_p", "P_LEN", fmi.initial_parameters) }}
    m->assertions_initialized=false; m->assertion_failed=false; m->parameters_dirty=true;
    memcpy(m->y, initial_y, sizeof(m->y));
    memcpy(m->p, initial_p, sizeof(m->p));
    m->time = 0.0;
}

