FMI_EXPORT fmi2Status fmi2SetFMUstate(fmi2Component c, fmi2FMUstate s) { (void)c; (void)s; return fmi2Error; }
FMI_EXPORT fmi2Status fmi2FreeFMUstate(fmi2Component c, fmi2FMUstate* s) { (void)c; (void)s; return fmi2Error; }
FMI_EXPORT fmi2Status fmi2SerializedFMUstateSize(fmi2Component c, fmi2FMUstate s, size_t* n) { (void)c; (void)s; (void)n; return fmi2Error; }
FMI_EXPORT fmi2Status fmi2SerializeFMUstate(fmi2Component c, fmi2FMUstate s, fmi2Byte bytes[], size_t n) { (void)c; (void)s; (void)bytes; (void)n; return fmi2Error; }
FMI_EXPORT fmi2Status fmi2DeSerializeFMUstate(fmi2Component c, const fmi2Byte bytes[], size_t n, fmi2FMUstate* s) { (void)c; (void)bytes; (void)n; (void)s; return fmi2Error; }
FMI_EXPORT fmi2Status fmi2GetDirectionalDerivative(fmi2Component c, const fmi2ValueReference u[], size_t nu, const fmi2ValueReference k[], size_t nk, const fmi2Real seed[], fmi2Real sensitivity[]) { (void)c; (void)u; (void)nu; (void)k; (void)nk; (void)seed; (void)sensitivity; return fmi2Error; }
FMI_EXPORT fmi2Status fmi2SetRealInputDerivatives(fmi2Component c, const fmi2ValueReference vr[], size_t nvr, const fmi2Integer order[], const fmi2Real value[]) { (void)c; (void)vr; (void)order; (void)value; return nvr == 0 ? fmi2OK : fmi2Error; }
FMI_EXPORT fmi2Status fmi2GetRealOutputDerivatives(fmi2Component c, const fmi2ValueReference vr[], size_t nvr, const fmi2Integer order[], fmi2Real value[]) { (void)c; (void)vr; (void)order; (void)value; return nvr == 0 ? fmi2OK : fmi2Error; }
FMI_EXPORT fmi2Status fmi2DoStep(fmi2Component c, fmi2Real current, fmi2Real step, fmi2Boolean noSetState) {
    (void)noSetState;
    ModelInstance* m = c;
    if (!m || m->type != fmi2CoSimulation || m->state != MODEL_STEP || !isfinite(current) || !isfinite(step) || step <= 0.0) return fmi2Error;
    if (fabs(current - m->time) > 1e-12 * fmax(1.0, fmax(fabs(current), fabs(m->time)))) return fmi2Error;
    double old_y[Y_LEN];
    for (size_t i = 0; i < Y_LEN; ++i) old_y[i] = m->y[i];
    if (integrate_rk4(m, current, step) != fmi2OK) {
        for (size_t i = 0; i < Y_LEN; ++i) m->y[i] = old_y[i];
        m->time = current;
        return fmi2Error;
    }
    return fmi2OK;
}
FMI_EXPORT fmi2Status fmi2CancelStep(fmi2Component c) { (void)c; return fmi2Error; }
