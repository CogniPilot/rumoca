def init_state(p):
	"""Start values of the states, with those computed from parameters (e.g.
	trainable weights carried as states) evaluated from p (length N_P, after
	init_params). Returns a list of N_Y values."""
	P = [float(v) for v in p] + [0.0] * (N_P_COMPILED - N_P)
	y = [float(v) for v in DEFAULT_X] + [float("nan")] * ({{ solve.layout.y_scalars }} - N_Y)
