[package]
name = "{{ model_name | lower | replace("_", "-") }}-fmi-ls-wasm"
version = "0.1.0"
edition = "2024"
publish = false
build = "build.rs"

# Generated crates are standalone even when emitted beneath another Cargo
# workspace directory.
[workspace]

[lib]
name = "rumoca_{{ artifact.identities.fmu | replace("-", "_") }}"
crate-type = ["cdylib"]

[dependencies]
# Must match the bindings version used by the pinned FMI-LS-Wasm revision.
wit-bindgen = "=0.43.0"

[build-dependencies]
cc = "1"
