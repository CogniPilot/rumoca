{%- set model_identifier = "Rumoca_" ~ (artifact.identities.fmu | replace("-", "_")) %}
{%- set numeric_types = [["float64", "Float64", "f64"], ["int32", "Int32", "i32"], ["int64", "Int64", "i64"], ["boolean", "Boolean", "bool"]] %}
//! FMI-LS-Wasm Co-Simulation component generated from Rumoca's checked FMI IR.
//!
//! The component is a thin adapter: every WIT call is forwarded through the C
//! ABI to the FMI 3 Co-Simulation kernel that the `fmi3` target renders from
//! the same Solve IR facts. Initialization projection, algebraic projection,
//! and scalar state-event location all execute inside that C kernel; this crate
//! holds no solve decision and only marshals WIT values to and from the ABI.
//!
//! The WIT package is pinned to modelica/fmi-ls-wasm commit
//! c1aac17d392bec989fe2d059db3cc57bb7a0fff5. The draft is non-normative.

wit_bindgen::generate!({
    world: "co-simulation-fmu",
    path: "wit",
});

use core::ffi::{c_char, c_int, c_void};
use std::ffi::{CStr, CString};

use exports::fmi::fmi3::co_simulation::{
    DiscreteStatesInfo, DoStepResult, Guest as CoSimulationGuest, GuestCoSimulationInstance,
    IntervalFraction, IntervalQualifier, Status, VariableDependency,
};
use exports::fmi::fmi3::common::Guest as CommonGuest;

// ---------------------------------------------------------------------------
// FMI 3 C ABI of the shared kernel
//
// The kernel is compiled with `FMI3_FUNCTION_PREFIX {{ model_identifier }}_`,
// so each entry point carries that prefix. Only the Co-Simulation lifecycle and
// the numeric accessors are bound; the remaining ABI stays in the object for
// the kernel's own use.
// ---------------------------------------------------------------------------

type FmiInstance = *mut c_void;
type FmiLogMessage = extern "C" fn(*mut c_void, c_int, *const c_char, *const c_char);

const FMI3_OK: c_int = 0;
const FMI3_WARNING: c_int = 1;
const FMI3_DISCARD: c_int = 2;
const FMI3_FATAL: c_int = 4;

unsafe extern "C" {
    #[link_name = "{{ model_identifier }}_fmi3GetVersion"]
    fn kernel_get_version() -> *const c_char;

    #[link_name = "{{ model_identifier }}_fmi3InstantiateCoSimulation"]
    #[allow(clippy::too_many_arguments)]
    fn kernel_instantiate_cs(
        instance_name: *const c_char,
        instantiation_token: *const c_char,
        resource_path: *const c_char,
        visible: bool,
        logging_on: bool,
        event_mode_used: bool,
        early_return_allowed: bool,
        required_intermediate_variables: *const u32,
        n_required_intermediate_variables: usize,
        instance_environment: *mut c_void,
        log_message: Option<FmiLogMessage>,
        intermediate_update: Option<extern "C" fn()>,
    ) -> FmiInstance;

    #[link_name = "{{ model_identifier }}_fmi3FreeInstance"]
    fn kernel_free_instance(instance: FmiInstance);

    #[link_name = "{{ model_identifier }}_fmi3SetDebugLogging"]
    fn kernel_set_debug_logging(
        instance: FmiInstance,
        logging_on: bool,
        n_categories: usize,
        categories: *const *const c_char,
    ) -> c_int;

    #[link_name = "{{ model_identifier }}_fmi3EnterInitializationMode"]
    fn kernel_enter_initialization_mode(
        instance: FmiInstance,
        tolerance_defined: bool,
        tolerance: f64,
        start_time: f64,
        stop_time_defined: bool,
        stop_time: f64,
    ) -> c_int;

    #[link_name = "{{ model_identifier }}_fmi3ExitInitializationMode"]
    fn kernel_exit_initialization_mode(instance: FmiInstance) -> c_int;

    #[link_name = "{{ model_identifier }}_fmi3Terminate"]
    fn kernel_terminate(instance: FmiInstance) -> c_int;

    #[link_name = "{{ model_identifier }}_fmi3Reset"]
    fn kernel_reset(instance: FmiInstance) -> c_int;

{% for method, suffix, ty in numeric_types %}
    #[link_name = "{{ model_identifier }}_fmi3Get{{ suffix }}"]
    fn kernel_get_{{ method }}(
        instance: FmiInstance,
        value_references: *const u32,
        n_value_references: usize,
        values: *mut {{ ty }},
        n_values: usize,
    ) -> c_int;

    #[link_name = "{{ model_identifier }}_fmi3Set{{ suffix }}"]
    fn kernel_set_{{ method }}(
        instance: FmiInstance,
        value_references: *const u32,
        n_value_references: usize,
        values: *const {{ ty }},
        n_values: usize,
    ) -> c_int;
{% endfor %}

    #[link_name = "{{ model_identifier }}_fmi3DoStep"]
    #[allow(clippy::too_many_arguments)]
    fn kernel_do_step(
        instance: FmiInstance,
        current_communication_point: f64,
        communication_step_size: f64,
        no_set_fmu_state_prior_to_current_point: bool,
        event_handling_needed: *mut bool,
        terminate_simulation: *mut bool,
        early_return: *mut bool,
        last_successful_time: *mut f64,
    ) -> c_int;
}

fn status_from(code: c_int) -> Status {
    match code {
        FMI3_OK => Status::Ok,
        FMI3_WARNING => Status::Warning,
        FMI3_DISCARD => Status::Discard,
        FMI3_FATAL => Status::Fatal,
        _ => Status::Error,
    }
}

/// The scalar count addressed by one value reference. The shared C accessor
/// validates the requested value type and lifecycle before accessing storage.
/// Derived from the same checked variable inventory the
/// kernel numbers its references from: time, then the variables in inventory
/// order, then one derivative per state, then the event indicators.
fn value_scalar_count(value_reference: u32) -> Option<usize> {
    match value_reference {
        0 => Some(1),
{%- for variable in fmi.variables %}
        {{ variable.value_reference_fmi3 }} => Some({{ variable.storage.scalar_count }}),
{%- endfor %}
{%- set deriv = namespace(ordinal=0) %}
{%- for variable in fmi.variables %}{% if variable.role == "State" %}
        {{ fmi.derivative_value_reference_base_fmi3 + deriv.ordinal }} => Some({{ variable.storage.scalar_count }}),
{%- set deriv.ordinal = deriv.ordinal + 1 %}{% endif %}{% endfor %}
{%- for root in fmi.event_indicator_roots %}
        {{ fmi.derivative_value_reference_base_fmi3 + deriv.ordinal + loop.index0 }} => Some(1),
{%- endfor %}
        _ => None,
    }
}

// ---------------------------------------------------------------------------
// co-simulation::co-simulation-instance resource
// ---------------------------------------------------------------------------

pub struct RumocaCoSimulationInstance {
    instance: FmiInstance,
    // The C instance borrows this stable allocation until kernel_free_instance.
    _log_context: Box<LogContext>,
}

struct LogContext {
    instance_name: String,
}

extern "C" fn forward_log_message(
    environment: *mut c_void,
    status: c_int,
    category: *const c_char,
    message: *const c_char,
) {
    // All three pointers come from the shared FMI kernel and its live context.
    let context = unsafe { &*environment.cast::<LogContext>() };
    let category = unsafe { CStr::from_ptr(category) }.to_string_lossy();
    let message = unsafe { CStr::from_ptr(message) }.to_string_lossy();
    fmi::fmi3::callbacks::log_message(
        &context.instance_name,
        status_from(status),
        &category,
        &message,
    );
}

impl RumocaCoSimulationInstance {
    fn get_numeric<T: Default + Clone>(
        &self,
        value_references: &[u32],
        getter: unsafe extern "C" fn(FmiInstance, *const u32, usize, *mut T, usize) -> c_int,
    ) -> Result<Vec<T>, Status> {
        let total = value_references.iter()
            .try_fold(0usize, |total, reference| {
                total.checked_add(value_scalar_count(*reference)?)
            })
            .ok_or(Status::Error)?;
        let mut values = vec![T::default(); total];
        let status = unsafe {
            getter(
                self.instance,
                value_references.as_ptr(),
                value_references.len(),
                values.as_mut_ptr(),
                total,
            )
        };
        if status == FMI3_OK {
            Ok(values)
        } else {
            Err(status_from(status))
        }
    }

    fn set_numeric<T>(
        &self,
        value_references: &[u32],
        values: &[T],
        setter: unsafe extern "C" fn(FmiInstance, *const u32, usize, *const T, usize) -> c_int,
    ) -> Status {
        status_from(unsafe {
            setter(
                self.instance,
                value_references.as_ptr(),
                value_references.len(),
                values.as_ptr(),
                values.len(),
            )
        })
    }
}

impl Drop for RumocaCoSimulationInstance {
    fn drop(&mut self) {
        unsafe { kernel_free_instance(self.instance) };
    }
}

impl GuestCoSimulationInstance for RumocaCoSimulationInstance {
    fn instantiate_co_simulation(
        instance_name: String,
        instantiation_token: String,
        resource_path: String,
        visible: bool,
        logging_on: bool,
        event_mode_used: bool,
        early_return_allowed: bool,
        required_intermediate_variables: Vec<u32>,
    ) -> Option<exports::fmi::fmi3::co_simulation::CoSimulationInstance> {
        let name = CString::new(instance_name.as_str()).ok()?;
        let token = CString::new(instantiation_token).ok()?;
        let resources = CString::new(resource_path).ok()?;
        let mut log_context = Box::new(LogContext { instance_name });
        let instance = unsafe {
            kernel_instantiate_cs(
                name.as_ptr(),
                token.as_ptr(),
                resources.as_ptr(),
                visible,
                logging_on,
                event_mode_used,
                early_return_allowed,
                required_intermediate_variables.as_ptr(),
                required_intermediate_variables.len(),
                (&mut *log_context as *mut LogContext).cast(),
                Some(forward_log_message),
                None,
            )
        };
        if instance.is_null() {
            return None;
        }
        Some(exports::fmi::fmi3::co_simulation::CoSimulationInstance::new(
            RumocaCoSimulationInstance { instance, _log_context: log_context },
        ))
    }

    fn set_debug_logging(&self, logging_on: bool, _categories: Vec<String>) -> Status {
        status_from(unsafe {
            kernel_set_debug_logging(self.instance, logging_on, 0, core::ptr::null())
        })
    }

    fn enter_initialization_mode(
        &self,
        tolerance: Option<f64>,
        start_time: f64,
        stop_time: Option<f64>,
    ) -> Status {
        status_from(unsafe {
            kernel_enter_initialization_mode(
                self.instance,
                tolerance.is_some(),
                tolerance.unwrap_or(0.0),
                start_time,
                stop_time.is_some(),
                stop_time.unwrap_or(0.0),
            )
        })
    }

    fn exit_initialization_mode(&self) -> Status {
        status_from(unsafe { kernel_exit_initialization_mode(self.instance) })
    }

    fn enter_event_mode(&self) -> Status {
        Status::Error
    }

    fn update_discrete_states(&self) -> Result<DiscreteStatesInfo, Status> {
        Err(Status::Error)
    }

    fn terminate(&self) -> Status {
        status_from(unsafe { kernel_terminate(self.instance) })
    }

    fn reset(&self) -> Status {
        status_from(unsafe { kernel_reset(self.instance) })
    }

    fn enter_configuration_mode(&self) -> Status {
        Status::Error
    }

    fn exit_configuration_mode(&self) -> Status {
        Status::Error
    }

{% for method, suffix, ty in numeric_types %}
    fn get_{{ method }}(&self, value_references: Vec<u32>) -> Result<Vec<{{ ty }}>, Status> {
        self.get_numeric(&value_references, kernel_get_{{ method }})
    }

    fn set_{{ method }}(&self, value_references: Vec<u32>, values: Vec<{{ ty }}>) -> Status {
        self.set_numeric(&value_references, &values, kernel_set_{{ method }})
    }
{% endfor %}

    // ── All other typed getters – outside this draft's mapped profile ────────

    fn get_float32(&self, _: Vec<u32>) -> Result<Vec<f32>,      Status> { Err(Status::Error) }
    fn get_int8   (&self, _: Vec<u32>) -> Result<Vec<i8>,       Status> { Err(Status::Error) }
    fn get_int16  (&self, _: Vec<u32>) -> Result<Vec<i16>,      Status> { Err(Status::Error) }
    fn get_uint8  (&self, _: Vec<u32>) -> Result<Vec<u8>,       Status> { Err(Status::Error) }
    fn get_uint16 (&self, _: Vec<u32>) -> Result<Vec<u16>,      Status> { Err(Status::Error) }
    fn get_uint32 (&self, _: Vec<u32>) -> Result<Vec<u32>,      Status> { Err(Status::Error) }
    fn get_uint64 (&self, _: Vec<u32>) -> Result<Vec<u64>,      Status> { Err(Status::Error) }
    fn get_string (&self, _: Vec<u32>) -> Result<Vec<String>,   Status> { Err(Status::Error) }
    fn get_binary (&self, _: Vec<u32>) -> Result<Vec<Vec<u8>>,  Status> { Err(Status::Error) }
    fn get_clock  (&self, _: Vec<u32>) -> Result<Vec<bool>,     Status> { Err(Status::Error) }

    // ── All other typed setters – outside this draft's mapped profile ────────

    fn set_float32(&self, _: Vec<u32>, _: Vec<f32>)     -> Status { Status::Error }
    fn set_int8   (&self, _: Vec<u32>, _: Vec<i8>)      -> Status { Status::Error }
    fn set_int16  (&self, _: Vec<u32>, _: Vec<i16>)     -> Status { Status::Error }
    fn set_uint8  (&self, _: Vec<u32>, _: Vec<u8>)      -> Status { Status::Error }
    fn set_uint16 (&self, _: Vec<u32>, _: Vec<u16>)     -> Status { Status::Error }
    fn set_uint32 (&self, _: Vec<u32>, _: Vec<u32>)     -> Status { Status::Error }
    fn set_uint64 (&self, _: Vec<u32>, _: Vec<u64>)     -> Status { Status::Error }
    fn set_string (&self, _: Vec<u32>, _: Vec<String>)  -> Status { Status::Error }
    fn set_binary (&self, _: Vec<u32>, _: Vec<Vec<u8>>) -> Status { Status::Error }
    fn set_clock  (&self, _: Vec<u32>, _: Vec<bool>)    -> Status { Status::Error }

    fn get_number_of_variable_dependencies(&self, _vr: u32) -> Result<u64, Status> {
        Err(Status::Error)
    }

    fn get_variable_dependencies(
        &self,
        _dependent: u32,
    ) -> Result<Vec<VariableDependency>, Status> {
        Err(Status::Error)
    }

    fn get_fmu_state(&self) -> Result<Vec<u8>, Status> {
        Err(Status::Error)
    }

    fn set_fmu_state(&self, _state: Vec<u8>) -> Status {
        Status::Error
    }

    fn get_directional_derivative(
        &self,
        _unknowns: Vec<u32>,
        _knowns:   Vec<u32>,
        _seed:     Vec<f64>,
    ) -> Result<Vec<f64>, Status> {
        Err(Status::Error)
    }

    fn get_adjoint_derivative(
        &self,
        _unknowns: Vec<u32>,
        _knowns:   Vec<u32>,
        _seed:     Vec<f64>,
    ) -> Result<Vec<f64>, Status> {
        Err(Status::Error)
    }

    fn get_interval_decimal(&self, _: Vec<u32>) -> Result<Vec<(f64, IntervalQualifier)>, Status> {
        Err(Status::Error)
    }
    fn get_interval_fraction(&self, _: Vec<u32>) -> Result<Vec<(IntervalFraction, IntervalQualifier)>, Status> {
        Err(Status::Error)
    }
    fn get_shift_decimal(&self, _: Vec<u32>) -> Result<Vec<f64>, Status> {
        Err(Status::Error)
    }
    fn get_shift_fraction(&self, _: Vec<u32>) -> Result<Vec<IntervalFraction>, Status> {
        Err(Status::Error)
    }
    fn set_interval_decimal(&self, _: Vec<u32>, _: Vec<f64>) -> Status {
        Status::Error
    }
    fn set_interval_fraction(&self, _: Vec<u32>, _: Vec<IntervalFraction>) -> Status {
        Status::Error
    }
    fn set_shift_decimal(&self, _: Vec<u32>, _: Vec<f64>) -> Status {
        Status::Error
    }
    fn set_shift_fraction(&self, _: Vec<u32>, _: Vec<IntervalFraction>) -> Status {
        Status::Error
    }
    fn evaluate_discrete_states(&self) -> Status {
        Status::Error
    }

    fn do_step(
        &self,
        current_communication_point: f64,
        communication_step_size:     f64,
        no_set_fmu_state_prior_to_current_point: bool,
    ) -> Result<DoStepResult, Status> {
        let mut event_handling_needed = false;
        let mut terminate_simulation = false;
        let mut early_return = false;
        let mut last_successful_time = current_communication_point;
        let status = unsafe {
            kernel_do_step(
                self.instance,
                current_communication_point,
                communication_step_size,
                no_set_fmu_state_prior_to_current_point,
                &mut event_handling_needed,
                &mut terminate_simulation,
                &mut early_return,
                &mut last_successful_time,
            )
        };
        if status == FMI3_OK {
            Ok(DoStepResult {
                last_successful_time,
                event_handling_needed,
                terminate_simulation,
                early_return,
            })
        } else {
            Err(status_from(status))
        }
    }

    fn set_input_derivatives(
        &self,
        _requests: Vec<(u32, u32)>,
        _values:   Vec<f64>,
    ) -> Status {
        Status::Error
    }

    fn get_output_derivatives(
        &self,
        _requests: Vec<(u32, u32)>,
    ) -> Result<Vec<f64>, Status> {
        Err(Status::Error)
    }

    fn enter_step_mode(&self) -> Status {
        Status::Error
    }
}

// ---------------------------------------------------------------------------
// World binding
// ---------------------------------------------------------------------------

struct RumocaFmu;

impl CommonGuest for RumocaFmu {
    fn get_version() -> String {
        let version = unsafe { core::ffi::CStr::from_ptr(kernel_get_version()) };
        version.to_string_lossy().into_owned()
    }
}

impl CoSimulationGuest for RumocaFmu {
    type CoSimulationInstance = RumocaCoSimulationInstance;
}

export!(RumocaFmu);
