{#- Every emitted C identifier comes from the single symbol policy in
    `embedded-c-galec/symbols.jinja`, registered here as
    `galec-c-symbols.jinja` and shared by the header, the source, and the
    Production Code manifest. This template declares no reserved list and no
    allocation of its own: a second declaration site is what renames the same
    variable differently across artifacts. -#}
{%- import "galec-c-symbols.jinja" as c_symbol_policy -%}
{%- set c_symbols = c_symbol_policy.symbols -%}
{%- set c_state_symbols = c_symbol_policy.state_symbols -%}
{%- set c_model = symbol(c_symbols, algorithm_code.block_name) -%}
{%- macro attr(name, value) -%}{{ " " }}{{ name }}="{{ value | xml_escape }}"{%- endmacro -%}
{%- macro type_id(kind) -%}{% if kind == "real" %}TD_F32{% elif kind == "integer" %}TD_I32{% elif kind == "boolean" %}TD_BOOL{% else %}{{ fail_closed_scalar_type }}{% endif %}{%- endmacro -%}
{#- The block's working memory is deliberately ABSENT from this manifest. It is
    a translation-unit-private object, not a member of the block state and not
    interface: `LogicalData` exists to map the block's inputs, outputs,
    parameters and states onto code, and one generated function's intermediate
    row buffer is none of those. There is no Algorithm Code variable behind a
    scratch slot for a `DataReference` to name, and no consumer may bind to one,
    so describing them here would have added hundreds of `Component` and
    `Dimension` elements that document nothing a reader may act on. -#}
{%- macro function(id, name, return_id, self_id) %}
          <Function{{ attr("id", id) }}{{ attr("name", name) }}>
            <ReturnParameter{{ attr("id", return_id) }} typeDefRefId="TD_VOID"/>
            <FormalParameters>
              <FormalParameter name="self" number="0"{{ attr("id", self_id) }} typeDefRefId="TD_STATE" pointer="true"/>
            </FormalParameters>
          </Function>
{%- endmacro -%}
<?xml version="1.0" encoding="UTF-8"?>
<Manifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../schemas/ProductionCode/efmiProductionCodeManifest.xsd" xsdVersion="0.17.0" kind="ProductionCode" efmiVersion="1.0.0"{{ attr("id", "{" ~ artifact.identities.pc_manifest ~ "}") }}{{ attr("name", algorithm_code.block_name) }}{{ attr("generationDateAndTime", artifact.generated_at) }}{{ attr("generationTool", artifact.generation_tool) }}>
  <ManifestReferences>
    <ManifestReference id="MR_AC"{{ attr("manifestRefId", "{" ~ artifact.identities.ac_manifest ~ "}") }}{{ attr("checksum", artifact.checksums.ac_manifest_sha1) }} origin="true"/>
  </ManifestReferences>
  <Files>
    <File id="F_H"{{ attr("name", model_name ~ ".h") }} path="./" needsChecksum="true"{{ attr("checksum", artifact.checksums.c_header_sha1) }} role="Code"/>
    <File id="F_C"{{ attr("name", model_name ~ ".c") }} path="./" needsChecksum="true"{{ attr("checksum", artifact.checksums.c_source_sha1) }} role="Code"/>
    <File id="F_KH" name="rumoca_galec_kernels.h" path="./" needsChecksum="true"{{ attr("checksum", artifact.checksums.c_kernels_header_sha1) }} role="Code"/>
    <File id="F_KC" name="rumoca_galec_kernels.c" path="./" needsChecksum="true"{{ attr("checksum", artifact.checksums.c_kernels_source_sha1) }} role="Code"/>
    <File id="F_FMT" name=".clang-format" path="./" needsChecksum="true"{{ attr("checksum", artifact.checksums.c_format_sha1) }} role="other" description="clang-format configuration the generated C already satisfies; reformatting with any other style invalidates the code-file checksums above"/>
  </Files>
  <CodeContainer language="C" standard="C99" platform="Legacy" floatPrecision="32-bit">
    <Target>Generic</Target>
    <TargetTypes>
      <TargetType id="TT_F32" kind="efmiFloat32" codedType="float"/>
      <TargetType id="TT_I32" kind="efmiInteger32" codedType="int32_t"/>
      <TargetType id="TT_BOOL" kind="efmiBool" codedType="bool"/>
      <TargetType id="TT_U32" kind="efmiUnsignedInteger32" codedType="uint32_t"/>
      <TargetType id="TT_VOID" kind="efmiVoid" codedType="void"/>
    </TargetTypes>
    <CodeFiles>
      <CodeFile id="CF_H" fileType="ProductionCode" codeType="HeaderFile">
        <FileReference fileRefId="F_H"/>
        <Typedefs>
          <Typedef id="TD_F32" name="float"><Alias targetTypeRefId="TT_F32"/></Typedef>
          <Typedef id="TD_I32" name="int32_t"><Alias targetTypeRefId="TT_I32"/></Typedef>
          <Typedef id="TD_BOOL" name="bool"><Alias targetTypeRefId="TT_BOOL"/></Typedef>
          <Typedef id="TD_U32" name="uint32_t"><Alias targetTypeRefId="TT_U32"/></Typedef>
          <Typedef id="TD_VOID" name="void"><Alias targetTypeRefId="TT_VOID"/></Typedef>
          <Typedef id="TD_STATE"{{ attr("name", c_model ~ "State") }}>
            <Components>
{%- for variable in algorithm_code.variables %}
              <Component{{ attr("id", "CO_" ~ variable.ordinal) }}{{ attr("name", symbol(c_state_symbols, variable.name)) }}{{ attr("typeDefRefId", type_id(variable.kind)) }}
{%- if variable.dimensions|length == 0 %}/>
{%- else %}>
                <Dimensions>
{%- for size in variable.dimensions %}
                  <Dimension number="{{ loop.index0 }}" size="{{ size }}"/>
{%- endfor %}
                </Dimensions>
              </Component>
{%- endif %}
{%- endfor %}
              <Component id="CO_ERROR_SIGNAL_STATUS" name="rumoca_galec_error_signal_status" typeDefRefId="TD_U32"/>
            </Components>
          </Typedef>
        </Typedefs>
      </CodeFile>
      <CodeFile id="CF_KH" fileType="ProductionCode" codeType="HeaderFile">
        <FileReference fileRefId="F_KH"/>
      </CodeFile>
      <CodeFile id="CF_KC" fileType="ProductionCode" codeType="SourceFile">
        <FileReference fileRefId="F_KC"/>
        <Includes><Include codeFileRefId="CF_KH"/></Includes>
      </CodeFile>
      <CodeFile id="CF_C" fileType="ProductionCode" codeType="SourceFile">
        <FileReference fileRefId="F_C"/>
        <Includes><Include codeFileRefId="CF_H"/><Include codeFileRefId="CF_KH"/></Includes>
        <Functions>
{{ function("FN_STARTUP", c_model ~ "_startup", "RP_STARTUP", "FP_STARTUP_SELF") }}
{{ function("FN_RECALIBRATE", c_model ~ "_recalibrate", "RP_RECALIBRATE", "FP_RECALIBRATE_SELF") }}
{{ function("FN_DOSTEP", c_model ~ "_dostep", "RP_DOSTEP", "FP_DOSTEP_SELF") }}
        </Functions>
      </CodeFile>
    </CodeFiles>
    <LogicalData>
      <DataReferences>
{%- for variable in algorithm_code.variables %}
        <DataReference>
          <ForeignVariableReference manifestReferenceRefId="MR_AC"{{ attr("foreignRefId", "V" ~ variable.ordinal) }}/>
          <FormalParameter formalParameterRefId="FP_DOSTEP_SELF"{{ attr("componentIdentifier", symbol(c_state_symbols, variable.name)) }}/>
        </DataReference>
{%- endfor %}
        <DataReference>
          <ForeignVariableReference manifestReferenceRefId="MR_AC" foreignRefId="ESS"/>
          <FormalParameter formalParameterRefId="FP_DOSTEP_SELF" componentIdentifier="rumoca_galec_error_signal_status"/>
        </DataReference>
      </DataReferences>
      <FunctionReferences>
        <FunctionReference><ForeignFunctionReference manifestReferenceRefId="MR_AC" foreignRefId="BM_STARTUP"/><GlobalFunction functionRefId="FN_STARTUP"/></FunctionReference>
        <FunctionReference><ForeignFunctionReference manifestReferenceRefId="MR_AC" foreignRefId="BM_RECALIBRATE"/><GlobalFunction functionRefId="FN_RECALIBRATE"/></FunctionReference>
        <FunctionReference><ForeignFunctionReference manifestReferenceRefId="MR_AC" foreignRefId="BM_DOSTEP"/><GlobalFunction functionRefId="FN_DOSTEP"/></FunctionReference>
      </FunctionReferences>
    </LogicalData>
  </CodeContainer>
</Manifest>
