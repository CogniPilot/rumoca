def _build_rhs():
	t = ca.MX.sym('t')
	x = ca.MX.sym('x', N_Y)
	u = ca.MX.sym('u', N_U)
	p = ca.MX.sym('p', N_P)
	# Compiled parameter vector the bytecode indexes: [params, inputs, pad].
	_parts = [p, u]
	if _PAD > 0:
		_parts.append(ca.MX.zeros(_PAD))
	P = ca.vertcat(*_parts)
