def _linsolve_component(matrix, rhs, n, component):
	"""Solve A x = b (A row-major n*n) and return x[component]; symbolic-safe."""
	A = ca.reshape(ca.vertcat(*matrix), n, n).T
	b = ca.vertcat(*rhs)
	return ca.solve(A, b)[component]



def init_params(p):
	"""Compute the parameters defined by other parameters (e.g. a weight matrix
	built from scalar parameters) from the base parameters in p (length N_P).
	Returns the completed parameter list. Call after changing any parameter,
	before rhs: p = init_params(DEFAULT_P)."""
	P = [float(v) for v in p] + [0.0] * (N_P_COMPILED - N_P)
