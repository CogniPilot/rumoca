{%- macro scalar_const(op) -%}
{%- if op.value_class == "finite" -%}{{ op.value }}
{%- elif op.value_class == "positive_infinity" -%}inf
{%- elif op.value_class == "negative_infinity" -%}(-inf)
{%- else -%}nan
{%- endif -%}
{%- endmacro %}
{%- macro unary(operator, arg) -%}
{%- if operator == "Neg" -%}(-__r{{ arg }})
{%- elif operator == "Not" -%}if_else(__r{{ arg }} == 0.0, 1.0, 0.0)
{%- elif operator == "Abs" -%}fabs(__r{{ arg }})
{%- elif operator == "Sign" -%}sign(__r{{ arg }})
{%- elif operator in ["Sqrt", "Floor", "Ceil", "Trunc", "Sin", "Cos", "Tan", "Asin", "Acos", "Atan", "Sinh", "Cosh", "Tanh", "Exp", "Log", "Log10"] -%}{{ operator | lower }}(__r{{ arg }})
{%- else -%}{{ fail("unsupported-feature:scalar.unary." ~ operator) }}
{%- endif -%}
{%- endmacro %}
{%- macro binary(operator, lhs, rhs) -%}
{%- if operator == "Add" -%}(__r{{ lhs }} + __r{{ rhs }})
{%- elif operator == "Sub" -%}(__r{{ lhs }} - __r{{ rhs }})
{%- elif operator == "Mul" -%}(__r{{ lhs }} * __r{{ rhs }})
{%- elif operator == "Div" -%}(__r{{ lhs }} / __r{{ rhs }})
{%- elif operator == "Pow" -%}(__r{{ lhs }} ** __r{{ rhs }})
{%- elif operator == "And" -%}if_else(logical_and(__r{{ lhs }} != 0.0, __r{{ rhs }} != 0.0), 1.0, 0.0)
{%- elif operator == "Or" -%}if_else(logical_or(__r{{ lhs }} != 0.0, __r{{ rhs }} != 0.0), 1.0, 0.0)
{%- elif operator == "Atan2" -%}atan2(__r{{ lhs }}, __r{{ rhs }})
{%- elif operator == "Min" -%}fmin(__r{{ lhs }}, __r{{ rhs }})
{%- elif operator == "Max" -%}fmax(__r{{ lhs }}, __r{{ rhs }})
{%- else -%}{{ fail("unsupported-feature:scalar.binary." ~ operator) }}
{%- endif -%}
{%- endmacro %}
{%- macro compare(operator, lhs, rhs) -%}
{%- if operator == "Lt" -%}(__r{{ lhs }} < __r{{ rhs }})
{%- elif operator == "Le" -%}(__r{{ lhs }} <= __r{{ rhs }})
{%- elif operator == "Gt" -%}(__r{{ lhs }} > __r{{ rhs }})
{%- elif operator == "Ge" -%}(__r{{ lhs }} >= __r{{ rhs }})
{%- elif operator == "Eq" -%}(__r{{ lhs }} == __r{{ rhs }})
{%- elif operator == "Ne" -%}(__r{{ lhs }} != __r{{ rhs }})
{%- else -%}{{ fail("unsupported-feature:scalar.compare." ~ operator) }}
{%- endif -%}
{%- endmacro %}
{%- macro scalar_op(op) %}
{%- if op.kind == "Const" %}
	__r{{ op.dst }} = {{ scalar_const(op) }}
{%- elif op.kind == "LoadTime" %}
	__r{{ op.dst }} = t
{%- elif op.kind == "LoadY" %}
	__r{{ op.dst }} = x[{{ op.index }}]
{%- elif op.kind == "LoadP" %}
	__r{{ op.dst }} = P[{{ op.index }}]
{%- elif op.kind == "Move" %}
	__r{{ op.dst }} = __r{{ op.src }}
{%- elif op.kind == "LinearSolveComponent" %}
	__r{{ op.dst }} = _linsolve_component(
		[{% for index in range(op.matrix_start, op.matrix_start + op.n * op.n) %}__r{{ index }}{{ ", " if not loop.last else "" }}{% endfor %}],
		[{% for index in range(op.rhs_start, op.rhs_start + op.n) %}__r{{ index }}{{ ", " if not loop.last else "" }}{% endfor %}],
		{{ op.n }}, {{ op.component }})
{%- elif op.kind == "Unary" %}
	__r{{ op.dst }} = {{ unary(op.operator, op.arg) }}
{%- elif op.kind == "Binary" %}
	__r{{ op.dst }} = {{ binary(op.operator, op.lhs, op.rhs) }}
{%- elif op.kind == "Compare" %}
	__r{{ op.dst }} = {{ compare(op.operator, op.lhs, op.rhs) }}
{%- elif op.kind == "Select" %}
	__r{{ op.dst }} = if_else(__r{{ op.cond }}, __r{{ op.if_true }}, __r{{ op.if_false }})
{%- elif op.kind == "StoreOutput" %}
	out[{{ op.output_index }}] = __r{{ op.src }}
{%- elif op.kind == "StoreOutputRange" %}
{%- for output_index in op.output_indices %}
	out[{{ output_index }}] = __r{{ op.start + loop.index0 * op.stride }}
{%- endfor %}
{%- else %}
{{ fail("unsupported-feature:scalar.op." ~ op.kind) }}
{%- endif %}
{%- endmacro %}
# Generated by Rumoca - CasADi solve-IR export
#
# Standalone explicit ODE right-hand side  xdot = rhs(t, x, u, p)  built directly
# from the scalarized, causalized solve IR (the same source the C / FMI / Rust
# backends use). No DAE residual, no algebraic projection, no rootfinder.
#
#   x : state vector           ({{ solve.solve_layout.state_scalar_count }})
#   u : control inputs         ({{ solve.solve_layout.input_scalar_names | length }})
#   p : model parameter vector ({{ solve.solve_layout.parameter_count }}, model-declaration order)
#   xdot = d/dt(x)             ({{ solve_blocks.continuous.derivative_rhs.output_count }})
#
# rhs is a ca.Function, so it is differentiable, serializable, and composable.

import casadi as ca

# Bare-name math aliases bound to the CasADi namespace for the solve dialect.
sin = ca.sin; cos = ca.cos; tan = ca.tan
asin = ca.asin; acos = ca.acos; atan = ca.atan
sinh = ca.sinh; cosh = ca.cosh; tanh = ca.tanh
exp = ca.exp; log = ca.log; log10 = ca.log10; sqrt = ca.sqrt
fabs = ca.fabs; sign = ca.sign; floor = ca.floor; ceil = ca.ceil
trunc = lambda value: ca.if_else(value < 0.0, ca.ceil(value), ca.floor(value))
atan2 = ca.atan2; fmin = ca.fmin; fmax = ca.fmax
if_else = ca.if_else; logical_and = ca.logic_and; logical_or = ca.logic_or
inf = ca.inf; nan = float("nan")

{% set n_y = solve.solve_layout.state_scalar_count -%}
N_Y = {{ n_y }}
N_U = {{ solve.solve_layout.input_scalar_names | length }}
N_P = {{ solve.solve_layout.parameter_count }}
N_P_COMPILED = {{ solve.solve_layout.compiled_parameter_len }}
_PAD = N_P_COMPILED - N_P - N_U

STATE_NAMES = [{% for name in solve.state_names %}'{{ name }}'{{ ", " if not loop.last else "" }}{% endfor %}]
INPUT_NAMES = [{% for name in solve.solve_layout.input_scalar_names %}'{{ name }}'{{ ", " if not loop.last else "" }}{% endfor %}]
# Static storage is grouped by role by the checked Solve layout.
PARAM_NAMES = [{% for name in solve.static_parameter_names %}'{{ name }}'{{ ", " if not loop.last else "" }}{% endfor %}]
DEFAULT_X = [{% for value in solve.initial_state_values %}{{ value }}{{ ", " if not loop.last else "" }}{% endfor %}]
DEFAULT_P = [{% for value in solve.static_parameter_values %}{{ value }}{{ ", " if not loop.last else "" }}{% endfor %}]


def _linsolve_component(matrix, rhs, n, component):
	"""Solve A x = b (A row-major n*n) and return x[component]; symbolic-safe."""
	A = ca.reshape(ca.vertcat(*matrix), n, n).T
	b = ca.vertcat(*rhs)
	return ca.solve(A, b)[component]


def _build_rhs():
	t = ca.SX.sym('t')
	x = ca.SX.sym('x', N_Y)
	u = ca.SX.sym('u', N_U)
	p = ca.SX.sym('p', N_P)
	# Compiled parameter vector the bytecode indexes: [params, inputs, pad].
	_parts = [p, u]
	if _PAD > 0:
		_parts.append(ca.SX.zeros(_PAD))
	P = ca.vertcat(*_parts)
	out = [None] * {{ solve_blocks.continuous.derivative_rhs.output_count }}
{%- for program in solve_blocks.continuous.derivative_rhs.scalar_plan.programs %}
{%- for op in program.ops %}
{{ scalar_op(op) }}
{%- endfor %}
{%- endfor %}
	xdot = ca.vertcat(*out)
	return ca.Function('rhs', [t, x, u, p], [xdot], ['t', 'x', 'u', 'p'], ['xdot'])


rhs = _build_rhs()


if __name__ == '__main__':
	import numpy as np
	print(f"rhs: {rhs}")
	print(f"  states ({N_Y}): {STATE_NAMES}")
	print(f"  inputs ({N_U}): {INPUT_NAMES}")
	print(f"  params: {N_P}")
	xdot0 = np.array(rhs(0.0, np.zeros(N_Y), np.zeros(N_U), np.zeros(N_P))).reshape(-1)
	print(f"  rhs(0, 0, 0, 0) = {xdot0}")
