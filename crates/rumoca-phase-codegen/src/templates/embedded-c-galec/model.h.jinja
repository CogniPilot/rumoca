{#- Every emitted C identifier comes from the single symbol policy in
    `embedded-c-galec/symbols.jinja`, registered here as
    `galec-c-symbols.jinja` and shared by the header, the source, and the
    Production Code manifest. This template declares no reserved list and no
    allocation of its own: a second declaration site is what renames the same
    variable differently across artifacts. -#}
{%- import "galec-c-symbols.jinja" as c_symbol_policy -%}
{%- set c_symbols = c_symbol_policy.symbols -%}
{%- set c_state_symbols = c_symbol_policy.state_symbols -%}
{%- set c_model = symbol(c_symbols, algorithm_code.block_name) -%}
{%- macro c_type(kind) -%}
{%- if kind == "real" -%}float{%- elif kind == "integer" -%}int32_t{%- elif kind == "boolean" -%}bool{%- else -%}{{ fail_closed_scalar_type }}{%- endif -%}
{%- endmacro -%}
{% block conformance %}/* {{ algorithm_code.block_name | replace("*/", "* /") | replace("/*", "/ *") }}
 * GALEC-derived embedded C export (SPEC_0034 GAL-024).
 * NOT an eFMI Production Code container.
 * Designed for the MISRA C:2023 assurance profile in SPEC_0034 GAL-029/030.
 * MISRA compliance and DO-178C compliance are not claimed.
 * Target syntax and layout are owned by this template. */{% endblock %}
#ifndef RUMOCA_{{ c_model | upper }}_GALEC_H_INCLUDED
#define RUMOCA_{{ c_model | upper }}_GALEC_H_INCLUDED

#include <stdbool.h>
#include <stdint.h>

typedef struct {{ c_model }}StateTag {
{%- for variable in algorithm_code.variables %}
    {{ c_type(variable.kind) }} {{ symbol(c_state_symbols, variable.name) }}{% for size in variable.dimensions %}[{{ size }}]{% endfor %}; /* declaration {{ variable.ordinal }}: {{ variable.name | replace("*/", "* /") | replace("/*", "/ *") }} ({{ variable.causality }}) */
{%- endfor %}
    uint32_t rumoca_galec_error_signal_status; /* eFMI ErrorSignalStatus */
} {{ c_model }}State;

void {{ c_model }}_startup({{ c_model }}State *self);
void {{ c_model }}_recalibrate({{ c_model }}State *self);
void {{ c_model }}_dostep({{ c_model }}State *self);

#endif
