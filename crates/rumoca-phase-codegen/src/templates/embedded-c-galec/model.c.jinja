/* GALEC Beta-1 `integer`: truncate toward zero, return zero after signaling
 * NAN or OVERFLOW, and never execute an out-of-range C conversion. The DAE to
 * GALEC projection applies `roundDown` first for Modelica's floor semantics. */
static inline int32_t rumoca_galec_integer(uint32_t *signals, float value) {
    int32_t result = INT32_C(0);
    if (isnan(value)) {
        *signals |= UINT32_C(4); /* NAN */
    } else if ((value < -0x1p31f) || (value >= 0x1p31f)) {
        *signals |= UINT32_C(2); /* OVERFLOW */
    } else {
        result = (int32_t)value;
