    /* Never taken: keeps the fault exit referenced in a method that cannot fault. */
    if (rumoca_galec_status != 0u) { goto rumoca_galec_fault; }
{%- set run = namespace(previous="", status=[]) %}
{%- for k in range(6) %}{% set run.status = run.status + ["(&ctx->rumoca_galec_st[" ~ k ~ "])"] %}{% endfor %}
{% filter indent(4, true) %}{{ program(prog, "ctx->rumoca_galec_", "method", [], [], "goto rumoca_galec_fault;", run) }}{% endfilter %}
    for (size_t k = 0; k < 6u; ++k) { if (ctx->rumoca_galec_st[k]) { rumoca_galec_status |= (uint32_t)1u << k; } }
    self->rumoca_galec_error_signal_status = rumoca_galec_status;
    return;
