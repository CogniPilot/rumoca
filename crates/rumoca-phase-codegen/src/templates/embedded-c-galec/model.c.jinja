static inline int32_t rumoca_galec_bounded_index(int32_t value, int32_t extent) {
    int32_t result = extent - INT32_C(1);
    if ((value >= INT32_C(1)) && (value <= extent)) {
        result = value - INT32_C(1);
    }
    return result;
}
{%- endif %}

{%- if algorithm_code.package.block.semantic_uses.sign %}
static inline float rumoca_galec_sign(float value) {
    float result = 0.0f;
    if (value > 0.0f) {
        result = 1.0f;
    } else if (value < 0.0f) {
        result = -1.0f;
    } else {
        result = 0.0f;
    }
    return result;
}
{%- endif %}
