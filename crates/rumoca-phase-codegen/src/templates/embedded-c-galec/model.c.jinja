{% block conformance %}/* {{ algorithm_code.block_name | replace("*/", "* /") | replace("/*", "/ *") }}
 * GALEC-derived embedded C export (SPEC_0034 GAL-024). */{% endblock %}
#include "{{ model_name }}.h"

#include <math.h>

#define rumoca_galec_sign(x) ((x) > 0.0 ? 1.0 : ((x) < 0.0 ? -1.0 : 0.0))
/* GALEC Real min/max select by a relational comparison. C99 fmin/fmax
 * instead discard one qNaN operand, so they are not semantic substitutes.
 * Functions also guarantee that each argument is evaluated exactly once. */
static inline double rumoca_galec_min(double u1, double u2) {
    return u1 < u2 ? u1 : u2;
}
static inline double rumoca_galec_max(double u1, double u2) {
    return u1 > u2 ? u1 : u2;
}
#define rumoca_galec_imin(a, b) ((a) < (b) ? (a) : (b))
#define rumoca_galec_imax(a, b) ((a) > (b) ? (a) : (b))
#define rumoca_galec_division_towards_zero(a, b) ((a) / (b))

