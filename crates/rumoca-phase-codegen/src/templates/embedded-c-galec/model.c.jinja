    for (size_t k = 0; k < 6u; ++k) { if (ctx->rumoca_galec_st[k]) { rumoca_galec_status |= (uint32_t)1u << k; } }
{%- if backup %}
{%- for variable in algorithm_code.variables %}
    memcpy(&self->{{ symbol(c_state_symbols, variable.name) }}, &scratch->methods.startup.backup.{{ symbol(c_state_symbols, variable.name) }}, sizeof self->{{ symbol(c_state_symbols, variable.name) }});
{%- endfor %}
{%- endif %}
    self->rumoca_galec_error_signal_status = rumoca_galec_status | RUMOCA_GALEC_FAULT;
}
{% endmacro -%}

