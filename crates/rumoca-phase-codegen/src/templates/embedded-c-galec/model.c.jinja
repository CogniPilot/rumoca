/* GALEC `sign`: -1, 0, or +1. */
static inline float rumoca_galec_sign(float value) {
    float result = 0.0f;
    if (value > 0.0f) {
        result = 1.0f;
    } else if (value < 0.0f) {
        result = -1.0f;
    } else {
        result = 0.0f;
    }
    return result;
}
