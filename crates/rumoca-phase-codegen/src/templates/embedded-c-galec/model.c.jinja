{#- #483: the block methods printed from the refined Solve algorithm block
    (DAE → GALEC → Solve IR → C). The header, struct and field names are
    `model.h.jinja`'s, through the same symbol policy; only the bodies come
    from Solve.

    Every Solve register and temporary array is a member of its owner's frame
    in the instance-owned scratch (`galec-solve-c.jinja` lists them), reached
    as `ctx->...`; block slots are struct fields, and regions are inline C
    blocks. Only scalar temporaries live on the stack. Integer values
    compute in int64_t and fault outside the profile's domain; a fault jumps
    to the method's fault exit, which keeps what was stored (Recalibrate,
    DoStep) or restores the backup taken in scratch (Startup) and sets bit 31 of the
    status word. Every identifier this file invents carries the
    `rumoca_galec_` prefix the symbol allocator never hands out. -#}
{%- import "galec-c-symbols.jinja" as c_symbol_policy -%}
{%- from "galec-solve-c.jinja" import ctype, count -%}
{%- set c_symbols = c_symbol_policy.symbols -%}
{%- set c_state_symbols = c_symbol_policy.state_symbols -%}
{%- set c_model = symbol(c_symbols, algorithm_code.block_name) -%}
{#- The ABI stores Real as float and Integer as int32_t: only the
    binary32/signed32 profile refines into it. -#}
{%- if solve_block.arithmetic.real_format != "binary32" -%}{{ fail("unsupported-feature:embedded-c-solve:real-format") }}{%- endif -%}
{%- set integers = solve_block.arithmetic.integer_domain -%}
{%- if integers.minimum|string != "-2147483648" or integers.maximum|string != "2147483647" -%}{{ fail("unsupported-feature:embedded-c-solve:integer-domain") }}{%- endif -%}
{%- set fields = namespace(names=[]) -%}
{%- for slot in solve_block.slots -%}
{%- set fields.names = fields.names + [symbol(c_state_symbols, slot.name) if slot.status_bit is none else ""] -%}
{%- endfor -%}
{%- set field_names = fields.names -%}
{#- Traceability (SPEC_0034 GAL-032), in the GALEC-derived export's format:
    paths relative to the traced files' common root, and a trace comment that
    opens a run, printed when an operation's anchor differs from the previous
