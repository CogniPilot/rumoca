{%- if variable.kind == "real" -%}{% set text = variable.real_min | binary32_bound("min") %}{% if text is not none %}{{ text }}f{% endif %}
{%- elif variable.kind == "integer" -%}{% set text = variable.integer_min | int32_bound("min") %}{% if text is not none %}INT32_C({{ text }}){% endif %}
{%- endif -%}
{%- endmacro -%}
{%- macro high_bound(variable) -%}
{%- if variable.kind == "real" -%}{% set text = variable.real_max | binary32_bound("max") %}{% if text is not none %}{{ text }}f{% endif %}
{%- elif variable.kind == "integer" -%}{% set text = variable.integer_max | int32_bound("max") %}{% if text is not none %}INT32_C({{ text }}){% endif %}
{%- endif -%}
{%- endmacro -%}
{#- Nonempty exactly when this variable still saturates in the target domain.
