 * Functions also guarantee that each argument is evaluated exactly once. */
{%- endif %}
{%- if algorithm_code.package.block.semantic_uses.real_min %}
static inline float rumoca_galec_min(float u1, float u2) {
    float result = u2;
    if (u1 < u2) {
        result = u1;
    }
    return result;
}
{%- endif %}
{%- if algorithm_code.package.block.semantic_uses.real_max %}
static inline float rumoca_galec_max(float u1, float u2) {
