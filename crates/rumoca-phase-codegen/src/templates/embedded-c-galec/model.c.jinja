{#- Every emitted C identifier comes from the single symbol policy in
    `embedded-c-galec/symbols.jinja`, registered here as
    `galec-c-symbols.jinja` and shared by the header, the source, and the
    Production Code manifest. This template declares no reserved list and no
    allocation of its own: a second declaration site is what renames the same
    variable differently across artifacts. -#}
{%- import "galec-c-symbols.jinja" as c_symbol_policy -%}
{%- set c_symbols = c_symbol_policy.symbols -%}
{%- set c_state_symbols = c_symbol_policy.state_symbols -%}
{%- set c_model = symbol(c_symbols, algorithm_code.block_name) -%}
{#- The directory every traced Modelica path is printed relative to. It is the
    longest prefix all of them share, and it is subtracted rather than printed:
    a build-machine path in the emitted C would make the file — and the SHA-1
    the manifest records for it — depend on where the source tree happens to
    live, which is exactly the property configuration management needs the
    generated code NOT to have. `none` means the traced files share no
    directory (sources from unrelated trees) and the paths stay absolute. -#}
{%- set trace_root = algorithm_code.traces.root -%}
{#- The block's working memory, decided in the checked view and printed here.
    `groups` are the overlay groups in declaration order — which regions share
    storage, and why, is settled in `views/algorithm_code_typed.rs`; this file
    spells the result and performs no layout reasoning of its own.
    `region_groups` maps a callee's SOURCE name to its group, which is what a
    call site has to hand when it reads the callee's outputs back. -#}
{%- set scratch_layout = algorithm_code.package.block.scratch_layout -%}
{%- set scratch_groups = scratch_layout.region_groups -%}
{#- The member one region occupies in its group's union, and the suffix of its
    own struct type. A user function contributes its allocated C name; a block
    method contributes its fixed spelling, which `symbols.jinja` reserves so the
    two can never land on the same member. -#}
{%- macro region_name(region) -%}
{%- if region.function is not none -%}{{ symbol(c_symbols, region.function) }}{%- else -%}{{ region.method }}{%- endif -%}
{%- endmacro -%}
{#- Where one region lives: the caller-provided instance, its overlay group,
    and the region. Spelled in exactly one macro so an alias and a call-site
    read-back can never name two different objects. -#}
{%- macro region_path(group, name) -%}self->rumoca_galec_scratch.rumoca_galec_g{{ group }}.{{ name }}{%- endmacro -%}
{%- macro trace_path(path) -%}
{%- if trace_root is not none -%}{{ path | replace(trace_root ~ "/", "") }}{%- else -%}{{ path }}{%- endif -%}
{%- endmacro -%}
{%- macro name_text(value) -%}{{ value.value[0] }}{%- endmacro -%}
{%- macro state_symbol(part) -%}
{%- set spelling = part.name.value[0] -%}
{%- set found = namespace(value="") -%}
{%- for variable in algorithm_code.variables -%}
{%- if variable.name == spelling -%}{%- set found.value = symbol(c_state_symbols, variable.name) -%}{%- endif -%}
{%- endfor -%}
{%- if found.value == "" -%}{{ fail_closed_unresolved_state_reference }}{%- else -%}{{ found.value }}{%- endif -%}
{%- endmacro -%}
{#- A GALEC subscript is 1-based; C is 0-based. When the subscript is a literal
    the whole conversion is known here, so the folded index is emitted directly.
    That is not an optimization for the C compiler — it folds this anyway — it is
    for the reviewer and the MISRA scanner, who read the source. A non-literal
    subscript keeps the explicit cast-and-decrement, which is where the
    conversion's width and signedness are actually pinned down. -#}
{%- macro subscript(index) -%}
{%- if index.kind == "integer" -%}[{{ index.value - 1 }}]
{#- A bare Integer reference — overwhelmingly a loop induction variable — is
    already `int32_t` in the emitted C, so `((int32_t)(i)) - 1` casts an int to
    int. 1,280 of those in the RDD2 estimator alone. The cast is kept only where
    the index is a computed expression, which is where the conversion's width
    and signedness genuinely need pinning down. -#}
