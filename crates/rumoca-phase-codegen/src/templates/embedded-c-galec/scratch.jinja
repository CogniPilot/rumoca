{#- Single declaration site for the instance-owned GALEC C working-memory
    types. The generated source includes the header and only addresses these
    types; it never redeclares their layout. -#}
{%- macro c_type(kind) -%}
{%- if kind == "real" -%}float{%- elif kind == "integer" -%}int32_t{%- elif kind == "boolean" -%}bool{%- else -%}{{ fail_closed_scalar_type }}{%- endif -%}
{%- endmacro -%}
{%- macro region_name(region, c_symbols) -%}
{%- if region.function is not none -%}{{ symbol(c_symbols, region.function) }}{%- else -%}{{ region.method }}{%- endif -%}
{%- endmacro -%}
{#- The extents come from the checked view, which owns them: they are the
    block's own declared extents except where the bound equalization widened a
    leading one so that two union siblings starting at one offset cannot be read
    as objects of different sizes. A slot the view could not size has no
    extents at all, and this target fails closed on it. -#}
{%- macro region_dimensions(slot) -%}
{%- if slot.extents is none %}{{ fail("unsupported-feature:embedded-c-scratch-dimension") }}{% else %}{% for extent in slot.extents %}[{{ extent }}]{% endfor %}{% endif -%}
{%- endmacro -%}
{#- A widened leading extent is annotated where it is declared. Without this the
    header states a bound the Modelica source does not, and the only way to find
    out why is to know this pass exists. -#}
{%- macro equalization_note(slot) -%}
{%- if slot.equalized_from is not none %} /* declared [{{ slot.equalized_from }}]; widened so this address carries one bound across the overlay */{% endif -%}
{%- endmacro -%}
{%- macro slot_declaration(slot, c_symbols) -%}
{%- if slot.scalar is none %}{{ fail_closed_scalar_type }}{% else %}{{ c_type(slot.scalar.kind) }} {{ symbol(c_symbols, slot.name.value[0]) }}{{ region_dimensions(slot) }};{{ equalization_note(slot) }}{% endif -%}
{%- endmacro -%}
{#- An arm overlay: the slots of one region that the checked projection proved
    live in mutually exclusive arms of one conditional. Declared as its own
    named union type rather than inline, so the region struct below reads as a
    list of members and every generated aggregate has a name a map file can
    show. -#}
{%- macro overlays(c_model, region, c_symbols) -%}
{%- for member in region.members %}{% if member.overlay is not none %}
typedef union {{ c_model }}ScratchArm{{ member.overlay }}_{{ region_name(region, c_symbols) }}Tag {
{%- for slot in member.slots %}
    {{ slot_declaration(slot, c_symbols) }}
{%- endfor %}
} {{ c_model }}ScratchArm{{ member.overlay }}_{{ region_name(region, c_symbols) }};
{% endif %}{% endfor -%}
{%- endmacro -%}
{#- A region's value arena: one flat float array whose fixed offsets carry the
    slots the checked projection proved never live together where they overlap.
    The legend restates each slot's placement so a map-file reader can find a
    value without opening the generated source, where the same offsets appear
    on the typed pointers the body declares. Offsets and extents are in float
    elements; every resident is a float array, so every offset the projection
    chose is naturally aligned for every access. A wider resident would need
    its offset rounded to its own alignment, and none is emitted today. -#}
{%- macro arena_member(c_model, region, c_symbols) -%}
{%- if region.arena is not none %}
    /* Value arena (float offsets; overlapping slots are proven never live
     * together by the checked projection):
{%- for slot in region.arena.slots %}
     *   [{{ slot.offset }}..{{ slot.offset + slot.floats }}) {{ symbol(c_symbols, slot.name.value[0]) }}{{ region_dimensions(slot) }}
{%- endfor %}
     */
    float rumoca_galec_arena[{{ region.arena.floats }}];
{%- endif %}
{%- endmacro -%}
{%- macro declarations(c_model, scratch_layout, c_symbols) -%}
{%- for group in scratch_layout.groups %}
{%- for region in group.regions %}
{{- overlays(c_model, region, c_symbols) }}
typedef struct {{ c_model }}Scratch_{{ region_name(region, c_symbols) }}Tag {
{%- for member in region.members %}
{%- if member.overlay is none %}
    {{ slot_declaration(member.slots[0], c_symbols) }}
{%- else %}
    {{ c_model }}ScratchArm{{ member.overlay }}_{{ region_name(region, c_symbols) }} rumoca_galec_arm{{ member.overlay }};
{%- endif %}
{%- endfor %}
{{- arena_member(c_model, region, c_symbols) }}
} {{ c_model }}Scratch_{{ region_name(region, c_symbols) }};
{% endfor %}
{%- endfor %}
{%- for group in scratch_layout.groups %}
/* Overlay group {{ group.ordinal }}. */
typedef union {{ c_model }}ScratchGroup{{ group.ordinal }}Tag {
{%- for region in group.regions %}
    {{ c_model }}Scratch_{{ region_name(region, c_symbols) }} {{ region_name(region, c_symbols) }};
{%- endfor %}
} {{ c_model }}ScratchGroup{{ group.ordinal }};
{% endfor %}
typedef struct {{ c_model }}ScratchTag {
{%- for group in scratch_layout.groups %}
    {{ c_model }}ScratchGroup{{ group.ordinal }} rumoca_galec_g{{ group.ordinal }};
{%- endfor %}
} {{ c_model }}Scratch;
{%- endmacro -%}
