{#- The GALEC array-kernel library, definition half. Model-independent and
    emitted in full every time; see `kernels.h.jinja` for why.

    Every definition here is a counted loop over `int32_t` with a single exit
    and no pointer arithmetic: a kernel only ever subscripts the run it was
    handed. Read-only runs are `const`-qualified, which is possible precisely
    because every parameter is rank 1 -- C99 has no implicit conversion from
    pointer-to-array-of-T to pointer-to-array-of-const-T, so a kernel that took
    a rank > 1 operand could not have been const-correct without a cast this
    target prohibits. Taking rows instead is what keeps both properties. -#}
{%- block conformance %}/* rumoca GALEC array kernels
 * GALEC-derived embedded C export (SPEC_0034 GAL-024).
 * Designed for the MISRA C:2023 assurance profile in SPEC_0034 GAL-029/030.
 * MISRA compliance and DO-178C compliance are not claimed. */
{%- endblock %}

#include "rumoca_galec_kernels.h"

/* The header this was compiled against must be the one emitted beside it. */
#if RUMOCA_GALEC_KERNELS_VERSION != UINT32_C(0x{{ "%08x" | format(galec_kernels_version) }})
#error "rumoca_galec_kernels.c and rumoca_galec_kernels.h come from different rumoca builds"
#endif

void rumoca_galec_copy_real(int32_t count, float target[], const float source[]) {
    for (int32_t element = INT32_C(0); element < count; ++element) {
        target[element] = source[element];
    }
}

void rumoca_galec_copy_integer(int32_t count, int32_t target[], const int32_t source[]) {
    for (int32_t element = INT32_C(0); element < count; ++element) {
        target[element] = source[element];
    }
}

void rumoca_galec_copy_boolean(int32_t count, bool target[], const bool source[]) {
    for (int32_t element = INT32_C(0); element < count; ++element) {
        target[element] = source[element];
    }
}

void rumoca_galec_fill_real(int32_t count, float target[], float value) {
    for (int32_t element = INT32_C(0); element < count; ++element) {
        target[element] = value;
    }
}

void rumoca_galec_fill_integer(int32_t count, int32_t target[], int32_t value) {
    for (int32_t element = INT32_C(0); element < count; ++element) {
        target[element] = value;
    }
}

void rumoca_galec_fill_boolean(int32_t count, bool target[], bool value) {
    for (int32_t element = INT32_C(0); element < count; ++element) {
        target[element] = value;
    }
}

float rumoca_galec_dot_real(int32_t count, const float lhs[], const float rhs[]) {
    float accumulator = 0.0f;
    for (int32_t element = INT32_C(0); element < count; ++element) {
        accumulator = accumulator + (lhs[element] * rhs[element]);
    }
    return accumulator;
}

void rumoca_galec_scaled_add_real(int32_t count, float target[], float scale, const float source[]) {
    for (int32_t element = INT32_C(0); element < count; ++element) {
        target[element] = target[element] + (scale * source[element]);
    }
}
