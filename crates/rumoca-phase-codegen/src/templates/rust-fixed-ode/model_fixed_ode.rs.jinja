/// Instants of the model's time events, ascending. A host lands a step
/// exactly on each one (`step` does) so `handle_events` observes it.
pub const TIME_EVENTS: &[f64] = &[{% if ev %}{% for instant in ev.time_events.instants | sort %}{{ instant }}{{ ", " if not loop.last else "" }}{% endfor %}{% endif %}];

/// Number of root conditions: zero crossings of `root_conditions` are state
/// events.
pub const N_ROOTS: usize = {{ nroots }};

const ROOT_SLOTS: usize = {{ [nroots, 1] | max }};
const INDICATORS: usize = {{ nind }};
const INDICATOR_SLOTS: usize = {{ [nind, 1] | max }};
/// The relative tolerance within which two instants are one instant.
const TIME_MATCH_TOLERANCE: f64 = {{ ev.time_events.match_tolerance if ev else 0.0 }};

/// timeline.rs sample_time_match_with_tol.
fn ev_time_match(a: f64, b: f64) -> bool {
    (a - b).abs() <= TIME_MATCH_TOLERANCE * (1.0 + a.abs().max(b.abs()))
}

/// Event bookkeeping a host keeps beside `State` and `Parameters` for the
/// whole simulation. Start from `EventState::new()`.
#[derive(Clone, Copy, Debug)]
pub struct EventState {
    initialized: bool,
    domain: [bool; INDICATOR_SLOTS],
    domain_valid: bool,
    entry_y: State,
    entry_p: Parameters,
    entry_captured: bool,
    initial_event: bool,
    override_root: [usize; ROOT_SLOTS],
    override_value: [f64; ROOT_SLOTS],
    override_count: usize,
    pass: usize,
}

impl EventState {
    pub const fn new() -> Self {
        Self {
            initialized: false,
            domain: [false; INDICATOR_SLOTS],
            domain_valid: false,
            entry_y: [0.0; Y_LEN],
            entry_p: [0.0; P_LEN],
            entry_captured: false,
            initial_event: false,
            override_root: [0; ROOT_SLOTS],
            override_value: [0.0; ROOT_SLOTS],
            override_count: 0,
            pass: 0,
        }
    }
}

impl Default for EventState {
    fn default() -> Self {
        Self::new()
    }
}

/// Every root condition at `time`, `y`, and `p`. A root changes sign where
/// its relation changes side. Reads the algebraic slots of `y` as given.
pub fn root_conditions(
    time: Scalar,
    y: &State,
    p: &Parameters,
    out: &mut [f64; N_ROOTS],
) -> Result<(), SolveError> {
    let mut roots = [0.0; ROOT_SLOTS];
    ev_eval_roots(time, y, p, &mut roots)?;
    out.copy_from_slice(&roots[..N_ROOTS]);
    Ok(())
}

fn ev_eval_roots(
    time: Scalar,
    y: &State,
    p: &Parameters,
    roots: &mut [f64; ROOT_SLOTS],
