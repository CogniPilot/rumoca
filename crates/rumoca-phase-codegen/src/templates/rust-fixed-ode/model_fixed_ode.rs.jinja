const SURFACE_SLOTS: usize = {{ [schedule.relation_surface_window if schedule else 0, 1] | max }};
const MODE_LIMIT: usize = {{ schedule.mode_search_relations if schedule else 0 }};
const MODE_SLOTS: usize = {{ [schedule.mode_search_relations if schedule else 0, 1] | max }};
{%- set nb = namespace(offsets=[], flat=[]) %}
{%- for hood in (ev.root_neighborhoods if ev else []) %}{% set nb.offsets = nb.offsets + [nb.flat | length] %}{% set nb.flat = nb.flat + hood %}{% endfor %}
{%- set nb.offsets = nb.offsets + [nb.flat | length] %}
/// Per root, the roots reading a coordinate it reads, itself included:
/// `NEIGHBOR[NEIGHBOR_OFFSET[r]..NEIGHBOR_OFFSET[r + 1]]`.
const NEIGHBOR_OFFSET: &[usize] = &[{% for offset in nb.offsets %}{{ offset }}, {% endfor %}];
const NEIGHBOR: &[usize] = &[{% for root in nb.flat %}{{ root }}, {% endfor %}];
const SETTLE_PASS: &[SettleStep] = &[{% for s in (schedule.settle_pass if schedule else []) %}SettleStep::{{ s }}, {% endfor %}];
