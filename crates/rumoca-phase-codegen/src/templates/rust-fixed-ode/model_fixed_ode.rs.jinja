/// Zero domain per root: 1 positive, -1 non-positive, 0 previous side.
const ROOT_ZERO: [i8; ROOT_SLOTS] = [{% for root in ev.roots %}{{ 1 if root.zero == "positive" else (-1 if root.zero == "non_positive" else 0) }}, {% else %}0{% endfor %}];
/// Relation-memory parameter per root.
const ROOT_MEMORY: [Option<usize>; ROOT_SLOTS] = [{% for root in ev.roots %}{% if root.memory is not none %}Some({{ root.memory }}){% else %}None{% endif %}, {% else %}None{% endfor %}];
const ROOT_ALGEBRAIC: [bool; ROOT_SLOTS] = [{% for root in ev.roots %}{{ "true" if root.algebraic_dependent else "false" }}, {% else %}false{% endfor %}];
/// The root each event indicator reads: the searched roots.
const INDICATOR_ROOT: [usize; INDICATOR_SLOTS] = [{% for root in search.roots %}{{ root }}, {% else %}0{% endfor %}];

/// solve_ops.rs orient_typed_root_zero.
fn ev_orient_root(root: f64, zero: i8) -> f64 {
    if root != 0.0 {
        return root;
    }
    match zero {
        1 => f64::EPSILON,
        -1 => -f64::EPSILON,
        _ => root,
    }
}

/// solve_ops.rs relation_memory_value_from_root.
fn ev_memory_value(root: f64) -> f64 {
    if root < 0.0 { 1.0 } else { 0.0 }
}

/// solve_ops.rs runtime_value_changed at zero tolerance.
fn ev_value_changed(before: f64, after: f64) -> bool {
    if before.to_bits() == after.to_bits() {
        return false;
    }
    !before.is_finite() || !after.is_finite() || (before - after).abs() > 0.0
}

/// Write `value` into `slot`; whether its bits changed.
fn ev_write(slot: &mut f64, value: f64) -> bool {
    let changed = slot.to_bits() != value.to_bits();
    *slot = value;
    changed
}

fn ev_overridden(events: &EventState, root: usize) -> bool {
    events.override_root[..events.override_count].contains(&root)
}

/// component.rs event_indicators_into: the searched roots at the refreshed
/// coordinate, an exact zero reported on its domain's side.
fn ev_indicators(
    events: &EventState,
    time: Scalar,
    y: &mut State,
    p: &Parameters,
    z: &mut [f64; INDICATOR_SLOTS],
) -> Result<(), SolveError> {
    let mut roots = [0.0; ROOT_SLOTS];
    refresh_algebraics(time, y, p)?;
    ev_eval_roots(time, y, p, &mut roots)?;
    for k in 0..INDICATORS {
        let root = INDICATOR_ROOT[k];
        let mut value = roots[root];
        if value == 0.0 {
            let frozen_positive = match ROOT_MEMORY[root] {
                Some(memory) => p[memory] <= 0.5,
                None => events.domain_valid && events.domain[k],
            };
            value = match ROOT_ZERO[root] {
                1 => f64::EPSILON,
                -1 => -f64::EPSILON,
                _ if frozen_positive => f64::EPSILON,
                _ => -f64::EPSILON,
            };
        }
        z[k] = value;
    }
    Ok(())
}

/// component.rs complete_indicator_domains: a changed domain captures the
/// event entry and arms each crossed root's post-event relation side.
fn ev_completed(
    events: &mut EventState,
    time: Scalar,
    y: &mut State,
    p: &Parameters,
) -> Result<bool, SolveError> {
    if INDICATORS == 0 {
        return Ok(false);
    }
    let mut z = [0.0; INDICATOR_SLOTS];
    ev_indicators(events, time, y, p, &mut z)?;
    if !events.domain_valid {
        for k in 0..INDICATORS {
            events.domain[k] = z[k] > 0.0;
        }
        events.domain_valid = true;
        return Ok(false);
    }
    if (0..INDICATORS).all(|k| events.domain[k] == (z[k] > 0.0)) {
        return Ok(false);
    }
    events.entry_y = *y;
    events.entry_p = *p;
    events.entry_captured = true;
    events.override_count = 0;
    for k in 0..INDICATORS {
        let now = z[k] > 0.0;
        if now != events.domain[k] {
            events.override_root[events.override_count] = INDICATOR_ROOT[k];
            events.override_value[events.override_count] = if now { 0.0 } else { 1.0 };
            events.override_count += 1;
        }
        events.domain[k] = now;
    }
    Ok(true)
}

/// relation_memory.rs apply_root_relation_memory_overrides.
fn ev_apply_overrides(events: &EventState, p: &mut Parameters) -> bool {
    let mut changed = false;
    for k in 0..events.override_count {
        if let Some(memory) = ROOT_MEMORY[events.override_root[k]] {
            changed |= ev_write(&mut p[memory], events.override_value[k]);
        }
    }
    changed
}

/// relation_memory.rs refresh_event_relation_memory and, with
/// `algebraic_only`, update_algebraic_relation_memory_from_solver_y_except_overrides:
/// release overrides the roots now contradict, then encode every other root.
fn ev_relation_refresh(
    events: &mut EventState,
    time: Scalar,
    y: &State,
    p: &mut Parameters,
    algebraic_only: bool,
) -> Result<bool, SolveError> {
    let mut roots = [0.0; ROOT_SLOTS];
    let mut changed = false;
    ev_eval_roots(time, y, p, &mut roots)?;
    let mut kept = 0;
    for k in 0..events.override_count {
        let root = events.override_root[k];
        let include = !algebraic_only || ROOT_ALGEBRAIC[root];
        if !include || roots[root] == 0.0 || ev_memory_value(roots[root]) == events.override_value[k] {
            events.override_root[kept] = root;
            events.override_value[kept] = events.override_value[k];
            kept += 1;
        } else {
            changed = true;
        }
    }
    events.override_count = kept;
    for root in 0..N_ROOTS {
        let Some(memory) = ROOT_MEMORY[root] else {
            continue;
        };
        if (algebraic_only && !ROOT_ALGEBRAIC[root]) || ev_overridden(events, root) {
            continue;
        }
        changed |= ev_write(&mut p[memory], ev_memory_value(ev_orient_root(roots[root], ROOT_ZERO[root])));
    }
    Ok(changed)
}

/// kernel.rs project_event_algebraics: refresh the algebraic coordinate and
/// report a change.
fn ev_projection(time: Scalar, y: &mut State, p: &Parameters) -> Result<bool, SolveError> {
    let before = *y;
    refresh_algebraics(time, y, p)?;
    Ok(before.iter().zip(y.iter()).any(|(before, after)| ev_value_changed(*before, *after)))
}

