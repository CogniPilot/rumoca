/// The pre-binding lanes (pre_params.rs): destination, source, and whether the
/// source is a solver coordinate.
const PRE_LANES: [(usize, usize, bool); {{ lanes | length }}] = [{% for lane in lanes %}({{ lane.dest }}, {{ lane.source }}, {{ "true" if lane.column == "y" else "false" }}), {% endfor %}];
/// The pre lanes an event pass advances and whose settlement ends it.
const ITERATION_LANES: [usize; {{ ev.iteration_lanes | length }}] = [{% for lane in ev.iteration_lanes %}{{ lane }}, {% endfor %}];

fn ev_pre_source(y: &State, p: &Parameters, lane: usize) -> f64 {
    let (_, source, from_y) = PRE_LANES[lane];
    if from_y { y[source] } else { p[source] }
}

/// pre_params.rs advance_event_iteration_pre_params: the next pass reads the
/// previous pass's values.
fn ev_advance_lanes(y: &State, p: &mut Parameters) -> bool {
    let mut current = [0.0; ITERATION_LANES.len()];
    for (k, lane) in ITERATION_LANES.iter().enumerate() {
        current[k] = ev_pre_source(y, p, *lane);
    }
    let mut changed = false;
    for (k, lane) in ITERATION_LANES.iter().enumerate() {
        changed |= ev_write(&mut p[PRE_LANES[*lane].0], current[k]);
    }
    changed
}

/// pre_params.rs event_iteration_plan_settled.
fn ev_lanes_settled(y: &State, p: &Parameters) -> bool {
    ITERATION_LANES
        .iter()
        .all(|lane| p[PRE_LANES[*lane].0].to_bits() == ev_pre_source(y, p, *lane).to_bits())
}

/// The discrete settle pass, as the schedule lists its steps (ME-EVENT-006).
/// Steps after the last settle check change the coordinate without a reader.
#[allow(unused_assignments)]
fn ev_discrete_settle(
    events: &EventState,
    time: Scalar,
    y: &mut State,
    p: &mut Parameters,
    changed_any: &mut bool,
) -> Result<(), SolveError> {
    for _ in 0..{{ cap }} {
        let mut pass_changed = false;
{%- for step in schedule.settle_pass %}
{%- if step == "DiscreteOwners" %}
        pass_changed |= ev_discrete_owners(events, time, y, p, false)?;
{%- elif step == "RuntimeAssignments" %}
        pass_changed |= ev_runtime_assignments(time, y, p)?;
{%- elif step == "SettledIfUnchanged" %}
        if !pass_changed {
            return Ok(());
        }
{%- elif step == "AlgebraicProjection" %}
        pass_changed |= ev_projection(time, y, p)?;
{%- else %}{{ fail("unsupported-feature:events.settle-step " ~ step) }}{% endif %}
{%- endfor %}
        *changed_any = true;
    }
    // A stalled discrete iteration needs the coupled event Newton solve, which
    // is not rendered.
    Err(SolveError)
}

const SURFACE_WINDOW: usize = {{ schedule.relation_surface_window }};
const SURFACE_SLOTS: usize = {{ [schedule.relation_surface_window, 1] | max }};
const MODE_LIMIT: usize = {{ schedule.mode_search_relations }};

/// relation_memory.rs on_relation_surface history: the last passes' discrete
/// values and coordinates.
struct EvSurface {
    y: [State; SURFACE_SLOTS],
    p: [Parameters; SURFACE_SLOTS],
    count: usize,
    head: usize,
}

impl EvSurface {
    const fn new() -> Self {
        Self {
            y: [[0.0; Y_LEN]; SURFACE_SLOTS],
            p: [[0.0; P_LEN]; SURFACE_SLOTS],
            count: 0,
            head: 0,
        }
    }

    fn clear(&mut self) {
        self.count = 0;
        self.head = 0;
    }

    /// Whether the iteration returned to the discrete values of one of its
    /// last passes with the coordinate unchanged: a surface where its
    /// alternating relations' expression is continuous. Records this pass.
    fn repeats(&mut self, y: &State, p: &Parameters) -> bool {
        if SURFACE_WINDOW == 0 {
            return false;
        }
        let repeats = (0..self.count).any(|k| {
            self.p[k].iter().zip(p).all(|(a, b)| a.to_bits() == b.to_bits())
                && self.y[k].iter().zip(y).all(|(a, b)| !ev_value_changed(*a, *b))
        });
        self.y[self.head] = *y;
        self.p[self.head] = *p;
        self.head = (self.head + 1) % SURFACE_WINDOW;
        if self.count < SURFACE_WINDOW {
            self.count += 1;
        }
        repeats
    }
}

{%- set nb = namespace(at=0, offsets=[], flat=[]) %}
{%- for hood in ev.root_neighborhoods %}{% set nb.offsets = nb.offsets + [nb.flat | length] %}{% set nb.flat = nb.flat + hood %}{% endfor %}
{%- set nb.offsets = nb.offsets + [nb.flat | length] %}

/// Per root: the roots reading a coordinate it reads, itself included
/// (`NEIGHBOR[NEIGHBOR_OFFSET[r]..NEIGHBOR_OFFSET[r + 1]]`).
const NEIGHBOR_OFFSET: [usize; {{ nb.offsets | length }}] = [{% for offset in nb.offsets %}{{ offset }}, {% endfor %}];
const NEIGHBOR: [usize; {{ [nb.flat | length, 1] | max }}] = [{% for root in nb.flat %}{{ root }}, {% else %}0{% endfor %}];

/// relation_memory.rs search_consistent_mode candidates: the cycling relations
/// and their neighborhoods.
fn ev_mode_candidates(surface: &EvSurface, p: &Parameters, candidates: &mut [usize; ROOT_SLOTS]) -> usize {
    let mut cycling = [false; ROOT_SLOTS];
    let mut joined = [false; ROOT_SLOTS];
    for root in 0..N_ROOTS {
        if let Some(memory) = ROOT_MEMORY[root] {
            cycling[root] = (0..surface.count).any(|k| surface.p[k][memory].to_bits() != p[memory].to_bits());
        }
    }
    for root in 0..N_ROOTS {
        if cycling[root] {
            for neighbor in &NEIGHBOR[NEIGHBOR_OFFSET[root]..NEIGHBOR_OFFSET[root + 1]] {
                joined[*neighbor] = true;
            }
        }
    }
    let mut count = 0;
    for root in 0..N_ROOTS {
        if joined[root] && ROOT_MEMORY[root].is_some() {
            if count < MODE_LIMIT {
                candidates[count] = root;
            }
            count += 1;
        }
    }
    count
}

fn ev_mode_consistent(
    time: Scalar,
    y: &mut State,
    p: &mut Parameters,
    candidates: &[usize],
    mode: usize,
) -> bool {
    let side = |k: usize| if mode >> k & 1 == 1 { 1.0 } else { 0.0 };
    for (k, root) in candidates.iter().enumerate() {
        if let Some(memory) = ROOT_MEMORY[*root] {
            p[memory] = side(k);
        }
    }
    if refresh_algebraics(time, y, p).is_err() {
        return false;
    }
    let mut roots = [0.0; ROOT_SLOTS];
    if ev_eval_roots(time, y, p, &mut roots).is_err() {
        return false;
    }
    candidates.iter().enumerate().all(|(k, root)| {
        let value = ev_orient_root(roots[*root], ROOT_ZERO[*root]);
        value == 0.0 || ev_memory_value(value) == side(k)
    })
}

/// relation_memory.rs search_consistent_mode and resolve_relation_cycle: a
/// joint mode whose projected coordinate gives each cycling relation its
/// assigned side, or none, which keeps the current side.
fn ev_mode_search(
    events: &mut EventState,
    surface: &EvSurface,
    time: Scalar,
    y: &mut State,
    p: &mut Parameters,
) -> Result<bool, SolveError> {
    let mut candidates = [0; ROOT_SLOTS];
    let count = ev_mode_candidates(surface, p, &mut candidates);
    if count == 0 || count > MODE_LIMIT {
        // The iteration cycles among more relations than the mode search
        // covers.
        return Err(SolveError);
    }
    let candidates = &candidates[..count];
    let (base_y, base_p) = (*y, *p);
    for mode in 0..(1usize << count) {
        if ev_mode_consistent(time, y, p, candidates, mode) {
            let mut kept = 0;
            for k in 0..events.override_count {
                if !candidates.contains(&events.override_root[k]) {
                    events.override_root[kept] = events.override_root[k];
                    events.override_value[kept] = events.override_value[k];
                    kept += 1;
                }
            }
            for (c, root) in candidates.iter().enumerate() {
                events.override_root[kept] = *root;
                events.override_value[kept] = if mode >> c & 1 == 1 { 1.0 } else { 0.0 };
                kept += 1;
            }
            events.override_count = kept;
            return Ok(true);
        }
        *y = base_y;
        *p = base_p;
    }
    Ok(false)
}

/// The relation pass (relation_memory.rs settle_event_equations_with_fixed_pre).
/// Its projection steps change the coordinate without a reader.
#[allow(unused_assignments)]
fn ev_relation_settle(
    events: &mut EventState,
    time: Scalar,
    y: &mut State,
    p: &mut Parameters,
    changed_any: &mut bool,
) -> Result<(), SolveError> {
    let mut surface = EvSurface::new();
    for _ in 0..{{ cap }} {
        #[allow(unused_mut, unused_variables)]
        let mut step_changed = false;
{%- for step in schedule.relation_pass %}
{%- if step == "DiscreteSettle" %}
        ev_discrete_settle(events, time, y, p, changed_any)?;
{%- elif step == "SettledIfRelationsUnchanged" %}
        if !ev_relation_refresh(events, time, y, p, false)? {
            return Ok(());
        }
        *changed_any = true;
{%- elif step == "AlgebraicProjection" %}
        step_changed |= ev_projection(time, y, p)?;
{%- elif step == "RuntimeAssignments" %}
        step_changed |= ev_runtime_assignments(time, y, p)?;
{%- else %}{{ fail("unsupported-feature:events.relation-step " ~ step) }}{% endif %}
{%- endfor %}
        if surface.repeats(y, p) {
            if !ev_mode_search(events, &surface, time, y, p)? {
                return Ok(());
            }
            surface.clear();
            *changed_any = true;
        }
    }
    // The event condition equations did not converge with fixed pre.
    Err(SolveError)
}

/// One event pass, as the schedule lists its steps.
fn ev_pass(
    events: &mut EventState,
    time: Scalar,
    y: &mut State,
    p: &mut Parameters,
    changed: &mut bool,
) -> Result<(), SolveError> {
    #[allow(unused_mut)]
    let mut step = false;
{%- for s in schedule.event_pass %}
{%- if s == "RelationOverrides" %}
    *changed |= ev_apply_overrides(events, p);
{%- elif s == "RuntimeAssignments" %}
    step |= ev_runtime_assignments(time, y, p)?;
{%- elif s == "AlgebraicProjection" %}
    step |= ev_projection(time, y, p)?;
{%- elif s == "RelationRefresh" %}
    step = ev_relation_refresh(events, time, y, p, false)?;
    if step {
        step |= ev_runtime_assignments(time, y, p)?;
    }
{%- elif s == "RelationSettle" %}
    ev_relation_settle(events, time, y, p, changed)?;
{%- else %}{{ fail("unsupported-feature:events.event-step " ~ s) }}{% endif %}
    *changed |= step;
{%- endfor %}
    Ok(())
}

/// relation_memory.rs apply_projected_event_update and component.rs
/// commit_event_runtime_state. Pre values are seeded from the event entry;
/// each later pass reads the previous pass (Appendix B).
fn ev_iterate(
    events: &mut EventState,
    time: Scalar,
    y: &mut State,
    p: &mut Parameters,
    canonicalize: bool,
) -> Result<(), SolveError> {
    for lane in 0..PRE_LANES.len() {
        p[PRE_LANES[lane].0] = ev_pre_source(&events.entry_y, &events.entry_p, lane);
    }
    let mut settled = false;
    let mut surface = EvSurface::new();
    for pass in 0..{{ cap }} {
        if settled {
            break;
        }
        events.pass = pass;
        let mut changed = pass > 0 && ev_advance_lanes(y, p);
        ev_pass(events, time, y, p, &mut changed)?;
        // Condition memories advance on the settled pass, before the next
        // pass advances the pre lanes.
        changed |= ev_discrete_owners(events, time, y, p, true)?;
        settled = !changed && ev_lanes_settled(y, p);
        if settled || !surface.repeats(y, p) {
            continue;
        }
        if ev_mode_search(events, &surface, time, y, p)? {
            surface.clear();
        } else {
            settled = true;
        }
    }
    events.pass = 0;
    if !settled {
        // The event update iteration did not converge.
        return Err(SolveError);
    }
    // pre_params.rs commit_pre_params_after_event_at.
    let committed_p = *p;
    let mut history = false;
    for lane in 0..PRE_LANES.len() {
        let value = ev_pre_source(y, &committed_p, lane);
        history |= ev_value_changed(p[PRE_LANES[lane].0], value);
        p[PRE_LANES[lane].0] = value;
    }
    if !canonicalize || !history {
        return Ok(());
    }
    // component.rs canonicalize_committed_event_view.
    for _ in 0..{{ cap }} {
        let mut changed = ev_post_commit_assignments(time, y, p)?;
        changed |= ev_projection(time, y, p)?;
        let relations = ev_relation_refresh(events, time, y, p, true)?;
        if !changed && !relations {
            return Ok(());
        }
    }
    // The post-commit event view did not converge.
    Err(SolveError)
}

/// component.rs exit_initialization_mode_inner and discrete_rows.rs
/// seed_condition_memory_for_initialization: relation memory from the settled
/// state, then every condition memory with pre following the current value.
fn ev_initialize(
    events: &mut EventState,
    time: Scalar,
    y: &mut State,
    p: &mut Parameters,
) -> Result<(), SolveError> {
{%- if solve.solve_layout.initial_event_parameter_index is not none %}
    p[{{ solve.solve_layout.initial_event_parameter_index }}] = 1.0;
{%- endif %}
    events.override_count = 0;
    refresh_algebraics(time, y, p)?;
    ev_relation_refresh(events, time, y, p, false)?;
    for lane in 0..PRE_LANES.len() {
        p[PRE_LANES[lane].0] = ev_pre_source(y, p, lane);
    }
    ev_discrete_owners(events, time, y, p, true)?;
    events.entry_y = *y;
    events.entry_p = *p;
    events.entry_captured = true;
    events.initial_event = true;
    events.domain_valid = false;
    Ok(())
}

/// runtime/schedule.rs coincident_scheduled_event: an event at a static
/// instant is observed at its right limit.
fn ev_observes_right_limit(time: Scalar) -> bool {
    TIME_EVENTS.iter().any(|instant| ev_time_match(*instant, time))
}

/// Event Mode: the initial event after initialization, else the event the
/// completed step captured. Without a captured entry (a time event), the entry
/// is the current coordinate.
fn ev_update(
    events: &mut EventState,
    time: Scalar,
    y: &mut State,
    p: &mut Parameters,
) -> Result<(), SolveError> {
    let initial = events.initial_event;
    if !events.entry_captured {
        refresh_algebraics(time, y, p)?;
        events.entry_y = *y;
        events.entry_p = *p;
        events.override_count = 0;
    }
    let mut status = ev_iterate(events, time, y, p, !initial);
    // event_boundary.rs apply_event_right_limit: the right limit observes the
    // same event, so it starts again from the event-entry discrete values.
    if status.is_ok() && !initial && ev_observes_right_limit(time) {
        *p = events.entry_p;
        status = ev_iterate(events, time.next_up(), y, p, true);
    }
    events.entry_captured = false;
{%- if solve.solve_layout.initial_event_parameter_index is not none %}
    if initial && status.is_ok() {
        p[{{ solve.solve_layout.initial_event_parameter_index }}] = 0.0;
    }
{%- endif %}
    events.initial_event = false;
    events.override_count = 0;
    status
}

/// component.rs seed_settled_indicator_domains.
fn ev_continuous(
    events: &mut EventState,
    time: Scalar,
    y: &mut State,
    p: &Parameters,
) -> Result<(), SolveError> {
    if INDICATORS == 0 {
        return Ok(());
    }
    let mut z = [0.0; INDICATOR_SLOTS];
    ev_indicators(events, time, y, p, &mut z)?;
    for k in 0..INDICATORS {
        events.domain[k] = z[k] > 0.0;
    }
    events.domain_valid = true;
    Ok(())
}
{%- endif %}

/// Settle the model's events at `time`, after `y` and `p` reached it. Call it
/// once at the start time and after every accepted step, never inside a
/// multistage step: the first call runs the initial event, later calls run the
/// state event a root sign change reports and the time event at an instant of
/// `TIME_EVENTS`. Returns whether an event ran.
pub fn handle_events(
    events: &mut EventState,
    time: Scalar,
    y: &mut State,
    p: &mut Parameters,
) -> Result<bool, SolveError> {
{%- if ev %}
    if !events.initialized {
        ev_initialize(events, time, y, p)?;
        events.initialized = true;
        ev_update(events, time, y, p)?;
        ev_continuous(events, time, y, p)?;
        return Ok(true);
    }
    let state_event = ev_completed(events, time, y, p)?;
    let time_event = TIME_EVENTS.iter().any(|instant| ev_time_match(*instant, time));
    if !state_event && !time_event {
        return Ok(false);
    }
    ev_update(events, time, y, p)?;
    ev_continuous(events, time, y, p)?;
    Ok(true)
{%- else %}
    let _ = (time, &y, &p);
    events.initialized = true;
    Ok(false)
{%- endif %}
}

/// Explicit fixed-step integration schemes of `step`.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Method {
    /// First-order forward Euler.
    Euler,
    /// Classical fourth-order Runge-Kutta.
    Rk4,
}

fn advance(state: &mut State, rate: &Derivative, scale: Scalar) {
    for (value, rate) in state.iter_mut().zip(rate) {
        *value += scale * rate;
    }
}

/// Advance `y` from `time` by at most `dt`, shortened to land exactly on the
/// next instant of `TIME_EVENTS`, then settle events there. Runs the initial
/// event first when `events` has not seen one. Returns the new time.
pub fn step(
    method: Method,
    events: &mut EventState,
    time: Scalar,
    dt: Scalar,
    y: &mut State,
    p: &mut Parameters,
) -> Result<Scalar, SolveError> {
    if !events.initialized {
        handle_events(events, time, y, p)?;
    }
    let mut end = time + dt;
    let mut at_instant = false;
    for instant in TIME_EVENTS {
        if *instant > time && !ev_time_match(*instant, time) && (*instant < end || ev_time_match(*instant, end)) {
            end = end.min(*instant);
            at_instant = true;
        }
    }
    let h = end - time;
    // The last stage of a step that ends at a time event reads its left limit.
    let stage_end = if at_instant { end.next_down() } else { end };
    match method {
        Method::Euler => {
            let rate = derivative_rhs(time, y, p)?;
            advance(y, &rate, h);
        }
        Method::Rk4 => {
            let k1 = derivative_rhs(time, y, p)?;
            let mut trial = *y;
            advance(&mut trial, &k1, h / 2.0);
            let k2 = derivative_rhs(time + h / 2.0, &trial, p)?;
            trial = *y;
            advance(&mut trial, &k2, h / 2.0);
            let k3 = derivative_rhs(time + h / 2.0, &trial, p)?;
            trial = *y;
            advance(&mut trial, &k3, h);
            let k4 = derivative_rhs(stage_end, &trial, p)?;
            for index in 0..DERIVATIVE_LEN {
                y[index] += h * (k1[index] + 2.0 * k2[index] + 2.0 * k3[index] + k4[index]) / 6.0;
            }
        }
    }
    handle_events(events, end, y, p)?;
    Ok(end)
}
