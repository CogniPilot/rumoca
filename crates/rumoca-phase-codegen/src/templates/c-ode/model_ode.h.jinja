#ifndef RUMOCA_{{ model_name | upper | replace("-", "_") }}_ODE_H
#define RUMOCA_{{ model_name | upper | replace("-", "_") }}_ODE_H

#include <stddef.h>

#ifdef __cplusplus
extern "C" {
#endif

enum {
    RUMOCA_{{ model_name | upper | replace("-", "_") }}_Y_LEN = {{ solve.layout.y_scalars }},
    RUMOCA_{{ model_name | upper | replace("-", "_") }}_P_LEN = {{ solve.layout.p_scalars }},
    RUMOCA_{{ model_name | upper | replace("-", "_") }}_DERIVATIVE_LEN = {{ solve_blocks.continuous.derivative_rhs.output_count }}
};

{%- if solve.layout.p_scalars > 0 %}
/* Default value of every compiled parameter slot (P layout). NaN marks a slot
 * the host must supply (an input) or that init_params computes. */
extern const double {{ model_name | sanitize }}_default_p[RUMOCA_{{ model_name | upper | replace("-", "_") }}_P_LEN];
{%- endif %}

/* Compute the parameters defined by other parameters (e.g. a weight matrix
 * built from scalar parameters) in place, from the base parameters already in
 * p (length P_LEN). Call after changing any parameter, before derivative_rhs.
 * Returns 0 on success. */
int {{ model_name | sanitize }}_init_params(double *p);

/* Write the start values that are computed from parameters (e.g. trainable
 * weights carried as states) into the state slots of y (length Y_LEN); other
 * slots are left as given. Call after init_params. Returns 0 on success. */
int {{ model_name | sanitize }}_init_state(const double *p, double *y);

/* Returns 0 on success. On failure, out is left unchanged. */
int {{ model_name | sanitize }}_derivative_rhs(
    double time,
    const double *y,
    const double *p,
    double *out);

#ifdef __cplusplus
}
#endif

#endif
