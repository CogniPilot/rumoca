int {{ model_name | sanitize }}_init_params(double *p)
{
    (void)p;
{%- set pinit = solve_blocks.parameter_initialization %}
{%- if pinit and pinit.output_count > 0 %}
    {
        /* Ordered parameter-only initialization: a later assignment may read
         * a parameter an earlier one computed. */
        double *__out = p;
{%- for program in pinit.scalar_plan.programs %}
        {
{%- for op in program.ops %}
{{ scalar_op(op) }}
{%- endfor %}
        {%- for op in program.ops %}{% if op.dst is defined and op.dst is not none %}
        (void)__r{{ op.dst }};
        {%- endif %}{% endfor %}
        }
{%- endfor %}
    }
{%- endif %}
    return 0;
}

int {{ model_name | sanitize }}_init_state(const double *p, double *y)
{
    (void)p;
    (void)y;
{%- set sinit = solve_blocks.state_initialization %}
{%- if sinit and sinit.output_count > 0 %}
    {
        double *__out = y;
{%- for program in sinit.scalar_plan.programs %}
        {
{%- for op in program.ops %}
{{ scalar_op(op) }}
{%- endfor %}
        {%- for op in program.ops %}{% if op.dst is defined and op.dst is not none %}
        (void)__r{{ op.dst }};
        {%- endif %}{% endfor %}
        }
{%- endfor %}
    }
{%- endif %}
    return 0;
}

int {{ model_name | sanitize }}_derivative_rhs(
    double time,
    const double *y_in,
    const double *p,
    double *out)
{
    (void)time;
    (void)p;
{%- if alg_plan and alg_plan.output_count > 0 %}
    /* Algebraic refresh: the derivative rows read algebraic slots of y. Only
     * the state slots of y_in are inputs; every algebraic slot is assigned
     * here first, in checked exact-assignment order. */
    double y[RUMOCA_{{ model_name | upper | replace("-", "_") }}_Y_LEN];
    for (int i = 0; i < RUMOCA_{{ model_name | upper | replace("-", "_") }}_Y_LEN; ++i) {
        y[i] = y_in[i];
    }
    {
        double *__out = y;
{%- for program in alg_plan.programs %}
        {
{%- for op in program.ops %}
{{ scalar_op(op) }}
{%- endfor %}
        {#- An assignment program carries its source residual's prefix, which can
            load registers the isolated value never reads. #}
        {%- for op in program.ops %}{% if op.dst is defined and op.dst is not none %}
        (void)__r{{ op.dst }};
        {%- endif %}{% endfor %}
        }
{%- endfor %}
    }
{%- else %}
    const double *y = y_in;
{%- endif %}
    (void)y;
{%- if plan.output_count > 0 %}
    double __out[RUMOCA_{{ model_name | upper | replace("-", "_") }}_DERIVATIVE_LEN];
    for (int i = 0; i < RUMOCA_{{ model_name | upper | replace("-", "_") }}_DERIVATIVE_LEN; ++i) {
        __out[i] = 0.0;
    }
{%- for program in plan.programs %}
    {
{%- for op in program.ops %}
{{ scalar_op(op) }}
{%- endfor %}
    }
{%- endfor %}
    for (int i = 0; i < RUMOCA_{{ model_name | upper | replace("-", "_") }}_DERIVATIVE_LEN; ++i) {
        out[i] = __out[i];
    }
{%- else %}
    (void)out;
{%- endif %}
    return 0;
}
