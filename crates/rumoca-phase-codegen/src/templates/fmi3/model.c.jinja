static inline fmi3Boolean checked_integer_add(int64_t lhs, int64_t rhs, int64_t* result) {
    if ((rhs > 0 && lhs > INT64_MAX - rhs) || (rhs < 0 && lhs < INT64_MIN - rhs)) return fmi3False;
    *result = lhs + rhs;
    return fmi3True;
}
static inline fmi3Boolean checked_integer_subtract(int64_t lhs, int64_t rhs, int64_t* result) {
    if ((rhs < 0 && lhs > INT64_MAX + rhs) || (rhs > 0 && lhs < INT64_MIN + rhs)) return fmi3False;
