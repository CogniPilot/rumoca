static fmi3Status evaluate_derivatives(ModelInstance* m) {
    if (settle_derivative_values(m) != fmi3OK) return fmi3Error;
{% set plan = solve_blocks.continuous.derivative_rhs.scalar_plan %}
{% for program in plan.programs %}{% for op in program.ops %}
{% if loop.first %}    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{% endif %}
{{ scalar_op(op) }}
{% if loop.last %}    }
{% endif %}
{% endfor %}{% endfor %}
    for (size_t i = 0; i < {{ solve.solve_layout.state_scalar_count }}; ++i) {
        if (!isfinite(m->derivative[i])) return fmi3Error;
    }
    return fmi3OK;
}
static fmi3Status integrate_rk4(ModelInstance* m, fmi3Float64 start, fmi3Float64 step) {
    double initial[STATE_LEN]; double k1[STATE_LEN]; double k2[STATE_LEN]; double k3[STATE_LEN]; double k4[STATE_LEN];
    size_t count = {{ solve.solve_layout.state_scalar_count }};
    for (size_t i=0;i<count;++i) initial[i]=m->y[i];
    m->time=start; if(evaluate_derivatives(m)!=fmi3OK)return fmi3Error;
    for(size_t i=0;i<count;++i){k1[i]=m->derivative[i];m->y[i]=initial[i]+0.5*step*k1[i];}
    m->time=start+0.5*step; if(evaluate_derivatives(m)!=fmi3OK)return fmi3Error;
    for(size_t i=0;i<count;++i){k2[i]=m->derivative[i];m->y[i]=initial[i]+0.5*step*k2[i];}
    if(evaluate_derivatives(m)!=fmi3OK)return fmi3Error;
    for(size_t i=0;i<count;++i){k3[i]=m->derivative[i];m->y[i]=initial[i]+step*k3[i];}
    m->time=start+step; if(evaluate_derivatives(m)!=fmi3OK)return fmi3Error;
    for(size_t i=0;i<count;++i){k4[i]=m->derivative[i];m->y[i]=initial[i]+step*(k1[i]+2.0*k2[i]+2.0*k3[i]+k4[i])/6.0;if(!isfinite(m->y[i]))return fmi3Error;}
    return settle_assertion_event(m);
}
{#- One row per FMI 3 value reference, indexed by the reference itself: time
    is 0, the variables are 1..N in inventory order and the state derivatives
    follow (the renderer refuses any other numbering). Integer and
    enumeration values are Int32 and Boolean values Boolean, all held in the
    numeric storage run; String values live in the instance text table. -#}
enum RmcColumn { RMC_COLUMN_TIME, RMC_COLUMN_Y, RMC_COLUMN_P, RMC_COLUMN_DERIVATIVE, RMC_COLUMN_TEXT };
enum RmcKind { RMC_KIND_FLOAT64, RMC_KIND_INT32, RMC_KIND_BOOLEAN, RMC_KIND_STRING };
enum RmcAccess { RMC_ACCESS_FIXED, RMC_ACCESS_STATE, RMC_ACCESS_INPUT, RMC_ACCESS_PARAMETER, RMC_ACCESS_TUNABLE_PARAMETER };
typedef struct { unsigned char column; unsigned char kind; unsigned char access; unsigned char marks_parameters; size_t base; size_t count; } RmcValueReference;
static const RmcValueReference rmc_value_references[] = {
    {RMC_COLUMN_TIME, RMC_KIND_FLOAT64, RMC_ACCESS_FIXED, 0, 0, 1},
{%- set text = namespace(base=0) %}
{%- for variable in fmi.variables %}{% if loop.index0 % 6 == 0 %}
   {% endif %} {
{%- if variable.value_kind == "String" %}RMC_COLUMN_TEXT{% elif variable.storage.column == "y" %}RMC_COLUMN_Y{% elif variable.storage.column == "p" %}RMC_COLUMN_P{% else %}{{ fail("unsupported-feature:fmi.c.value-reference-column " ~ variable.storage.column) }}{% endif %}, {{ rmc_kind(variable) }}, {% if variable.role == "State" %}RMC_ACCESS_STATE{% elif variable.causality == "input" %}RMC_ACCESS_INPUT{% elif variable.causality == "parameter" %}{% if variable.tunable %}RMC_ACCESS_TUNABLE_PARAMETER{% else %}RMC_ACCESS_PARAMETER{% endif %}{% else %}RMC_ACCESS_FIXED{% endif %}, {{ 1 if variable.causality == "parameter" and variable.value_kind != "String" else 0 }}, {% if variable.value_kind == "String" %}{{ text.base }}{% set text.base = text.base + variable.storage.scalar_count %}{% else %}{{ variable.storage.base }}{% endif %}, {{ variable.storage.scalar_count }}},
{%- endfor %}
{%- set derivative = namespace(ordinal=0, base=0) %}
{%- for variable in fmi.variables %}{% if variable.role == "State" %}{% if derivative.ordinal % 6 == 0 %}
   {% endif %} {RMC_COLUMN_DERIVATIVE, RMC_KIND_FLOAT64, RMC_ACCESS_FIXED, 0, {{ derivative.base }}, {{ variable.storage.scalar_count }}},
{%- set derivative.ordinal = derivative.ordinal + 1 %}{% set derivative.base = derivative.base + variable.storage.scalar_count %}{% endif %}{% endfor %}
};
#define RMC_VALUE_REFERENCES (sizeof(rmc_value_references) / sizeof(rmc_value_references[0]))
static const RmcValueReference* rmc_reference(fmi3ValueReference vr, unsigned char kind) {
    return vr < RMC_VALUE_REFERENCES && rmc_value_references[vr].kind == kind ? &rmc_value_references[vr] : NULL;
}
static fmi3Boolean rmc_can_set(const ModelInstance* m, const RmcValueReference* ref) {
    switch (ref->access) {
    case RMC_ACCESS_STATE:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION
            || (m->type == INTERFACE_ME && m->state == MODEL_CONTINUOUS);
    case RMC_ACCESS_INPUT:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION
            || (m->type == INTERFACE_ME && (m->state == MODEL_EVENT || m->state == MODEL_CONTINUOUS))
            || (m->type == INTERFACE_CS && m->state == MODEL_STEP);
    case RMC_ACCESS_PARAMETER:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION;
    case RMC_ACCESS_TUNABLE_PARAMETER:
        return m->state == MODEL_INSTANTIATED || m->state == MODEL_INITIALIZATION
            || (m->type == INTERFACE_ME && m->state == MODEL_EVENT)
            || (m->type == INTERFACE_CS && m->state == MODEL_STEP);
    default: return fmi3False;
    }
}
/* One typed request: every reference names a variable of `kind` (settable
   in the current state when `setting`) and the counts cover `nvalues`. */
static bool rmc_request(const ModelInstance* m, const fmi3ValueReference vr[], size_t nvr, size_t nvalues, unsigned char kind, bool setting) {
    size_t total = 0;
    for (size_t k = 0; k < nvr; ++k) {
        const RmcValueReference* ref = rmc_reference(vr[k], kind);
        if (!ref || (setting && !rmc_can_set(m, ref)) || ref->count > nvalues - total) return false;
        total += ref->count;
    }
    return total == nvalues;
}
/* The settled numeric storage one reference reads; NULL on a failed refresh. */
static const double* rmc_numeric_source(ModelInstance* m, const RmcValueReference* ref) {
    if (settle_values(m) != fmi3OK) return NULL;
    switch (ref->column) {
    case RMC_COLUMN_TIME: return &m->time;
    case RMC_COLUMN_Y: return m->y;
    case RMC_COLUMN_P: return m->p;
    case RMC_COLUMN_DERIVATIVE: return evaluate_derivatives(m) == fmi3OK ? m->derivative : NULL;
    default: return NULL;
    }
}
#define RMC_GET_NUMERIC(Name, Type, KIND, CONVERT) \
FMI_EXPORT fmi3Status fmi3Get##Name(fmi3Instance i, const fmi3ValueReference vr[], size_t nvr, Type values[], size_t nvalues) { \
    ModelInstance* m = i; size_t cursor = 0; \
    if (!m || (!vr && nvr) || (!values && nvalues) || !rmc_request(m, vr, nvr, nvalues, KIND, false)) return fmi3Error; \
    for (size_t k = 0; k < nvr; ++k) { \
        const RmcValueReference* ref = &rmc_value_references[vr[k]]; const double* source = rmc_numeric_source(m, ref); \
        if (!source) return fmi3Error; \
        for (size_t j = 0; j < ref->count; ++j) { double value = source[ref->base + j]; values[cursor++] = CONVERT; } \
    } \
    return fmi3OK; \
}
#define RMC_SET_NUMERIC(Name, Type, KIND, VALID, STORE) \
FMI_EXPORT fmi3Status fmi3Set##Name(fmi3Instance i, const fmi3ValueReference vr[], size_t nvr, const Type values[], size_t nvalues) { \
    ModelInstance* m = i; size_t cursor = 0; \
    if (!m || (!vr && nvr) || (!values && nvalues) || !rmc_request(m, vr, nvr, nvalues, KIND, true)) return fmi3Error; \
    for (size_t k = 0; k < nvalues; ++k) { Type value = values[k]; (void)value; if (!(VALID)) return fmi3Error; } \
    for (size_t k = 0; k < nvr; ++k) { \
        const RmcValueReference* ref = &rmc_value_references[vr[k]]; double* target = ref->column == RMC_COLUMN_Y ? m->y : m->p; \
        for (size_t j = 0; j < ref->count; ++j) { Type value = values[cursor++]; target[ref->base + j] = STORE; } \
        if (ref->marks_parameters) m->parameters_dirty = true; \
    } \
    return fmi3OK; \
}
RMC_GET_NUMERIC(Float64, fmi3Float64, RMC_KIND_FLOAT64, value)
RMC_SET_NUMERIC(Float64, fmi3Float64, RMC_KIND_FLOAT64, isfinite(value), value)
RMC_GET_NUMERIC(Int32, fmi3Int32, RMC_KIND_INT32, (fmi3Int32)value)
RMC_SET_NUMERIC(Int32, fmi3Int32, RMC_KIND_INT32, true, (double)value)
RMC_GET_NUMERIC(Boolean, fmi3Boolean, RMC_KIND_BOOLEAN, value != 0.0)
RMC_SET_NUMERIC(Boolean, fmi3Boolean, RMC_KIND_BOOLEAN, true, value ? 1.0 : 0.0)
FMI_EXPORT fmi3Status fmi3GetString(fmi3Instance i, const fmi3ValueReference vr[], size_t nvr, fmi3String values[], size_t nvalues) {
    ModelInstance* m = i; size_t cursor = 0;
    if (!m || (!vr && nvr) || (!values && nvalues) || !rmc_request(m, vr, nvr, nvalues, RMC_KIND_STRING, false)) return fmi3Error;
    for (size_t k = 0; k < nvr; ++k) {
        const RmcValueReference* ref = &rmc_value_references[vr[k]];
        for (size_t j = 0; j < ref->count; ++j) values[cursor++] = rmc_text(m, ref->base + j);
    }
    return fmi3OK;
}
FMI_EXPORT fmi3Status fmi3SetString(fmi3Instance i, const fmi3ValueReference vr[], size_t nvr, const fmi3String values[], size_t nvalues) {
    ModelInstance* m = i; size_t cursor = 0;
    if (!m || (!vr && nvr) || (!values && nvalues) || !rmc_request(m, vr, nvr, nvalues, RMC_KIND_STRING, true)) return fmi3Error;
    for (size_t k = 0; k < nvalues; ++k) if (!values[k]) return fmi3Error;
    for (size_t k = 0; k < nvr; ++k) {
        const RmcValueReference* ref = &rmc_value_references[vr[k]];
        for (size_t j = 0; j < ref->count; ++j) if (!rmc_set_text(m, ref->base + j, values[cursor++])) return fmi3Error;
    }
    return fmi3OK;
}
FMI_EXPORT const char* fmi3GetVersion(void) { return "3.0"; }
FMI_EXPORT fmi3Instance fmi3InstantiateModelExchange(fmi3String name, fmi3String token, fmi3String resources, fmi3Boolean visible, fmi3Boolean loggingOn, fmi3InstanceEnvironment environment, fmi3LogMessageCallback logger) {
    (void)name; (void)resources; (void)visible; (void)loggingOn; (void)environment; (void)logger;
    if (!token || strcmp(token, "{{ artifact.identities.fmu }}") != 0) return NULL;
    ModelInstance* m = calloc(1, sizeof(ModelInstance)); if (!m) return NULL; initialize_values(m); m->environment=environment; m->logger=logger; m->type=INTERFACE_ME; m->state = MODEL_INSTANTIATED; return m;
}
FMI_EXPORT fmi3Instance fmi3InstantiateCoSimulation(fmi3String name, fmi3String token, fmi3String resources, fmi3Boolean visible, fmi3Boolean loggingOn, fmi3Boolean eventModeUsed, fmi3Boolean earlyReturnAllowed, const fmi3ValueReference requiredIntermediateVariables[], size_t nRequiredIntermediateVariables, fmi3InstanceEnvironment environment, fmi3LogMessageCallback logger, fmi3IntermediateUpdateCallback intermediateUpdate) {
    (void)name;(void)resources;(void)visible;(void)loggingOn;(void)earlyReturnAllowed;(void)environment;(void)logger;(void)intermediateUpdate;
    (void)requiredIntermediateVariables;
    if(eventModeUsed || nRequiredIntermediateVariables!=0 || !token || strcmp(token,"{{ artifact.identities.fmu }}")!=0)return NULL;
    ModelInstance* m=calloc(1,sizeof(ModelInstance));if(!m)return NULL;initialize_values(m);m->environment=environment;m->logger=logger;m->type=INTERFACE_CS;m->state=MODEL_INSTANTIATED;return m;
}
FMI_EXPORT fmi3Instance fmi3InstantiateScheduledExecution(fmi3String name, fmi3String token, fmi3String resources, fmi3Boolean visible, fmi3Boolean loggingOn, fmi3InstanceEnvironment environment, fmi3LogMessageCallback logger, fmi3ClockUpdateCallback clockUpdate, fmi3LockPreemptionCallback lockPreemption, fmi3UnlockPreemptionCallback unlockPreemption) { (void)name;(void)token;(void)resources;(void)visible;(void)loggingOn;(void)environment;(void)logger;(void)clockUpdate;(void)lockPreemption;(void)unlockPreemption;return NULL; }
FMI_EXPORT void fmi3FreeInstance(fmi3Instance instance) { if (instance) rmc_release_text(instance); free(instance); }
FMI_EXPORT fmi3Status fmi3SetDebugLogging(fmi3Instance i, fmi3Boolean loggingOn, size_t n, const fmi3String categories[]) { (void)loggingOn; return i && (categories || n == 0) ? fmi3OK : fmi3Error; }
FMI_EXPORT fmi3Status fmi3EnterInitializationMode(fmi3Instance i, fmi3Boolean td, fmi3Float64 tol, fmi3Float64 start, fmi3Boolean sd, fmi3Float64 stop) { ModelInstance* m=i; if (!m || m->state != MODEL_INSTANTIATED || !isfinite(start) || (td && (!isfinite(tol) || tol < 0.0)) || (sd && (!isfinite(stop) || stop < start))) return fmi3Error; m->time=start; m->tolerance=td ? tol : 0.0; m->state=MODEL_INITIALIZATION; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3ExitInitializationMode(fmi3Instance i) { ModelInstance* m=i; if (!m || m->state != MODEL_INITIALIZATION || {% if me_refresh.init.rows > 0 %}rmc_initialize(m, m->tolerance) != fmi3OK || {% endif %}initialize_assertions(m) != fmi3OK || evaluate_derivatives(m) != fmi3OK) return fmi3Error; m->state=m->type==INTERFACE_ME?MODEL_EVENT:MODEL_STEP; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3EnterEventMode(fmi3Instance i) { ModelInstance* m=i; if (!m || m->type != INTERFACE_ME || (m->state != MODEL_EVENT && m->state != MODEL_CONTINUOUS)) return fmi3Error; m->state=MODEL_EVENT; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3UpdateDiscreteStates(fmi3Instance i, fmi3Boolean* need, fmi3Boolean* terminate, fmi3Boolean* nominalsChanged, fmi3Boolean* valuesChanged, fmi3Boolean* nextDefined, fmi3Float64* nextTime) { ModelInstance* m=i; if (!m || m->state != MODEL_EVENT || !need || !terminate || !nominalsChanged || !valuesChanged || !nextDefined || !nextTime) return fmi3Error; if (settle_assertion_event(m) != fmi3OK) return fmi3Error; *need=0; *terminate=0; *nominalsChanged=0; *valuesChanged=0; *nextDefined=0; *nextTime=0.0; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3EnterContinuousTimeMode(fmi3Instance i) { ModelInstance* m=i; if (!m || m->type != INTERFACE_ME || m->state != MODEL_EVENT) return fmi3Error; m->state=MODEL_CONTINUOUS; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3Terminate(fmi3Instance i) { ModelInstance* m=i; if (!m || (m->state != MODEL_EVENT && m->state != MODEL_CONTINUOUS && m->state != MODEL_STEP)) return fmi3Error; m->state=MODEL_TERMINATED; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3Reset(fmi3Instance i) { ModelInstance* m=i; if (!m) return fmi3Error; initialize_values(m); m->state=MODEL_INSTANTIATED; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3SetTime(fmi3Instance i, fmi3Float64 time) { ModelInstance* m=i; if (!m || m->type != INTERFACE_ME || m->state != MODEL_CONTINUOUS || !isfinite(time)) return fmi3Error; m->time=time; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3SetContinuousStates(fmi3Instance i, const fmi3Float64 x[], size_t nx) { ModelInstance* m=i; if (!m || m->type != INTERFACE_ME || m->state != MODEL_CONTINUOUS || nx != {{ solve.solve_layout.state_scalar_count }} || (!x && nx)) return fmi3Error; for(size_t k=0;k<nx;++k)if(!isfinite(x[k]))return fmi3Error; for(size_t k=0;k<nx;++k)m->y[k]=x[k]; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3GetContinuousStates(fmi3Instance i, fmi3Float64 x[], size_t nx) { ModelInstance* m=i; if (!m || m->type != INTERFACE_ME || m->state == MODEL_INSTANTIATED || m->state == MODEL_STEP || nx != {{ solve.solve_layout.state_scalar_count }} || (!x && nx)) return fmi3Error; for(size_t k=0;k<nx;++k)x[k]=m->y[k]; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3GetContinuousStateDerivatives(fmi3Instance i, fmi3Float64 dx[], size_t nx) { ModelInstance* m=i; if (!m || m->type != INTERFACE_ME || m->state == MODEL_INSTANTIATED || m->state == MODEL_STEP || nx != {{ solve.solve_layout.state_scalar_count }} || (!dx && nx) || evaluate_derivatives(m)!=fmi3OK) return fmi3Error; for(size_t k=0;k<nx;++k)dx[k]=m->derivative[k]; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3GetNominalsOfContinuousStates(fmi3Instance i, fmi3Float64 values[], size_t nx) { ModelInstance* m=i; if (!m || m->type != INTERFACE_ME || nx != {{ solve.solve_layout.state_scalar_count }} || (!values && nx)) return fmi3Error; for(size_t k=0;k<nx;++k)values[k]=1.0; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3GetEventIndicators(fmi3Instance i, fmi3Float64 values[], size_t ni) { ModelInstance* m=i; (void)values; return m && m->type == INTERFACE_ME && m->state != MODEL_INSTANTIATED && m->state != MODEL_STEP && ni==0?fmi3OK:fmi3Error; }
FMI_EXPORT fmi3Status fmi3GetNumberOfContinuousStates(fmi3Instance i, size_t* nx) { ModelInstance* m=i; if(!m||m->type!=INTERFACE_ME||!nx)return fmi3Error; *nx={{ solve.solve_layout.state_scalar_count }}; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3GetNumberOfEventIndicators(fmi3Instance i, size_t* ni) { ModelInstance* m=i; if(!m||m->type!=INTERFACE_ME||!ni)return fmi3Error; *ni=0; return fmi3OK; }
FMI_EXPORT fmi3Status fmi3CompletedIntegratorStep(fmi3Instance i, fmi3Boolean noSetState, fmi3Boolean* enterEventMode, fmi3Boolean* terminate) { (void)noSetState; ModelInstance* m=i; if(!m||m->type!=INTERFACE_ME||m->state!=MODEL_CONTINUOUS||!enterEventMode||!terminate)return fmi3Error; *enterEventMode=fmi3False; *terminate=fmi3False; return fmi3OK; }

