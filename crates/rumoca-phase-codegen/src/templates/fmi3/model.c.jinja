}
static inline fmi3Boolean modelica_index_offset(const size_t dimensions[], const int64_t indices[], size_t rank, size_t* offset) {
    size_t result = 0;
    for (size_t axis = 0; axis < rank; ++axis) {
        if (indices[axis] < 1 || (uint64_t)indices[axis] > dimensions[axis]) return fmi3False;
        result = result * dimensions[axis] + (size_t)(indices[axis] - 1);
    }
    *offset = result;
    return fmi3True;
}
