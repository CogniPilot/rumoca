FMI_EXPORT fmi3Status fmi3DoStep(fmi3Instance i,fmi3Float64 current,fmi3Float64 step,fmi3Boolean noSetState,fmi3Boolean* eventNeeded,fmi3Boolean* terminate,fmi3Boolean* earlyReturn,fmi3Float64* lastTime){
    (void)noSetState; ModelInstance* m=i;
    if(!m||m->type!=INTERFACE_CS||m->state!=MODEL_STEP||!eventNeeded||!terminate||!earlyReturn||!lastTime||!isfinite(current)||!isfinite(step)||step<=0.0)return fmi3Error;
    if(fabs(current-m->time)>1e-12*fmax(1.0,fmax(fabs(current),fabs(m->time))))return fmi3Error;
    double old_y[Y_LEN];for(size_t k=0;k<Y_LEN;++k)old_y[k]=m->y[k];
    if(integrate_rk4(m,current,step)!=fmi3OK){for(size_t k=0;k<Y_LEN;++k)m->y[k]=old_y[k];m->time=current;return fmi3Error;}
    *eventNeeded=fmi3False;*terminate=fmi3False;*earlyReturn=fmi3False;*lastTime=m->time;return fmi3OK;
}
