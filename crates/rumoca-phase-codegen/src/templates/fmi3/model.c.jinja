static fmi3Status integrate_rk4(ModelInstance* m, fmi3Float64 start, fmi3Float64 step) {
    double initial[STATE_LEN]; double k1[STATE_LEN]; double k2[STATE_LEN]; double k3[STATE_LEN]; double k4[STATE_LEN];
    size_t count = {{ solve.solve_layout.state_scalar_count }};
    for (size_t i=0;i<count;++i) initial[i]=m->y[i];
    m->time=start; if(evaluate_derivatives(m)!=fmi3OK)return fmi3Error;
    for(size_t i=0;i<count;++i){k1[i]=m->derivative[i];m->y[i]=initial[i]+0.5*step*k1[i];}
    m->time=start+0.5*step; if(evaluate_derivatives(m)!=fmi3OK)return fmi3Error;
    for(size_t i=0;i<count;++i){k2[i]=m->derivative[i];m->y[i]=initial[i]+0.5*step*k2[i];}
    if(evaluate_derivatives(m)!=fmi3OK)return fmi3Error;
    for(size_t i=0;i<count;++i){k3[i]=m->derivative[i];m->y[i]=initial[i]+step*k3[i];}
    m->time=start+step; if(evaluate_derivatives(m)!=fmi3OK)return fmi3Error;
