/* solve_ops.rs orient_typed_root_zero and relation_memory_value_from_root. */
static double rmc_orient_root(double root, signed char zero) {
    if (root != 0.0) return root;
    return zero > 0 ? DBL_EPSILON : (zero < 0 ? -DBL_EPSILON : root);
}
static double rmc_memory_value(double root) { return root < 0.0 ? 1.0 : 0.0; }
/* solve_ops.rs runtime_value_changed. */
static bool rmc_value_changed(double before, double after, double tol) {
    if (memcmp(&before, &after, sizeof(double)) == 0) return false;
    if (!isfinite(before) || !isfinite(after)) return true;
    double scale = fmax(1.0, fmax(fabs(before), fabs(after)));
    return fabs(before - after) > fabs(tol) * scale;
}
static bool rmc_root_overridden(const ModelInstance* m, size_t root) {
    for (size_t k = 0; k < m->rmc_override_count; ++k) if (m->rmc_override_root[k] == root) return true;
    return false;
}

{%- set te = ev.time_events %}
{%- set nclock = te.clocks|length %}
{%- set ninstant = te.instants|length %}
/* Time events: the static instants and the periodic clock schedules the
   Solve problem owns (timeline.rs). A time event is announced to a Model
   Exchange importer and ends a Co-Simulation interval exactly. */
#define RMC_TIME_INSTANTS {{ ninstant }}
#define RMC_CLOCKS {{ nclock }}
static const double rmc_time_instant[{{ [ninstant, 1]|max }}] = { {% for instant in te.instants %}{{ instant }},{% else %}0.0{% endfor %} };
static const double rmc_clock_period[{{ [nclock, 1]|max }}] = { {% for clock in te.clocks %}{{ clock.period }},{% else %}1.0{% endfor %} };
static const double rmc_clock_phase[{{ [nclock, 1]|max }}] = { {% for clock in te.clocks %}{{ clock.phase }},{% else %}0.0{% endfor %} };
static const double rmc_clock_phase_numerator[{{ [nclock, 1]|max }}] = { {% for clock in te.clocks %}{{ clock.phase_numerator }},{% else %}0.0{% endfor %} };
static const double rmc_clock_period_numerator[{{ [nclock, 1]|max }}] = { {% for clock in te.clocks %}{{ clock.period_numerator }},{% else %}1.0{% endfor %} };
static const double rmc_clock_denominator[{{ [nclock, 1]|max }}] = { {% for clock in te.clocks %}{{ clock.denominator }},{% else %}1.0{% endfor %} };
static const size_t rmc_clock_activation[{{ [nclock, 1]|max }}] = { {% for clock in te.clocks %}{{ clock.activation }},{% else %}0{% endfor %} };
/* timeline.rs sample_time_match_with_tol. */
static bool rmc_time_match(double a, double b) {
    return fabs(a - b) <= {{ te.match_tolerance }} * (1.0 + fmax(fabs(a), fabs(b)));
}
/* timeline.rs event_time_in_window. */
static bool rmc_time_in_window(double event, double current, double target) {
    return isfinite(event) && event > current && (event < target || rmc_time_match(event, target));
}
/* timeline.rs schedule_tick_time: the tick's exact ratio rounded once. */
static double rmc_clock_tick_time(size_t clock, double tick) {
    return (rmc_clock_phase_numerator[clock] + tick * rmc_clock_period_numerator[clock]) / rmc_clock_denominator[clock];
}
/* timeline.rs periodic_schedule_matches_time. */
static bool rmc_clock_active(size_t clock, double t) {
    double period = rmc_clock_period[clock], phase = rmc_clock_phase[clock];
    if (!isfinite(period) || !isfinite(phase) || period <= 0.0 || t + period < phase) return false;
    double ticks = (t - phase) / period;
    return ticks >= 0.0 && rmc_time_match(ticks, round(ticks));
}
/* The answer of a time-event query: no event in the window, the next event, or
   a clock whose ticks the match tolerance cannot tell apart from `current`
   (the schedule lattice is finer than the time resolution). */
typedef enum { RMC_NO_EVENT, RMC_EVENT, RMC_EVENT_UNRESOLVED } RmcNext;
/* timeline.rs next_schedule_event_time: the first tick of `clock` after
   `current` and within `target`. The linked runtime gives up after four ticks
   and reports no event; a tick it cannot resolve here is RMC_EVENT_UNRESOLVED,
   which the entry points return as an FMI error, never a dropped tick. */
static RmcNext rmc_clock_next(size_t clock, double current, double target, double* event) {
    double period = rmc_clock_period[clock], phase = rmc_clock_phase[clock];
    if (!isfinite(period) || !isfinite(phase) || period <= 0.0 || !isfinite(current) || !isfinite(target)) return RMC_NO_EVENT;
    double tick = fmax(floor((current - phase) / period), 0.0);
    for (int attempt = 0; attempt < 4; ++attempt) {
        double at = rmc_clock_tick_time(clock, tick);
        if (rmc_time_in_window(at, current, target) && !rmc_time_match(at, current)) { *event = at; return RMC_EVENT; }
        if (at > target && !rmc_time_match(at, target)) return RMC_NO_EVENT;
        double first_distinct = current + {{ te.match_tolerance }} * (1.0 + fmax(fabs(at), fabs(current)));
        double next = fmax(fmax(floor((first_distinct - phase) / period) + 1.0, tick + 1.0), 0.0);
        if (!isfinite(next) || next <= tick) return RMC_NO_EVENT;
        tick = next;
    }
    return RMC_EVENT_UNRESOLVED;
}
/* runtime/schedule.rs next_stop: the earliest time event after `current` and
   within `target`, instants and clock ticks alike. */
static RmcNext rmc_next_time_event(double current, double target, double* event) {
    bool found = false;
    for (size_t k = 0; k != RMC_TIME_INSTANTS; ++k) {
        double at = rmc_time_instant[k];
        if (at > current && !rmc_time_match(at, current) && (at < target || rmc_time_match(at, target)) && (!found || at < *event)) { *event = at; found = true; }
    }
    for (size_t k = 0; k != RMC_CLOCKS; ++k) {
        double at = 0.0;
        RmcNext next = rmc_clock_next(k, current, target, &at);
        if (next == RMC_EVENT_UNRESOLVED) return RMC_EVENT_UNRESOLVED;
        if (next == RMC_EVENT && (!found || at < *event)) { *event = at; found = true; }
    }
    return found ? RMC_EVENT : RMC_NO_EVENT;
}
/* solve_ops.rs write_clock_activation_params: every activation lane reads
   whether its clock ticks at `t`; an event holds them for its iteration. */
static void rmc_write_clock_lanes(ModelInstance* m, double t) {
    for (size_t k = 0; k != RMC_CLOCKS; ++k) m->p[rmc_clock_activation[k]] = rmc_clock_active(k, t) ? 1.0 : 0.0;
    (void)m; (void)t;
}
/* solve_ops.rs write_observation_clock_activation_params: outside an event no
   clock ticks. */
static void rmc_clear_clock_lanes(ModelInstance* m) {
    for (size_t k = 0; k != RMC_CLOCKS; ++k) m->p[rmc_clock_activation[k]] = 0.0;
    (void)m;
}

/* component.rs event_indicators_into: the searched roots at the refreshed
   coordinate, an exact zero reported on its domain's side. */
static {{ prefix }}Status rmc_event_indicators(ModelInstance* m, double* z) {
    double roots[{{ [nroots, 1]|max }}] = {0};
    if (settle_values(m) != {{ prefix }}OK || rmc_eval_roots(m, roots) != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t k = 0; k != RMC_EVENT_INDICATORS; ++k) {
        size_t root = rmc_indicator_root[k];
        double value = roots[root];
        if (value == 0.0) {
            signed char zero = rmc_root_zero[root];
            value = zero > 0 ? DBL_EPSILON : (zero < 0 ? -DBL_EPSILON : (m->rmc_domain_valid && m->rmc_domain[k] ? DBL_EPSILON : -DBL_EPSILON));
        }
        z[k] = value;
    }
    return {{ prefix }}OK;
}

/* component.rs complete_indicator_domains: a changed domain captures the
   event entry and arms each crossed root's post-event relation side. */
static {{ prefix }}Status rmc_events_completed(ModelInstance* m, bool* enter) {
    double z[{{ [nind, 1]|max }}];
    *enter = false;
    if (RMC_EVENT_INDICATORS == 0) return {{ prefix }}OK;
    if (rmc_event_indicators(m, z) != {{ prefix }}OK) return {{ prefix }}Error;
    if (!m->rmc_domain_valid) {
        for (size_t k = 0; k != RMC_EVENT_INDICATORS; ++k) m->rmc_domain[k] = z[k] > 0.0;
        m->rmc_domain_valid = true;
        return {{ prefix }}OK;
    }
    bool changed = false;
    for (size_t k = 0; k != RMC_EVENT_INDICATORS; ++k) changed |= m->rmc_domain[k] != (z[k] > 0.0);
    if (!changed) return {{ prefix }}OK;
    memcpy(m->rmc_entry_y, m->y, sizeof(m->y));
    memcpy(m->rmc_entry_p, m->p, sizeof(m->p));
    m->rmc_entry_captured = true;
    m->rmc_override_count = 0;
    for (size_t k = 0; k != RMC_EVENT_INDICATORS; ++k) {
        bool now = z[k] > 0.0;
        if (now != m->rmc_domain[k]) {
            m->rmc_override_root[m->rmc_override_count] = rmc_indicator_root[k];
            m->rmc_override_value[m->rmc_override_count] = now ? 0.0 : 1.0;
            ++m->rmc_override_count;
        }
        m->rmc_domain[k] = now;
    }
    *enter = true;
    return {{ prefix }}OK;
}

/* relation_memory.rs apply_root_relation_memory_overrides. */
static bool rmc_apply_overrides(ModelInstance* m) {
    bool changed = false;
    for (size_t k = 0; k < m->rmc_override_count; ++k) {
        long target = rmc_root_memory[m->rmc_override_root[k]];
        if (target < 0) continue;
        double value = m->rmc_override_value[k];
        changed |= memcmp(&m->p[target], &value, sizeof(double)) != 0;
        m->p[target] = value;
    }
    return changed;
}

/* relation_memory.rs refresh_event_relation_memory and, with
   `algebraic_only`, update_algebraic_relation_memory_from_solver_y_except_overrides:
   release overrides the roots now contradict, then encode every other root. */
static {{ prefix }}Status rmc_relation_refresh(ModelInstance* m, bool algebraic_only, bool* changed) {
    double roots[{{ [nroots, 1]|max }}] = {0};
    *changed = false;
    if (rmc_eval_roots(m, roots) != {{ prefix }}OK) return {{ prefix }}Error;
    size_t kept = 0;
    for (size_t k = 0; k < m->rmc_override_count; ++k) {
        size_t root = m->rmc_override_root[k];
        bool include = !algebraic_only || rmc_root_algebraic[root];
        if (!include || roots[root] == 0.0 || rmc_memory_value(roots[root]) == m->rmc_override_value[k]) {
            m->rmc_override_root[kept] = root;
            m->rmc_override_value[kept] = m->rmc_override_value[k];
            ++kept;
        } else {
            *changed = true;
        }
    }
    m->rmc_override_count = kept;
    for (size_t root = 0; root != RMC_ROOTS; ++root) {
        long target = rmc_root_memory[root];
        if (target < 0 || (algebraic_only && !rmc_root_algebraic[root]) || rmc_root_overridden(m, root)) continue;
        double value = rmc_memory_value(rmc_orient_root(roots[root], rmc_root_zero[root]));
        *changed |= memcmp(&m->p[target], &value, sizeof(double)) != 0;
        m->p[target] = value;
    }
    return {{ prefix }}OK;
}

/* kernel.rs project_event_algebraics: refresh the algebraic coordinate and
   report a change beyond the instance tolerance. */
static {{ prefix }}Status rmc_event_projection(ModelInstance* m, bool* changed) {
    double before[Y_LEN];
    memcpy(before, m->y, sizeof(m->y));
    if (refresh_algebraics(m) != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t k = 0; k < Y_LEN; ++k) if (rmc_value_changed(before[k], m->y[k], m->tolerance)) { *changed = true; break; }
    return {{ prefix }}OK;
}

