    RMC_LOG(m, "the discrete event iteration stalled; the coupled event Newton solve is not rendered in C");
    return {{ prefix }}Error;
}

/* relation_memory.rs on_relation_surface: an iteration that returns to the
   discrete values and relation memory of one of its last passes with the
   coordinate unchanged sits on a surface where its alternating relations'
   expression is continuous; every state of the cycle is a fixed point. */
#define RMC_SURFACE_WINDOW {{ schedule.relation_surface_window }}
typedef struct { double* data; size_t count; size_t head; } RmcSurface;
static bool rmc_surface_open(RmcSurface* s) {
    s->count = 0; s->head = 0;
    s->data = RMC_SURFACE_WINDOW > 0 ? malloc((size_t)RMC_SURFACE_WINDOW * (Y_LEN + P_LEN) * sizeof(double)) : NULL;
    return RMC_SURFACE_WINDOW == 0 || s->data != NULL;
}
static void rmc_surface_close(RmcSurface* s) { free(s->data); s->data = NULL; }
static bool rmc_on_surface(const ModelInstance* m, RmcSurface* s) {
    if (!s->data) return false;
    bool repeats = false;
    for (size_t k = 0; k < s->count && !repeats; ++k) {
        const double* entry = s->data + k * (Y_LEN + P_LEN);
        bool same = memcmp(entry + Y_LEN, m->p, sizeof(m->p)) == 0;
        for (size_t i = 0; same && i < Y_LEN; ++i) same = !rmc_value_changed(entry[i], m->y[i], m->tolerance);
        repeats = same;
    }
    double* slot = s->data + s->head * (Y_LEN + P_LEN);
    memcpy(slot, m->y, sizeof(m->y));
    memcpy(slot + Y_LEN, m->p, sizeof(m->p));
    s->head = (s->head + 1) % (size_t)RMC_SURFACE_WINDOW;
    if (s->count < (size_t)RMC_SURFACE_WINDOW) ++s->count;
    return repeats;
}

/* The relation pass (relation_memory.rs settle_event_equations_with_fixed_pre). */
/* relation_memory.rs search_consistent_mode: when the relation passes cycle,
   the cycling relations and their neighborhoods are searched jointly for a
   mode whose projected coordinate gives each relation its assigned side. */
{%- set nb = namespace(offsets=[], flat=[]) %}
{%- for hood in ev.root_neighborhoods %}{% set nb.offsets = nb.offsets + [nb.flat|length] %}{% set nb.flat = nb.flat + hood %}{% endfor %}
{%- set nb.offsets = nb.offsets + [nb.flat|length] %}
#define RMC_MODE_LIMIT {{ schedule.mode_search_relations }}
static const size_t rmc_neighbor_offset[{{ nb.offsets|length }}] = { {% for o in nb.offsets %}{{ o }},{% endfor %} };
static const size_t rmc_neighbor[{{ [nb.flat|length, 1]|max }}] = { {% for r in nb.flat %}{{ r }},{% else %}0{% endfor %} };
static size_t rmc_mode_candidates(const ModelInstance* m, const RmcSurface* s, size_t* candidates) {
    bool cycling[RMC_ROOT_SLOTS] = {false}, joined[RMC_ROOT_SLOTS] = {false};
    for (size_t root = 0; root != RMC_ROOTS; ++root) {
        long memory = rmc_root_memory[root];
        for (size_t k = 0; memory >= 0 && k < s->count && !cycling[root]; ++k)
            cycling[root] = s->data[k * (Y_LEN + P_LEN) + Y_LEN + (size_t)memory] != m->p[memory];
    }
    for (size_t root = 0; root != RMC_ROOTS; ++root)
        for (size_t k = rmc_neighbor_offset[root]; cycling[root] && k < rmc_neighbor_offset[root + 1]; ++k) joined[rmc_neighbor[k]] = true;
    size_t count = 0;
    for (size_t root = 0; root != RMC_ROOTS; ++root)
        if (joined[root] && rmc_root_memory[root] >= 0) { if (count < RMC_MODE_LIMIT) candidates[count] = root; ++count; }
    return count;
}
static bool rmc_mode_consistent(ModelInstance* m, const size_t* candidates, size_t count, size_t mode) {
    for (size_t k = 0; k < count; ++k) m->p[rmc_root_memory[candidates[k]]] = (mode >> k & 1u) ? 1.0 : 0.0;
    if (refresh_algebraics(m) != {{ prefix }}OK) return false;
    double roots[RMC_ROOT_SLOTS] = {0};
    if (rmc_eval_roots(m, roots) != {{ prefix }}OK) return false;
    for (size_t k = 0; k < count; ++k) {
        double value = rmc_orient_root(roots[candidates[k]], rmc_root_zero[candidates[k]]);
        if (value != 0.0 && rmc_memory_value(value) != ((mode >> k & 1u) ? 1.0 : 0.0)) return false;
    }
    return true;
}
static {{ prefix }}Status rmc_mode_search(ModelInstance* m, const RmcSurface* s, bool* found) {
    size_t candidates[RMC_MODE_LIMIT > 0 ? RMC_MODE_LIMIT : 1];
    size_t count = rmc_mode_candidates(m, s, candidates);
    *found = false;
    if (count == 0 || count > RMC_MODE_LIMIT) {
        RMC_LOG(m, "event iteration cycles among more relations than the mode search covers");
        return {{ prefix }}Error;
    }
    double* base = malloc((Y_LEN + P_LEN) * sizeof(double));
    if (!base) { RMC_LOG(m, "the mode search could not allocate its base point"); return {{ prefix }}Error; }
    memcpy(base, m->y, sizeof(m->y));
    memcpy(base + Y_LEN, m->p, sizeof(m->p));
    for (size_t mode = 0; mode < ((size_t)1 << count) && !*found; ++mode) {
        *found = rmc_mode_consistent(m, candidates, count, mode);
        if (*found) {
            size_t kept = 0;
            for (size_t k = 0; k < m->rmc_override_count; ++k) {
                bool pinned = false;
                for (size_t c = 0; c < count; ++c) pinned |= m->rmc_override_root[k] == candidates[c];
                if (!pinned) { m->rmc_override_root[kept] = m->rmc_override_root[k]; m->rmc_override_value[kept] = m->rmc_override_value[k]; ++kept; }
            }
            for (size_t c = 0; c < count; ++c) { m->rmc_override_root[kept] = candidates[c]; m->rmc_override_value[kept] = (mode >> c & 1u) ? 1.0 : 0.0; ++kept; }
            m->rmc_override_count = kept;
        } else {
            memcpy(m->y, base, sizeof(m->y));
            memcpy(m->p, base + Y_LEN, sizeof(m->p));
        }
    }
    free(base);
    /* relation_memory.rs resolve_relation_cycle: no joint mode is consistent,
       so the current side is kept and reported as a relation-surface settle. */
    if (!*found) RMC_LOG_AT(m, "relation_surface", "an event iteration kept a relation on its coordinate surface");
    return {{ prefix }}OK;
}

static {{ prefix }}Status rmc_relation_passes(ModelInstance* m, bool* changed_any, RmcSurface* surface);
static {{ prefix }}Status rmc_relation_settle(ModelInstance* m, bool* changed_any) {
    RmcSurface surface;
    if (!rmc_surface_open(&surface)) { RMC_LOG(m, "the relation surface history could not be allocated"); return {{ prefix }}Error; }
    {{ prefix }}Status status = rmc_relation_passes(m, changed_any, &surface);
    rmc_surface_close(&surface);
    return status;
}
static {{ prefix }}Status rmc_relation_passes(ModelInstance* m, bool* changed_any, RmcSurface* surface) {
    for (size_t pass = 0; pass < {{ schedule.fixed_point_cap }}; ++pass) {
        bool step_changed = false;
{%- for step in schedule.relation_pass %}
{%- if step == "DiscreteSettle" %}
        if (rmc_discrete_settle(m, changed_any) != {{ prefix }}OK) return {{ prefix }}Error;
{%- elif step == "SettledIfRelationsUnchanged" %}
        if (rmc_relation_refresh(m, false, &step_changed) != {{ prefix }}OK) return {{ prefix }}Error;
        if (!step_changed) return {{ prefix }}OK;
        *changed_any = true;
{%- elif step == "AlgebraicProjection" %}
{{- projection_step("step_changed", prefix) }}
{%- elif step == "RuntimeAssignments" %}
        if (rmc_runtime_assignments(m, &step_changed) != {{ prefix }}OK) return {{ prefix }}Error;
{%- else %}{{ fail("unsupported-feature:fmi.c.relation-step " ~ step) }}{% endif %}
{%- endfor %}
        if (rmc_on_surface(m, surface)) {
            bool found = false;
            if (rmc_mode_search(m, surface, &found) != {{ prefix }}OK) return {{ prefix }}Error;
            if (!found) return {{ prefix }}OK;
            surface->count = 0; surface->head = 0;
            *changed_any = true;
        }
    }
    RMC_LOG(m, "event condition equations did not converge with fixed pre");
    return {{ prefix }}Error;
}

/* One event pass, as the schedule lists its steps. */
static {{ prefix }}Status rmc_event_pass(ModelInstance* m, bool* changed) {
    bool step = false;
{%- for s in schedule.event_pass %}
{%- if s == "RelationOverrides" %}
    *changed |= rmc_apply_overrides(m);
{%- elif s == "RuntimeAssignments" %}
    if (rmc_runtime_assignments(m, &step) != {{ prefix }}OK) return {{ prefix }}Error;
{%- elif s == "AlgebraicProjection" %}
{{- projection_step("step", prefix) }}
{%- elif s == "RelationRefresh" %}
    step = false;
    if (rmc_relation_refresh(m, false, &step) != {{ prefix }}OK) return {{ prefix }}Error;
    if (step && rmc_runtime_assignments(m, &step) != {{ prefix }}OK) return {{ prefix }}Error;
{%- elif s == "RelationSettle" %}
    if (rmc_relation_settle(m, changed) != {{ prefix }}OK) return {{ prefix }}Error;
{%- else %}{{ fail("unsupported-feature:fmi.c.event-step " ~ s) }}{% endif %}
    *changed |= step;
{%- endfor %}
    return {{ prefix }}OK;
}

/* relation_memory.rs apply_projected_event_update, eval_event_actions, and
   component.rs commit_event_runtime_state. Pre values are seeded from the
   event entry; each later pass reads the previous pass (Appendix B). */
static {{ prefix }}Status rmc_event_iterate_passes(ModelInstance* m, bool canonicalize) {
    for (size_t k = 0; k < RMC_PRE_LANES; ++k) m->p[rmc_pre_dest[k]] = rmc_pre_source(m->rmc_entry_y, m->rmc_entry_p, k);
    bool settled = false;
    RmcSurface surface;
    if (!rmc_surface_open(&surface)) { RMC_LOG(m, "the event surface history could not be allocated"); return {{ prefix }}Error; }
    for (size_t pass = 0; pass < {{ schedule.fixed_point_cap }} && !settled; ++pass) {
        m->rmc_pass = pass;
        bool changed = pass > 0 && rmc_advance_lanes(m);
        if (rmc_event_pass(m, &changed) != {{ prefix }}OK) { rmc_surface_close(&surface); return {{ prefix }}Error; }
        /* relation_memory.rs: condition memories advance on the settled pass,
           before the next pass advances the pre lanes. */
        if (rmc_discrete_owners(m, &changed, true) != {{ prefix }}OK) { rmc_surface_close(&surface); return {{ prefix }}Error; }
        settled = !changed && rmc_lanes_settled(m);
        if (settled || !rmc_on_surface(m, &surface)) continue;
        bool found = false;
        if (rmc_mode_search(m, &surface, &found) != {{ prefix }}OK) { rmc_surface_close(&surface); return {{ prefix }}Error; }
        if (found) { surface.count = 0; surface.head = 0; } else settled = true;
    }
    rmc_surface_close(&surface);
    if (!settled) { RMC_LOG(m, "event update iteration did not converge"); return {{ prefix }}Error; }
{%- if ev.condition_memories|length > 0 %}
    /* solve_events.rs event_action_params: actions read each condition memory
       at its event-entry value. */
    static const size_t memories[{{ ev.condition_memories|length }}] = { {% for index in ev.condition_memories %}{{ index }},{% endfor %} };
    double held[{{ ev.condition_memories|length }}];
    for (size_t k = 0; k < {{ ev.condition_memories|length }}; ++k) { held[k] = m->p[memories[k]]; m->p[memories[k]] = m->rmc_entry_p[memories[k]]; }
    {{ prefix }}Status actions = check_assertions(m);
    if (actions == {{ prefix }}OK) actions = report_warnings(m);
    for (size_t k = 0; k < {{ ev.condition_memories|length }}; ++k) m->p[memories[k]] = held[k];
    if (actions != {{ prefix }}OK) return {{ prefix }}Error;
{%- else %}
    if (check_assertions(m) != {{ prefix }}OK || report_warnings(m) != {{ prefix }}OK) return {{ prefix }}Error;
{%- endif %}
    /* pre_params.rs commit_pre_params_after_event_at. */
    bool history = false;
    double committed_p[P_LEN];
    memcpy(committed_p, m->p, sizeof(m->p));
    for (size_t k = 0; k < RMC_PRE_LANES; ++k) {
        double value = rmc_pre_source(m->y, committed_p, k);
        history |= rmc_value_changed(m->p[rmc_pre_dest[k]], value, m->tolerance);
        m->p[rmc_pre_dest[k]] = value;
    }
    if (!canonicalize || !history) return {{ prefix }}OK;
    /* component.rs canonicalize_committed_event_view. */
    for (size_t round = 0; round < {{ schedule.fixed_point_cap }}; ++round) {
        bool changed = false, relations = false;
        if (rmc_post_commit_assignments(m, &changed) != {{ prefix }}OK) return {{ prefix }}Error;
        if (rmc_event_projection(m, &changed) != {{ prefix }}OK || rmc_relation_refresh(m, true, &relations) != {{ prefix }}OK) return {{ prefix }}Error;
        if (!changed && !relations) return {{ prefix }}OK;
    }
    RMC_LOG(m, "the post-commit event view did not converge");
    return {{ prefix }}Error;
}

/* The discrete inputs as the last event saw them. */
#define RMC_DISCRETE_INPUTS {{ ev.discrete_inputs|length }}
static const size_t rmc_discrete_input[{{ [ev.discrete_inputs|length, 1]|max }}] = { {% for index in ev.discrete_inputs %}{{ index }},{% else %}0{% endfor %} };
static void rmc_discrete_inputs_seen(ModelInstance* m) {
    for (size_t k = 0; k != RMC_DISCRETE_INPUTS; ++k) m->rmc_input_seen[k] = m->p[rmc_discrete_input[k]];
    (void)m;
}
/* A discrete-time input changes only at events (MLS §4.5): one the importer
   set since the last event is an event at the next instant. */
static bool rmc_discrete_inputs_changed(const ModelInstance* m) {
    for (size_t k = 0; k != RMC_DISCRETE_INPUTS; ++k) if (memcmp(&m->rmc_input_seen[k], &m->p[rmc_discrete_input[k]], sizeof(double)) != 0) return true;
    (void)m;
    return false;
}

/* One event at `m->time`: every clock that ticks there reads active for the
   whole iteration, and none reads active once it has settled. */
static {{ prefix }}Status rmc_event_iterate(ModelInstance* m, bool canonicalize) {
    rmc_write_clock_lanes(m, m->time);
    {{ prefix }}Status status = rmc_event_iterate_passes(m, canonicalize);
    rmc_clear_clock_lanes(m);
    m->rmc_pass = 0;
    return status;
}

/* component.rs exit_initialization_mode_inner and discrete_rows.rs
   seed_condition_memory_for_initialization: relation memory from the settled
   state, then every condition memory with pre following the current value. */
static {{ prefix }}Status rmc_events_initialize(ModelInstance* m) {
    bool changed = false;
    m->rmc_override_count = 0;
    if (settle_values(m) != {{ prefix }}OK || rmc_relation_refresh(m, false, &changed) != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t k = 0; k < RMC_PRE_LANES; ++k) m->p[rmc_pre_dest[k]] = rmc_pre_source(m->y, m->p, k);
    if (rmc_discrete_owners(m, &changed, true) != {{ prefix }}OK) return {{ prefix }}Error;
    memcpy(m->rmc_entry_y, m->y, sizeof(m->y));
    memcpy(m->rmc_entry_p, m->p, sizeof(m->p));
    m->rmc_entry_captured = true;
    m->rmc_initial_event = true;
    m->rmc_domain_valid = false;
    rmc_discrete_inputs_seen(m);
    /* Assertions are checked from here on, with every condition memory seeded. */
    m->assertions_initialized = true;
    return {{ prefix }}OK;
}

/* runtime/schedule.rs coincident_scheduled_event: an event at a static instant
   is observed at its right limit unless a clock ticks there (EventEntry wins
   the merge of the two owners' pre modes). */
static bool rmc_observes_right_limit(double t) {
    bool instant = false;
    for (size_t k = 0; k != RMC_TIME_INSTANTS; ++k) instant |= rmc_time_match(rmc_time_instant[k], t);
    for (size_t k = 0; k != RMC_CLOCKS; ++k) if (rmc_clock_active(k, t)) return false;
    return instant;
}

/* Event Mode: the initial event after initialization, else the state event
   the completed step captured. Without a captured entry (a host-requested
   event), the entry is the current coordinate. */
static {{ prefix }}Status rmc_events_update(ModelInstance* m, bool* states_changed) {
    bool initial = m->rmc_initial_event;
    double states[STATE_LEN];
    memcpy(states, m->y, sizeof(states));
    if (!m->rmc_entry_captured) {
        if (settle_values(m) != {{ prefix }}OK) return {{ prefix }}Error;
        memcpy(m->rmc_entry_y, m->y, sizeof(m->y));
        memcpy(m->rmc_entry_p, m->p, sizeof(m->p));
        m->rmc_override_count = 0;
    }
    m->rmc_right_valid = false;
    {{ prefix }}Status status = rmc_event_iterate(m, !initial);
    /* event_boundary.rs apply_event_right_limit: the right limit observes the
       same event, so it starts again from the event-entry discrete values. */
    if (status == {{ prefix }}OK && !initial && rmc_observes_right_limit(m->time)) {
        m->rmc_anchor = m->time; m->rmc_right = nextafter(m->time, DBL_MAX); m->rmc_right_valid = true;
        memcpy(m->p, m->rmc_entry_p, sizeof(m->p));
        status = rmc_event_iterate(m, true);
    }
    if (status == {{ prefix }}OK) rmc_discrete_inputs_seen(m);
    *states_changed = memcmp(states, m->y, sizeof(states)) != 0;
    m->rmc_entry_captured = false;
    m->rmc_initial_event = false;
    m->rmc_override_count = 0;
    return status;
}

/* component.rs seed_settled_indicator_domains. */
static {{ prefix }}Status rmc_events_continuous(ModelInstance* m) {
    double z[{{ [nind, 1]|max }}];
    if (RMC_EVENT_INDICATORS == 0) return {{ prefix }}OK;
    if (rmc_event_indicators(m, z) != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t k = 0; k != RMC_EVENT_INDICATORS; ++k) {
        long memory = rmc_root_memory[rmc_indicator_root[k]];
        bool previous = m->rmc_domain_valid ? m->rmc_domain[k] : z[k] > 0.0;
        m->rmc_domain[k] = memory >= 0 ? m->p[memory] <= 0.5 : previous;
    }
    m->rmc_domain_valid = true;
    return {{ prefix }}OK;
}

/* Co-Simulation has no Event Mode call: the initial event, and with it the
   values of a tick at the start instant, runs as initialization exits. */
static {{ prefix }}Status rmc_cs_start(ModelInstance* m) {
    bool reinit = false;
    if (!m->rmc_initial_event) return {{ prefix }}OK;
    return rmc_events_update(m, &reinit) == {{ prefix }}OK && rmc_events_continuous(m) == {{ prefix }}OK ? {{ prefix }}OK : {{ prefix }}Error;
}

/* The time event Event Mode announces: the first instant or clock tick after
   the current time (`nextEventTime`). */
static RmcNext rmc_next_event(const ModelInstance* m, double* event) {
    return rmc_next_time_event(m->time, DBL_MAX, event);
}
{%- endmacro %}

{#- The refinement method of a RootLocationPlan (ME-EVENT-004): RootBracket of
    rumoca-ir-solve fmi/root_location/bracket.rs, operation for operation, so a
    bracket narrows through the same coordinates as in the linked runtime. -#}
{%- macro root_refinement(plan) %}
{%- if plan.refinement_method != "IllinoisMinmax" %}{{ fail("unsupported-feature:fmi.c.root-refinement " ~ plan.refinement_method) }}{% endif %}
{%- if plan.tie_break != "ToleranceWindow" %}{{ fail("unsupported-feature:fmi.c.root-tie-break " ~ plan.tie_break) }}{% endif %}
/* RootBracket: a domain change between `low` (no changed indicator has left
   its domain) and `high` (one has), narrowed to `tolerance`. */
typedef struct {
    double low, high, tolerance, schedule, low_weight, high_weight;
    int last_moved; /* 0 none, -1 low, 1 high */
} RmcRootBracket;
/* RootBracket::open. */
static RmcRootBracket rmc_root_open(double low, double high, double tolerance) {
    RmcRootBracket b = { low, high, tolerance, tolerance, 1.0, 1.0, 0 };
    for (size_t k = 0; k < 2100 && b.schedule < high - low; ++k) b.schedule *= 2.0;
    for (unsigned k = 0; k < {{ plan.minmax_slack }}u; ++k) b.schedule *= 2.0;
    return b;
}
/* RootBracket::is_located. */
static bool rmc_root_located(const RmcRootBracket* b) {
    return b->high - b->low <= b->tolerance;
}
/* RootBracket::crossing_fraction. */
static double rmc_root_fraction(const RmcRootBracket* b, double at_low, double at_high) {
    double low = b->low_weight * fabs(at_low), high = b->high_weight * fabs(at_high);
    double sum = low + high;
    return sum > 0.0 && isfinite(sum) ? low / sum : 0.5;
}
/* RootBracket::trial. */
static bool rmc_root_trial(const RmcRootBracket* b, double least, double* trial) {
    double width = b->high - b->low;
    double middle = b->low + 0.5 * width;
    double secant = fmin(fmax(b->low + width * least, b->low + 0.5 * b->tolerance), b->high - 0.5 * b->tolerance);
    double radius = fmax(0.5 * b->schedule - 0.5 * width, 0.0);
    double projected = secant - middle > radius ? middle + radius : (middle - secant > radius ? middle - radius : secant);
    if (b->low < projected && projected < b->high) { *trial = projected; return true; }
    if (b->low < middle && middle < b->high) { *trial = middle; return true; }
    return false;
}
/* RootBracket::application_window. */
static double rmc_root_window(const RmcRootBracket* b, double upper) {
    return fmin(b->low + b->tolerance, upper);
}
/* RootBracket::narrow. */
static void rmc_root_narrow(RmcRootBracket* b, double trial, bool entered) {
    int moved = entered ? 1 : -1;
    if (entered) { b->high = trial; b->high_weight = 1.0; } else { b->low = trial; b->low_weight = 1.0; }
    if (b->last_moved == moved) { if (entered) b->low_weight *= 0.5; else b->high_weight *= 0.5; }
    b->last_moved = moved;
    b->schedule *= 0.5;
}
{%- endmacro %}

{#- Co-Simulation stepping with located state events (ME-EVENT-004). The scan
    cadence, the location tolerance, the refinement method, and its budget are
    the component's RootLocationPlan; `integrate` is the plan's error-controlled
    substep integrator over one interval. -#}
{%- macro cs_events(fmi, integrate, prefix) %}
{%- set plan = fmi.root_location %}
{{- root_refinement(plan) }}
/* RootLocationPlan::scan_resolution. */
static double rmc_scan_resolution(double width) {
    width = fabs(width);
    return isfinite(width) && width > 0.0 ? fmax(width * {{ plan.scan_fraction }}, DBL_MIN) : {{ plan.fallback_scan_resolution }};
}
/* RootLocationPlan::interval_roundoff. */
static double rmc_interval_roundoff(double start, double duration) {
    return fmax({{ plan.roundoff_epsilons }} * DBL_EPSILON * (fabs(start) + fabs(duration)), DBL_MIN);
}
/* RootLocationPlan::location_tolerance over interval_roundoff. */
static double rmc_location_tolerance(double start, double scan) {
    return fmin(rmc_interval_roundoff(start, scan), scan);
}
/* The indicators `z` at the current coordinate, and whether any has left the
   domain its relation memory holds. */
static {{ prefix }}Status rmc_domains_changed(ModelInstance* m, double* z, bool* changed) {
    *changed = false;
    if (RMC_EVENT_INDICATORS == 0 || !m->rmc_domain_valid) return {{ prefix }}OK;
    if (rmc_event_indicators(m, z) != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t k = 0; k != RMC_EVENT_INDICATORS; ++k) *changed |= m->rmc_domain[k] != (z[k] > 0.0);
    return {{ prefix }}OK;
}
/* Narrow the interval [t, t + h], whose end has a changed domain (`z_high`)
   and whose start has none (`z_low`), to the location tolerance by the plan's
   refinement (root.rs refine_earliest), and integrate to the application
   coordinate the tie-break picks; `*application` is its distance from `t`. */
static {{ prefix }}Status rmc_cs_locate(ModelInstance* m, double t, double h, const double* y0, double* z_low, double* z_high, double* application) {
    double z[{{ [fmi.event_indicator_roots|length, 1]|max }}] = {0};
    bool changed = false;
    RmcRootBracket bracket = rmc_root_open(0.0, h, rmc_location_tolerance(t, h));
    bool exhausted = true;
    for (size_t iter = 0; iter < {{ plan.refinement_iteration_cap }}; ++iter) {
        double least = 1.0, trial = 0.0;
        if (rmc_root_located(&bracket)) { exhausted = false; break; }
        for (size_t k = 0; k != RMC_EVENT_INDICATORS; ++k) {
            if (m->rmc_domain[k] != (z_high[k] > 0.0)) least = fmin(least, rmc_root_fraction(&bracket, z_low[k], z_high[k]));
        }
        /* No representable coordinate strictly inside the bracket. */
        if (!rmc_root_trial(&bracket, least, &trial)) { exhausted = false; break; }
        memcpy(m->y, y0, sizeof(m->y));
        if ({{ integrate }}(m, t, trial) != {{ prefix }}OK || rmc_domains_changed(m, z, &changed) != {{ prefix }}OK) return {{ prefix }}Error;
        rmc_root_narrow(&bracket, trial, changed);
        memcpy(changed ? z_high : z_low, z, sizeof(z));
    }
    if (exhausted && !rmc_root_located(&bracket)) { RMC_LOG(m, "state event location exceeded its refinement budget"); return {{ prefix }}Error; }
    /* RootTieBreak::ToleranceWindow (root.rs window_application): the window
       end applies every change within one tolerance after the left limit when
       a changed indicator stands in its new domain there. */
    *application = bracket.high;
    double window = rmc_root_window(&bracket, h);
    bool integrated_to_application = false;
    if (window > bracket.high) {
        memcpy(m->y, y0, sizeof(m->y));
        if ({{ integrate }}(m, t, window) != {{ prefix }}OK || rmc_domains_changed(m, z, &changed) != {{ prefix }}OK) return {{ prefix }}Error;
        if (changed) { *application = window; integrated_to_application = true; }
    }
    if (!integrated_to_application) {
        memcpy(m->y, y0, sizeof(m->y));
        if ({{ integrate }}(m, t, *application) != {{ prefix }}OK) return {{ prefix }}Error;
    }
    return {{ prefix }}OK;
}
/* One scan interval from `t`: integrate; when a domain changed, locate the
   crossing (rmc_cs_locate), integrate to it, and run Event Mode there.
   `*advanced` is the time covered.
   An interval that ends at a time event also looks one location tolerance
   past its end, the window the tie-break above applies after a located root:
   a state root the substep integrator reaches a rounding short of the instant
   joins the time event's iteration, as it does in the simulation, whose
   integration reaches the instant. */
static {{ prefix }}Status rmc_cs_interval(ModelInstance* m, double t, double h, bool ends_at_time_event, double* advanced) {
    double y0[Y_LEN];
    /* Every indicator buffer is defined on every path: rmc_domains_changed
       leaves its output untouched while no domain is armed, and the
       refinement copies whole buffers. */
    double z[{{ [fmi.event_indicator_roots|length, 1]|max }}] = {0};
    double z_low[{{ [fmi.event_indicator_roots|length, 1]|max }}] = {0};
    double z_high[{{ [fmi.event_indicator_roots|length, 1]|max }}] = {0};
    bool changed = false;
    memcpy(y0, m->y, sizeof(m->y));
    {{ prefix }}Status integrated = {{ integrate }}(m, t, h);
    if (integrated != {{ prefix }}OK) return integrated == {{ prefix }}Discard ? {{ prefix }}Discard : {{ prefix }}Error;
    if (rmc_domains_changed(m, z_high, &changed) != {{ prefix }}OK) return {{ prefix }}Error;
    *advanced = h;
    if (!changed && ends_at_time_event && RMC_EVENT_INDICATORS != 0 && m->rmc_domain_valid) {
        double settled[Y_LEN], substep = m->rmc_cs_substep;
        memcpy(settled, m->y, sizeof(settled));
        memcpy(m->y, y0, sizeof(m->y));
        bool past_end = false;
        if ({{ integrate }}(m, t, h + rmc_location_tolerance(t, h)) != {{ prefix }}OK || rmc_domains_changed(m, z, &past_end) != {{ prefix }}OK) return {{ prefix }}Error;
        if (!past_end) { memcpy(m->y, settled, sizeof(settled)); m->rmc_cs_substep = substep; }
        m->time = t + h;
        /* The caller's time event iteration observes the changed domain. */
        return {{ prefix }}OK;
    }
    if (!changed) return {{ prefix }}OK;
    memcpy(m->y, y0, sizeof(m->y));
    m->time = t;
    if (rmc_event_indicators(m, z_low) != {{ prefix }}OK) return {{ prefix }}Error;
    if (rmc_cs_locate(m, t, h, y0, z_low, z_high, advanced) != {{ prefix }}OK) return {{ prefix }}Error;
    /* RootLocationPlan::coincides_with_time_event: a root located within the
       interval's roundoff of the time event it ends at is not applied on its
       own; the interval ends at the event and the event's iteration handles
       it. */
    if (ends_at_time_event && fabs(h - *advanced) <= rmc_interval_roundoff(t, h)) {
        memcpy(m->y, y0, sizeof(m->y));
        if ({{ integrate }}(m, t, h) != {{ prefix }}OK) return {{ prefix }}Error;
        *advanced = h;
        return {{ prefix }}OK;
    }
    bool enter = false;
    if (rmc_events_completed(m, &enter) != {{ prefix }}OK) return {{ prefix }}Error;
    bool reinit = false;
    if (enter && (rmc_events_update(m, &reinit) != {{ prefix }}OK || rmc_events_continuous(m) != {{ prefix }}OK)) return {{ prefix }}Error;
    return {{ prefix }}OK;
}
static {{ prefix }}Status rmc_cs_advance(ModelInstance* m, double start, double step) {
    double end = start + step, t = start;
    /* Co-Simulation has no Event Mode call: the initial event runs here. */
    bool reinit = false;
    if (m->rmc_initial_event && rmc_events_update(m, &reinit) != {{ prefix }}OK) return {{ prefix }}Error;
    if (!m->rmc_domain_valid && rmc_events_continuous(m) != {{ prefix }}OK) return {{ prefix }}Error;
    /* The importer sets inputs between steps: an indicator that reads one may
       have changed domain since the last step ended, which is an event at the
       step's first instant, handled before integrating. */
    bool entered = false;
    if (rmc_events_completed(m, &entered) != {{ prefix }}OK) return {{ prefix }}Error;
    entered |= rmc_discrete_inputs_changed(m);
    if (entered && (rmc_events_update(m, &reinit) != {{ prefix }}OK || rmc_events_continuous(m) != {{ prefix }}OK)) return {{ prefix }}Error;
    while (t < end) {
        /* Indicators bound the scan; a component without any integrates a
           whole interval. */
        double scan = RMC_EVENT_INDICATORS == 0 ? INFINITY : (m->rmc_scan > 0.0 ? m->rmc_scan : rmc_scan_resolution(NAN));
        double h = fmin(end - t, scan), advanced = 0.0, event = 0.0;
        /* A time event inside the interval ends it exactly at the event, and
           an event at the interval's end is handled at the end. */
        RmcNext next = rmc_next_time_event(t, t + h, &event);
        if (next == RMC_EVENT_UNRESOLVED) { RMC_LOG(m, "a clock tick is finer than the time resolution"); return {{ prefix }}Error; }
        bool at_event = next == RMC_EVENT;
        if (at_event) h = fmin(event, t + h) - t;
        {{ prefix }}Status interval = rmc_cs_interval(m, t, h, at_event, &advanced);
        if (interval != {{ prefix }}OK) return interval == {{ prefix }}Discard ? {{ prefix }}Discard : {{ prefix }}Error;
        t = advanced == end - t ? end : t + advanced;
        m->time = t;
        if (at_event && advanced == h && (rmc_events_update(m, &reinit) != {{ prefix }}OK || rmc_events_continuous(m) != {{ prefix }}OK)) return {{ prefix }}Error;
    }
    return {{ prefix }}OK;
}
{%- endmacro %}
