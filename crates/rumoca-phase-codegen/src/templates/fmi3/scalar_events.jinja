{#- State events of the scalar event profile (SPEC_0044 ME-EVENT-002 to 006).

    Every decision below is a Solve IR fact carried by `fmi.scalar_events`:
    the indicator table (`fmi.event_indicator_roots`), each root's search
    role, zero domain, relation-memory target, and refresh role, the pre-binding
    lanes, and the event iteration schedule, whose steps are rendered in the
    order the schedule lists them. The linked runtime walks the same facts
    (rumoca-solver fmi_me/kernel/component.rs and runtime/solve_runtime/
    relation_memory.rs, discrete_rows.rs). -#}
{%- from "fmi-c-kernel.jinja" import scalar_op %}

{%- macro event_fields(fmi) -%}
{%- if fmi.scalar_events %} bool rmc_domain[{{ [fmi.event_indicator_roots|length, 1]|max }}]; bool rmc_domain_valid; double rmc_indicator[{{ [fmi.event_indicator_roots|length, 1]|max }}]; double rmc_entry_y[Y_LEN]; double rmc_entry_p[P_LEN]; bool rmc_entry_captured; bool rmc_initial_event; double rmc_scan; size_t rmc_override_root[{{ [fmi.scalar_events.roots|length, 1]|max }}]; double rmc_override_value[{{ [fmi.scalar_events.roots|length, 1]|max }}]; size_t rmc_override_count;{% endif -%}
{%- endmacro %}

{%- macro event_reset(fmi) -%}
{%- if fmi.scalar_events %} m->rmc_domain_valid=false; m->rmc_entry_captured=false; m->rmc_initial_event=false; m->rmc_override_count=0; m->rmc_scan=0.0;{% endif -%}
{%- endmacro %}

{#- One named change step of a pass; `flag` accumulates whether it changed the
    coordinate. -#}
{%- macro projection_step(flag, prefix) %}
        if (rmc_event_projection(m, &{{ flag }}) != {{ prefix }}OK) return {{ prefix }}Error;
{%- endmacro %}

{#- relation_memory.rs apply_prepared_update_rows_until_stable: every row of
    the block reads the same coordinate, then all write; repeat until nothing
    changes. -#}
{%- macro update_rows(name, plan, targets, cap, prefix) %}
static {{ prefix }}Status {{ name }}(ModelInstance* m, bool* changed) {
{%- if targets|length > 0 %}
    static const size_t index[{{ targets|length }}] = { {% for slot in targets %}{{ slot.index }},{% endfor %} };
    static const bool in_y[{{ targets|length }}] = { {% for slot in targets %}{{ "true" if slot.column == "y" else "false" }},{% endfor %} };
    double values[{{ targets|length }}];
    for (size_t round = 0; round < {{ cap }}; ++round) {
{%- for program in plan.programs %}
        {
        double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "values", prefix ~ "Error") }}
{%- endfor %}
        }
{%- endfor %}
        bool round_changed = false;
        for (size_t k = 0; k < {{ targets|length }}; ++k) {
            double* slot = in_y[k] ? &m->y[index[k]] : &m->p[index[k]];
            round_changed |= memcmp(slot, &values[k], sizeof(double)) != 0;
            *slot = values[k];
        }
        if (!round_changed) return {{ prefix }}OK;
        *changed = true;
    }
    RMC_LOG(m, "{{ name }} did not converge");
    return {{ prefix }}Error;
{%- else %}
    (void)m; (void)changed;
    return {{ prefix }}OK;
{%- endif %}
}
{%- endmacro %}

{%- macro scalar_events(solve, fmi, prefix) %}
{%- set ev = fmi.scalar_events %}
{%- set nroots = ev.roots|length %}
{%- set nind = fmi.event_indicator_roots|length %}
{%- set ndisc = ev.discrete_targets|length %}
{%- set schedule = ev.schedule %}
#define RMC_EVENT_INDICATORS {{ nind }}
#define RMC_ROOTS {{ nroots }}
static const size_t rmc_indicator_root[{{ [nind, 1]|max }}] = { {% for root in fmi.event_indicator_roots %}{{ root }},{% else %}0{% endfor %} };
/* Zero domain per root: 1 positive, -1 non-positive, 0 previous side. */
static const signed char rmc_root_zero[{{ [nroots, 1]|max }}] = { {% for root in ev.roots %}{{ 1 if root.zero == "positive" else (-1 if root.zero == "non_positive" else 0) }},{% else %}0{% endfor %} };
/* Relation-memory parameter per root, or -1. */
static const long rmc_root_memory[{{ [nroots, 1]|max }}] = { {% for root in ev.roots %}{{ root.memory if root.memory is not none else -1 }},{% else %}-1{% endfor %} };
static const bool rmc_root_algebraic[{{ [nroots, 1]|max }}] = { {% for root in ev.roots %}{{ "true" if root.algebraic_dependent else "false" }},{% else %}false{% endfor %} };

/* All root rows at the current coordinate, as Event Mode reads them. */
static {{ prefix }}Status rmc_eval_roots(ModelInstance* m, double* roots) {
    (void)m; (void)roots;
{%- for program in solve.events.root_plan.programs %}
    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "roots", prefix ~ "Error") }}
{%- endfor %}
    }
{%- endfor %}
    for (size_t k = 0; k < RMC_ROOTS; ++k) if (!isfinite(roots[k])) return {{ prefix }}Error;
    return {{ prefix }}OK;
}
/* solve_ops.rs orient_typed_root_zero and relation_memory_value_from_root. */
static double rmc_orient_root(double root, signed char zero) {
    if (root != 0.0) return root;
    return zero > 0 ? DBL_EPSILON : (zero < 0 ? -DBL_EPSILON : root);
}
static double rmc_memory_value(double root) { return root < 0.0 ? 1.0 : 0.0; }
/* solve_ops.rs runtime_value_changed. */
static bool rmc_value_changed(double before, double after, double tol) {
    if (memcmp(&before, &after, sizeof(double)) == 0) return false;
    if (!isfinite(before) || !isfinite(after)) return true;
    double scale = fmax(1.0, fmax(fabs(before), fabs(after)));
    return fabs(before - after) > fabs(tol) * scale;
}
static bool rmc_root_overridden(const ModelInstance* m, size_t root) {
    for (size_t k = 0; k < m->rmc_override_count; ++k) if (m->rmc_override_root[k] == root) return true;
    return false;
}

/* component.rs event_indicators_into: the searched roots at the refreshed
   coordinate, an exact zero reported on its domain's side. */
static {{ prefix }}Status rmc_event_indicators(ModelInstance* m, double* z) {
    double roots[{{ [nroots, 1]|max }}];
    if (settle_values(m) != {{ prefix }}OK || rmc_eval_roots(m, roots) != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t k = 0; k < RMC_EVENT_INDICATORS; ++k) {
        size_t root = rmc_indicator_root[k];
        double value = roots[root];
        if (value == 0.0) {
            signed char zero = rmc_root_zero[root];
            value = zero > 0 ? DBL_EPSILON : (zero < 0 ? -DBL_EPSILON : (m->rmc_domain_valid && m->rmc_domain[k] ? DBL_EPSILON : -DBL_EPSILON));
        }
        z[k] = value;
    }
    return {{ prefix }}OK;
}

/* component.rs complete_indicator_domains: a changed domain captures the
   event entry and arms each crossed root's post-event relation side. */
static {{ prefix }}Status rmc_events_completed(ModelInstance* m, bool* enter) {
    double z[{{ [nind, 1]|max }}];
    *enter = false;
    if (RMC_EVENT_INDICATORS == 0) return {{ prefix }}OK;
    if (rmc_event_indicators(m, z) != {{ prefix }}OK) return {{ prefix }}Error;
    if (!m->rmc_domain_valid) {
        for (size_t k = 0; k < RMC_EVENT_INDICATORS; ++k) m->rmc_domain[k] = z[k] > 0.0;
        m->rmc_domain_valid = true;
        return {{ prefix }}OK;
    }
    bool changed = false;
    for (size_t k = 0; k < RMC_EVENT_INDICATORS; ++k) changed |= m->rmc_domain[k] != (z[k] > 0.0);
    if (!changed) return {{ prefix }}OK;
    memcpy(m->rmc_entry_y, m->y, sizeof(m->y));
    memcpy(m->rmc_entry_p, m->p, sizeof(m->p));
    m->rmc_entry_captured = true;
    m->rmc_override_count = 0;
    for (size_t k = 0; k < RMC_EVENT_INDICATORS; ++k) {
        bool now = z[k] > 0.0;
        if (now != m->rmc_domain[k]) {
            m->rmc_override_root[m->rmc_override_count] = rmc_indicator_root[k];
            m->rmc_override_value[m->rmc_override_count] = now ? 0.0 : 1.0;
            ++m->rmc_override_count;
        }
        m->rmc_domain[k] = now;
    }
    *enter = true;
    return {{ prefix }}OK;
}

/* relation_memory.rs apply_root_relation_memory_overrides. */
static bool rmc_apply_overrides(ModelInstance* m) {
    bool changed = false;
    for (size_t k = 0; k < m->rmc_override_count; ++k) {
        long target = rmc_root_memory[m->rmc_override_root[k]];
        if (target < 0) continue;
        double value = m->rmc_override_value[k];
        changed |= memcmp(&m->p[target], &value, sizeof(double)) != 0;
        m->p[target] = value;
    }
    return changed;
}

/* relation_memory.rs refresh_event_relation_memory and, with
   `algebraic_only`, update_algebraic_relation_memory_from_solver_y_except_overrides:
   release overrides the roots now contradict, then encode every other root. */
static {{ prefix }}Status rmc_relation_refresh(ModelInstance* m, bool algebraic_only, bool* changed) {
    double roots[{{ [nroots, 1]|max }}];
    *changed = false;
    if (rmc_eval_roots(m, roots) != {{ prefix }}OK) return {{ prefix }}Error;
    size_t kept = 0;
    for (size_t k = 0; k < m->rmc_override_count; ++k) {
        size_t root = m->rmc_override_root[k];
        bool include = !algebraic_only || rmc_root_algebraic[root];
        if (!include || roots[root] == 0.0 || rmc_memory_value(roots[root]) == m->rmc_override_value[k]) {
            m->rmc_override_root[kept] = root;
            m->rmc_override_value[kept] = m->rmc_override_value[k];
            ++kept;
        } else {
            *changed = true;
        }
    }
    m->rmc_override_count = kept;
    for (size_t root = 0; root < RMC_ROOTS; ++root) {
        long target = rmc_root_memory[root];
        if (target < 0 || (algebraic_only && !rmc_root_algebraic[root]) || rmc_root_overridden(m, root)) continue;
        double value = rmc_memory_value(rmc_orient_root(roots[root], rmc_root_zero[root]));
        *changed |= memcmp(&m->p[target], &value, sizeof(double)) != 0;
        m->p[target] = value;
    }
    return {{ prefix }}OK;
}

/* kernel.rs project_event_algebraics: refresh the algebraic coordinate and
   report a change beyond the instance tolerance. */
static {{ prefix }}Status rmc_event_projection(ModelInstance* m, bool* changed) {
    double before[Y_LEN];
    memcpy(before, m->y, sizeof(m->y));
    if (refresh_algebraics(m) != {{ prefix }}OK) return {{ prefix }}Error;
    for (size_t k = 0; k < Y_LEN; ++k) if (rmc_value_changed(before[k], m->y[k], m->tolerance)) { *changed = true; break; }
    return {{ prefix }}OK;
}

/* discrete_rows.rs apply_discrete_rows_for_pre_snapshot: every row reads the
   pass's snapshot, a row writing an overridden relation memory keeps the
   located side, and a change is a change of bits. A settle pass writes the
   discrete equations; `memories_only` writes only the condition memories,
   which advance between passes (advance_condition_memory). */
static {{ prefix }}Status rmc_discrete_owners(ModelInstance* m, bool* changed, bool memories_only) {
    (void)m; (void)changed; (void)memories_only;
{%- set nguard = ev.guarded_targets|length %}
{%- if ndisc > 0 %}
    static const size_t targets[{{ ndisc }}] = { {% for target in ev.discrete_targets %}{{ target }},{% endfor %} };
    static const bool memory_row[{{ ndisc }}] = { {% for row in ev.condition_memory_rows %}{{ "true" if row else "false" }},{% endfor %} };
    double values[{{ ndisc }}];
{%- for program in solve.discrete.rhs_plan.programs %}
    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "values", prefix ~ "Error") }}
{%- endfor %}
    }
{%- endfor %}
{%- endif %}
{%- if nguard > 0 %}
    /* guarded_assignments.rs: every guarded owner reads the same snapshot as
       the rows; a target that is an overridden relation memory keeps the
       located side. Clock-free owners run in every pass. */
    static const size_t gindex[{{ nguard }}] = { {% for slot in ev.guarded_targets %}{{ slot.index }},{% endfor %} };
    static const bool gin_y[{{ nguard }}] = { {% for slot in ev.guarded_targets %}{{ "true" if slot.column == "y" else "false" }},{% endfor %} };
    double gvalues[{{ nguard }}];
    if (!memories_only) {
{%- for program in solve.discrete.guarded_assignment_plan.programs %}
    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "gvalues", prefix ~ "Error") }}
{%- endfor %}
    }
{%- endfor %}
    }
{%- endif %}
{%- if ndisc > 0 %}
    for (size_t k = 0; k < m->rmc_override_count; ++k) {
        long memory = rmc_root_memory[m->rmc_override_root[k]];
        if (memory < 0) continue;
        for (size_t d = 0; d < {{ ndisc }}; ++d) if ((long)targets[d] == memory) values[d] = m->rmc_override_value[k];
    }
    for (size_t d = 0; d < {{ ndisc }}; ++d) {
        if (memories_only != memory_row[d]) continue;
        *changed |= memcmp(&m->p[targets[d]], &values[d], sizeof(double)) != 0;
        m->p[targets[d]] = values[d];
    }
{%- endif %}
{%- if nguard > 0 %}
    if (!memories_only) {
        for (size_t k = 0; k < m->rmc_override_count; ++k) {
            long memory = rmc_root_memory[m->rmc_override_root[k]];
            if (memory < 0) continue;
            for (size_t g = 0; g < {{ nguard }}; ++g) if (!gin_y[g] && (long)gindex[g] == memory) gvalues[g] = m->rmc_override_value[k];
        }
        for (size_t g = 0; g < {{ nguard }}; ++g) {
            double* slot = gin_y[g] ? &m->y[gindex[g]] : &m->p[gindex[g]];
            *changed |= memcmp(slot, &gvalues[g], sizeof(double)) != 0;
            *slot = gvalues[g];
        }
    }
{%- endif %}
    return {{ prefix }}OK;
}

{{ update_rows("rmc_runtime_assignments", solve.discrete.runtime_assignment_plan, ev.runtime_targets, schedule.fixed_point_cap, prefix) }}
{{ update_rows("rmc_post_commit_assignments", solve.discrete.post_commit_assignment_plan, ev.post_commit_targets, schedule.fixed_point_cap, prefix) }}

/* The pre-binding lanes (pre_params.rs). */
{%- set lanes = ev.pre_bindings %}
static double rmc_pre_source(const double* y, const double* p, size_t lane) {
{%- if lanes|length > 0 %}
    static const size_t source[{{ lanes|length }}] = { {% for lane in lanes %}{{ lane.source }},{% endfor %} };
    static const bool from_y[{{ lanes|length }}] = { {% for lane in lanes %}{{ "true" if lane.column == "y" else "false" }},{% endfor %} };
    return from_y[lane] ? y[source[lane]] : p[source[lane]];
{%- else %}
    (void)y; (void)p; (void)lane; return 0.0;
{%- endif %}
}
static const size_t rmc_pre_dest[{{ [lanes|length, 1]|max }}] = { {% for lane in lanes %}{{ lane.dest }},{% else %}0{% endfor %} };
static const size_t rmc_pre_lanes = {{ lanes|length }};
#define RMC_PRE_LANES rmc_pre_lanes
{%- if ev.iteration_lanes|length > 0 %}
static const size_t rmc_iteration_lanes[{{ [ev.iteration_lanes|length, 1]|max }}] = { {% for lane in ev.iteration_lanes %}{{ lane }},{% else %}0{% endfor %} };
static const size_t rmc_iteration_lane_count = {{ ev.iteration_lanes|length }};
#define RMC_ITERATION_LANES rmc_iteration_lane_count
{%- endif %}
/* pre_params.rs advance_event_iteration_pre_params: the next pass reads the
   previous pass's values; `changed` when any differs. */
static bool rmc_advance_lanes(ModelInstance* m) {
    bool changed = false;
{%- if ev.iteration_lanes|length > 0 %}
    double current[{{ [ev.iteration_lanes|length, 1]|max }}];
    for (size_t k = 0; k < RMC_ITERATION_LANES; ++k) current[k] = rmc_pre_source(m->y, m->p, rmc_iteration_lanes[k]);
    for (size_t k = 0; k < RMC_ITERATION_LANES; ++k) {
        double* pre = &m->p[rmc_pre_dest[rmc_iteration_lanes[k]]];
        changed |= memcmp(pre, &current[k], sizeof(double)) != 0;
        *pre = current[k];
    }
{%- else %}
    (void)m;
{%- endif %}
