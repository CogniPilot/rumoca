/* The pre-binding lanes (pre_params.rs). */
{%- set lanes = ev.pre_bindings %}
static double rmc_pre_source(const double* y, const double* p, size_t lane) {
{%- if lanes|length > 0 %}
    static const size_t source[{{ lanes|length }}] = { {% for lane in lanes %}{{ lane.source }},{% endfor %} };
    static const bool from_y[{{ lanes|length }}] = { {% for lane in lanes %}{{ "true" if lane.column == "y" else "false" }},{% endfor %} };
    return from_y[lane] ? y[source[lane]] : p[source[lane]];
{%- else %}
    (void)y; (void)p; (void)lane; return 0.0;
{%- endif %}
}
static const size_t rmc_pre_dest[{{ [lanes|length, 1]|max }}] = { {% for lane in lanes %}{{ lane.dest }},{% else %}0{% endfor %} };
static const size_t rmc_pre_lanes = {{ lanes|length }};
#define RMC_PRE_LANES rmc_pre_lanes
{%- if ev.iteration_lanes|length > 0 %}
static const size_t rmc_iteration_lanes[{{ [ev.iteration_lanes|length, 1]|max }}] = { {% for lane in ev.iteration_lanes %}{{ lane }},{% else %}0{% endfor %} };
static const size_t rmc_iteration_lane_count = {{ ev.iteration_lanes|length }};
#define RMC_ITERATION_LANES rmc_iteration_lane_count
{%- endif %}
/* pre_params.rs advance_event_iteration_pre_params: the next pass reads the
   previous pass's values; `changed` when any differs. */
static bool rmc_advance_lanes(ModelInstance* m) {
    bool changed = false;
{%- if ev.iteration_lanes|length > 0 %}
    double current[{{ [ev.iteration_lanes|length, 1]|max }}];
    for (size_t k = 0; k < RMC_ITERATION_LANES; ++k) current[k] = rmc_pre_source(m->y, m->p, rmc_iteration_lanes[k]);
    for (size_t k = 0; k < RMC_ITERATION_LANES; ++k) {
        double* pre = &m->p[rmc_pre_dest[rmc_iteration_lanes[k]]];
        changed |= memcmp(pre, &current[k], sizeof(double)) != 0;
        *pre = current[k];
    }
{%- else %}
    (void)m;
{%- endif %}
    return changed;
}
/* pre_params.rs event_iteration_plan_settled. */
static bool rmc_lanes_settled(const ModelInstance* m) {
{%- if ev.iteration_lanes|length > 0 %}
    for (size_t k = 0; k < RMC_ITERATION_LANES; ++k) {
        double current = rmc_pre_source(m->y, m->p, rmc_iteration_lanes[k]);
        if (memcmp(&m->p[rmc_pre_dest[rmc_iteration_lanes[k]]], &current, sizeof(double)) != 0) return false;
    }
{%- else %}
    (void)m;
{%- endif %}
    return true;
}

/* The discrete settle pass, as the schedule lists its steps (ME-EVENT-006). */
static {{ prefix }}Status rmc_discrete_settle(ModelInstance* m, bool* changed_any) {
    for (size_t pass = 0; pass < {{ schedule.fixed_point_cap }}; ++pass) {
        bool pass_changed = false;
{%- for step in schedule.settle_pass %}
{%- if step == "DiscreteOwners" %}
        if (rmc_discrete_owners(m, &pass_changed, false) != {{ prefix }}OK) return {{ prefix }}Error;
{%- elif step == "RuntimeAssignments" %}
        if (rmc_runtime_assignments(m, &pass_changed) != {{ prefix }}OK) return {{ prefix }}Error;
{%- elif step == "SettledIfUnchanged" %}
        if (!pass_changed) return {{ prefix }}OK;
{%- elif step == "AlgebraicProjection" %}
{{- projection_step("pass_changed", prefix) }}
{%- else %}{{ fail("unsupported-feature:fmi.c.settle-step " ~ step) }}{% endif %}
{%- endfor %}
        *changed_any = true;
