/* All root rows at the current coordinate, as Event Mode reads them. */
static {{ prefix }}Status rmc_eval_roots(ModelInstance* m, double* roots) {
    (void)m; (void)roots;
{%- for program in solve.events.root_plan.programs %}
    {
