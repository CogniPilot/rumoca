    if (rmc_init_settle_view(m) != 0) result = -1;
    for (size_t col = 0; col < n && result == 0; ++col) {
        memset(seed, 0, RMC_SEED_LEN * sizeof(double));
        seed[rmc_init_pool[b->unknowns + col]] = 1.0;
        if (rmc_init_tangent(m, seed) != 0 || rmc_tan_rows(m, rows, RMC_INIT_ROWS, 2, seed, out, residual) != 0) { result = -1; break; }
        for (size_t row = 0; row < n; ++row) jac[row * n + col] = residual[rmc_init_pool[b->rows + row]];
