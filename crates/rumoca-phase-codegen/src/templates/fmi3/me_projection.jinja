   descriptor table holds no address constants. */
typedef struct RmcBlockDescS {
    size_t id; size_t canonical; size_t n; size_t y; size_t row_target; size_t row_program; size_t row_offset;
    size_t max_outputs; bool affine; bool singleton_exact; bool has_tearing; size_t row_ptr;
