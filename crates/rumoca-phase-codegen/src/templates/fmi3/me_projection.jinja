/* A pure call's assertion, as the component's observer answers it
   (scalar_kernel.jinja: observers) without its messages: an observation the
   model does not issue, or one with another capture count, fails the call;
   an error-level action observed for its error marks the lane; a warning
   records no notice. */
{{ device_qualifier(true) }} int rmc_model_assertion(void* context, size_t predicate, const void* const captures[], size_t count) {
{%- if fmi_assertion_observations %}
    RmcModelAssertionContext* observed = (RmcModelAssertionContext*)context;
{%- else %}
    (void)context;
{%- endif %}
    (void)predicate; (void)captures; (void)count;
{%- for observation in fmi_assertion_observations %}
    if (observed->owner == {{ observation.owner }} && predicate == {{ observation.predicate }}) {
        if (count != {{ observation.capture_count }}) return 1;
        if (observed->predicates) observed->predicates[{{ observation.predicate_index }}] = 0.0;
{%- for action in observation.actions %}{% if action.kind == "error" %}
        if (observed->mode == 1) observed->instance->assertion_failed = true;
{%- endif %}{% endfor %}
        return 0;
    }
{%- endfor %}
    return 1;
}
{{ device_qualifier(true) }} void rmc_finish_assertion_observation(RmcModelAssertionContext* context, int status) { (void)context; (void)status; }
/* A lane as a new instance starts it, but for its time, coordinate,
   parameters and `parameters_dirty`, which the caller sets: no fault or
   failed assertion, and the projection workspace zeroed as the host
   component's allocation zeroes it (device memory comes unzeroed), then the
   reset the component runs. The arena, the workspace's first two fields, is
   left as it is: `rmc_dalloc` and `rmc_salloc` zero what they hand out and a
   raw buffer is written before it is read. */
{{ device_qualifier(true) }} void rmc_lane_reset(ModelInstance* m) {
    m->rmc_nonfinite = false; m->assertion_failed = false;
    unsigned char* workspace = (unsigned char*){{ "&m->rmc_dtop" if me.kernel else "(m->p + P_LEN)" }};
    memset(workspace, 0, (size_t)((unsigned char*)(m + 1) - workspace));{{ workspace_reset(me) }}
}
