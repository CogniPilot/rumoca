{%- if values|length > 0 %}
static const {{ type }} {{ name }}[{{ values|length }}] = { {% for value in values %}{{ value }}{% if not loop.last %}, {% endif %}{% endfor %} };
{%- endif %}
{%- endmacro %}

{%- macro c_ref(name, values) -%}{% if values|length > 0 %}{{ name }}{% else %}NULL{% endif %}{%- endmacro %}

{%- macro program_function(name, program, signature, seed) %}
static int {{ name }}({{ signature }}) {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r; (void)m; (void)o;{% if seed %} (void)seed;{% endif %}
{%- for op in program.ops %}
{{ scalar_op(op, "o", "-1") }}
{%- endfor %}
    return 0;
}
{%- endmacro %}

