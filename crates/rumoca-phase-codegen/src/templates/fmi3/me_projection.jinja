#define RMC_TAN_OUTPUTS {{ tan.max_outputs }}
/* JVP rows `(function, output offset, ...)` with `stride` entries each, under
   `seed` over [solver-y | parameter]; consecutive rows of one function share
   its evaluation. -1 error */
RMC_COLD static int rmc_tan_rows(ModelInstance* m, const size_t* entries, size_t count, size_t stride, const double* seed, double* out, double* values) {
    size_t last = (size_t)-1;
    for (size_t i = 0; i < count; ++i) {
        const size_t* e = entries + stride * i;
        if (e[0] != last) { if (rmc_jvp_fn[e[0]](m, seed, out) != 0) return -1; last = e[0]; }
        values[i] = out[e[1]];
    }
    return 0;
}
{%- if tan.nblocks > 0 %}
#define RMC_TAN_BLOCKS {{ tan.nblocks }}
#define RMC_TAN_ROWS {{ tan.nrows }}
#define RMC_TAN_MAX_N {{ tan.max_n }}
/* seed_linearization.rs: SeedBlockLinearization::build: the block Jacobian
   at the settled point and its partial-pivot LU. -1 error */
RMC_COLD static int rmc_tan_factor(ModelInstance* m, const RmcBlock* b, double* jac, double* lu, size_t* ipiv, size_t* columns) {
    size_t n = b->n;
    if (rmc_jacobian(m, b, jac) != 0) return -1;
    for (size_t i = 0; i < n * n; ++i) lu[i] = 0.0;
    for (size_t row = 0; row < n; ++row)
        for (size_t e = b->row_ptr[row]; e < b->row_ptr[row + 1]; ++e) lu[row * n + b->col_idx[e]] = jac[e];
    rmc_lu(lu, n, ipiv, columns);
    return 0;
}
/* seed_linearization.rs: refine_direction: the residual of the block's
   linearized rows at the current seed, `J x + base` (equal to nalgebra's
   product up to the sign of zero); zero when every entry vanishes, else one
   LU correction. -1 error */
RMC_COLD static int rmc_tan_refine(ModelInstance* m, const RmcBlock* b, const size_t* rows, double* seed, double* inputs, double* out, double* scratch, double* lu, size_t* ipiv, size_t* columns) {
    size_t n = b->n; double* base = scratch; double* jac = scratch + n; double* correction = scratch + n + n * n;
    memcpy(inputs, seed, RMC_SEED_LEN * sizeof(double));
    for (size_t i = 0; i < n; ++i) inputs[b->y[i]] = 0.0;
    if (rmc_tan_rows(m, rows, n, 2, inputs, out, base) != 0 || rmc_tan_factor(m, b, jac, lu, ipiv, columns) != 0) return -1;
    bool zero = true;
    for (size_t row = 0; row < n; ++row) {
        double acc = 0.0;
        for (size_t e = b->row_ptr[row]; e < b->row_ptr[row + 1]; ++e) acc += jac[e] * seed[b->y[b->col_idx[e]]];
        correction[row] = -(acc + base[row]);
        zero &= correction[row] == 0.0;
    }
    if (zero) return 0;
    if (!rmc_lu_solve(lu, n, ipiv, correction)) { RMC_LOG(m, "algebraic projection sensitivity matrix is singular during refinement"); return -1; }
    for (size_t i = 0; i < n; ++i) {
        double value = seed[b->y[i]] + correction[i];
        if (!isfinite(value)) { RMC_LOG(m, "algebraic projection produced a non-finite sensitivity"); return -1; }
        seed[b->y[i]] = value;
    }
    return 0;
}
/* projection.rs: project_algebraic_seed_with_plan over the primary chart's
   complete algebraic plan: every block solves its linearized rows for its
   unknowns' seeds in plan order, then certify_with_refinement checks all
   rows at the scaled tolerance with up to two refinements. -1 error */
RMC_COLD static int rmc_tan_refresh(ModelInstance* m, double* seed) {
    RMC_MARK; int result = 0; size_t n_max = RMC_TAN_MAX_N;
    const size_t* blocks = rmc_init_pool + {{ tan.blocks }};
    const size_t* rows = rmc_init_pool + {{ tan.rows }};
    double* rscale = rmc_dalloc(m, RMC_TAN_ROWS + 1); double* residual = rmc_dalloc(m, RMC_TAN_ROWS + 1);
    double* out = rmc_dalloc(m, RMC_TAN_OUTPUTS + 1); double* inputs = rmc_dalloc(m, RMC_SEED_LEN);
    double* vscale = rmc_dalloc(m, n_max); double* scratch = rmc_dalloc(m, 2 * n_max + n_max * n_max); double* lu = rmc_dalloc(m, n_max * n_max);
    size_t* ipiv = rmc_salloc(m, n_max); size_t* columns = rmc_salloc(m, n_max);
    if (!rscale || !residual || !out || !inputs || !vscale || !scratch || !lu || !ipiv || !columns) { RMC_RELEASE; return rmc_exhausted(m); }
    for (size_t k = 0; k < RMC_TAN_BLOCKS; ++k) { const RmcBlock* b = &rmc_blocks[blocks[k]]; for (size_t i = 0; i < b->n; ++i) seed[b->y[i]] = 0.0; }
    size_t offset = 0;
    for (size_t k = 0; k < RMC_TAN_BLOCKS && result == 0; ++k) {
        const RmcBlock* b = &rmc_blocks[blocks[k]]; size_t n = b->n; double* rhs = scratch; double* jac = scratch + n;
        if (rmc_tan_rows(m, rows + 2 * offset, n, 2, seed, out, rhs) != 0 || rmc_tan_factor(m, b, jac, lu, ipiv, columns) != 0) { result = -1; break; }
        for (size_t i = 0; i < n; ++i) rhs[i] = -rhs[i];
        if (!rmc_lu_solve(lu, n, ipiv, rhs)) { RMC_LOG(m, "algebraic projection sensitivity matrix is singular"); result = -1; break; }
        for (size_t i = 0; i < n && result == 0; ++i) {
            if (!isfinite(rhs[i])) { RMC_LOG(m, "algebraic projection produced a non-finite sensitivity"); result = -1; }
            else seed[b->y[i]] = rhs[i];
        }
        if (result == 0 && rmc_block_scales_at(m, b, jac, seed, rscale + offset, vscale) != 0) result = -1;
        offset += n;
    }
    for (int iteration = 0; iteration <= 2 && result == 0; ++iteration) {
        if (rmc_tan_rows(m, rows, RMC_TAN_ROWS, 2, seed, out, residual) != 0) { result = -1; break; }
        if (rmc_scaled_converged(m->rmc_tol, residual, rscale, RMC_TAN_ROWS)) break;
        if (iteration == 2) { RMC_LOG(m, "algebraic projection sensitivity did not satisfy the selected residual system"); result = -1; break; }
        offset = 0;
        for (size_t k = 0; k < RMC_TAN_BLOCKS && result == 0; ++k) {
            const RmcBlock* b = &rmc_blocks[blocks[k]];
            if (rmc_tan_refine(m, b, rows + 2 * offset, seed, inputs, out, scratch, lu, ipiv, columns) != 0) result = -1;
            else if (rmc_block_scales_at(m, b, scratch + b->n, seed, rscale + offset, vscale) != 0) result = -1;
            offset += b->n;
        }
    }
    RMC_RELEASE; return result;
}
