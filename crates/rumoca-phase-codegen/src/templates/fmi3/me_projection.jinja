   column declines the torn solve. -1 error, 0 declined, 1 ok */
{{ q }} int rmc_reduced_jacobian(ModelInstance* m, const RmcBlock* b, double* jac, double* recovered) {
    const size_t b_k = RMC_BS(b, k); const bool b_tangent_directional = RMC_BS(b, tangent_directional); const size_t b_ncausal = RMC_BS(b, ncausal);
