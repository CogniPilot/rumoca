/* tearing.rs: line_search; -1 error, 0 declined (y at base), 2 advanced */
{{ q }} int rmc_torn_line_search(ModelInstance* m, const RmcBlock* b, const double* base, const double* delta, const double* rscale, double before, double* residual) {
    const size_t b_k = RMC_BS(b, k); const size_t* const b_tear_col_pool = RMC_BP(b, tear_col);
