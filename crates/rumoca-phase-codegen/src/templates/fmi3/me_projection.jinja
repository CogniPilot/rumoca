/* tearing.rs: causal_correction_converged; -1 error, 0 no, 1 yes */
{{ q }} int rmc_causal_converged(ModelInstance* m, const RmcBlock* b, const double* base, const double* delta, const double* rscale, double before) {
    const size_t b_ncausal = RMC_BS(b, ncausal); const size_t b_k = RMC_BS(b, k); const size_t* const b_causal_target_pool = RMC_BP(b, causal_target); const size_t* const b_causal_col_pool = RMC_BP(b, causal_col);
