}
{%- endif %}
{%- if tan.nupdates > 0 %}
#define RMC_TAN_UPDATES {{ tan.nupdates }}
/* initial_projection.rs: write_update_tangents: the update rows' JVP under
   the seed, written into their targets' seeds after all are evaluated. */
RMC_COLD {{ q }} int rmc_tan_updates(ModelInstance* m, double* seed, double* out, double* values, bool* changed) {
    const size_t* updates = rmc_init_pool + {{ tan.updates }};
    if (rmc_tan_rows(m, updates, RMC_TAN_UPDATES, 3, seed, out, values) != 0) return -1;
    for (size_t i = 0; i < RMC_TAN_UPDATES; ++i) {
        size_t target = updates[3 * i + 2];
        if (target == 0 || memcmp(&seed[target - 1], &values[i], sizeof(double)) == 0) continue;
        seed[target - 1] = values[i]; *changed = true;
    }
    return 0;
}
