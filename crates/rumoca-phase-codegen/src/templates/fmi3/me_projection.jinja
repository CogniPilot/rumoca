    for (size_t k = 0; k < P_LEN; ++k) pscale[k] = (isfinite(m->p[k]) && m->p[k] != 0.0) ? fabs(m->p[k]) : 1.0;
{%- for index in init.nominal_indices %}
    pscale[{{ index }}] = {{ init.nominal_values[loop.index0] }};
{%- endfor %}
    for (int iteration = 0; iteration < RMC_REFINE_ITERS && result == 1; ++iteration) {
        bool changed = false;
        rmc_init_seed(m);
