/* tearing.rs: line_search_step; -1 error, 0 rejected, 1 accepted */
{{ q }} int rmc_torn_trial(ModelInstance* m, const RmcBlock* b, const double* base, const double* delta, double alpha, const double* rscale, double before, double* residual) {
