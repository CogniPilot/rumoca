        double moved = m->y[b_causal_target_pool[i]] - base[b_causal_col_pool[i]];
        double scale = rmc_model_scale(b_causal_target_pool[i], base[b_causal_col_pool[i]]);
        if (!isfinite(moved) || fabs(moved) > rmc_scaled_tolerance(m->rmc_tol, scale)) converged = 0;
