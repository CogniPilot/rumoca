{#- committed_seed.rs (SPEC_0044 ME-PROJ-005): a continuous-time refresh is a
    function of (t, x, p, relation memory, committed seed), never of the
    trial evaluations the importer made since the last accepted point. The
    seed is the settled coordinate at the last event exit or, after a
    completed integrator step, the derivative refresh at the accepted point
    from the previous seed; that refresh runs once, on the first refresh
    after the step, and a derivative query at the accepted point reads it.
    Event Mode and Co-Simulation keep their own iteration's warm start. -#}
{%- macro committed_seed(me, prefix, device=false) %}{%- set q = device_qualifier(device) %}
{%- if me.blocks|length > 0 and me.seed_rule == "CommittedAcceptedPoint" %}
{{ q }} bool rmc_at_mark(const ModelInstance* m) {
    return memcmp(&m->time, &m->rmc_mark_t, sizeof(double)) == 0 && memcmp(m->y, m->rmc_mark_x, sizeof(m->rmc_mark_x)) == 0;
}
/* Commit the settled coordinate (event exit) as the continuous-time seed. */
{{ q }} inline void rmc_seed_commit(ModelInstance* m) {
    memcpy(m->rmc_commit_y, m->y, sizeof(m->y));
    m->rmc_mark_pending = false; m->rmc_mark_resolved = false; m->rmc_seeding = true;
}
/* Mark the accepted point of a completed integrator step. */
{{ q }} inline void rmc_seed_mark(ModelInstance* m) {
    m->rmc_mark_t = m->time; memcpy(m->rmc_mark_x, m->y, sizeof(m->rmc_mark_x));
    m->rmc_mark_pending = true; m->rmc_mark_resolved = false;
}
/* Event Mode keeps its own iteration warm start. */
{{ q }} inline void rmc_seed_suspend(ModelInstance* m) { m->rmc_seeding = false; }
{{ q }} void rmc_seed_load(ModelInstance* m) {
    double x[STATE_LEN]; memcpy(x, m->y, sizeof(x));
    memcpy(m->y, m->rmc_commit_y, sizeof(m->y)); memcpy(m->y, x, sizeof(x));
}
/* The next seed: the derivative refresh at the marked point from the
   current seed. */
{{ q }} {{ prefix }}Status rmc_seed_resolve(ModelInstance* m) {
    if (!m->rmc_mark_pending) return {{ prefix }}OK;
    double t = m->time; double x[STATE_LEN]; memcpy(x, m->y, sizeof(x));
    memcpy(m->y, m->rmc_commit_y, sizeof(m->y)); memcpy(m->y, m->rmc_mark_x, sizeof(x)); m->time = m->rmc_mark_t;
    {{ prefix }}Status status = refresh_derivative_values_plan(m);
    if (status == {{ prefix }}OK) { memcpy(m->rmc_commit_y, m->y, sizeof(m->y)); m->rmc_mark_pending = false; m->rmc_mark_resolved = true; }
    m->time = t; memcpy(m->y, x, sizeof(x));
    return status;
}
{{ q }} {{ prefix }}Status (refresh_derivative_values)(ModelInstance* m) {
    if (!m->rmc_seeding) return refresh_derivative_values_plan(m);
    if (rmc_seed_resolve(m) != {{ prefix }}OK) return {{ prefix }}Error;
    rmc_seed_load(m);
    if (m->rmc_mark_resolved && rmc_at_mark(m)) return RMC_FAULTED(m) ? {{ prefix }}Error : {{ prefix }}OK;
    return refresh_derivative_values_plan(m);
}
{{ q }} {{ prefix }}Status (refresh_algebraics)(ModelInstance* m) {
    if (!m->rmc_seeding) return refresh_algebraics_plan(m);
    if (rmc_seed_resolve(m) != {{ prefix }}OK) return {{ prefix }}Error;
    rmc_seed_load(m);
    return refresh_algebraics_plan(m);
}
{%- else %}
{{ q }} inline void rmc_seed_commit(ModelInstance* m) { (void)m; }
{{ q }} inline void rmc_seed_mark(ModelInstance* m) { (void)m; }
{{ q }} inline void rmc_seed_suspend(ModelInstance* m) { (void)m; }
{%- endif %}
{%- endmacro %}

{#- ── device build ──────────────────────────────────────────────────────────
    The same kernel compiled for a device (CUDA C++, SPEC_0044 ME-PROJ-001):
    one translation unit holds the whole program, so every kernel function,
    table and typed pure function is `static __device__`, the report composer
    (ME-PROJ-003) is static host code, and no symbol is shared between units.
    Each lane runs the kernel on its own `ModelInstance`, whose `y` and `p`
    are the lane's coordinate and parameters and whose workspace
    (`workspace_fields`) holds its projection arena, its tolerance and
    certification mode, its program fault, its fallback counters and its
    fault report.

    `device_instance` declares the instance and what the kernel reads around
    it; `device_kernel` defines the kernel and `rmc_lane_reset`, which resets
    a lane's workspace. Between the two, the including unit defines the
    parameter refresh every refresh entry runs first,
    `static __device__ <prefix>Status refresh_parameters(ModelInstance* m)`,
    and, for a kernel with an initialization (`me.init.rows > 0`), the
    parameter bindings it settles,
    `static __device__ int rmc_apply_updates(ModelInstance* m, bool initializing)`
    (-1 error, 0 unchanged, 1 changed). The including unit includes
    <float.h>, <math.h>, <stdbool.h>, <stddef.h>, <stdint.h> and <string.h>,
    <assert.h> when it defines RMC_DEBUG, and any other standard header it
    uses, before `device_instance`, which includes <stdio.h> for the host's
    report and then redefines `snprintf` and `memcmp` until the end of
    `device_kernel`, where the includer's own definitions come back
    (push_macro, pop_macro); neither macro includes a header after its
    shims. It
    emits the min/max helpers its programs and typed functions call
    (`real_extremum_prelude("cuda")`) before `device_kernel`. After a launch,
    the host code of the same unit passes a copy of each lane's
    `rmc_lane_status` (copied alone, for instance by a pitched copy of that
    member of the lane array) to `rmc_lane_report`, a static host function,
    for the lane's fallback and fault reports; a model with neither a
    projection kernel nor assignment programs has no report, and its unit no
    `rmc_lane_report`. -#}
{%- macro device_instance(solve, me, prefix) %}
#include <stdio.h>
typedef enum { {{ prefix }}OK, {{ prefix }}Warning, {{ prefix }}Discard, {{ prefix }}Error, {{ prefix }}Fatal } {{ prefix }}Status;
{{ storage_lengths(solve) }}
/* A lane has no logger: a failure reaches its caller through the status the
   entry returns, and the kernel keeps its fallback and fault reports in the
   lane's status (RMC_LANE_STATUS: rmc_lane_status), which the host reads
   back and passes to rmc_lane_report (SPEC_0044 ME-PROJ-003): every crossed
   site in site order, then the first fault, whatever order they occurred
   in. The faults after the first are counted, not kept; besides those and
   the messages of a pure call's assertions (ME-PROJ-001), only the chart
   switch trace, which an FMI component logs when debug logging is on, is
   dropped. */
#ifndef RMC_LANE_STATUS
#define RMC_LANE_STATUS 1
#endif
{{- lane_status_type(me) }}
typedef struct { bool parameters_dirty; bool rmc_nonfinite; bool assertion_failed; double time; double y[Y_LEN]; double p[P_LEN];{{ workspace_fields(me) }} } ModelInstance;
#define RMC_INFO(m, category, message) ((void)(m), (void)(category), (void)(message))
/* The unit is a library: a lane kernel calls only the entries it needs, so
   every device function carries the unused attribute (RMC_UNUSED, which the
   kernel declarations define again with the same text). */
#if defined(__GNUC__) || defined(__clang__)
#define RMC_UNUSED __attribute__((unused))
#else
#define RMC_UNUSED
#endif
{{ device_qualifier(true) }} inline double rmc_now(const ModelInstance* m) { return m->time; }
/* The device library has no formatted output, so the chart switch trace the
   kernel formats is left empty (the host's report formats with the library
   `(snprintf)`); and no `memcmp`, which the kernel uses to compare values
   bit for bit. */
{{ device_qualifier(true) }} inline int rmc_device_format(char* text, size_t size) { if (size > 0) text[0] = '\0'; return 0; }
#pragma push_macro("snprintf")
#undef snprintf
#define snprintf(text, size, ...) rmc_device_format((text), (size))
{{ device_qualifier(true) }} inline int rmc_device_memcmp(const void* a, const void* b, size_t n) {
    const unsigned char* x = (const unsigned char*)a; const unsigned char* y = (const unsigned char*)b;
    for (size_t i = 0; i < n; ++i) if (x[i] != y[i]) return x[i] < y[i] ? -1 : 1;
    return 0;
}
#pragma push_macro("memcmp")
#undef memcmp
#define memcmp rmc_device_memcmp
{{ kernel_declarations(me, device=true) }}{{ linear_solve_kernel(device=true) }}
{{ typed_function_prototypes(typed_pure_calls, typed_directional_calls if me.blocks|length > 0 or me.table.jvp.programs|length > 0 else [], device=true) }}
