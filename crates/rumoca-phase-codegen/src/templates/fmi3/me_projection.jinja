{%- endfor %}
};
{{ q }} inline const RmcBlock* rmc_block(size_t id) { return &rmc_block_desc[id]; }
#define RMC_FALLBACK_RATE {{ me.policy.fallback_rate }}
#define RMC_FALLBACK_MIN_CALLS {{ me.policy.fallback_min_calls }}
/* projection_fallbacks.rs: note_fallback. A call counts once however many
   fallbacks it takes, and a fallback ahead of a site's next call (a seed
   rescue) belongs to that call. The first time the share of calls that fell
   back exceeds the policy rate, the site is logged under `projection`; a
   lane build keeps the counts of that call in its status instead (calls is
   at least one, which marks the site as crossed there), and keeps the first
   crossing should an FMU state restored under it cross the site again. */
RMC_COLD {{ q }} void rmc_fb_note(ModelInstance* m, size_t site) {
    size_t call = m->rmc_fb_calls[site] + (m->rmc_fb_active[site] ? 0 : 1);
    if (m->rmc_fb_mark[site] == call) return;
    m->rmc_fb_mark[site] = call; m->rmc_fb_count[site] += 1;
    size_t calls = m->rmc_fb_calls[site] > 0 ? m->rmc_fb_calls[site] : 1;
    if (m->rmc_fb_reported[site] || calls < RMC_FALLBACK_MIN_CALLS || (double)m->rmc_fb_count[site] <= RMC_FALLBACK_RATE * (double)calls) return;
    m->rmc_fb_reported[site] = true;
#if defined(RMC_LANE_STATUS)
    if (m->rmc_lane_status.crossed_calls[site] == 0) { m->rmc_lane_status.crossed_count[site] = m->rmc_fb_count[site]; m->rmc_lane_status.crossed_calls[site] = calls; }
#else
    char message[192];
    rmc_fallback_message(site, m->rmc_fb_count[site], calls, message, sizeof message);
    RMC_LOG_AT(m, "projection", message);
#endif
}
{{ q }} bool rmc_all_zero(const double* values, size_t n) {
    for (size_t i = 0; i < n; ++i) if (values[i] != 0.0) return false;
    return true;
}
{{ q }} void rmc_save(const ModelInstance* m, const RmcBlock* b, double* saved) { for (size_t i = 0; i < RMC_BS(b, n); ++i) saved[i] = m->y[RMC_BP(b, y)[i]]; }
{{ q }} void rmc_restore(ModelInstance* m, const RmcBlock* b, const double* saved) { for (size_t i = 0; i < RMC_BS(b, n); ++i) m->y[RMC_BP(b, y)[i]] = saved[i]; }

/* ImplicitProjectionModel::eval_implicit_residual_row */
{{ q }} RMC_ALWAYS_INLINE int rmc_row(ModelInstance* m, const RmcBlock* b, size_t row, double* value) {
    double out[{{ me.table.row_max_outputs }}];
    int status = rmc_row_call(RMC_BP(b, row_program)[row], m, out);
    if (status != 0) return RMC_FAILURE(status);
    *value = out[RMC_BP(b, row_offset)[row]];
    return 0;
}
/* projection.rs: implicit_selected_residuals; with the invariant values `inv`
   of an affine projection call (block_residual_split.rs), a split row's
   dependent part evaluates its program; one that fails hands the pass to
   the unsplit program, which raises its own error. */
{{ q }} int rmc_rows_split(ModelInstance* m, const RmcBlock* b, const double* inv, double* residual) {
    /* A one-row block (every singleton) runs one program: no range is held
       across its call. */
    if (RMC_BS(b, n) == 1) {
        double out[{{ me.table.row_max_outputs }}];
        size_t dependent = inv ? RMC_BP(b, row_split)[0] : 0;
        int split = dependent ? rmc_dep_call(dependent - 1, m, inv, out) : -1;
        if (split == RMC_FATAL) return RMC_FATAL;
        int status = split != 0 ? rmc_row_call(RMC_BP(b, row_program)[0], m, out) : 0;
        if (status != 0) return RMC_FAILURE(status);
        residual[0] = out[RMC_BP(b, row_offset)[0]];
        return 0;
    }
    const size_t b_n = RMC_BS(b, n); const size_t* const b_row_program_pool = RMC_BP(b, row_program); const size_t* const b_row_split_pool = RMC_BP(b, row_split); const size_t* const b_row_offset_pool = RMC_BP(b, row_offset);
    /* Consecutive rows of one multi-output program read one evaluation. */
    double out[{{ me.table.row_max_outputs }}]; size_t last = SIZE_MAX;
    for (size_t row = 0; row < b_n; ++row) {
        size_t program = b_row_program_pool[row];
        if (program != last) {
            size_t dependent = inv ? b_row_split_pool[row] : 0;
            int split = dependent ? rmc_dep_call(dependent - 1, m, inv, out) : -1;
            if (split == RMC_FATAL) return RMC_FATAL;
            int status = split != 0 ? rmc_row_call(program, m, out) : 0;
            if (status != 0) return RMC_FAILURE(status);
        }
        last = program; residual[row] = out[b_row_offset_pool[row]];
    }
    return 0;
}
{{ q }} int rmc_rows(ModelInstance* m, const RmcBlock* b, double* residual) { return rmc_rows_split(m, b, NULL, residual); }
/* block_residual_split.rs: begin_block_residual_split; NULL when the block has
   no split, an invariant part fails, or the arena has no room for the
   invariant values. Each disables the split for this call and reports
   nothing: the rows run their unsplit programs, which raise any error. */
{{ q }} const double* rmc_block_invariants(ModelInstance* m, const RmcBlock* b) {
    const size_t b_nsplit = RMC_BS(b, nsplit); const size_t b_inv_len = RMC_BS(b, inv_len); const size_t* const b_split_pool = RMC_BP(b, split);
    if (b_nsplit == 0) return NULL;
    double* inv = rmc_dalloc_raw(m, b_inv_len + 1);
    if (!inv) return NULL;
    for (size_t s = 0; s < b_nsplit; ++s)
        if (rmc_inv_call(b_split_pool[2 * s], m, inv + b_split_pool[2 * s + 1]) != 0) return NULL;
    return inv;
}
/* initial.rs: algebraic_block_jacobian through the issued colored application */
{%- if me.lane_max > 0 %}
/* tangent_lanes.rs: ColoredTangentEvaluator::eval; lane j of a call seeds
   the columns of its j-th color (element-major; only the seeds the program
   reads are written), and every placement takes the value that color's
   one-direction call writes. -1 error */
{{ q }} int rmc_jacobian_lanes(ModelInstance* m, const RmcBlock* b, double* values) {
    const size_t b_lane_max_outputs = RMC_BS(b, lane_max_outputs); const size_t b_nnz = RMC_BS(b, nnz); const size_t b_nlane_calls = RMC_BS(b, nlane_calls); const size_t* const b_lane_calls_pool = RMC_BP(b, lane_calls);
    RMC_MARK; int result = 0;
    double* out = rmc_dalloc(m, b_lane_max_outputs);
    if (!out) { RMC_RELEASE; return rmc_exhausted(m); }
    for (size_t e = 0; e < b_nnz; ++e) values[e] = 0.0;
    for (size_t call = 0; call < b_nlane_calls && result == 0; ++call) {
        const size_t* entry = b_lane_calls_pool + 7 * call;
        const size_t* seeds = RMC_BLOCK_POOL(b) + entry[2];
        const size_t* placements = RMC_BLOCK_POOL(b) + entry[4];
        size_t outputs = entry[6];
        for (size_t s = 0; s < entry[3]; ++s) m->rmc_lane_seed[seeds[s]] = 1.0;
        if (rmc_lane_call(entry[0], m, m->rmc_lane_seed, out) != 0) result = -1;
        for (size_t s = 0; s < entry[3]; ++s) m->rmc_lane_seed[seeds[s]] = 0.0;
        for (size_t p = 0; p < entry[5] && result == 0; ++p) values[placements[3 * p + 2]] = out[placements[3 * p] * outputs + placements[3 * p + 1]];
    }
    RMC_RELEASE; return result;
}
{%- endif %}
{{ q }} int rmc_jacobian(ModelInstance* m, const RmcBlock* b, double* values) {
{%- if me.lane_max > 0 %}
    /* A block with lane calls reads none of the colored fields below. */
    if (RMC_BS(b, nlane_calls) > 0) return rmc_jacobian_lanes(m, b, values);
{%- endif %}
    const size_t b_jvp_max_outputs = RMC_BS(b, jvp_max_outputs); const size_t b_nnz = RMC_BS(b, nnz); const size_t b_ncolors = RMC_BS(b, ncolors); const size_t* const b_colors_pool = RMC_BP(b, colors); const size_t* const b_color_seeds_pool = RMC_BP(b, color_seeds); const size_t* const b_color_calls_pool = RMC_BP(b, color_calls); const size_t* const b_placements_pool = RMC_BP(b, placements);
    RMC_MARK; int result = 0;
    double* seed = m->rmc_seed; double* out = rmc_dalloc(m, b_jvp_max_outputs);
    if (!out) { result = rmc_exhausted(m); goto done; }
    for (size_t e = 0; e < b_nnz; ++e) values[e] = 0.0;
    for (size_t c = 0; c < b_ncolors; ++c) {
        const size_t* color = b_colors_pool + 4 * c;
        for (size_t s = color[0]; s < color[1]; ++s) seed[b_color_seeds_pool[s]] = 1.0;
        for (size_t call = color[2]; call < color[3]; ++call) {
            const size_t* entry = b_color_calls_pool + 3 * call;
            if (rmc_jvp_call(entry[0], m, seed, out) != 0) result = -1;
            if (result != 0) break;
            for (size_t p = entry[1]; p < entry[2]; ++p) values[b_placements_pool[2 * p + 1]] = out[b_placements_pool[2 * p]];
        }
        for (size_t s = color[0]; s < color[1]; ++s) seed[b_color_seeds_pool[s]] = 0.0;
        if (result != 0) break;
    }
done:
    RMC_RELEASE; return result;
}
/* scaling.rs: jacobian_row_scales over the compressed-row pattern */
{{ q }} void rmc_row_scales(const RmcBlock* b, const double* jac, const double* vscale, const double* fallback, double* valid, double* rscale) {
    const size_t b_n = RMC_BS(b, n); const size_t* const b_row_ptr_pool = RMC_BP(b, row_ptr); const size_t* const b_col_idx_pool = RMC_BP(b, col_idx);
    for (size_t col = 0; col < b_n; ++col) valid[col] = rmc_valid_scale(vscale[col]);
    for (size_t row = 0; row < b_n; ++row) {
        double scale = 0.0;
        for (size_t e = b_row_ptr_pool[row]; e < b_row_ptr_pool[row + 1]; ++e) {
            double contribution = fabs(jac[e]) * valid[b_col_idx_pool[e]];
            if (isfinite(contribution)) scale = rmc_max(scale, contribution);
        }
        rscale[row] = scale > 0.0 ? scale : fallback[row];
    }
}
/* scaling.rs: algebraic_block_scales at the solver coordinates `values`; -1 error */
{{ q }} int rmc_block_scales_at(ModelInstance* m, const RmcBlock* b, const double* jac, const double* values, double* rscale, double* vscale) {
    const size_t b_n = RMC_BS(b, n); const size_t* const b_y_pool = RMC_BP(b, y); const size_t* const b_row_target_pool = RMC_BP(b, row_target);
    RMC_MARK;
    double* fallback = rmc_dalloc_raw(m, b_n); double* valid = rmc_dalloc_raw(m, b_n);
    if (!fallback || !valid) { RMC_RELEASE; return rmc_exhausted(m); }
    for (size_t i = 0; i < b_n; ++i) vscale[i] = rmc_model_scale(b_y_pool[i], values[b_y_pool[i]]);
    for (size_t row = 0; row < b_n; ++row) {
        size_t target = b_row_target_pool[row];
        fallback[row] = target != 0 ? rmc_model_scale(target - 1, values[target - 1]) : vscale[row];
    }
    rmc_row_scales(b, jac, vscale, fallback, valid, rscale);
    RMC_RELEASE; return 0;
}
{{ q }} int rmc_block_scales(ModelInstance* m, const RmcBlock* b, const double* jac, double* rscale, double* vscale) {
    return rmc_block_scales_at(m, b, jac, m->y, rscale, vscale);
}
{{ q }} bool rmc_lu_invertible(const double* lu, size_t n) {
    for (size_t i = 0; i < n; ++i) if (lu[i * n + i] == 0.0) return false;
    return true;
}

/* One target isolation: its row's grouped isolator program, one slot. */
{{ q }} int rmc_isolate(ModelInstance* m, size_t id, double* value) {
{%- if me.table.isolators.programs|length > 0 %}
    double out[{{ me.table.iso_max_outputs }}];
    int status = rmc_iso_call(rmc_iso_group[id], m, out);
    if (status != 0) return RMC_FAILURE(status);
    *value = out[rmc_iso_slot[id]];
    return 0;
{%- else %}
    /* A component without isolator programs has no isolator tables: an
       isolation its descriptors name is a fault of those tables. */
    (void)value;
    return rmc_bad_program(m, id);
{%- endif %}
}
/* projection.rs: assignment_tolerances */
{{ q }} void rmc_assignment_tolerances(double tol, size_t index, double before, double after, double previous, double value, double* row_tol, double* variable_tol) {
    double vscale = rmc_model_scale(index, fmax(fabs(previous), fabs(value)));
    double step = fabs(previous - value), change = fabs(before - after), rscale = vscale;
    if (isfinite(step) && step > 0.0 && isfinite(change)) { double scale = change / step * vscale; if (isfinite(scale) && scale > 0.0) rscale = scale; }
    *row_tol = rmc_scaled_tolerance(tol, rscale); *variable_tol = rmc_scaled_tolerance(tol, vscale);
}
/* ImplicitProjectionModel::isolation_value: -1 error, 0 none, 1 value */
{{ q }} int rmc_isolation(ModelInstance* m, const RmcBlock* b, size_t row, size_t col, double* value) {
    const size_t* const b_iso_default_pool = RMC_BP(b, iso_default); const size_t* const b_iso_start_pool = RMC_BP(b, iso_start); const size_t* const b_iso_entries_pool = RMC_BP(b, iso_entries);
    size_t kind = b_iso_default_pool[row], function = 0; double result = 0.0;
    for (size_t e = b_iso_start_pool[row]; e < b_iso_start_pool[row + 1]; ++e)
        if (b_iso_entries_pool[3 * e] == col) { kind = b_iso_entries_pool[3 * e + 1]; function = b_iso_entries_pool[3 * e + 2]; break; }
    if (kind == RMC_ISOLATION_UNAVAILABLE) return 0;
    int status = kind == RMC_ISOLATION_OUTPUT_VALUE ? rmc_row(m, b, row, &result) : rmc_isolate(m, function, &result);
    if (status != 0) return status;
    if (!isfinite(result)) return 0;
    *value = result;
    return 1;
}
/* The residual of a one-row block's row at the current coordinates, when a
   declined singleton assignment already evaluated it there
   (projection.rs: project_algebraic_block, `declined_residual`). */
typedef struct { bool known; double value; } RmcKnownRow;
/* projection.rs: project_algebraic_singleton_assignment; -1 error, 0 declined, 1 handled.
   A decline after the row was evaluated leaves the coordinates as they were
   and records that residual in `declined`. */
{{ q }} int rmc_project_singleton(ModelInstance* m, const RmcBlock* b, RmcUpdate* update, RmcKnownRow* declined) {
    if (RMC_BS(b, n) != 1) return 0;
    size_t index = RMC_BP(b, y)[0]; double value = 0.0, before = 0.0, after = 0.0, row_tol = 0.0, variable_tol = 0.0;
    if (RMC_BS(b, singleton_exact)) {
        int found = rmc_isolation(m, b, 0, 0, &value);
        if (found < 0) return -1;
        if (found == 0) { update->changed = false; update->settled = false; return 1; }
        double previous = m->y[index]; m->y[index] = value;
        update->changed = previous != value; update->settled = true; return 1;
    }
    if (rmc_row(m, b, 0, &before) != 0) return -1;
    if (!isfinite(before)) { update->changed = false; update->settled = false; return 1; }
    int found = rmc_isolation(m, b, 0, 0, &value);
    if (found < 0) return -1;
    if (found == 0) { declined->known = true; declined->value = before; return 0; }
    double previous = m->y[index]; m->y[index] = value;
    /* A failed evaluation of the trial leaves y as the assignment found it. */
    if (rmc_row(m, b, 0, &after) != 0) { m->y[index] = previous; return -1; }
    if (isfinite(after)) {
        rmc_assignment_tolerances(m->rmc_tol, index, before, after, previous, value, &row_tol, &variable_tol);
        /* singleton.rs: singleton_assignment_improves */
        bool improves = fabs(after) + row_tol < fabs(before)
            || (fabs(after) <= row_tol && fabs(after) < fabs(before) && fabs(previous - value) <= variable_tol);
        if (improves) { update->changed = previous != value; update->settled = fabs(after) <= row_tol; return 1; }
    }
    m->y[index] = previous;
    declined->known = true; declined->value = before;
    return 0;
}

/* One causal run of the sweep: -1 error, 0 declined, 1 recovered. */
{{ q }} inline int rmc_torn_run(ModelInstance* m, const RmcBlock* b, size_t run) {
    const size_t* entry = RMC_BP(b, cruns) + 4 * run;
    if (entry[0] == RMC_RUN_ISOLATOR) {
        double value = 0.0;
        int status = rmc_isolate(m, entry[1], &value);
        if (status != 0) return status;
        if (!isfinite(value)) return 0;
        m->y[RMC_BP(b, causal_target)[entry[2]]] = value;
        return 1;
    }
    int result = rmc_causal_call(entry[1], m, RMC_BP(b, causal_target) + entry[2]);
    return result < 0 ? RMC_FAILURE(result) : (result > 0 ? 0 : 1);
}
{{ q }} inline int rmc_torn_residual(ModelInstance* m, const RmcBlock* b, size_t i, double* residual) {
    double value = 0.0;
    int status = rmc_row(m, b, RMC_BP(b, residual_row)[i], &value);
    if (status != 0) return status;
    residual[i] = isfinite(value) ? value : NAN;
    return 0;
}
/* tearing.rs: per_row_torn_block_sweep; -1 error, 0 declined, 1 completed */
{{ q }} int rmc_torn_sweep(ModelInstance* m, const RmcBlock* b, double* residual) {
    const size_t b_ncruns = RMC_BS(b, ncruns); const size_t b_k = RMC_BS(b, k);
    for (size_t run = 0; run < b_ncruns; ++run) { int result = rmc_torn_run(m, b, run); if (result != 1) return result; }
    for (size_t i = 0; i < b_k; ++i) if (rmc_torn_residual(m, b, i, residual) != 0) return -1;
    return 1;
}
{%- if me.lane_max > 0 %}
/* tangent_lanes.rs: TornTangentEvaluator::eval on the swept base point. Lanes
   0..tears seed the tear columns and the last lane a causal step's own target;
   each step's tangent is minus its row's tangent over the coefficient, written
   back as that target's seed for the steps after it. One evaluation answers a
   step group, with the coefficient lane seeding every member target. The
   reduced rows then give the Jacobian row-major. The lane seed is all zero on
   entry and on return. -1 error, 0 a non-finite causal coefficient, 1 ok */
{{ q }} int rmc_torn_tangent(ModelInstance* m, const RmcBlock* b, double* jac, double* recovered) {
