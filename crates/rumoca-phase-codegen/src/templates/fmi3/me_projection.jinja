{#- refresh_execution.rs: refresh_slots_with_plan over the checked step
    table. A non-finite exact assignment or causal warm start restores the
    incoming coordinate and projects the complete simultaneous plan instead of
    the remaining steps (refresh_projection.rs: restore_after_causal_seed_error
    then project_refresh_slots over the complete plan); an unavailable
    projection-stage seed restores its targets and the block unknowns,
    projects the block, and continues, running the complete plan only when
    that projection fails; a failed pure call restores the incoming coordinate
    and reports an error. -#}
{%- macro refresh_kernel(me, prefix) %}
{%- set blocks = me.blocks|length > 0 %}
{%- set assigns = me.assign.plan.programs|length > 0 %}
{%- if me.derivative.steps|length > 0 or me.algebraic.steps|length > 0 %}
enum { RMC_STEP_ASSIGN, RMC_STEP_COMPLETE, RMC_STEP_PROJECT };
typedef struct { unsigned char kind; size_t first; size_t count; size_t block; size_t seed_first; size_t seed_count; size_t rescue; size_t nrescue; } RmcStep;
static {{ prefix }}Status rmc_refresh(ModelInstance* m, const RmcStep* steps, size_t nsteps, const size_t* complete, size_t ncomplete) {
    double incoming[Y_LEN];
    if (refresh_parameters(m) != {{ prefix }}OK) return {{ prefix }}Error;
    memcpy(incoming, m->y, sizeof(incoming));
    (void)complete; (void)ncomplete;
    for (size_t s = 0; s < nsteps; ++s) {
        const RmcStep* step = &steps[s]; int result = 0; (void)result;
        switch (step->kind) {
{%- if assigns %}
        case RMC_STEP_ASSIGN:
            result = rmc_assign(m, step->first, step->count);
            if (result < 0) goto fail;
            if (result > 0) goto failure;
            break;
{%- endif %}
{%- if blocks %}
        case RMC_STEP_COMPLETE:
            if (rmc_project_complete(m, complete, ncomplete) != 0) { RMC_LOG(m, "complete algebraic projection did not establish coordinate convergence"); goto fail; }
            break;
        case RMC_STEP_PROJECT:
{%- if assigns %}
            if (step->seed_count > 0) {
                result = rmc_assign(m, step->seed_first, step->seed_count);
                if (result < 0) goto fail;
                if (result > 0) {
                    for (size_t e = 0; e < step->nrescue; ++e) { size_t index = rmc_pool[step->rescue + e]; m->y[index] = incoming[index]; }
                    if (rmc_project_stage(m, &rmc_blocks[step->block]) == 0) break;
                    goto failure;
                }
            }
{%- endif %}
            if (rmc_project_stage(m, &rmc_blocks[step->block]) != 0) { RMC_LOG(m, "algebraic projection did not establish coordinate convergence"); goto fail; }
            break;
{%- endif %}
        default: goto fail;
        }
    }
    return {{ prefix }}OK;
{%- if assigns %}
failure:
{%- if blocks %}
    if (complete) {
