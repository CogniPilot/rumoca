/* A fault at `site`. An FMI component logs it under `error` as it occurs; a
   lane build keeps the first fault and its site in the lane's status, and
   counts every fault (saturating, so that a count wrapped to zero on a
   32-bit target never lets a later fault replace the first). */
RMC_COLD {{ q }} void rmc_fault(ModelInstance* m, unsigned code, size_t site) {
#if defined(RMC_LANE_STATUS)
    RmcLaneStatus* status = &m->rmc_lane_status;
    if (status->faults == 0) { status->fault = code; status->fault_site = site; }
    if (status->faults != (size_t)-1) status->faults += 1;
#else
    RMC_LOG(m, rmc_fault_message(code, site));
#endif
}
#if defined(RMC_LANE_STATUS)
/* The host report of one lane's status (a copy of its rmc_lane_status), in
   the categories and messages the FMI component logs: each site whose
   fallback rate crossed the policy rate, in site order, with the counts of
   the call that crossed it, then the first fault. Answers the number of
   reports. A device unit keeps it local, as every other symbol of the unit,
   for the host code of the same unit. */
{% if device %}RMC_UNUSED static {% else %}RMC_API {% endif %}size_t rmc_lane_report(const RmcLaneStatus* status, RmcReportSink sink, void* environment) {
    size_t reports = 0;
{%- if me.blocks|length > 0 %}
    for (size_t site = 0; site <= RMC_FB_PLAN; ++site) {
        if (status->crossed_calls[site] == 0) continue;
        char message[192];
        rmc_fallback_message(site, status->crossed_count[site], status->crossed_calls[site], message, sizeof message);
        sink(environment, "projection", message);
        reports += 1;
    }
{%- endif %}
    if (status->faults > 0) {
        sink(environment, "error", rmc_fault_message(status->fault, status->fault_site));
        reports += 1;
    }
