/* ── workspace: one per-instance arena, released on every return ─────── */
RMC_COLD static int rmc_exhausted(ModelInstance* m) { RMC_LOG(m, "algebraic projection workspace exhausted"); return -1; }
static double* rmc_dalloc(ModelInstance* m, size_t count) {
    if (count > RMC_DWORK - m->rmc_dtop) return NULL;
    double* values = m->rmc_d + m->rmc_dtop; m->rmc_dtop += count;
    for (size_t i = 0; i < count; ++i) values[i] = 0.0;
    return values;
}
/* A buffer its caller writes completely before reading it. */
static inline double* rmc_dalloc_raw(ModelInstance* m, size_t count) {
    if (count > RMC_DWORK - m->rmc_dtop) return NULL;
    double* values = m->rmc_d + m->rmc_dtop; m->rmc_dtop += count;
    return values;
}
static size_t* rmc_salloc(ModelInstance* m, size_t count) {
    if (count > RMC_SWORK - m->rmc_stop) return NULL;
    size_t* values = m->rmc_s + m->rmc_stop; m->rmc_stop += count;
    for (size_t i = 0; i < count; ++i) values[i] = 0;
    return values;
}
#define RMC_MARK size_t rmc_dmark = m->rmc_dtop, rmc_smark = m->rmc_stop
#define RMC_RELEASE (m->rmc_dtop = rmc_dmark, m->rmc_stop = rmc_smark)

/* scaling.rs: valid_variable_scale */
/* fmax for operands known not to be NaN, where it is the plain comparison. */
static inline double rmc_max(double a, double b) { return a > b ? a : b; }
static inline double rmc_valid_scale(double scale) { return (isfinite(scale) && scale > 0.0) ? scale : 1.0; }
/* scaling.rs: scaled_tolerance */
static double rmc_scaled_tolerance(double tol, double scale) {
    double scaled = fabs(tol) * rmc_valid_scale(scale);
    return isfinite(scaled) ? rmc_max(scaled, DBL_MIN) : DBL_MAX;
}
/* scaling.rs: scaled_residual_converged / scaled_correction_converged */
static bool rmc_scaled_converged(double tol, const double* values, const double* scales, size_t n) {
    for (size_t i = 0; i < n; ++i) if (!isfinite(values[i]) || fabs(values[i]) > rmc_scaled_tolerance(tol, scales[i])) return false;
    return true;
}
/* scaling.rs: scaled_residual_norm */
static double rmc_scaled_norm(const double* values, const double* scales, size_t n) {
    double norm = 0.0;
    for (size_t i = 0; i < n; ++i) {
        double quotient = fabs(values[i]) / rmc_valid_scale(scales[i]);
        if (!isfinite(quotient)) return INFINITY;
        norm = rmc_max(norm, quotient);
    }
    return norm;
}
/* scaling.rs: model_variable_scale over SolveModel::solver_variable_scale */
static double rmc_model_scale(size_t index, double value) {
    double magnitude = isfinite(value) ? fabs(value) : 0.0;
    return rmc_max(rmc_valid_scale(rmc_variable_scale[index]), magnitude);
}
static bool rmc_all_finite(const double* values, size_t n) {
    for (size_t i = 0; i < n; ++i) if (!isfinite(values[i])) return false;
    return true;
}

/* nalgebra LU with partial pivoting on the row-major n x n matrix `a`. An
   exactly zero multiplier or pivot-row entry contributes nothing to a finite
   update, so those products are skipped; the arithmetic that remains is the
   dense factorization's, in its order. */
static void rmc_lu(double* a, size_t n, size_t* ipiv, size_t* columns) {
    for (size_t i = 0; i < n; ++i) {
        size_t piv = i; double best = fabs(a[i * n + i]);
        for (size_t row = i + 1; row < n; ++row) { double value = fabs(a[row * n + i]); if (value > best) { best = value; piv = row; } }
        ipiv[i] = i;
        double diag = a[piv * n + i];
        if (diag == 0.0) continue;
        if (piv != i) {
            ipiv[i] = piv;
            for (size_t col = 0; col < n; ++col) { double tmp = a[i * n + col]; a[i * n + col] = a[piv * n + col]; a[piv * n + col] = tmp; }
        }
        double inv = 1.0 / diag; size_t count = 0; bool finite_row = true;
        for (size_t col = i + 1; col < n; ++col) {
            double pivot = a[i * n + col];
            if (pivot != 0.0) columns[count++] = col;
            if (!isfinite(pivot)) finite_row = false;
        }
        for (size_t row = i + 1; row < n; ++row) {
            double multiplier = a[row * n + i] * inv;
            a[row * n + i] = multiplier;
            if (multiplier == 0.0 && finite_row) continue;
            if (!finite_row || !isfinite(multiplier)) {
                for (size_t col = i + 1; col < n; ++col) a[row * n + col] += -a[i * n + col] * multiplier;
                continue;
            }
            for (size_t c = 0; c < count; ++c) { size_t col = columns[c]; a[row * n + col] += -a[i * n + col] * multiplier; }
        }
    }
}
/* nalgebra LU::solve_mut */
static bool rmc_lu_solve(const double* lu, size_t n, const size_t* ipiv, double* b) {
    for (size_t i = 0; i < n; ++i) if (ipiv[i] != i) { double tmp = b[i]; b[i] = b[ipiv[i]]; b[ipiv[i]] = tmp; }
    for (size_t i = 0; i < n; ++i) { double coeff = b[i]; for (size_t row = i + 1; row < n; ++row) b[row] += -coeff * lu[row * n + i]; }
    for (size_t i = n; i-- > 0;) {
        double diag = lu[i * n + i];
        if (diag == 0.0) return false;
        double coeff = b[i] / diag; b[i] = coeff;
        for (size_t row = 0; row < i; ++row) b[row] += -coeff * lu[row * n + i];
    }
    return true;
}
/* Rank-deficient least-squares fallback: one-sided Jacobi SVD, dropping
   singular values at or below `eps` (nalgebra SVD::solve); -1 error */
RMC_COLD static int rmc_svd_solve(ModelInstance* m, const double* a, size_t n, const double* rhs, double eps, double* x) {
    RMC_MARK;
    double* u = rmc_dalloc(m, n * n); double* v = rmc_dalloc(m, n * n);
    if (!u || !v) { RMC_RELEASE; return rmc_exhausted(m); }
    for (size_t i = 0; i < n * n; ++i) u[i] = a[i];
    for (size_t i = 0; i < n; ++i) v[i * n + i] = 1.0;
    for (int sweep = 0; sweep < 64; ++sweep) {
        bool rotated = false;
        for (size_t p = 0; p + 1 < n; ++p) for (size_t q = p + 1; q < n; ++q) {
            double alpha = 0.0, beta = 0.0, gamma = 0.0;
            for (size_t i = 0; i < n; ++i) { alpha += u[i * n + p] * u[i * n + p]; beta += u[i * n + q] * u[i * n + q]; gamma += u[i * n + p] * u[i * n + q]; }
            if (fabs(gamma) <= DBL_EPSILON * sqrt(alpha * beta)) continue;
            rotated = true;
            double zeta = (beta - alpha) / (2.0 * gamma);
            double t = (zeta >= 0.0 ? 1.0 : -1.0) / (fabs(zeta) + sqrt(1.0 + zeta * zeta));
            double c = 1.0 / sqrt(1.0 + t * t), s = c * t;
            for (size_t i = 0; i < n; ++i) {
                double up = u[i * n + p], uq = u[i * n + q]; u[i * n + p] = c * up - s * uq; u[i * n + q] = s * up + c * uq;
                double vp = v[i * n + p], vq = v[i * n + q]; v[i * n + p] = c * vp - s * vq; v[i * n + q] = s * vp + c * vq;
            }
        }
        if (!rotated) break;
    }
    for (size_t i = 0; i < n; ++i) x[i] = 0.0;
    for (size_t j = 0; j < n; ++j) {
        double sigma2 = 0.0, projection = 0.0;
        for (size_t i = 0; i < n; ++i) { sigma2 += u[i * n + j] * u[i * n + j]; projection += u[i * n + j] * rhs[i]; }
        if (!(sqrt(sigma2) > eps)) continue;
        double coefficient = projection / sigma2;
        for (size_t i = 0; i < n; ++i) x[i] += coefficient * v[i * n + j];
    }
    RMC_RELEASE; return 0;
}

/* One scaled dense Newton factorization, reused for every right-hand side
   while its matrix and scales are fixed (sparse_newton/dense.rs). */
typedef struct { size_t n; double* scaled; double* lu; size_t* ipiv; const double* rscale; const double* vscale; } RmcDenseFactor;
/* Allocate and factor; -1 error. */
static int rmc_dense_factor(ModelInstance* m, const double* jac, size_t n, const double* rscale, const double* vscale, RmcDenseFactor* f) {
    size_t* columns = NULL;
    f->n = n; f->rscale = rscale; f->vscale = vscale;
    f->scaled = rmc_dalloc(m, n * n); f->lu = rmc_dalloc(m, n * n); f->ipiv = rmc_salloc(m, n); columns = rmc_salloc(m, n);
    if (!f->scaled || !f->lu || !f->ipiv || !columns) return rmc_exhausted(m);
    for (size_t row = 0; row < n; ++row)
        for (size_t col = 0; col < n; ++col) f->scaled[row * n + col] = jac[row * n + col] * rmc_valid_scale(vscale[col]) / rmc_valid_scale(rscale[row]);
    for (size_t i = 0; i < n * n; ++i) f->lu[i] = f->scaled[i];
    rmc_lu(f->lu, n, f->ipiv, columns);
    return 0;
}
/* scaling.rs: scaled_newton_delta over a prepared factor (dense LU, then the
   SVD fallback); -1 error, 0 no solution, 1 solved */
static int rmc_dense_solve(ModelInstance* m, const RmcDenseFactor* f, const double* residual, double* delta) {
    RMC_MARK; size_t n = f->n; int result = 1;
    double* rhs = rmc_dalloc(m, n); double* x = rmc_dalloc(m, n);
    if (!rhs || !x) { RMC_RELEASE; return rmc_exhausted(m); }
    for (size_t row = 0; row < n; ++row) { rhs[row] = -residual[row] / rmc_valid_scale(f->rscale[row]); x[row] = rhs[row]; }
    if (!rmc_lu_solve(f->lu, n, f->ipiv, x) && rmc_svd_solve(m, f->scaled, n, rhs, m->rmc_tol, x) != 0) result = -1;
    if (result == 1) for (size_t col = 0; col < n; ++col) delta[col] = x[col] * rmc_valid_scale(f->vscale[col]);
    RMC_RELEASE; return result;
}
/* scaling.rs: scaled_newton_delta for a one-shot system; -1 error, 1 solved */
static int rmc_scaled_newton_delta(ModelInstance* m, const double* jac, size_t n, const double* residual, const double* rscale, const double* vscale, double* delta) {
    RMC_MARK; RmcDenseFactor factor;
    int result = rmc_dense_factor(m, jac, n, rscale, vscale, &factor);
    if (result == 0) result = rmc_dense_solve(m, &factor, residual, delta);
    RMC_RELEASE; return result;
}
