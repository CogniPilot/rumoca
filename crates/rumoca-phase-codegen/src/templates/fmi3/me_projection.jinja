    double* out = rmc_dalloc(m, RMC_TAN_OUTPUTS + 1); double* inputs = rmc_dalloc(m, RMC_SEED_LEN);
    double* vscale = rmc_dalloc(m, n_max); double* scratch = rmc_dalloc(m, 3 * n_max + n_max * n_max + 1); double* unit = rmc_dalloc(m, RMC_SEED_LEN); double* column = rmc_dalloc(m, n_max); double* lu = rmc_dalloc(m, n_max * n_max);
    size_t* ipiv = rmc_salloc(m, n_max); size_t* columns = rmc_salloc(m, n_max);
    if (!rscale || !residual || !out || !inputs || !vscale || !scratch || !unit || !column || !lu || !ipiv || !columns) { RMC_RELEASE; return rmc_exhausted(m); }
    for (size_t k = 0; k < RMC_TAN_BLOCKS; ++k) { const RmcBlock* b = rmc_block(blocks[k]); for (size_t i = 0; i < RMC_BS(b, n); ++i) seed[RMC_BP(b, y)[i]] = 0.0; }
    size_t offset = 0;
    for (size_t k = 0; k < RMC_TAN_BLOCKS && result == 0; ++k) {
        const RmcBlock* b = rmc_block(blocks[k]); size_t n = RMC_BS(b, n); double* rhs = scratch; double* jac = scratch + n;
        if (rmc_tan_rows(m, rows + 2 * offset, n, 2, seed, out, rhs) != 0 || rmc_tan_factor(m, b, rows + 2 * offset, unit, out, column, jac, lu, ipiv, columns) != 0) { result = -1; break; }
        for (size_t i = 0; i < n; ++i) rhs[i] = -rhs[i];
        if (!rmc_lu_solve(lu, n, ipiv, rhs)) { rmc_fault(m, RMC_FAULT_SENSITIVITY_SINGULAR, blocks[k]); result = -1; break; }
        for (size_t i = 0; i < n && result == 0; ++i) {
            if (!isfinite(rhs[i])) { rmc_fault(m, RMC_FAULT_SENSITIVITY_NONFINITE, blocks[k]); result = -1; }
            else seed[RMC_BP(b, y)[i]] = rhs[i];
        }
        if (result == 0 && rmc_block_scales_at(m, b, jac, seed, rscale + offset, vscale) != 0) result = -1;
        offset += n;
    }
    for (int iteration = 0; iteration <= 2 && result == 0; ++iteration) {
        if (rmc_tan_rows(m, rows, RMC_TAN_ROWS, 2, seed, out, residual) != 0) { result = -1; break; }
        if (rmc_scaled_converged(m->rmc_tol, residual, rscale, RMC_TAN_ROWS)) break;
        if (iteration == 2) { rmc_fault(m, RMC_FAULT_SENSITIVITY_RESIDUAL, RMC_NO_SITE); result = -1; break; }
        offset = 0;
        for (size_t k = 0; k < RMC_TAN_BLOCKS && result == 0; ++k) {
            const RmcBlock* b = rmc_block(blocks[k]);
            if (rmc_tan_refine(m, blocks[k], rows + 2 * offset, seed, inputs, unit, out, scratch, lu, ipiv, columns) != 0) result = -1;
            else if (rmc_block_scales_at(m, b, scratch + RMC_BS(b, n), seed, rscale + offset, vscale) != 0) result = -1;
            offset += RMC_BS(b, n);
        }
