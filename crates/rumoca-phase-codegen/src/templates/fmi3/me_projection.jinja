/* tearing.rs: advance_torn_newton; an exactly zero residual settles an
   uncertified refresh. An advanced step leaves its row scales in `step_scales`.
   -1 error, 0 declined, 1 settled, 2 advanced */
{{ q }} int rmc_torn_newton(ModelInstance* m, const RmcBlock* b, double* residual, const double* vscale, double* step_scales) {
    const size_t b_k = RMC_BS(b, k); const size_t b_n = RMC_BS(b, n); const size_t b_ncausal = RMC_BS(b, ncausal);
