{#- Declarations every translation unit of a component shares: the linkage
    and code-placement attributes and the program tables of the projection
    kernel, which the program units define. -#}
{%- macro kernel_declarations(me) %}
#if defined(__GNUC__) || defined(__clang__)
#define RMC_API __attribute__((visibility("hidden")))
#define RMC_COLD __attribute__((cold))
#else
#define RMC_API
#define RMC_COLD
#endif
{%- if me.assign.plan.programs|length > 0 %}
RMC_API int rmc_assign(ModelInstance* m, size_t first, size_t count);
{%- endif %}
{%- if me.blocks|length > 0 %}
typedef int (*RmcProgram)(ModelInstance* m, double* out);
typedef int (*RmcJvpProgram)(ModelInstance* m, const double* seed, double* out);
typedef int (*RmcCausalProgram)(ModelInstance* m, const size_t* targets);
RMC_API extern const RmcProgram rmc_row_fn[{{ me.table.rows.programs|length }}];
{%- if me.table.inv.programs|length > 0 %}
RMC_API extern const RmcProgram rmc_inv_fn[{{ me.table.inv.programs|length }}];
RMC_API extern const RmcJvpProgram rmc_dep_fn[{{ me.table.dep.programs|length }}];
{%- else %}
#define rmc_inv_fn ((const RmcProgram*)0)
#define rmc_dep_fn ((const RmcJvpProgram*)0)
{%- endif %}
{%- if me.table.jvp.programs|length > 0 %}
RMC_API extern const RmcJvpProgram rmc_jvp_fn[{{ me.table.jvp.programs|length }}];
{%- else %}
#define rmc_jvp_fn ((const RmcJvpProgram*)0)
{%- endif %}
{%- if me.table.lanes.programs|length > 0 %}
RMC_API extern const RmcJvpProgram rmc_lane_fn[{{ me.table.lanes.programs|length }}];
{%- else %}
#define rmc_lane_fn ((const RmcJvpProgram*)0)
{%- endif %}
{%- if me.table.isolators.programs|length > 0 %}
RMC_API extern const RmcProgram rmc_iso_fn[{{ me.table.isolators.programs|length }}];
RMC_API extern const size_t rmc_iso_group[{{ me.table.isolator_group|length }}];
RMC_API extern const size_t rmc_iso_slot[{{ me.table.isolator_slot|length }}];
{%- else %}
#define rmc_iso_fn ((const RmcProgram*)0)
#define rmc_iso_group ((const size_t*)0)
#define rmc_iso_slot ((const size_t*)0)
{%- endif %}
{%- if me.table.causal.programs|length > 0 %}
RMC_API extern const RmcCausalProgram rmc_causal_fn[{{ me.table.causal.programs|length }}];
{%- else %}
#define rmc_causal_fn ((const RmcCausalProgram*)0)
{%- endif %}
{%- endif %}
{%- endmacro %}

{#- The residual-row programs of the projection blocks. -#}
{%- macro rows_unit(me) %}
{%- if me.blocks|length > 0 %}
{%- for program in me.table.rows.programs %}
{{ program_function("rmc_row_p" ~ loop.index0, program, "ModelInstance* m, double* o", false) }}
{%- endfor %}
RMC_API const RmcProgram rmc_row_fn[{{ me.table.rows.programs|length }}] = { {% for program in me.table.rows.programs %}rmc_row_p{{ loop.index0 }},{% endfor %} };
{%- for program in me.table.inv.programs %}
{{ program_function("rmc_inv_p" ~ loop.index0, program, "ModelInstance* m, double* o", false) }}
{%- endfor %}
{%- for program in me.table.dep.programs %}
{{ program_function("rmc_dep_p" ~ loop.index0, program, "ModelInstance* m, const double* seed, double* o", true) }}
{%- endfor %}
{%- if me.table.inv.programs|length > 0 %}
RMC_API const RmcProgram rmc_inv_fn[{{ me.table.inv.programs|length }}] = { {% for program in me.table.inv.programs %}rmc_inv_p{{ loop.index0 }},{% endfor %} };
RMC_API const RmcJvpProgram rmc_dep_fn[{{ me.table.dep.programs|length }}] = { {% for program in me.table.dep.programs %}rmc_dep_p{{ loop.index0 }},{% endfor %} };
{%- endif %}
{%- endif %}
{%- endmacro %}

{#- The forward-Jacobian programs of the projection blocks. -#}
{%- macro jacobian_unit(me) %}
{%- if me.blocks|length > 0 %}
{%- for program in me.table.jvp.programs %}
{{ program_function("rmc_jvp_p" ~ loop.index0, program, "ModelInstance* m, const double* seed, double* o", true) }}
{%- endfor %}
{%- if me.table.jvp.programs|length > 0 %}
RMC_API const RmcJvpProgram rmc_jvp_fn[{{ me.table.jvp.programs|length }}] = { {% for program in me.table.jvp.programs %}rmc_jvp_p{{ loop.index0 }},{% endfor %} };
{%- endif %}
{%- for program in me.table.lanes.programs %}
{{ program_function("rmc_lane_p" ~ loop.index0, program, "ModelInstance* m, const double* seed, double* o", true) }}
{%- endfor %}
{%- if me.table.lanes.programs|length > 0 %}
RMC_API const RmcJvpProgram rmc_lane_fn[{{ me.table.lanes.programs|length }}] = { {% for program in me.table.lanes.programs %}rmc_lane_p{{ loop.index0 }},{% endfor %} };
{%- endif %}
{%- endif %}
{%- endmacro %}

{#- The target isolators and causal runs of the projection blocks. -#}
{%- macro isolators_unit(me) %}
{%- if me.blocks|length > 0 %}
{%- for program in me.table.isolators.programs %}
{{ program_function("rmc_iso_p" ~ loop.index0, program, "ModelInstance* m, double* o", false) }}
{%- endfor %}
{#- One causal run (tearing.rs: per_row_torn_block_sweep over consecutive
    steps of one residual program): each recovered value is written to its
    step's target as soon as it is computed; a non-finite value declines (1)
    before its write, a failed pure call reports an error (-1). -#}
{%- for program in me.table.causal.programs %}
static int rmc_causal_p{{ loop.index0 }}(ModelInstance* m, const size_t* t) {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{%- for op in program.ops %}
{%- if op.kind == "StoreOutput" %}
    { double v = r[{{ op.src }}]; if (!isfinite(v)) return 1; m->y[t[{{ op.output_index }}]] = v; }
{%- else %}
{{ scalar_op(op, "m->y", "-1") }}
{%- endif %}
{%- endfor %}
    return 0;
}
{%- endfor %}
{%- if me.table.causal.programs|length > 0 %}
RMC_API const RmcCausalProgram rmc_causal_fn[{{ me.table.causal.programs|length }}] = { {% for program in me.table.causal.programs %}rmc_causal_p{{ loop.index0 }},{% endfor %} };
{%- endif %}
{%- if me.table.isolators.programs|length > 0 %}
RMC_API const RmcProgram rmc_iso_fn[{{ me.table.isolators.programs|length }}] = { {% for program in me.table.isolators.programs %}rmc_iso_p{{ loop.index0 }},{% endfor %} };
RMC_API const size_t rmc_iso_group[{{ me.table.isolator_group|length }}] = { {% for value in me.table.isolator_group %}{{ value }},{% endfor %} };
RMC_API const size_t rmc_iso_slot[{{ me.table.isolator_slot|length }}] = { {% for value in me.table.isolator_slot %}{{ value }},{% endfor %} };
{%- endif %}
{%- endif %}
{%- endmacro %}
