static double* rmc_init_slot(ModelInstance* m, size_t combined) { return combined < RMC_INIT_Y_LEN ? &m->y[combined] : &m->p[combined - RMC_INIT_Y_LEN]; }
/* CombinedInitializationProjectionModel::variable_scale_for_y_index under
   scaling.rs: model_variable_scale: a solver coordinate takes its solver
   variable scale, a parameter its magnitude when the projection began. */
static double rmc_init_scale(const double* pscale, size_t combined, double value) {
    if (combined < RMC_INIT_Y_LEN) return rmc_model_scale(combined, value);
    return fmax(rmc_valid_scale(pscale[combined - RMC_INIT_Y_LEN]), isfinite(value) ? fabs(value) : 0.0);
}
/* initial_projection.rs: InitialProjectionModel::eval_initial_residual over
   settled_initial_coordinates: the bindings and the uncertified algebraic
   refresh run on a copy of the coordinates until the bindings stop changing,
   and the rows are evaluated there. -1 error */
RMC_COLD static int rmc_init_settled(ModelInstance* m, double* out) {
    RMC_MARK; int result = -1; bool dirty = m->parameters_dirty;
    double* y = rmc_dalloc(m, Y_LEN); double* p = rmc_dalloc(m, P_LEN);
    if (!y || !p) { RMC_RELEASE; return rmc_exhausted(m); }
    memcpy(y, m->y, sizeof(m->y)); memcpy(p, m->p, sizeof(m->p));
    for (int pass = 0; pass < RMC_UPDATE_ITERS; ++pass) {
        int changed = rmc_apply_updates(m);
        m->parameters_dirty = false;
        if (changed < 0 || refresh_algebraics(m) != {{ prefix }}OK) break;
        if (pass > 0 && changed == 0) { result = 0; break; }
    }
    if (result == 0 && rmc_init_residual(m, out) != 0) result = -1;
    memcpy(m->y, y, sizeof(m->y)); memcpy(m->p, p, sizeof(m->p)); m->parameters_dirty = dirty;
    if (result != 0) RMC_LOG(m, "initial residual evaluation view did not converge");
    RMC_RELEASE; return result;
}
/* initial.rs: initial_block_jacobian through eval_settled_initial_jacobian_v:
   the symmetric difference of the settled residual along each unknown, with
   the probe no smaller than sqrt(tol). Row-major over the block. -1 error */
RMC_COLD static int rmc_init_jacobian(ModelInstance* m, const RmcInitBlock* b, double* jac) {
    RMC_MARK; int result = 0; size_t n = b->n;
    double* plus = rmc_dalloc(m, RMC_INIT_ROWS); double* minus = rmc_dalloc(m, RMC_INIT_ROWS);
    if (!plus || !minus) { RMC_RELEASE; return rmc_exhausted(m); }
    double relative = fmax(cbrt(DBL_EPSILON), sqrt(m->rmc_tol));
    for (size_t col = 0; col < n && result == 0; ++col) {
        double* slot = rmc_init_slot(m, rmc_init_pool[b->unknowns + col]); double base = *slot;
        double step = relative * fmax(1.0, fabs(base)) / 1.0;
        *slot = base + step * 1.0;
        if (rmc_init_settled(m, plus) != 0) result = -1;
        *slot = base - step * 1.0;
        if (result == 0 && rmc_init_settled(m, minus) != 0) result = -1;
        *slot = base;
        for (size_t row = 0; row < n && result == 0; ++row) {
            size_t r = rmc_init_pool[b->rows + row];
            jac[row * n + col] = (plus[r] - minus[r]) / (2.0 * step);
        }
    }
    RMC_RELEASE; return result;
}
/* scaling.rs: initial_block_scales (variable scales, the row-target
   fallbacks, and jacobian_row_scales over the issued pattern when present). */
RMC_COLD static void rmc_init_scales(ModelInstance* m, const RmcInitBlock* b, const double* pscale, const double* jac, double* rscale, double* vscale) {
    size_t n = b->n;
    for (size_t i = 0; i < n; ++i) { size_t u = rmc_init_pool[b->unknowns + i]; vscale[i] = rmc_init_scale(pscale, u, *rmc_init_slot(m, u)); }
    for (size_t row = 0; row < n; ++row) {
        double scale = 0.0;
        size_t first = b->pattern ? rmc_init_pool[b->row_ptr + row] : 0, last = b->pattern ? rmc_init_pool[b->row_ptr + row + 1] : n;
        for (size_t e = first; e < last; ++e) {
            size_t col = b->pattern ? rmc_init_pool[b->col_idx + e] : e;
            double contribution = fabs(jac[row * n + col]) * rmc_valid_scale(vscale[col]);
            if (isfinite(contribution)) scale = fmax(scale, contribution);
        }
        size_t target = rmc_init_pool[b->fallback + row];
        rscale[row] = scale > 0.0 ? scale : (target != 0 ? rmc_init_scale(pscale, target - 1, m->y[target - 1]) : vscale[row]);
    }
}
/* initial.rs: initial_selected_residual_norm; -1 error */
RMC_COLD static int rmc_init_norm(ModelInstance* m, const RmcInitBlock* b, const double* rscale, double* norm) {
    RMC_MARK;
    double* residual = rmc_dalloc(m, RMC_INIT_ROWS); double* selected = rmc_dalloc(m, b->n);
    if (!residual || !selected) { RMC_RELEASE; return rmc_exhausted(m); }
    int result = rmc_init_settled(m, residual);
    *norm = 0.0;
    for (size_t i = 0; i < b->n && result == 0; ++i) selected[i] = residual[rmc_init_pool[b->rows + i]];
    if (result == 0) *norm = rmc_all_finite(selected, b->n) ? rmc_scaled_norm(selected, rscale, b->n) : INFINITY;
    RMC_RELEASE; return result;
}
/* initial.rs: accept_initial_block_delta; -1 error */
RMC_COLD static int rmc_init_accept(ModelInstance* m, const RmcInitBlock* b, const double* delta, const double* rscale, RmcUpdate* update) {
    RMC_MARK; size_t n = b->n; int result = 0; double before = 0.0, after = 0.0, alpha = 1.0;
    double* snapshot = rmc_dalloc(m, n);
    if (!snapshot) { RMC_RELEASE; return rmc_exhausted(m); }
    for (size_t i = 0; i < n; ++i) snapshot[i] = *rmc_init_slot(m, rmc_init_pool[b->unknowns + i]);
    if (rmc_init_norm(m, b, rscale, &before) != 0) { RMC_RELEASE; return -1; }
    for (int attempt = 0; attempt < 12; ++attempt) {
        bool changed = false, finite = true;
        for (size_t i = 0; i < n; ++i) *rmc_init_slot(m, rmc_init_pool[b->unknowns + i]) = snapshot[i];
        for (size_t i = 0; i < n && finite; ++i) {
            double step = alpha * delta[i]; double* slot = rmc_init_slot(m, rmc_init_pool[b->unknowns + i]);
            if (!isfinite(step)) { finite = false; break; }
            double candidate = *slot + step;
            changed = changed || candidate != *slot; *slot = candidate;
        }
        if (!finite || !changed) break;
        if (rmc_init_norm(m, b, rscale, &after) != 0) { result = -1; break; }
        if (isfinite(after) && (after <= m->rmc_tol || after < before)) { update->changed = true; update->settled = after <= m->rmc_tol; RMC_RELEASE; return 0; }
        alpha *= 0.5;
    }
    for (size_t i = 0; i < n; ++i) *rmc_init_slot(m, rmc_init_pool[b->unknowns + i]) = snapshot[i];
    RMC_RELEASE; return result;
}
/* initial.rs: relax_initial_block_from_row_targets for a one-row block;
   -1 error, 0 declined, 1 relaxed */
RMC_COLD static int rmc_init_relax(ModelInstance* m, const RmcInitBlock* b, const double* selected, const double* jac, const double* rscale, const double* vscale) {
    size_t column = rmc_init_pool[b->relax];
    if (column >= b->n || !isfinite(selected[0])) return 0;
    double derivative = jac[column];
    if (!isfinite(derivative) || fabs(derivative) <= 1.0e-15) return 0;
    double delta = -selected[0] / derivative;
    if (!isfinite(delta) || fabs(delta) <= rmc_scaled_tolerance(m->rmc_tol, vscale[column])) return 0;
    RMC_MARK;
    double* residual = rmc_dalloc(m, RMC_INIT_ROWS);
    if (!residual) { RMC_RELEASE; return rmc_exhausted(m); }
    double* slot = rmc_init_slot(m, rmc_init_pool[b->unknowns + column]); double previous = *slot;
    *slot += delta;
    int result = rmc_init_settled(m, residual) != 0 ? -1 : 0;
    if (result == 0) {
        double after = residual[rmc_init_pool[b->rows]];
        if (isfinite(after) && fabs(after) + rmc_scaled_tolerance(m->rmc_tol, rscale[0]) < fabs(selected[0])) result = 1;
    }
    if (result != 1) *slot = previous;
    RMC_RELEASE; return result;
}
/* initial.rs: project_initial_block on the settled rows, where neither
   singleton assignment applies (the settled model isolates no row); -1 error */
RMC_COLD static int rmc_init_block(ModelInstance* m, const RmcInitBlock* b, const double* pscale, RmcUpdate* update) {
    RMC_MARK; size_t n = b->n; int result = 0;
    update->changed = false; update->settled = false;
    if (n == 0) { update->settled = true; RMC_RELEASE; return 0; }
    double* residual = rmc_dalloc(m, RMC_INIT_ROWS); double* selected = rmc_dalloc(m, n); double* jac = rmc_dalloc(m, n * n);
    double* rscale = rmc_dalloc(m, n); double* vscale = rmc_dalloc(m, n); double* delta = rmc_dalloc(m, n);
    if (!residual || !selected || !jac || !rscale || !vscale || !delta) { RMC_RELEASE; return rmc_exhausted(m); }
    if (rmc_init_settled(m, residual) != 0) { RMC_RELEASE; return -1; }
    for (size_t i = 0; i < n; ++i) selected[i] = residual[rmc_init_pool[b->rows + i]];
    if (!rmc_all_finite(selected, n)) { RMC_RELEASE; return 0; }
    if (rmc_init_jacobian(m, b, jac) != 0) { RMC_RELEASE; return -1; }
    rmc_init_scales(m, b, pscale, jac, rscale, vscale);
    if (rmc_scaled_converged(m->rmc_tol, selected, rscale, n)) { update->settled = true; RMC_RELEASE; return 0; }
    if (n == 1) {
        int relaxed = rmc_init_relax(m, b, selected, jac, rscale, vscale);
        if (relaxed != 0) { update->changed = relaxed == 1; RMC_RELEASE; return relaxed < 0 ? -1 : 0; }
    }
    if (rmc_scaled_newton_delta(m, jac, n, selected, rscale, vscale, delta) != 1) result = -1;
    else result = rmc_init_accept(m, b, delta, rscale, update);
    RMC_RELEASE; return result;
}
static bool rmc_init_converged(const double* residual, double tol) {
    for (size_t row = 0; row < RMC_INIT_ROWS; ++row) if (!isfinite(residual[row]) || fabs(residual[row]) > tol) return false;
    return true;
}
static void rmc_init_seed(ModelInstance* m) {
    for (size_t k = 0; k < RMC_INIT_BLOCKS; ++k)
        for (size_t i = 0; i < rmc_init_blocks[k].n; ++i) { double* slot = rmc_init_slot(m, rmc_init_pool[rmc_init_blocks[k].unknowns + i]); if (!isfinite(*slot)) *slot = 0.0; }
}
/* initial.rs: project_initial_variables_by_plan (with the parameter scales of
   project_initial_variables_with_plan) and, when its sweeps stop unsettled,
   the complete residual check under initial_residual_scales; -1 error */
RMC_COLD static int rmc_init_project(ModelInstance* m) {
    RMC_MARK; int result = 1;
    double* pscale = rmc_dalloc(m, P_LEN); double* residual = rmc_dalloc(m, RMC_INIT_ROWS); double* scales = rmc_dalloc(m, RMC_INIT_ROWS);
    if (!pscale || !residual || !scales) { RMC_RELEASE; return rmc_exhausted(m); }
    for (size_t k = 0; k < P_LEN; ++k) pscale[k] = isfinite(m->p[k]) ? fmax(fabs(m->p[k]), 1.0) : 1.0;
    for (int iteration = 0; iteration < RMC_REFINE_ITERS && result == 1; ++iteration) {
        bool changed = false;
        rmc_init_seed(m);
        if (rmc_init_settled(m, residual) != 0) { result = -1; break; }
        if (iteration > 0 && rmc_init_converged(residual, m->rmc_tol)) { result = 0; break; }
        if (RMC_INIT_PLAN_ROWS == 0) break;
        for (size_t k = 0; k < RMC_INIT_BLOCKS; ++k) {
            RmcUpdate update = { false, false };
            if (rmc_init_block(m, &rmc_init_blocks[k], pscale, &update) != 0) { result = -1; break; }
            changed = changed || update.changed;
        }
        if (result == 1 && !changed) break;
    }
    if (result == 1) {
        rmc_init_seed(m);
        if (rmc_init_settled(m, residual) != 0) result = -1;
        else if (rmc_init_converged(residual, m->rmc_tol)) result = 0;
    }
    if (result == 1)
        for (size_t row = 0; row < RMC_INIT_ROWS; ++row) { size_t target = rmc_init_row_target[row]; scales[row] = target != 0 ? rmc_init_scale(pscale, target - 1, m->y[target - 1]) : 1.0; }
    for (size_t k = 0; k < RMC_INIT_BLOCKS && result == 1; ++k) {
        const RmcInitBlock* b = &rmc_init_blocks[k]; RMC_MARK;
        double* jac = rmc_dalloc(m, b->n * b->n + 1); double* rscale = rmc_dalloc(m, b->n + 1); double* vscale = rmc_dalloc(m, b->n + 1);
        if (!jac || !rscale || !vscale) result = rmc_exhausted(m);
        else if (rmc_init_jacobian(m, b, jac) != 0) result = -1;
        else {
            rmc_init_scales(m, b, pscale, jac, rscale, vscale);
            for (size_t i = 0; i < b->n; ++i) scales[rmc_init_pool[b->rows + i]] = rscale[i];
        }
        RMC_RELEASE;
    }
    if (result == 1) {
        if (rmc_scaled_converged(m->rmc_tol, residual, scales, RMC_INIT_ROWS)) result = 0;
        else { RMC_LOG(m, "initial variable projection did not satisfy the complete residual system"); result = -1; }
    }
    RMC_RELEASE; return result;
}
/* solve_runtime/initial_projection.rs: settle_initialization_system at the
   FMI tolerance; the certified continuous refresh follows at the refresh
   tolerance. */
RMC_COLD static {{ prefix }}Status rmc_initialize(ModelInstance* m, double tolerance) {
    {{ prefix }}Status status = {{ prefix }}Error;
    m->rmc_tol = tolerance > 0.0 ? tolerance : RMC_TOL; m->rmc_certify = false;
    for (int iteration = 0; iteration < RMC_UPDATE_ITERS; ++iteration) {
        if (rmc_apply_updates(m) < 0) break;
        m->parameters_dirty = false;
        if (rmc_init_project(m) != 0) break;
        int changed = rmc_apply_updates(m);
        if (changed < 0) break;
        if (changed == 0) { status = {{ prefix }}OK; break; }
    }
    m->rmc_tol = RMC_TOL; m->rmc_certify = true;
    if (status != {{ prefix }}OK) RMC_LOG(m, "initial algebraic/update projection did not converge");
    return status;
}
{%- endif %}
