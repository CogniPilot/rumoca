#define RMC_TAN_BLOCKS {{ tan.nblocks }}
#define RMC_TAN_ROWS {{ tan.nrows }}
#define RMC_TAN_MAX_N {{ tan.max_n }}
/* seed_linearization.rs: SeedBlockLinearization::build: the block Jacobian
   at the settled point, one column per unknown from the block rows' full JVP
   (`unit` is all zero on entry and on return), into the block pattern `jac`
   and its partial-pivot LU. -1 error */
RMC_COLD {{ q }} int rmc_tan_factor(ModelInstance* m, const RmcBlock* b, const size_t* rows, double* unit, double* out, double* column, double* jac, double* lu, size_t* ipiv, size_t* columns) {
    const size_t b_n = RMC_BS(b, n); const size_t* const b_y_pool = RMC_BP(b, y); const size_t* const b_row_ptr_pool = RMC_BP(b, row_ptr); const size_t* const b_col_idx_pool = RMC_BP(b, col_idx);
    size_t n = b_n;
    for (size_t col = 0; col < n; ++col) {
        unit[b_y_pool[col]] = 1.0;
        int evaluated = rmc_tan_rows(m, rows, n, 2, unit, out, column);
        unit[b_y_pool[col]] = 0.0;
        if (evaluated != 0) return -1;
        for (size_t row = 0; row < n; ++row) lu[row * n + col] = column[row];
    }
    for (size_t row = 0; row < n; ++row)
        for (size_t e = b_row_ptr_pool[row]; e < b_row_ptr_pool[row + 1]; ++e) jac[e] = lu[row * n + b_col_idx_pool[e]];
    rmc_lu(lu, n, ipiv, columns);
    return 0;
}
/* seed_linearization.rs: refine_direction: the residual of the block's
   linearized rows at the current seed, `J x + base` (equal to nalgebra's
   product up to the sign of zero); zero when every entry vanishes, else one
   LU correction. -1 error */
RMC_COLD {{ q }} int rmc_tan_refine(ModelInstance* m, size_t block, const size_t* rows, double* seed, double* inputs, double* unit, double* out, double* scratch, double* lu, size_t* ipiv, size_t* columns) {
    const RmcBlock* b = rmc_block(block);
    const size_t b_n = RMC_BS(b, n); const size_t* const b_y_pool = RMC_BP(b, y); const size_t* const b_row_ptr_pool = RMC_BP(b, row_ptr); const size_t* const b_col_idx_pool = RMC_BP(b, col_idx);
    size_t n = b_n; double* base = scratch; double* jac = scratch + n; double* correction = scratch + n + n * n; double* column = correction + n;
    memcpy(inputs, seed, RMC_SEED_LEN * sizeof(double));
    for (size_t i = 0; i < n; ++i) inputs[b_y_pool[i]] = 0.0;
    if (rmc_tan_rows(m, rows, n, 2, inputs, out, base) != 0 || rmc_tan_factor(m, b, rows, unit, out, column, jac, lu, ipiv, columns) != 0) return -1;
    bool zero = true;
    for (size_t row = 0; row < n; ++row) {
        double acc = 0.0;
        for (size_t e = b_row_ptr_pool[row]; e < b_row_ptr_pool[row + 1]; ++e) acc += jac[e] * seed[b_y_pool[b_col_idx_pool[e]]];
        correction[row] = -(acc + base[row]);
        zero &= correction[row] == 0.0;
    }
    if (zero) return 0;
    if (!rmc_lu_solve(lu, n, ipiv, correction)) { rmc_fault(m, RMC_FAULT_SENSITIVITY_REFINEMENT, block); return -1; }
    for (size_t i = 0; i < n; ++i) {
        double value = seed[b_y_pool[i]] + correction[i];
        if (!isfinite(value)) { rmc_fault(m, RMC_FAULT_SENSITIVITY_NONFINITE, block); return -1; }
        seed[b_y_pool[i]] = value;
    }
    return 0;
}
/* projection.rs: project_algebraic_seed_with_plan over the primary chart's
