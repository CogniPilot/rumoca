{#- Declarations every translation unit of a component shares: the linkage
    and code-placement attributes, the fatal answer to a bad program index,
    and one dispatcher per program family, `rmc_<family>_call(program, ...)`,
    a switch the family's program unit defines that calls each program
    directly. A family with no program gets an inline stub instead, which
    reports any index as a bad one (rmc_bad_program). -#}
{%- macro kernel_declarations(me, device=false) %}{%- set q = device_qualifier(device) %}{%- set api = device_qualifier(device, true) %}
/* The kernel symbols the component's units share carry the model identifier
   (shared_prefix): a shared library also hides them (RMC_API), and a static
   build links the units beside other components. */
{{ shared_prefix() }}{% for name in ["rmc_assign", "rmc_bad_program", "rmc_row_call", "rmc_inv_call", "rmc_dep_call", "rmc_jvp_call", "rmc_lane_call", "rmc_iso_call", "rmc_causal_call", "rmc_iso_group", "rmc_iso_slot", "rmc_model_assertion", "rmc_finish_assertion_observation"] %}{{ shared_symbol(name) }}{% endfor %}#if defined(__GNUC__) || defined(__clang__)
#define RMC_COLD __attribute__((cold))
#define RMC_UNUSED __attribute__((unused))
#else
#define RMC_COLD
#define RMC_UNUSED
#endif
/* A dispatcher calls each large program of its family out of line: inlined
   into its switch, a family's programs become one large function, which slows
   the hot path and the host compilers. A small program costs less than the
   call that reaches it, so the compiler may inline it into its case. A device
   compiler keeps its own inlining choices. */
#if (defined(__GNUC__) || defined(__clang__)) && !defined(__CUDACC__)
#define RMC_NOINLINE __attribute__((noinline))
#else
#define RMC_NOINLINE
#endif
/* A kernel wrapper small enough that its call costs more than its body, on
   a path every block takes (rmc_row): inlined even where the compiler's size
   estimate would keep it out of line. */
#if defined(__CUDACC__)
#define RMC_ALWAYS_INLINE __forceinline__
#elif defined(__GNUC__) || defined(__clang__)
#define RMC_ALWAYS_INLINE inline __attribute__((always_inline))
#else
#define RMC_ALWAYS_INLINE inline
#endif
/* Symbols shared between the component's translation units stay out of the
   dynamic symbol table; Windows objects have no such attribute and a static
   build has no symbol table to hide them from. */
#if (defined(__GNUC__) || defined(__clang__)) && !defined(_WIN32) && !defined(RMC_STATIC_BUILD)
#define RMC_API __attribute__((visibility("hidden")))
#else
#define RMC_API
#endif
