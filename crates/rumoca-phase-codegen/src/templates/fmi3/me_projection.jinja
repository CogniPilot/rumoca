/* initial_projection.rs: settled_initial_coordinates: the bindings and the
   uncertified algebraic refresh alternate on the instance coordinates until
   the bindings stop changing; the caller saves and restores them. -1 error */
RMC_COLD {{ q }} int rmc_init_settle_view(ModelInstance* m) {
    for (int pass = 0; pass < RMC_UPDATE_ITERS; ++pass) {
        int changed = rmc_apply_updates(m, true);
        m->parameters_dirty = false;
        if (changed < 0 || refresh_algebraics(m) != {{ prefix }}OK) break;
        if (pass > 0 && changed == 0) return 0;
    }
    rmc_fault(m, RMC_FAULT_INIT_VIEW, RMC_NO_SITE);
    return -1;
}
/* initial_projection.rs: InitialProjectionModel::eval_initial_residual on the
   settled view of a copy of the coordinates. -1 error */
RMC_COLD {{ q }} int rmc_init_settled(ModelInstance* m, double* out) {
    RMC_MARK; bool dirty = m->parameters_dirty;
    double* y = rmc_dalloc(m, Y_LEN); double* p = rmc_dalloc(m, P_LEN);
    if (!y || !p) { RMC_RELEASE; return rmc_exhausted(m); }
    memcpy(y, m->y, sizeof(m->y)); memcpy(p, m->p, sizeof(m->p));
    int result = rmc_init_settle_view(m);
    if (result == 0 && rmc_init_residual(m, out) != 0) result = -1;
    memcpy(m->y, y, sizeof(m->y)); memcpy(m->p, p, sizeof(m->p)); m->parameters_dirty = dirty;
    RMC_RELEASE; return result;
}
{%- set tan = init.tangent %}
#define RMC_TAN_OUTPUTS {{ tan.max_outputs }}
/* JVP rows `(function, output offset, ...)` with `stride` entries each, under
   `seed` over [solver-y | parameter]; consecutive rows of one function share
   its evaluation. -1 error */
RMC_COLD {{ q }} int rmc_tan_rows(ModelInstance* m, const size_t* entries, size_t count, size_t stride, const double* seed, double* out, double* values) {
    size_t last = (size_t)-1;
    for (size_t i = 0; i < count; ++i) {
        const size_t* e = entries + stride * i;
        if (e[0] != last) { int status = rmc_jvp_call(e[0], m, seed, out); if (status != 0) return RMC_FAILURE(status); last = e[0]; }
        values[i] = out[e[1]];
    }
    return 0;
}
