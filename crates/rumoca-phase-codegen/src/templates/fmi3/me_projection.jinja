/* initial.rs: initial_block_jacobian through eval_settled_initial_jacobian_v:
   the residual rows' JVP at the settled view along the settled tangent of
   each unknown. Row-major over the block. -1 error */
RMC_COLD static int rmc_init_jacobian(ModelInstance* m, const RmcInitBlock* b, double* jac) {
    RMC_MARK; int result = 0; size_t n = b->n; bool dirty = m->parameters_dirty;
    const size_t* rows = rmc_init_pool + {{ tan.residual }};
    double* y = rmc_dalloc(m, Y_LEN); double* p = rmc_dalloc(m, P_LEN); double* seed = rmc_dalloc(m, RMC_SEED_LEN);
    double* residual = rmc_dalloc(m, RMC_INIT_ROWS); double* out = rmc_dalloc(m, RMC_TAN_OUTPUTS + 1);
    if (!y || !p || !seed || !residual || !out) { RMC_RELEASE; return rmc_exhausted(m); }
