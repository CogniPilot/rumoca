    for (size_t i = 0; i < RMC_BS(b, n); ++i) if (!isfinite(m->y[y[i]])) m->y[y[i]] = 0.0;
}
/* Whether one block's residual converges under fresh scales; 1 converged, 0
   not, -1 error. */
RMC_COLD {{ q }} int rmc_block_accepted(ModelInstance* m, const RmcBlock* b) {
    if (RMC_BS(b, singleton_exact)) return 0;
    RMC_MARK; int result = 1;
    double* residual = rmc_dalloc(m, RMC_BS(b, n)); double* rscale = rmc_dalloc(m, RMC_BS(b, n)); double* vscale = rmc_dalloc(m, RMC_BS(b, n)); double* jac = rmc_dalloc(m, RMC_BS(b, nnz) + 1);
    if (!residual || !rscale || !vscale || !jac) result = rmc_exhausted(m);
    else if (rmc_rows(m, b, residual) != 0 || rmc_jacobian(m, b, jac) != 0 || rmc_block_scales(m, b, jac, rscale, vscale) != 0) result = -1;
    else if (!rmc_scaled_converged(m->rmc_tol, residual, rscale, RMC_BS(b, n))) result = 0;
    RMC_RELEASE;
    return result;
}
/* projection.rs: the uncertified end of project_algebraics_with_plan_inner.
   Sweeps that stop unsettled are accepted when the plan's residual converges
   under fresh block scales; a certifying refresh never accepts them. An exact
   singleton block carries no linearization to scale by and is never accepted
   this way. Entries are block ids `stride` apart. 1 converged, 0 not, -1 error */
RMC_COLD {{ q }} int rmc_plan_converged(ModelInstance* m, const size_t* entries, size_t count, size_t stride) {
    if (m->rmc_certify) return 0;
    for (size_t e = 0; e < count; ++e) rmc_block_clear_nonfinite(m, entries[stride * e]);
    for (size_t e = 0; e < count; ++e) {
        int result = rmc_block_accepted(m, rmc_block(entries[stride * e]));
        if (result != 1) return result;
    }
    return 1;
}
/* projection.rs: project_algebraics_with_plan_inner for one stage block under
   branch_continuity.rs; 0 settled, 1 not converged, -1 error */
{{ q }} inline int rmc_project_stage(ModelInstance* m, const RmcBlock* b) {
    const size_t b_n = RMC_BS(b, n); const size_t* const b_y_pool = RMC_BP(b, y);
    for (int iteration = 0; iteration < RMC_REFRESH_ITERS; ++iteration) {
        for (size_t i = 0; i < b_n; ++i) if (!isfinite(m->y[b_y_pool[i]])) m->y[b_y_pool[i]] = 0.0;
        RmcUpdate update = { false, false };
        if (rmc_project_block(m, b, &update) != 0) return -1;
        if (update.settled) return 0;
        if (!update.changed) break;
    }
    if (m->rmc_certify) return 1;
    for (size_t i = 0; i < b_n; ++i) if (!isfinite(m->y[b_y_pool[i]])) m->y[b_y_pool[i]] = 0.0;
    int accepted = rmc_block_accepted(m, b);
    return accepted < 0 ? -1 : (accepted ? 0 : 1);
}
/* projection.rs: project_algebraics_with_plan_inner over a complete
   simultaneous plan (pairs of block id and invalidates-earlier flag) under
   branch_continuity.rs; 0 settled, 1 not converged, -1 error */
{{ q }} inline int rmc_project_complete(ModelInstance* m, const size_t* entries, size_t count) {
    for (int iteration = 0; iteration < RMC_REFRESH_ITERS; ++iteration) {
        bool changed = false, all_settled = true, invalidated = false;
        for (size_t e = 0; e < count; ++e) rmc_block_clear_nonfinite(m, entries[2 * e]);
        for (size_t e = 0; e < count; ++e) {
            RmcUpdate update = { false, false };
            if (rmc_project_block(m, rmc_block(entries[2 * e]), &update) != 0) return -1;
            if (update.changed && e != 0 && !invalidated) invalidated = entries[2 * e + 1] != 0;
            changed = changed || update.changed;
            all_settled = all_settled && update.settled;
        }
        if (all_settled && !invalidated) return 0;
        if (!changed) break;
    }
    int accepted = rmc_plan_converged(m, entries, count, 2);
    return accepted < 0 ? -1 : (accepted ? 0 : 1);
}
