    const size_t b_elim_capacity = RMC_BS(b, elim_capacity); const size_t b_nguards = RMC_BS(b, nguards); const size_t* const b_guard_step_pool = RMC_BP(b, guard_step); const size_t* const b_guards_pool = RMC_BP(b, guards); const size_t b_nelim_tear = RMC_BS(b, nelim_tear); const size_t* const b_elim_tear_pool = RMC_BP(b, elim_tear); const size_t* const b_elim_residual_pool = RMC_BP(b, elim_residual); const size_t b_nelim = RMC_BS(b, nelim);
    size_t cap = b_elim_capacity;
