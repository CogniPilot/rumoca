    size_t causal_target; size_t causal_col; bool elimination; size_t nelim; size_t elim_row;
    size_t elim_col; size_t nelim_tear; size_t elim_residual; size_t elim_tear; size_t nguards;
    size_t guards; size_t guard_step; size_t elim_capacity; size_t iso_default; size_t iso_start;
    size_t iso_entries; size_t nlane_calls; size_t lane_calls; size_t lane_max_outputs;
    size_t lane_max; size_t nsplit; size_t split; size_t row_split; size_t inv_len;
    size_t tangent_lanes; bool tangent_directional; size_t ntangent_steps; size_t tangent_steps;
    size_t tangent_residuals;
} RmcBlockDesc;
