RMC_COLD static int rmc_init_settle_view(ModelInstance* m) {
    for (int pass = 0; pass < RMC_UPDATE_ITERS; ++pass) {
        int changed = rmc_apply_updates(m);
        m->parameters_dirty = false;
        if (changed < 0 || refresh_algebraics(m) != {{ prefix }}OK) break;
        if (pass > 0 && changed == 0) return 0;
