/* The kernel reads a block through its descriptor (`rmc_block`): scalar
   fields in place (RMC_BS) and pool ranges as `rmc_pool` plus the offset
   (RMC_BP). The descriptor carries its own index (`id`, the block's fallback
   site), so a block is one pointer and no field is reached through a second
   one. A C harness may name another pool for a synthetic descriptor
   (RMC_BLOCK_POOL) before it includes this unit. */
typedef struct RmcBlockDescS RmcBlock;
#ifndef RMC_BLOCK_POOL
#define RMC_BLOCK_POOL(b) rmc_pool
#endif
#define RMC_BS(b, field) ((b)->field)
