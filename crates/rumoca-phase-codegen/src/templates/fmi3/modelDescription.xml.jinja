<?xml version="1.0" encoding="UTF-8"?>
{%- set model_identifier = "Rumoca_" ~ (artifact.identities.fmu | replace("-", "_")) %}
<fmiModelDescription
  fmiVersion="3.0"
  modelName="{{ model_name | xml_escape }}"
  generationTool="Rumoca"
  instantiationToken="{{ artifact.identities.fmu }}">
{% if fmi.deployment.interfaces == "model-exchange-and-co-simulation" %}
  <ModelExchange modelIdentifier="{{ model_identifier }}"{% if me_refresh.switching or fmi.scalar_events %} needsCompletedIntegratorStep="true"{% endif %}{% if fmi.deployment.fmu_state %} canGetAndSetFMUState="true"{% endif %}/>
{% endif %}
  <CoSimulation modelIdentifier="{{ model_identifier }}" canHandleVariableCommunicationStepSize="true"{% if fmi.deployment.fmu_state %} canGetAndSetFMUState="true"{% endif %}/>
  <UnitDefinitions>
    <Unit name="s">
      <BaseUnit s="1"/>
    </Unit>
  </UnitDefinitions>
{%- if fmi.enumerations|length > 0 %}
  <TypeDefinitions>
{%- for enumeration in fmi.enumerations %}
    <EnumerationType name="{{ enumeration.name | xml_escape }}">
{%- for literal in enumeration.literals %}
      <Item name="{{ literal | xml_escape }}" value="{{ loop.index }}"/>
{%- endfor %}
    </EnumerationType>
{%- endfor %}
  </TypeDefinitions>
{%- endif %}
  <LogCategories>
    <Category name="error" description="Failures of the generated kernel"/>
{% if fmi.native_logger | default(false) %}
    <Category name="warning" description="Committed model warnings"/>
    <Category name="message" description="Committed model messages"/>
{% else %}
    <Category name="projection" description="Algebraic projection sites whose fallback rate exceeds the reporting threshold"/>
{% endif %}
    <Category name="event" description="State events of a sliding mode applied at the scan coordinate"/>
  </LogCategories>
  <ModelVariables>
    <Float64 name="time" valueReference="0" causality="independent" variability="continuous" unit="s"/>
{%- set state_ordinal = namespace(value=0) %}
{%- for variable in fmi.variables %}
{%- set kind = variable.value_kind %}
{%- set element = variable.fmi3_type %}
    <{{ element }} name="{{ variable.name | xml_escape }}" valueReference="{{ variable.value_reference_fmi3 }}"{% if kind == "Enumeration" %} declaredType="{{ variable.enumeration.name | xml_escape }}"{% endif %} causality="{{ "calculatedParameter" if variable.causality == "calculated_parameter" else variable.causality }}" variability="{{ variable.variability }}"{% if variable.initial %} initial="{{ variable.initial }}"{% endif %}
{%- if variable.start_fmi3 is defined and kind != "String" %} start="{% for value in variable.start_fmi3 %}{% if kind == "Real" %}{{ value }}{% elif kind == "Boolean" %}{{ "true" if value else "false" }}{% else %}{{ value | int }}{% endif %}{{ " " if not loop.last else "" }}{% endfor %}"{% endif %}
{%- if variable.description %} description="{{ variable.description | xml_escape }}"{% endif %}
{#- FMI 3.0 min, max, and nominal are single values that apply to every
    element of an array variable. Per-element bounds are declared by their
    loosest element (the smallest min, the largest max), which every element
    satisfies; a nominal is declared only when every element shares it. -#}
{%- if kind in ["Real", "Integer", "Enumeration"] %}
{%- if variable.minimum_fmi3 is not none %} min="{% set value = variable.minimum_fmi3 %}{{ value if kind == "Real" else value | int }}"{% endif %}
{%- if variable.maximum_fmi3 is not none %} max="{% set value = variable.maximum_fmi3 %}{{ value if kind == "Real" else value | int }}"{% endif %}
{%- endif %}
{%- if kind == "Real" and variable.nominal_fmi3 is not none %} nominal="{{ variable.nominal_fmi3 }}"{% endif %}>
{%- if variable.declared_causality %}
      <Annotations>
        <Annotation type="rumoca.declaredCausality">{{ variable.declared_causality }}</Annotation>
      </Annotations>
{%- endif %}
{%- for extent in variable.dimensions %}
      <Dimension start="{{ extent }}"/>
{%- endfor %}
{%- if kind == "String" and variable.start is defined %}
{%- for text in variable.text_start %}
      <Start value="{{ text | xml_escape }}"/>
{%- endfor %}
{%- endif %}
    </{{ element }}>
{%- if variable.role == "State" %}
{%- set state_ordinal.value = state_ordinal.value + 1 %}
{%- endif %}
{%- endfor %}
{%- set derivative_ordinal = namespace(value=0) %}
{%- for variable in fmi.variables %}
{%- if variable.role == "State" %}
    <Float64 name="der({{ variable.name | xml_escape }})" valueReference="{{ fmi.derivative_value_reference_base_fmi3 + derivative_ordinal.value }}" causality="local" variability="continuous" initial="calculated" derivative="{{ variable.value_reference_fmi3 }}">
{%- for extent in variable.dimensions %}
      <Dimension start="{{ extent }}"/>
{%- endfor %}
    </Float64>
{%- set derivative_ordinal.value = derivative_ordinal.value + 1 %}
{%- endif %}
{%- endfor %}
{%- for root in fmi.event_indicator_roots %}
    <Float64 name="_event_indicator[{{ loop.index }}]" valueReference="{{ fmi.derivative_value_reference_base_fmi3 + derivative_ordinal.value + loop.index0 }}" causality="local" variability="continuous" initial="calculated" description="root condition {{ root }}"/>
{%- endfor %}
  </ModelVariables>
  <ModelStructure>
{%- for variable in fmi.variables %}
{%- if variable.causality == "output" %}
    <Output valueReference="{{ variable.value_reference_fmi3 }}"/>
{%- endif %}
{%- endfor %}
{%- set derivative_ordinal.value = 0 %}
{%- for variable in fmi.variables %}
{%- if variable.role == "State" %}
    <ContinuousStateDerivative valueReference="{{ fmi.derivative_value_reference_base_fmi3 + derivative_ordinal.value }}"/>
{%- set derivative_ordinal.value = derivative_ordinal.value + 1 %}
{%- endif %}
{%- endfor %}
{%- for variable in fmi.variables %}
{%- if variable.initial_unknown %}
    <InitialUnknown valueReference="{{ variable.value_reference_fmi3 }}"/>
{%- endif %}
{%- endfor %}
{%- for ordinal in range(derivative_ordinal.value) %}
    <InitialUnknown valueReference="{{ fmi.derivative_value_reference_base_fmi3 + ordinal }}"/>
{%- endfor %}
{%- for root in fmi.event_indicator_roots %}
    <EventIndicator valueReference="{{ fmi.derivative_value_reference_base_fmi3 + derivative_ordinal.value + loop.index0 }}"/>
{%- endfor %}
  </ModelStructure>
{%- set carried = fmi.carried | default([]) %}
{%- if carried | length > 0 %}
  <Annotations>
    <Annotation type="rumoca.carriedState">
{%- for pair in carried %}
      <Carry output="{{ pair.output }}" input="{{ pair.input }}"/>
{%- endfor %}
    </Annotation>
  </Annotations>
{%- endif %}
</fmiModelDescription>
