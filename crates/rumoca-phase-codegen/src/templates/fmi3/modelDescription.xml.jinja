<?xml version="1.0" encoding="UTF-8"?>
{%- set model_identifier = "Rumoca_" ~ (artifact.identities.fmu | replace("-", "_")) %}
<fmiModelDescription
  fmiVersion="3.0"
  modelName="{{ model_name | xml_escape }}"
  generationTool="Rumoca"
  instantiationToken="{{ artifact.identities.fmu }}">
  <ModelExchange modelIdentifier="{{ model_identifier }}"{% if me_refresh.switching %} needsCompletedIntegratorStep="true"{% endif %} canGetAndSetFMUState="true"/>
  <CoSimulation modelIdentifier="{{ model_identifier }}" canHandleVariableCommunicationStepSize="true" canGetAndSetFMUState="true"/>
  <UnitDefinitions>
    <Unit name="s">
      <BaseUnit s="1"/>
    </Unit>
  </UnitDefinitions>
  <ModelVariables>
    <Float64 name="time" valueReference="0" causality="independent" variability="continuous" unit="s"/>
{%- set state_ordinal = namespace(value=0) %}
{%- for variable in fmi.variables %}
{%- set kind = variable.value_kind %}
{%- set element = "Float64" if kind == "Real" else ("Int32" if kind in ["Integer", "Enumeration"] else kind) %}
    <{{ element }} name="{{ variable.name | xml_escape }}" valueReference="{{ variable.value_reference_fmi3 }}" causality="{{ "calculatedParameter" if variable.causality == "calculated_parameter" else variable.causality }}" variability="{{ variable.variability }}"{% if variable.initial %} initial="{{ variable.initial }}"{% endif %}
{%- if variable.start is defined and kind != "String" %} start="{% for value in variable.start %}{% if kind == "Real" %}{{ value }}{% elif kind == "Boolean" %}{{ "true" if value != 0 else "false" }}{% else %}{{ value | int }}{% endif %}{{ " " if not loop.last else "" }}{% endfor %}"{% endif %}
{%- if variable.description %} description="{{ variable.description | xml_escape }}"{% endif %}
{#- FMI 3.0 min, max, and nominal are single values that apply to every
    element of an array variable. Per-element bounds are declared by their
    loosest element (the smallest min, the largest max), which every element
    satisfies; a nominal is declared only when every element shares it. -#}
{%- if kind in ["Real", "Integer", "Enumeration"] %}
{%- if variable.minimum %} min="{% set value = variable.minimum | min %}{{ value if kind == "Real" else value | int }}"{% endif %}
{%- if variable.maximum %} max="{% set value = variable.maximum | max %}{{ value if kind == "Real" else value | int }}"{% endif %}
{%- endif %}
{%- if kind == "Real" and variable.nominal and (variable.nominal | unique | list | length) == 1 %} nominal="{{ variable.nominal[0] }}"{% endif %}>
{%- for extent in variable.dimensions %}
      <Dimension start="{{ extent }}"/>
{%- endfor %}
{%- if kind == "String" and variable.start is defined %}
{%- for text in variable.text_start %}
      <Start value="{{ text | xml_escape }}"/>
{%- endfor %}
{%- endif %}
    </{{ element }}>
{%- if variable.role == "State" %}
{%- set state_ordinal.value = state_ordinal.value + 1 %}
{%- endif %}
{%- endfor %}
{%- set derivative_ordinal = namespace(value=0) %}
{%- for variable in fmi.variables %}
{%- if variable.role == "State" %}
    <Float64 name="der({{ variable.name | xml_escape }})" valueReference="{{ fmi.derivative_value_reference_base_fmi3 + derivative_ordinal.value }}" causality="local" variability="continuous" initial="calculated" derivative="{{ variable.value_reference_fmi3 }}">
{%- for extent in variable.dimensions %}
      <Dimension start="{{ extent }}"/>
{%- endfor %}
    </Float64>
{%- set derivative_ordinal.value = derivative_ordinal.value + 1 %}
{%- endif %}
{%- endfor %}
  </ModelVariables>
  <ModelStructure>
{%- for variable in fmi.variables %}
{%- if variable.causality == "output" %}
    <Output valueReference="{{ variable.value_reference_fmi3 }}"/>
{%- endif %}
{%- endfor %}
{%- set derivative_ordinal.value = 0 %}
{%- for variable in fmi.variables %}
{%- if variable.role == "State" %}
    <ContinuousStateDerivative valueReference="{{ fmi.derivative_value_reference_base_fmi3 + derivative_ordinal.value }}"/>
{%- set derivative_ordinal.value = derivative_ordinal.value + 1 %}
{%- endif %}
{%- endfor %}
{%- for variable in fmi.variables %}
{%- if variable.initial_unknown %}
    <InitialUnknown valueReference="{{ variable.value_reference_fmi3 }}"/>
{%- endif %}
{%- endfor %}
{%- for ordinal in range(derivative_ordinal.value) %}
    <InitialUnknown valueReference="{{ fmi.derivative_value_reference_base_fmi3 + ordinal }}"/>
{%- endfor %}
  </ModelStructure>
</fmiModelDescription>
