{#- Follows the whitespace convention stated in `typed_arithmetic.jinja`. -#}
{%- from "fmi-typed-arithmetic.jinja" import copy, binary, integer_binary %}
{%- macro bounds(index, extent) -%}
if (r{{ index }}[0]<1 || r{{ index }}[0]>{{ extent }}) return 1;
{% endmacro %}

{%- macro tensor(op, program) -%}
{% set dst = "r" ~ op.destination -%}
{% set ty = program.register_types[op.destination] -%}
{% if op.operation in ["scale", "matrix_multiply", "cross"] and (ty.scalar.kind != "real" or ty.scalar.profile.format != "binary64") %}{{ fail("unsupported-feature:fmi.c.pure-call: non-Real tensor arithmetic") }}{% endif -%}
{% if op.operation == "reduce" -%}
{% set operators = {"sum":"add", "product":"multiply", "minimum":"min", "maximum":"max", "all":"and"} -%}
{% if op.operator not in operators or not (((ty.scalar.kind == "real" and ty.scalar.profile.format == "binary64") or ty.scalar.kind == "integer") and op.operator != "all" or (ty.scalar.kind == "boolean" and op.operator in ["all", "minimum", "maximum"])) %}{{ fail("unsupported-feature:fmi.c.pure-call: reduction type or operator") }}{% endif -%}
{% set count = program.register_types[op.operand].scalar_count -%}
{#- Match the typed evaluator's eval_reduce: seed with the first element, then
    combine in order. An extra identity changes NaNs and signed zeros. -#}
{{ dst }}[0]=r{{ op.operand }}[0];
for (size_t k=1; k<{{ count }}; ++k) {
{% if ty.scalar.kind == "integer" -%}
{{ integer_binary(operators[op.operator], dst ~ "[0]", dst ~ "[0]", "r" ~ op.operand ~ "[k]") -}}
{% else -%}
{{ dst }}[0] = {{ binary(operators[op.operator], dst ~ "[0]", "r" ~ op.operand ~ "[k]") }};
{% endif -%}
}
{% elif op.operation == "fill" -%}
for (size_t k=0; k<{{ ty.scalar_count }}; ++k) {{ dst }}[k]=r{{ op.value }}[0];
{% elif op.operation == "identity" -%}
{% set size = ty.dimensions[0] -%}
for (size_t i=0; i<{{ size }}; ++i) for (size_t j=0; j<{{ size }}; ++j) {{ dst }}[i*{{ size }}+j]=(i==j)?1.0:0.0;
{% elif op.operation == "diagonal" -%}
{% set size = program.register_types[op.operand].dimensions[0] -%}
for (size_t i=0; i<{{ size }}; ++i) for (size_t j=0; j<{{ size }}; ++j) {{ dst }}[i*{{ size }}+j]=(i==j)?r{{ op.operand }}[i]:0.0;
{% elif op.operation == "concatenate" -%}
{% set inner = ty.dimensions[op.axis + 1:]|product -%}
{% set outer = ty.dimensions[:op.axis]|product -%}
{ size_t cursor=0;
for (size_t outer=0; outer<{{ outer }}; ++outer) {
{% for operand in op.operands -%}
{% set operand_dims = program.register_types[operand].dimensions -%}
{% set width = (operand_dims[op.axis] if operand_dims|length > op.axis else 1) * inner -%}
for (size_t k=0; k<{{ width }}; ++k) {{ dst }}[cursor++]=r{{ operand }}[outer*{{ width }}+k];
{% endfor -%}
} }
{% elif op.operation == "construct_aggregate" -%}
{% for element in op.elements -%}
{% set width = program.register_types[element].scalar_count -%}
memcpy(&{{ dst }}[{{ loop.index0 * width }}], r{{ element }}, {{ width if width > 0 else 1 }} * sizeof(r{{ element }}[0]));
{% endfor -%}
{% elif op.operation == "scale" -%}
for (size_t k=0; k<{{ ty.scalar_count }}; ++k) {{ dst }}[k]=r{{ op.aggregate }}[k]*r{{ op.scalar }}[0];
{% elif op.operation == "transpose" -%}
{% set shape = program.register_types[op.operand].dimensions -%}
{% set rows = shape[0] -%}
{% set columns = shape[1] -%}
{% set trailing = shape[2:]|product -%}
for (size_t i=0; i<{{ rows }}; ++i) for (size_t j=0; j<{{ columns }}; ++j) for (size_t k=0; k<{{ trailing }}; ++k) {{ dst }}[(j*{{ rows }}+i)*{{ trailing }}+k]=r{{ op.operand }}[(i*{{ columns }}+j)*{{ trailing }}+k];
{% elif op.operation == "matrix_multiply" -%}
{% set a = program.register_types[op.lhs].dimensions -%}
{% set b = program.register_types[op.rhs].dimensions -%}
{% set rows = 1 if a|length == 1 else a[0] -%}
{% set inner = a[0] if a|length == 1 else a[1] -%}
{% set columns = 1 if b|length == 1 else b[1] -%}
for (size_t i=0; i<{{ rows }}; ++i) for (size_t j=0; j<{{ columns }}; ++j) { double sum=0.0; for (size_t k=0; k<{{ inner }}; ++k) sum+=r{{ op.lhs }}[i*{{ inner }}+k]*r{{ op.rhs }}[k*{{ columns }}+j]; {{ dst }}[i*{{ columns }}+j]=sum; }
{% elif op.operation == "cross" -%}
{% for i in range(3) %}{{ dst }}[{{ i }}]=r{{ op.lhs }}[{{ (i+1)%3 }}]*r{{ op.rhs }}[{{ (i+2)%3 }}]-r{{ op.lhs }}[{{ (i+2)%3 }}]*r{{ op.rhs }}[{{ (i+1)%3 }}];{% endfor %}
{% elif op.operation in ["project_element", "project_element_dynamic", "update_element"] -%}
{% set shape = program.register_types[op.aggregate].dimensions -%}
{ size_t index=0;
{% for index in op.indices -%}
{% if op.operation == "project_element" -%}
index=index*{{ shape[loop.index0] }}+{{ index }};
{% else -%}
{{ bounds(index, shape[loop.index0]) -}}
index=index*{{ shape[loop.index0] }}+(size_t)(r{{ index }}[0]-1);
{% endif -%}
{% endfor -%}
{% if op.operation == "update_element" -%}
{{ copy(dst, "r" ~ op.aggregate) -}}
{{ dst }}[index]=r{{ op.value }}[0];
{% else -%}
{{ dst }}[0]=r{{ op.aggregate }}[index];
{% endif -%}
}
{% elif op.operation in ["project_slice", "update_slice"] -%}
{% set shape = program.register_types[op.aggregate].dimensions -%}
{% set slice = program.register_types[op.value] if op.operation == "update_slice" else ty -%}
{% if op.operation == "update_slice" %}{{ copy(dst, "r" ~ op.aggregate) }}{% endif -%}
{% if slice.scalar_count > 0 -%}
for (size_t k=0; k<{{ slice.scalar_count }}; ++k) { size_t rest=k; size_t offset=0; (void)rest;
{% for i in range(slice.dimensions|length)|reverse -%}
{% set stride = shape[i+1:]|product -%}
offset+=({{ op.origin[i] }}+rest%{{ slice.dimensions[i] }})*{{ stride }}; rest/={{ slice.dimensions[i] }};
{% endfor -%}
{% if op.operation == "update_slice" -%}
{{ dst }}[offset]=r{{ op.value }}[k];
{% else -%}
{{ dst }}[k]=r{{ op.aggregate }}[offset];
{% endif -%}
}
{% endif -%}
{% elif op.operation in ["project_view", "update_view"] -%}
{% set shape = program.register_types[op.aggregate].dimensions -%}
{% set count = program.register_types[op.value].scalar_count if op.operation == "update_view" else ty.scalar_count -%}
{% if op.operation == "update_view" %}{{ copy(dst, "r" ~ op.aggregate) }}{% endif -%}
{% for axis in op.axes %}{% if axis.index is defined %}{{ bounds(axis.index, shape[loop.index0]) }}{% endif %}{% endfor -%}
for (size_t k=0; k<{{ count }}; ++k) { size_t rest=k; size_t offset=0; (void)rest;
{% for i in range(op.axes|length)|reverse -%}
{% set axis = op.axes[i] -%}
{% set stride = shape[i+1:]|product -%}
{% if axis.index is defined -%}
offset+=(size_t)(r{{ axis.index }}[0]-1)*{{ stride }};
{% else -%}
offset+=({{ axis.span.origin }}+rest%{{ axis.span.extent }})*{{ stride }}; rest/={{ axis.span.extent }};
{% endif -%}
{% endfor -%}
{% if op.operation == "update_view" -%}
{{ dst }}[offset]=r{{ op.value }}[k];
{% else -%}
{{ dst }}[k]=r{{ op.aggregate }}[offset];
{% endif -%}
}
{% elif op.operation == "broadcast_binary" -%}
{% set a = "r" ~ op.aggregate ~ "[k]" -%}
{% set b = "r" ~ op.scalar ~ "[0]" -%}
for (size_t k=0; k<{{ ty.scalar_count }}; ++k) {
{% if ty.scalar.kind == "integer" -%}
{{ integer_binary(op.operator, dst ~ "[k]", b if op.scalar_on_lhs else a, a if op.scalar_on_lhs else b) -}}
{% else -%}
{{ dst }}[k]={{ binary(op.operator, b if op.scalar_on_lhs else a, a if op.scalar_on_lhs else b) }};
{% endif -%}
}
{% elif op.operation in ["project_slice", "update_slice"] -%}
{#- Rank-preserving compact block at a zero-based origin; the block's own
    shape is the destination's (project) or the value's (update). -#}
{% set shape = program.register_types[op.aggregate].dimensions -%}
{% set block = program.register_types[op.value].dimensions if op.operation == "update_slice" else ty.dimensions -%}
{% set count = program.register_types[op.value].scalar_count if op.operation == "update_slice" else ty.scalar_count -%}
{% if op.operation == "update_slice" %}{{ copy(dst, "r" ~ op.aggregate) }}{% endif -%}
for (size_t k=0; k<{{ count }}; ++k) { size_t rest=k; size_t offset=0; (void)rest;
{% for i in range(block|length)|reverse -%}
{% set stride = shape[i+1:]|product -%}
offset+=({{ op.origin[i] }}+rest%{{ block[i] }})*{{ stride }}; rest/={{ block[i] }};
{% endfor -%}
{% if op.operation == "update_slice" -%}
{{ dst }}[offset]=r{{ op.value }}[k];
{% else -%}
{{ dst }}[k]=r{{ op.aggregate }}[offset];
{% endif -%}
}
{% elif op.operation == "select_element" -%}
{#- Dynamic one-based element read that yields the fallback instead of
    failing when any coordinate is out of range. -#}
{% set shape = program.register_types[op.aggregate].dimensions -%}
{ size_t index=0; int in_range=1;
{% for index in op.indices -%}
if (r{{ index }}[0]<1 || r{{ index }}[0]>{{ shape[loop.index0] }}) in_range=0;
index=index*{{ shape[loop.index0] }}+(in_range ? (size_t)(r{{ index }}[0]-1) : 0);
{% endfor -%}
{{ dst }}[0]=in_range ? r{{ op.aggregate }}[index] : r{{ op.out_of_range }}[0];
}
{% elif op.operation == "linear_solve" -%}
{#- Dense square solve by Gaussian elimination with partial pivoting on a
    private copy; a zero pivot is a runtime failure. -#}
{% set n = program.register_types[op.matrix].dimensions[0] -%}
{% set m = program.register_types[op.rhs].dimensions -%}
{% set columns = 1 if m|length == 1 else m[1] -%}
{ double A[{{ n * n }}]; double B[{{ n * columns }}];
memcpy(A, r{{ op.matrix }}, sizeof(A)); memcpy(B, r{{ op.rhs }}, sizeof(B));
for (size_t c=0; c<{{ n }}; ++c) {
size_t p=c; for (size_t i=c+1; i<{{ n }}; ++i) if (fabs(A[i*{{ n }}+c])>fabs(A[p*{{ n }}+c])) p=i;
if (A[p*{{ n }}+c]==0.0) return 1;
if (p!=c) { for (size_t j=0; j<{{ n }}; ++j) { double t=A[c*{{ n }}+j]; A[c*{{ n }}+j]=A[p*{{ n }}+j]; A[p*{{ n }}+j]=t; } for (size_t j=0; j<{{ columns }}; ++j) { double t=B[c*{{ columns }}+j]; B[c*{{ columns }}+j]=B[p*{{ columns }}+j]; B[p*{{ columns }}+j]=t; } }
for (size_t i=c+1; i<{{ n }}; ++i) { double f=A[i*{{ n }}+c]/A[c*{{ n }}+c]; for (size_t j=c; j<{{ n }}; ++j) A[i*{{ n }}+j]-=f*A[c*{{ n }}+j]; for (size_t j=0; j<{{ columns }}; ++j) B[i*{{ columns }}+j]-=f*B[c*{{ columns }}+j]; }
}
for (size_t ii=0; ii<{{ n }}; ++ii) { size_t i={{ n }}-1-ii; for (size_t j=0; j<{{ columns }}; ++j) { double s=B[i*{{ columns }}+j]; for (size_t k=i+1; k<{{ n }}; ++k) s-=A[i*{{ n }}+k]*{{ dst }}[k*{{ columns }}+j]; {{ dst }}[i*{{ columns }}+j]=s/A[i*{{ n }}+i]; } }
}
{% else %}{{ fail("unsupported-feature:fmi.c.pure-call: tensor " ~ op.operation) }}{% endif -%}
{% endmacro %}
