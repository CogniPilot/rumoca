/* m and all buffers are private to this derivative evaluation. This routine
   writes no live primal coordinate and evaluates source JVPs without allocation. */
static int {{ stem }}_total_tangent(ModelInstance* m, double* seed,
                             double* rhs, double* scratch, double* implicit_work,
                             size_t* implicit_sizes) {
    (void)scratch; (void)implicit_work; (void)implicit_sizes;
    if (!m{% if tangent.uses.seed %} || !seed{% endif %}{% if tangent.uses.states %} || !rhs{% endif %}{% if tangent.uses.scratch %} || !scratch{% endif %}{% if tangent.uses.private %} || !implicit_work{% endif %}{% if tangent.uses.pivots %} || !implicit_sizes{% endif %}) return -1;
    for (size_t k=0; k<{{ tangent.seed_len }}; ++k)
        if (!isfinite(seed[k])) return -1;
{#- Each issued occurrence, in issued order. #}
{%- for occurrence in tangent.occurrences %}
{%- if occurrence.kind == "implicit_solve" %}
    if ({{ stem }}_implicit_tangent(m, seed, scratch, implicit_work, implicit_sizes) != 0) return -1;
{%- elif occurrence.kind == "assignment" %}
{%- for body in tangent.assignments[occurrence.segment].plan.programs %}
    if ({{ stem }}_tangent_assign_{{ occurrence.segment }}_{{ loop.index0 }}(m, seed, scratch) != 0) return -1;
{%- endfor %}
    /* Validate the entire simultaneous result before overwriting any seed. */
    for (size_t k=0; k<{{ occurrence.targets }}; ++k)
        if (!isfinite(scratch[k])) return -1;
{%- for target in tangent.assignments[occurrence.segment].targets %}
    seed[{{ target }}] = scratch[{{ loop.index0 }}];
{%- endfor %}
{%- elif occurrence.kind == "implicit_verification" %}
    static const size_t implicit_rows[{{ occurrence.unknowns }}] = { {% for row in tangent.implicit.rows %}{{ row }},{% endfor %} };
    static const size_t implicit_targets[{{ occurrence.unknowns }}] = { {% for target in tangent.implicit.subtract_targets %}{{ target }},{% endfor %} };
    static const RmcTangentCheck implicit_check = {
        {{ tangent.seed_len }}, {{ occurrence.unknowns }}, implicit_rows, implicit_targets,
        {{ stem }}_tangent_residuals, {{ tangent.implicit.tolerance }}
    };
    if (rmc_verify_tangent(m, seed, scratch, implicit_work, &implicit_check) != 0) return -1;
{%- elif occurrence.kind == "consistency" %}
    static const size_t check_rows[{{ occurrence.rows }}] = { {% for row in tangent.consistency.rows %}{{ row }},{% endfor %} };
    static const RmcTangentCheck source_check = {
        {{ tangent.seed_len }}, {{ occurrence.rows }}, check_rows, NULL,
        {{ stem }}_tangent_checks, {{ tangent.consistency.tolerance }}
    };
    if (rmc_verify_tangent(m, seed, scratch, implicit_work, &source_check) != 0) return -1;
{%- elif occurrence.kind == "rhs" %}
{%- for body in tangent.rhs.programs %}
    if ({{ stem }}_tangent_rhs_{{ loop.index0 }}(m, seed, rhs) != 0) return -1;
{%- endfor %}
{%- else %}{{ fail("unsupported-feature:fmi.c.tangent: unknown issued occurrence") }}
{%- endif %}
{%- endfor %}
    for (size_t k=0; k<{{ tangent.state_len }}; ++k)
        if (!isfinite(rhs[k])) return -1;
    return 0;
}
{%- endmacro %}

{%- macro verification_functions() %}
typedef int (*RmcTangentRows)(ModelInstance*, const double*, double*);
typedef struct {
    size_t seed_len, count;
    const size_t* rows;
    const size_t* subtract_targets;
    RmcTangentRows evaluate;
    double tolerance;
} RmcTangentCheck;

static double rmc_tangent_check_value(const RmcTangentCheck* check, size_t row,
                                      const double* values, const double* seed) {
    double value = values[check->rows[row]];
    if (check->subtract_targets && check->subtract_targets[row])
        value -= seed[check->subtract_targets[row]-1];
    return value;
}
/* fmi_tangents::consistency_row_converged. Scale each source row by the
   largest actual |Jacobian column * direction| contribution. No unit floor,
   absolute residual waiver, or fabricated zero derivative. Evaluations use exact source JVPs.
   All seed/scratch/work buffers and the primal point belong to this request. */
static int rmc_verify_tangent(ModelInstance* m, double* seed, double* scratch,
                               double* work, const RmcTangentCheck* check) {
    double* saved = work;
    double* scales = saved + check->seed_len;
    memcpy(saved, seed, check->seed_len*sizeof(double));
    memset(scales, 0, check->count*sizeof(double));
    for (size_t column=0; column<check->seed_len; ++column) {
        if (saved[column] == 0.0) continue;
        memset(seed, 0, check->seed_len*sizeof(double));
        seed[column] = 1.0;
        if (check->evaluate(m, seed, scratch) != 0) return -1;
        for (size_t row=0; row<check->count; ++row) {
            double coefficient = rmc_tangent_check_value(check, row, scratch, seed);
            if (!isfinite(coefficient)) return -1;
            double contribution = fabs(coefficient*saved[column]);
            if (!isfinite(contribution)) return -1;
            if (contribution > scales[row]) scales[row] = contribution;
        }
    }
    memcpy(seed, saved, check->seed_len*sizeof(double));
    if (check->evaluate(m, seed, scratch) != 0) return -1;
    for (size_t row=0; row<check->count; ++row) {
        double value = rmc_tangent_check_value(check, row, scratch, seed);
        double scale = scales[row];
        if (!isfinite(value) || !isfinite(scale) || scale < 0.0) return -1;
        if (value == 0.0) continue;
        if (scale == 0.0 || fabs(value) > check->tolerance*scale) return -1;
    }
    return 0;
}
{%- endmacro %}

{#- Construction has issued all three mode plans for this exact component.
    The API only projects that inventory and executes its numerical programs. -#}
