{{ verification_functions() }}
{%- endif %}
{{ functions(tangent, "rmc") }}
{%- if initialization.available %}
{{ functions(initialization, "rmc_initial") }}
{%- endif %}
{%- if post.available %}
{{ functions(post, "rmc_post") }}
{%- endif %}

static int rmc_evaluate_total_tangent(ModelInstance* m, double* seed, double* rhs,
                                      double* scratch, double* work, size_t* sizes) {
{%- if initialization.available %}
    if (m->state == MODEL_INITIALIZATION)
        return rmc_initial_total_tangent(m, seed, rhs, scratch, work, sizes);
{%- endif %}
{%- if post.available %}
    if (m->state == MODEL_EVENT || m->state == MODEL_STEP)
        return rmc_post_total_tangent(m, seed, rhs, scratch, work, sizes);
{%- endif %}
    return rmc_total_tangent(m, seed, rhs, scratch, work, sizes);
}

/* Role bits project the SAME inventory/order as rmc_value_references. Storage
   type, scalar extent and location are always read from that existing table. */
static const unsigned short rmc_tangent_roles[] = {
    0,
{%- for variable in fmi.variables %}{% set variable_index = loop.index0 %}{% for scalar in range(variable.storage.scalar_count if prefix == "fmi2" else 1) %}
    {{ (1 if variable.causality == "input" and variable.variability == "continuous" else 0) + (2 if variable.causality == "output" and variable.variability == "continuous" else 0) + (4 if variable.role == "State" else 0) + (16 if variable.causality == "input" and variable.variability == "discrete" else 0) + (32 if variable.initial == "exact" and variable.variability != "constant" else 0) + (64 if variable.initial_unknown else 0) + (128 if variable.causality == "output" and variable.variability == "discrete" else 0) + (256 if variable.causality == "parameter" and variable.variability == "tunable" else 0) + (512 if prefix == "fmi3" and variable.role == "State" and not fmi.state_reinitializations[variable_index] else 0) }},
{%- endfor %}{% endfor %}
{%- for variable in fmi.variables %}{% if variable.role == "State" %}{% for scalar in range(variable.storage.scalar_count if prefix == "fmi2" else 1) %}
    72,
{%- endfor %}{% endif %}{% endfor %}
{%- if prefix == "fmi3" %}{% for root in fmi.event_indicator_roots %}
    0,
{%- endfor %}{% endif %}
};
typedef struct { unsigned char column; size_t base; size_t count; } RmcTangentReference;
static bool rmc_tangent_reference(const ModelInstance* m, {{ prefix }}ValueReference vr,
                                  bool known, RmcTangentReference* result) {
    if (vr >= RMC_VALUE_REFERENCES || vr >= sizeof(rmc_tangent_roles)/sizeof(rmc_tangent_roles[0])) return false;
    RmcValueReference ref = rmc_value_references[vr];
    if (ref.kind != RMC_KIND_FLOAT64) return false;
    unsigned short role = rmc_tangent_roles[vr];
    if (ref.column == RMC_COLUMN_TIME) {
        /* Same lifecycle as the existing dedicated SetTime entrypoint.
           Time is never an unknown or an initialization/CS-step known. */
        if (!known || m->type != {{ me_type }} || m->state != MODEL_CONTINUOUS) return false;
    } else if (m->state == MODEL_INITIALIZATION) {
        if (known) {
            if (!(role & (1 | 16 | 32)) || !rmc_can_set(m, &ref)) return false;
            if (ref.column != RMC_COLUMN_Y && ref.column != RMC_COLUMN_P) return false;
        } else {
            if (!(role & 64)) return false;
            if (ref.column != RMC_COLUMN_Y && ref.column != RMC_COLUMN_P && ref.column != RMC_COLUMN_DERIVATIVE) return false;
        }
    } else if (m->state == MODEL_EVENT || m->state == MODEL_STEP) {
        if (known) {
            /* FMI 3 non-reinitializable ME states are settable in Event Mode.
               The ordinary setter owner still rejects them in CS Step Mode. */
            if (!(role & (1 | 16 | 256{% if prefix == "fmi3" %} | 512{% endif %})) || !rmc_can_set(m, &ref)) return false;
            if (ref.column != RMC_COLUMN_Y && ref.column != RMC_COLUMN_P) return false;
        } else {
            if (!(role & (2 | 8 | 128))) return false;
            if (ref.column != RMC_COLUMN_Y && ref.column != RMC_COLUMN_P && ref.column != RMC_COLUMN_DERIVATIVE) return false;
        }
    } else if (known) {
        if (!(role & 1) && !((role & 4) && m->type == {{ me_type }} && m->state == MODEL_CONTINUOUS)) return false;
        if (ref.column != RMC_COLUMN_Y && ref.column != RMC_COLUMN_P) return false;
    } else {
        if (!(role & (2 | 8))) return false;
        if (ref.column != RMC_COLUMN_Y && ref.column != RMC_COLUMN_P && ref.column != RMC_COLUMN_DERIVATIVE) return false;
    }
    result->column = ref.column;
    result->base = ref.{{ "index" if prefix == "fmi2" else "base" }};
    result->count = {{ "1" if prefix == "fmi2" else "ref.count" }};
    return true;
}
static bool rmc_tangent_extent(const ModelInstance* m,
                               const {{ prefix }}ValueReference refs[], size_t count,
                               bool known, size_t* extent) {
    if (!refs && count) return false;
    size_t total = 0;
    for (size_t k=0; k<count; ++k) {
        RmcTangentReference ref;
        if (!rmc_tangent_reference(m, refs[k], known, &ref) || ref.count > SIZE_MAX-total) return false;
        total += ref.count;
    }
    *extent = total; return true;
}
static size_t rmc_tangent_seed_index(RmcTangentReference ref, size_t element) {
    return ref.column == RMC_COLUMN_TIME ? {{ tangent.time_seed }}
         : ref.base + element + (ref.column == RMC_COLUMN_P ? {{ tangent.y_len }} : 0);
}
static double rmc_tangent_unknown(RmcTangentReference ref, size_t element,
                                  const double* seed, const double* rhs) {
    return ref.column == RMC_COLUMN_DERIVATIVE ? rhs[ref.base+element]
         : seed[rmc_tangent_seed_index(ref, element)];
}

/* All request/type/role/extent checks precede a snapshot or numerical call.
   The only public-buffer write is the final memcpy after complete success.
   Adjoint products use exact directional basis columns from the checked JVPs. */
static {{ prefix }}Status rmc_tangent_request({{ instance_type }} instance,
        const {{ prefix }}ValueReference unknowns[], size_t nunknowns,
        const {{ prefix }}ValueReference knowns[], size_t nknowns,
        const double input[], size_t ninput, double output[], size_t noutput,
        bool adjoint) {
    ModelInstance* live = instance;
    if (!live) return rmc_tangent_error(live);
    const bool initializing = live->state == MODEL_INITIALIZATION;
    const bool post_initial = live->state == MODEL_EVENT || live->state == MODEL_STEP;
    if (initializing) {
{%- if initialization.available %}
        if (live->type != {{ me_type }} && live->type != {{ cs_type }}) return rmc_tangent_error(live);
{%- else %}
        return rmc_tangent_error(live);
{%- endif %}
    } else if (post_initial) {
{%- if post.available %}
        if (!((live->type == {{ me_type }} && live->state == MODEL_EVENT)
                || (live->type == {{ cs_type }} && live->state == MODEL_STEP))) return rmc_tangent_error(live);
{%- else %}
        return rmc_tangent_error(live);
{%- endif %}
    } else if (live->type != {{ me_type }} || live->state != MODEL_CONTINUOUS) return rmc_tangent_error(live);
    size_t nk, nu;
    if (!rmc_tangent_extent(live, knowns, nknowns, true, &nk)
            || !rmc_tangent_extent(live, unknowns, nunknowns, false, &nu)
            || ninput != (adjoint ? nu : nk) || noutput != (adjoint ? nk : nu)
            || (!input && ninput) || (!output && noutput)
            || noutput > SIZE_MAX/sizeof(double)) return rmc_tangent_error(live);
    for (size_t k=0; k<ninput; ++k) if (!isfinite(input[k])) return rmc_tangent_error(live);
    if (noutput == 0) return {{ prefix }}OK;
    if (UINT64_C({{ plans.work_len if plans.work_len > 0 else 1 }}) > SIZE_MAX/sizeof(double)
            || UINT64_C({{ plans.sizes_len }}) > SIZE_MAX/sizeof(size_t)) return rmc_tangent_error(live);
    const size_t work_len = (size_t)UINT64_C({{ plans.work_len if plans.work_len > 0 else 1 }});
    double* result = rmc_instance_allocate(live, noutput ? noutput : 1, sizeof(double));
    double* work = rmc_instance_allocate(live, work_len, sizeof(double));
    const size_t sizes_len = (size_t)UINT64_C({{ plans.sizes_len }});
    size_t* sizes = sizes_len && sizes_len <= SIZE_MAX/sizeof(size_t)
        ? rmc_instance_allocate(live, sizes_len, sizeof(size_t)) : NULL;
    ModelInstance* point = rmc_instance_allocate(live, 1, sizeof(ModelInstance));
    bool owns_point = false;
    {{ prefix }}Status status = {{ prefix }}Error;
    if (!result || !work || !point || (sizes_len && !sizes)) goto cleanup;
    memcpy(point, live, sizeof(ModelInstance));
    if (!rmc_own_text(point, live)) { rmc_instance_free(live, point); point = NULL; goto cleanup; }
    owns_point = true;
{%- if initialization.available %}
    if (initializing) {
        /* Evaluate f_init on the private point, preserving Initialization Mode
           and every live value/history field. This is not ExitInitializationMode. */
{%- if me.init.rows > 0 %}
        if (rmc_initialize(point, point->tolerance) != {{ prefix }}OK) goto cleanup;
{%- else %}
        if (rmc_apply_updates(point, true) < 0) goto cleanup;
{%- endif %}
        point->parameters_dirty = false;
    }
{%- endif %}
    /* Settle the same private primal point; live values/relations/texts remain
       untouched even when a later operation or allocation refuses. */
    if (settle_public_values(point) != {{ prefix }}OK) goto cleanup;
    double* seed = work;
    double* rhs = seed + {{ tangent.seed_len }};
    double* scratch = rhs + {{ tangent.state_len }};
    const size_t scratch_len = {% if initialization.available %}initializing ? {{ initialization.scratch_len }} : {% endif %}{% if post.available %}post_initial ? {{ post.scratch_len }} : {% endif %}{{ tangent.scratch_len }};
    double* implicit_work = scratch + scratch_len;
    if (!adjoint) {
        size_t position = 0;
        for (size_t k=0; k<nknowns; ++k) {
            RmcTangentReference ref;
            if (!rmc_tangent_reference(point, knowns[k], true, &ref)) goto cleanup;
            for (size_t j=0; j<ref.count; ++j) {
                size_t slot = rmc_tangent_seed_index(ref, j);
                seed[slot] += input[position++];
                if (!isfinite(seed[slot])) goto cleanup;
            }
        }
        if (rmc_evaluate_total_tangent(point, seed, rhs, scratch, implicit_work, sizes) != 0) goto cleanup;
        position = 0;
        for (size_t k=0; k<nunknowns; ++k) {
            RmcTangentReference ref;
            if (!rmc_tangent_reference(point, unknowns[k], false, &ref)) goto cleanup;
            for (size_t j=0; j<ref.count; ++j)
                result[position++] = rmc_tangent_unknown(ref, j, seed, rhs);
        }
    } else {
        size_t column = 0;
        for (size_t k=0; k<nknowns; ++k) {
            RmcTangentReference known;
            if (!rmc_tangent_reference(point, knowns[k], true, &known)) goto cleanup;
            for (size_t j=0; j<known.count; ++j) {
                memset(work, 0, work_len*sizeof(double));
                seed[rmc_tangent_seed_index(known, j)] = 1.0;
                if (rmc_evaluate_total_tangent(point, seed, rhs, scratch, implicit_work, sizes) != 0) goto cleanup;
                size_t row = 0;
                double sum = 0.0;
                for (size_t u=0; u<nunknowns; ++u) {
                    RmcTangentReference unknown;
                    if (!rmc_tangent_reference(point, unknowns[u], false, &unknown)) goto cleanup;
                    for (size_t e=0; e<unknown.count; ++e) {
                        double product = input[row++]*rmc_tangent_unknown(unknown, e, seed, rhs);
                        if (!isfinite(product)) goto cleanup;
                        sum += product;
                        if (!isfinite(sum)) goto cleanup;
                    }
                }
                result[column++] = sum;
            }
        }
    }
    for (size_t k=0; k<noutput; ++k) if (!isfinite(result[k])) goto cleanup;
    if (noutput) memcpy(output, result, noutput*sizeof(double));
    status = {{ prefix }}OK;
cleanup:
    if (owns_point) rmc_release_text(point);
    rmc_instance_free(live, point); rmc_instance_free(live, sizes);
    rmc_instance_free(live, work); rmc_instance_free(live, result);
    return status == {{ prefix }}OK ? status : rmc_tangent_error(live);
}
{%- if prefix == "fmi2" %}
FMI_EXPORT fmi2Status fmi2GetDirectionalDerivative(fmi2Component instance,
        const fmi2ValueReference unknowns[], size_t nunknowns,
        const fmi2ValueReference knowns[], size_t nknowns,
        const fmi2Real seed[], fmi2Real sensitivity[]) {
    /* FMI 2 scalarizes every VR, so the scalar lengths are the VR counts. */
    return rmc_tangent_request(instance, unknowns, nunknowns, knowns, nknowns,
                               seed, nknowns, sensitivity, nunknowns, false);
