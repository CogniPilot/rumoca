{#- Total directional propagation for one retained component.
    This is an internal numerical consumer, not public FMI API admission.
    Including translation unit supplies ModelInstance, isfinite and the same
    fmi-c-kernel/pure-call owners as the component's primal execution.

    All three buffers belong to the derivative call, never the live component:
    seed is [solver-Y | P | time], rhs holds state derivatives and scratch holds one
    simultaneous assignment segment. The caller first refreshes a PRIVATE
    component snapshot, seeds admitted independent coordinates, and initializes
    every other seed to zero. It validates all buffers/capacities and commits
    a public sensitivity result only after the whole call succeeds. This keeps
    failed later segments from exposing partially updated seeds/results.
-#}
{%- from "fmi-c-kernel.jinja" import projection_lu_kernel %}
{%- from "fmi-me-projection.jinja" import program_function %}

{%- macro program(name, body) %}
{{ program_function(name, body, "ModelInstance* m, const double* seed, double* o", true) }}
{%- endmacro %}

{%- macro functions(tangent, stem) %}
{%- for segment in tangent.assignments %}
{%- set segment_id = loop.index0 %}
{%- for body in segment.plan.programs %}
{{ program(stem ~ "_tangent_assign_" ~ segment_id ~ "_" ~ loop.index0, body) }}
{%- endfor %}
{%- endfor %}
{%- for body in tangent.rhs.programs %}
{{ program(stem ~ "_tangent_rhs_" ~ loop.index0, body) }}
{%- endfor %}

{%- if tangent.implicit.present %}
{%- for body in tangent.implicit.plan.programs %}
{{ program(stem ~ "_tangent_residual_" ~ loop.index0, body) }}
{%- endfor %}
static int {{ stem }}_tangent_residuals(ModelInstance* m, const double* seed, double* out) {
{%- for body in tangent.implicit.plan.programs %}
    if ({{ stem }}_tangent_residual_{{ loop.index0 }}(m, seed, out) != 0) return -1;
{%- endfor %}
    return 0;
}
/* Differentiate the complete coupled relation at the private settled point.
   Algebraic programs ALREADY return residuals. Observation programs return
   values, so only those rows subtract their target seed, exactly once.
   R_z dz = -R_known dknown. Neither R_z nor dz alone is the public Jacobian. */
static int {{ stem }}_implicit_tangent(ModelInstance* m, double* seed, double* scratch,
                                 double* work, size_t* sizes) {
    const size_t n = {{ tangent.implicit.n }};
    double* saved = work;
    double* matrix = saved + {{ tangent.seed_len }};
    double* right = matrix + {{ tangent.implicit.matrix_len }};
    static const size_t targets[{{ tangent.implicit.n }}] = { {% for target in tangent.implicit.targets %}{{ target }},{% endfor %} };
    static const size_t rows[{{ tangent.implicit.n }}] = { {% for row in tangent.implicit.rows %}{{ row }},{% endfor %} };
    static const size_t subtract_targets[{{ tangent.implicit.n }}] = { {% for target in tangent.implicit.subtract_targets %}{{ target }},{% endfor %} };
    for (size_t i=0; i<n; ++i) seed[targets[i]] = 0.0;
    memcpy(saved, seed, {{ tangent.seed_len }}*sizeof(double));
    if ({{ stem }}_tangent_residuals(m, seed, scratch) != 0) return -1;
    for (size_t i=0; i<n; ++i) {
        double value = scratch[rows[i]];
        if (subtract_targets[i]) value -= seed[subtract_targets[i]-1];
        right[i] = -value;
        if (!isfinite(right[i])) return -1;
    }
    for (size_t column=0; column<n; ++column) {
        memset(seed, 0, {{ tangent.seed_len }}*sizeof(double));
        seed[targets[column]] = 1.0;
        if ({{ stem }}_tangent_residuals(m, seed, scratch) != 0) return -1;
        for (size_t row=0; row<n; ++row) {
            double value = scratch[rows[row]];
            if (subtract_targets[row]) value -= seed[subtract_targets[row]-1];
            if (!isfinite(value)) return -1;
            matrix[row*n+column] = value;
        }
    }
    memcpy(seed, saved, {{ tangent.seed_len }}*sizeof(double));
    /* Reuse the component's existing partial-pivot LU; no second linear
       solver, regularization, or singular least-squares substitute. */
    rmc_lu(matrix, n, sizes, sizes+n);
    if (!rmc_lu_solve(matrix, n, sizes, right)) return -1;
    for (size_t i=0; i<n; ++i) if (!isfinite(right[i])) return -1;
    for (size_t i=0; i<n; ++i) seed[targets[i]] = right[i];
    return 0;
}
{%- endif %}

{%- if tangent.consistency.present %}
{%- for body in tangent.consistency.plan.programs %}
{{ program(stem ~ "_tangent_check_" ~ loop.index0, body) }}
{%- endfor %}
static int {{ stem }}_tangent_checks(ModelInstance* m, const double* seed, double* out) {
{%- for body in tangent.consistency.plan.programs %}
