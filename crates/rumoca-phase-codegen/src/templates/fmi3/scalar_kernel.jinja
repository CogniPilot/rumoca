{%- macro scalar_const(op) -%}
{%- if op.value_class == "finite" -%}{{ op.value }}
{%- elif op.value_class == "positive_infinity" -%}INFINITY
{%- elif op.value_class == "negative_infinity" -%}(-INFINITY)
{%- else -%}NAN
{%- endif -%}
{%- endmacro %}
{%- macro unary(operator, arg) -%}
{%- if operator == "Neg" -%}(-r[{{ arg }}])
{%- elif operator == "Not" -%}(r[{{ arg }}] == 0.0 ? 1.0 : 0.0)
{%- elif operator == "Abs" -%}fabs(r[{{ arg }}])
{%- elif operator == "Sign" -%}(r[{{ arg }}] > 0.0 ? 1.0 : (r[{{ arg }}] < 0.0 ? -1.0 : 0.0))
{%- elif operator == "Sqrt" -%}sqrt(r[{{ arg }}])
{%- elif operator == "Floor" -%}floor(r[{{ arg }}])
{%- elif operator == "Ceil" -%}ceil(r[{{ arg }}])
{%- elif operator == "Trunc" -%}trunc(r[{{ arg }}])
{%- elif operator in ["Sin", "Cos", "Tan", "Asin", "Acos", "Atan", "Sinh", "Cosh", "Tanh", "Exp"] -%}{{ operator | lower }}(r[{{ arg }}])
{%- elif operator == "Log" -%}log(r[{{ arg }}])
{%- elif operator == "Log10" -%}log10(r[{{ arg }}])
{%- else -%}{{ fail("unsupported-feature:scalar.unary." ~ operator) }}
{%- endif -%}
{%- endmacro %}
{%- macro binary(operator, lhs, rhs) -%}
{%- if operator == "Add" -%}(r[{{ lhs }}] + r[{{ rhs }}])
{%- elif operator == "Sub" -%}(r[{{ lhs }}] - r[{{ rhs }}])
{%- elif operator == "Mul" -%}(r[{{ lhs }}] * r[{{ rhs }}])
{%- elif operator == "Div" -%}(r[{{ lhs }}] / r[{{ rhs }}])
{%- elif operator == "Pow" -%}pow(r[{{ lhs }}], r[{{ rhs }}])
{%- elif operator == "And" -%}((r[{{ lhs }}] != 0.0 && r[{{ rhs }}] != 0.0) ? 1.0 : 0.0)
{%- elif operator == "Or" -%}((r[{{ lhs }}] != 0.0 || r[{{ rhs }}] != 0.0) ? 1.0 : 0.0)
{%- elif operator == "Atan2" -%}atan2(r[{{ lhs }}], r[{{ rhs }}])
{%- elif operator == "Min" -%}fmin(r[{{ lhs }}], r[{{ rhs }}])
{%- elif operator == "Max" -%}fmax(r[{{ lhs }}], r[{{ rhs }}])
{%- else -%}{{ fail("unsupported-feature:scalar.binary." ~ operator) }}
{%- endif -%}
{%- endmacro %}
{%- macro compare(operator, lhs, rhs) -%}
{%- if operator == "Lt" -%}(r[{{ lhs }}] < r[{{ rhs }}] ? 1.0 : 0.0)
{%- elif operator == "Le" -%}(r[{{ lhs }}] <= r[{{ rhs }}] ? 1.0 : 0.0)
{%- elif operator == "Gt" -%}(r[{{ lhs }}] > r[{{ rhs }}] ? 1.0 : 0.0)
{%- elif operator == "Ge" -%}(r[{{ lhs }}] >= r[{{ rhs }}] ? 1.0 : 0.0)
{%- elif operator == "Eq" -%}(r[{{ lhs }}] == r[{{ rhs }}] ? 1.0 : 0.0)
{%- elif operator == "Ne" -%}(r[{{ lhs }}] != r[{{ rhs }}] ? 1.0 : 0.0)
{%- else -%}{{ fail("unsupported-feature:scalar.compare." ~ operator) }}
{%- endif -%}
{%- endmacro %}
{#- The emitted symbol of a pure-call owner: its content-addressed family
    representative. Every render path that emits pure calls must supply
    `pure_call_symbols`; a merged owner referenced by its own name would
    otherwise fail only at link time. -#}
{%- macro pure_symbol(owner) -%}
{%- if pure_call_symbols is not defined %}{{ fail("internal: pure_call_symbols is not in the render context") }}{% endif -%}
{{ pure_call_symbols[owner] }}
{%- endmacro %}
{%- macro scalar_op(op, output="m->derivative", error_status="fmi3Error", targets=none) %}
{%- if op.kind == "Const" %}    r[{{ op.dst }}] = {{ scalar_const(op) }};
{%- elif op.kind == "LoadTime" %}    r[{{ op.dst }}] = m->time;
{%- elif op.kind == "LoadY" %}    r[{{ op.dst }}] = m->y[{{ op.index }}];
{%- elif op.kind == "LoadP" %}    r[{{ op.dst }}] = m->p[{{ op.index }}];
{%- elif op.kind == "LoadSeed" %}    r[{{ op.dst }}] = seed[{{ op.index }}];
{%- elif op.kind == "LoadIndexedP" %}    r[{{ op.dst }}] = m->p[{{ op.base }} + (size_t)fmin(fmax(round(r[{{ op.index_ref }}]), 0.0), {{ op.count - 1 if op.count > 0 else 0 }}.0)];
{%- elif op.kind == "Move" %}    r[{{ op.dst }}] = r[{{ op.src }}];
{%- elif op.kind == "Unary" %}    r[{{ op.dst }}] = {{ unary(op.operator, op.arg) }};
{%- elif op.kind == "Binary" %}    r[{{ op.dst }}] = {{ binary(op.operator, op.lhs, op.rhs) }};
{%- elif op.kind == "Compare" %}    r[{{ op.dst }}] = {{ compare(op.operator, op.lhs, op.rhs) }};
{%- elif op.kind == "Select" %}    r[{{ op.dst }}] = r[{{ op.cond }}] != 0.0 ? r[{{ op.if_true }}] : r[{{ op.if_false }}];
{%- elif op.kind == "PureCall" %}    if (rumoca_scalar_pure_{{ pure_symbol(op.owner) }}((const double*[]){ {% for start in op.input_starts %}&r[{{ start }}],{% else %}NULL{% endfor %} }, &r[{{ op.dst }}])) return {{ error_status }};
{%- elif op.kind == "PureCallDirectional" %}    if (rumoca_scalar_pure_directional_{{ pure_symbol(op.owner) }}((const double*[]){ {% for start in op.input_starts %}&r[{{ start }}],{% else %}NULL{% endfor %} }, &r[{{ op.dst }}])) return {{ error_status }};
{%- elif op.kind == "TensorLoad" and op.lanes == 1 %}    for (size_t k=0; k<{{ op.count }}; ++k) r[{{ op.dst }}+k] = m->{{ op.input | lower }}[{{ op.input_start }}+k];
{%- elif op.kind == "TensorBinary" and op.lanes == 1 %}    for (size_t k=0; k<{{ op.count }}; ++k) r[{{ op.dst }}+k] = {{ binary(op.operator, op.lhs_start ~ "+k*" ~ op.lhs_stride, op.rhs_start ~ "+k*" ~ op.rhs_stride) }};
{%- elif op.kind == "MatrixMultiply" and op.lanes == 1 %}    for (size_t i=0; i<{{ op.rows }}; ++i) for (size_t j=0; j<{{ op.columns }}; ++j) {
        double sum=0.0;
        for (size_t k=0; k<{{ op.inner }}; ++k) sum+=r[{{ op.lhs_start }}+i*{{ op.inner }}+k]*r[{{ op.rhs_start }}+k*{{ op.columns }}+j];
        r[{{ op.dst }}+i*{{ op.columns }}+j]=sum;
    }
{%- elif op.kind == "TensorTranspose" and op.lanes == 1 %}    for (size_t i=0; i<{{ op.rows }}; ++i) for (size_t j=0; j<{{ op.columns }}; ++j) for (size_t k=0; k<{{ op.element_width }}; ++k)
        r[{{ op.dst }}+(i*{{ op.columns }}+j)*{{ op.element_width }}+k]=r[{{ op.src_start }}+(j*{{ op.rows }}+i)*{{ op.element_width }}+k];
{%- elif op.kind == "TensorFill" %}    for (size_t k=0; k<{{ op.count }}; ++k) for (size_t l=0; l<{{ op.lanes }}; ++l) r[{{ op.dst }}+k*{{ op.lanes }}+l] = r[{{ op.value_start }}+l];
{%- elif op.kind == "TensorIdentity" %}    for (size_t k=0; k<{{ op.size * op.size * op.lanes }}; ++k) r[{{ op.dst }}+k] = 0.0;
    for (size_t k=0; k<{{ op.size }}; ++k) r[{{ op.dst }}+(k*{{ op.size }}+k)*{{ op.lanes }}] = 1.0;
{%- elif op.kind == "TensorCross" and op.lanes == 1 %}{%- for i in range(3) %}    r[{{ op.dst + i }}] = r[{{ op.lhs_start + (i+1)%3 }}]*r[{{ op.rhs_start + (i+2)%3 }}] - r[{{ op.lhs_start + (i+2)%3 }}]*r[{{ op.rhs_start + (i+1)%3 }}];
{%- endfor %}
{%- elif op.kind == "TensorLoad" and op.lanes == 2 %}    for (size_t k=0; k<{{ op.count }}; ++k) { r[{{ op.dst }}+2*k] = m->{{ op.input | lower }}[{{ op.input_start }}+k]; r[{{ op.dst }}+2*k+1] = {% if op.seed_start is defined and op.seed_start is not none %}seed[{{ op.seed_start }}+k]{% else %}0.0{% endif %}; }
{%- elif op.kind == "TensorBinary" and op.lanes == 2 and op.operator in ["Add", "Sub", "Mul", "Div"] %}    for (size_t k=0; k<{{ op.count }}; ++k) {
        double a = r[{{ op.lhs_start }}+k*{{ op.lhs_stride * 2 }}], da = r[{{ op.lhs_start }}+k*{{ op.lhs_stride * 2 }}+1];
        double b = r[{{ op.rhs_start }}+k*{{ op.rhs_stride * 2 }}], db = r[{{ op.rhs_start }}+k*{{ op.rhs_stride * 2 }}+1];
{%- if op.operator == "Add" %}
        r[{{ op.dst }}+2*k] = a + b; r[{{ op.dst }}+2*k+1] = da + db;
{%- elif op.operator == "Sub" %}
        r[{{ op.dst }}+2*k] = a - b; r[{{ op.dst }}+2*k+1] = da - db;
{%- elif op.operator == "Mul" %}
        r[{{ op.dst }}+2*k] = a * b; r[{{ op.dst }}+2*k+1] = da * b + a * db;
{%- else %}
        r[{{ op.dst }}+2*k] = (b == 0.0 && a == 0.0) ? 0.0 : a / b; r[{{ op.dst }}+2*k+1] = b == 0.0 ? 0.0 : (da * b - a * db) / (b * b);
{%- endif %}
    }
{%- elif op.kind == "MatrixMultiply" and op.lanes == 2 %}    for (size_t i=0; i<{{ op.rows }}; ++i) for (size_t j=0; j<{{ op.columns }}; ++j) {
        double re=0.0, du=0.0;
        for (size_t k=0; k<{{ op.inner }}; ++k) {
            size_t l={{ op.lhs_start }}+(i*{{ op.inner }}+k)*2, q={{ op.rhs_start }}+(k*{{ op.columns }}+j)*2;
            re += r[l]*r[q]; du += r[l+1]*r[q] + r[l]*r[q+1];
        }
        r[{{ op.dst }}+(i*{{ op.columns }}+j)*2]=re; r[{{ op.dst }}+(i*{{ op.columns }}+j)*2+1]=du;
    }
{%- elif op.kind == "TensorTranspose" and op.lanes == 2 %}    for (size_t i=0; i<{{ op.rows }}; ++i) for (size_t j=0; j<{{ op.columns }}; ++j) for (size_t k=0; k<{{ op.element_width * 2 }}; ++k)
        r[{{ op.dst }}+(i*{{ op.columns }}+j)*{{ op.element_width * 2 }}+k]=r[{{ op.src_start }}+(j*{{ op.rows }}+i)*{{ op.element_width * 2 }}+k];
{%- elif op.kind == "TensorCross" and op.lanes == 2 %}    {
        double a[6], b[6], c[6];
        for (size_t k=0; k<6; ++k) { a[k]=r[{{ op.lhs_start }}+k]; b[k]=r[{{ op.rhs_start }}+k]; }
        static const size_t first[3]={1,2,0}, second[3]={2,0,1};
        for (size_t k=0; k<3; ++k) {
            size_t f=2*first[k], s=2*second[k];
            c[2*k]=a[f]*b[s]-a[s]*b[f];
            c[2*k+1]=a[f+1]*b[s]+a[f]*b[s+1]-a[s+1]*b[f]-a[s]*b[f+1];
        }
        for (size_t k=0; k<6; ++k) r[{{ op.dst }}+k]=c[k];
    }
{%- elif op.kind == "TensorConcatenate" %}
{%- set inner = op.dimensions[op.axis + 1:]|product %}{%- set result_axis = op.dimensions[op.axis] %}{%- set offset = namespace(value=0) %}
{%- for source in op.sources %}
{%- set source_axis = source.dimensions[op.axis] %}{%- set block = source_axis * inner %}
{%- if not loop.first %}
{% endif %}    for (size_t e=0; e<{{ source.dimensions|product }}; ++e) for (size_t l=0; l<{{ op.lanes }}; ++l)
        r[{{ op.dst }}+((e/{{ block }})*{{ result_axis * inner }}+{{ offset.value * inner }}+e%{{ block }})*{{ op.lanes }}+l] = r[{{ source.start }}+e*{{ op.lanes }}+l];
{%- set offset.value = offset.value + source_axis %}
{%- endfor %}
{%- elif op.kind == "StoreOutput" %}    {{ output }}[{{ targets[op.output_index].P.index if targets is not none else op.output_index }}] = r[{{ op.src }}];
{%- elif op.kind == "StoreOutputRange" %}{%- for output_index in op.output_indices %}    {{ output }}[{{ targets[output_index].P.index if targets is not none else output_index }}] = r[{{ op.start + loop.index0 * op.stride }}];
{%- endfor %}
{%- else %}{{ fail("unsupported-feature:scalar.op." ~ op.kind) }}
{%- endif %}
{%- endmacro %}

{%- macro c_string(bytes) -%}"{% for byte in bytes %}\{{ byte // 64 }}{{ (byte // 8) % 8 }}{{ byte % 8 }}{% endfor %}"{%- endmacro %}

{%- macro assertions(solve, fmi, messages, prefix) %}
static {{ prefix }}Status check_assertions(ModelInstance* m) {
    (void)m;
{%- if fmi.assertions %}
    if (m->assertion_failed) return {{ prefix }}Error;
    double actions[{{ solve.events.actions|length }}];
{%- for program in solve.events.action_plan.programs %}
    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "actions", prefix ~ "Error") }}
{%- endfor %}
    }
{%- endfor %}
{%- for action in solve.events.actions %}
    if (actions[{{ loop.index0 }}] != 0.0) {
        log_assertion(m, {{ c_string(messages[loop.index0]) }});
        m->assertion_failed = true;
        return {{ prefix }}Error;
    }
{%- endfor %}
{%- endif %}
    return {{ prefix }}OK;
}
static {{ prefix }}Status update_assertion_memory(ModelInstance* m) {
    (void)m;
{%- if fmi.assertions and solve.discrete.update_targets|length > 0 %}
    double current[{{ solve.discrete.update_targets|length }}];
{%- for program in solve.discrete.rhs_plan.programs %}
    {
    double r[{{ program.temporary_count if program.temporary_count > 0 else 1 }}]; (void)r;
{%- for op in program.ops %}
{{ scalar_op(op, "current", prefix ~ "Error") }}
{%- endfor %}
    }
{%- endfor %}
{%- for target in solve.discrete.update_targets %}
    m->p[{{ target.P.index }}] = current[{{ loop.index0 }}];
{%- endfor %}
{%- endif %}
    return {{ prefix }}OK;
}
{%- endmacro %}

{%- macro assertion_lifecycle(prefix) %}
static {{ prefix }}Status settle_values(ModelInstance* m) {
    if (refresh_algebraics(m) != {{ prefix }}OK) return {{ prefix }}Error;
    return m->assertions_initialized ? check_assertions(m) : {{ prefix }}OK;
}
static {{ prefix }}Status settle_derivative_values(ModelInstance* m) {
    if (refresh_derivative_values(m) != {{ prefix }}OK) return {{ prefix }}Error;
    return m->assertions_initialized ? check_assertions(m) : {{ prefix }}OK;
}
static {{ prefix }}Status initialize_assertions(ModelInstance* m) {
    if (refresh_algebraics(m) != {{ prefix }}OK || update_assertion_memory(m) != {{ prefix }}OK) return {{ prefix }}Error;
    m->assertions_initialized = true;
    return check_assertions(m);
}
static {{ prefix }}Status settle_assertion_event(ModelInstance* m) {
    if (settle_values(m) != {{ prefix }}OK) return {{ prefix }}Error;
    return update_assertion_memory(m);
}
{%- endmacro %}

{#- A function-scope constant double array, eight values per line; an empty
    list zero-fills. -#}
{%- macro value_array(name, length, values) %}
    static const double {{ name }}[{{ length }}] = {
{%- for value in values %}{% if loop.index0 % 8 == 0 %}
       {% endif %} {{ value }},{% else %} 0.0{% endfor %}
    };
{%- endmacro %}
