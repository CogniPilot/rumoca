}
/* After a bytewise copy of `src` into `dst`, give `dst` its own copies of the
   texts `src` owns; on a failed copy `dst` keeps only start texts. */
static inline bool rmc_own_text(ModelInstance* dst, const ModelInstance* src) {
    for (size_t k = 0; k < {{ texts|length }}; ++k) { dst->text_owned[k] = NULL; dst->text[k] = rmc_text_start[k]; }
    for (size_t k = 0; k < {{ texts|length }}; ++k) if (src->text_owned[k] && !rmc_set_text(dst, k, src->text_owned[k])) { rmc_release_text(dst); return false; }
    return true;
}
