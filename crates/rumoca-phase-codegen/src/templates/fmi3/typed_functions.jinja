{%- if token == "negate" -%}(-{{ a }})
{%- elif token == "not" -%}(!{{ a }})
{%- elif token == "sign" -%}({{ a }}>0 ? 1 : ({{ a }}<0 ? -1 : 0))
{%- elif token == "integer_abs" -%}({{ a }}<0 ? -{{ a }} : {{ a }})
{%- elif token == "real_abs" -%}fabs({{ a }})
{%- elif token == "ceiling" -%}ceil({{ a }})
{%- elif token == "truncate" -%}trunc({{ a }})
{%- else -%}{{ token }}({{ a }}){% endif -%}
{%- endmacro %}
{%- macro binary_spelling(token, a, b) -%}
{%- if token == "boolean_min" -%}({{ a }} && {{ b }})
{%- elif token == "boolean_max" -%}({{ a }} || {{ b }})
{%- elif token == "power" -%}pow({{ a }},{{ b }})
{%- elif token == "atan2" -%}atan2({{ a }},{{ b }})
{%- elif token == "real_min" -%}rumoca_real_min({{ a }},{{ b }})
{%- elif token == "real_max" -%}rumoca_real_max({{ a }},{{ b }})
{%- elif token == "add" -%}({{ a }} + {{ b }})
{%- elif token == "subtract" -%}({{ a }} - {{ b }})
{%- elif token == "multiply" -%}({{ a }} * {{ b }})
{%- elif token == "divide" -%}({{ a }} / {{ b }})
{%- elif token == "and" -%}({{ a }} && {{ b }})
{%- else -%}({{ a }} || {{ b }}){% endif -%}
{%- endmacro %}
{%- macro compare_spelling(token) -%}
{%- if token == "equal" -%}=={%- elif token == "not_equal" -%}!={%- elif token == "less" -%}<{%- elif token == "less_equal" -%}<={%- elif token == "greater" -%}>{%- else -%}>={%- endif -%}
{%- endmacro %}
{%- macro checked(token, d, a, b) -%}
{% if token == "add" -%}
if (({{ b }}>0 && {{ a }}>INT64_MAX-{{ b }}) || ({{ b }}<0 && {{ a }}<INT64_MIN-{{ b }})) return 1;
r{{ d }}[k] = {{ a }}+{{ b }};
{% elif token == "subtract" -%}
if (({{ b }}<0 && {{ a }}>INT64_MAX+{{ b }}) || ({{ b }}>0 && {{ a }}<INT64_MIN+{{ b }})) return 1;
r{{ d }}[k] = {{ a }}-{{ b }};
{% elif token == "multiply" -%}
if ({{ a }}>0 ? ({{ b }}>0 ? {{ a }}>INT64_MAX/{{ b }} : {{ b }}<INT64_MIN/{{ a }}) : ({{ a }}<0 ? ({{ b }}>0 ? {{ a }}<INT64_MIN/{{ b }} : ({{ b }}<0 && {{ a }}<INT64_MAX/{{ b }})) : 0)) return 1;
r{{ d }}[k] = {{ a }}*{{ b }};
{% elif token == "quotient" -%}
if ({{ b }} == 0) return 1;
if ({{ a }} == INT64_MIN && {{ b }} == -1) return 1;
r{{ d }}[k] = {{ a }}/{{ b }};
{% elif token == "modulo" -%}
if ({{ b }} == 0) return 1;
r{{ d }}[k] = {{ b }} == -1 ? 0 : {{ a }}%{{ b }};
if (r{{ d }}[k] != 0 && ((r{{ d }}[k] < 0) != ({{ b }} < 0))) r{{ d }}[k] += {{ b }};
{% elif token == "remainder" -%}
if ({{ b }} == 0) return 1;
r{{ d }}[k] = {{ b }} == -1 ? 0 : {{ a }}%{{ b }};
{% elif token == "min" -%}
r{{ d }}[k] = {{ a }} < {{ b }} ? {{ a }} : {{ b }};
{% else -%}
r{{ d }}[k] = {{ a }} > {{ b }} ? {{ a }} : {{ b }};
{% endif -%}
{% endmacro %}
{%- macro domain(item) -%}
{% if item.domain -%}
for (size_t k=0; k<{{ item.extent }}; ++k) if (r{{ item.destination }}[k]<{{ integer_literal(item.domain.minimum) }} || r{{ item.destination }}[k]>{{ integer_literal(item.domain.maximum) }}) return 1;
{% endif -%}
