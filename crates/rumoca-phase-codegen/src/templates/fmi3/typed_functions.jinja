{% elif item.kernel.kind == "binary" -%}
r{{ item.destination }}[k] = {{ binary_spelling(item.kernel.token, operand(item.kernel.lhs), operand(item.kernel.rhs)) }};
{% elif item.kernel.kind == "checked" -%}
{{ checked(item.kernel.token, item.destination, operand(item.kernel.lhs), operand(item.kernel.rhs)) -}}
