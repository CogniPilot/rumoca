{% endif -%}
}
{{ domain(item) -}}
{% endmacro %}
{%- macro convert(item) -%}
{% if item.token == "integer_to_real" -%}
for (size_t k=0; k<{{ item.extent }}; ++k) r{{ item.destination }}[k] = (double)r{{ item.operand }}[k];
{% else -%}
