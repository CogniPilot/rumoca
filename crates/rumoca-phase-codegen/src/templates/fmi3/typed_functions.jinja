{#- Follows the whitespace convention stated in `typed_arithmetic.jinja`. -#}
{%- from "fmi-typed-arithmetic.jinja" import integer, declaration, copy, import_scalars, arithmetic %}
{%- from "fmi-typed-tensors.jinja" import tensor %}

{#- A binder's trip count. The template engine's `//` does not floor a negative
    span by a negative step, so both are scaled by the step: span * step and
    step * step are non-negative, and their quotient is the exact count - 1. -#}
{%- macro trip_count(binder) -%}
{% set directed = (binder.upper - binder.lower) * binder.step -%}
{{ 0 if directed < 0 else directed // (binder.step * binder.step) + 1 }}
{%- endmacro %}

{#- Whether a value of this type is a binary64 array a caller can pass
    through unconverted (nonempty; an empty type keeps its one-element local). -#}
{%- macro direct(ty) -%}{% if ty.scalar.kind == "real" and ty.scalar.profile.format == "binary64" and ty.scalar_count > 0 %}1{% endif %}{%- endmacro %}
{#- The one spelling of each issued element token. -#}
{%- macro element(token) -%}{% if token == "real64" %}double{% elif token == "int64" %}int64_t{% elif token == "boolean" %}bool{% else %}{{ fail("unsupported-feature:fmi.c.pure-call: scalar type") }}{% endif %}{%- endmacro %}
{%- macro storage_name(name) -%}{% if name.space == "slot" %}s{% else %}r{% endif %}{{ name.id }}{%- endmacro %}
{#- The one spelling of each issued scalar token; each prints issued fields
    only. Statement spellings emit complete lines. -#}
{%- macro operand(value) -%}r{{ value.register }}[{% if value.broadcast %}0{% else %}k{% endif %}]{%- endmacro %}
{%- macro integer_literal(value) -%}{% if value.sign == "minimum" %}INT64_MIN{% elif value.sign == "negative" %}(-INT64_C({{ value.magnitude }})){% else %}INT64_C({{ value.magnitude }}){% endif %}{%- endmacro %}
