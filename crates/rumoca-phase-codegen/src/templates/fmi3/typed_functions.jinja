{% elif item.kernel.kind == "matrix_multiply" -%}
for (size_t i=0; i<{{ item.kernel.rows }}; ++i) for (size_t j=0; j<{{ item.kernel.columns }}; ++j) { double sum=0.0; for (size_t k=0; k<{{ item.kernel.inner }}; ++k) sum+=r{{ item.kernel.lhs }}[i*{{ item.kernel.inner }}+k]*r{{ item.kernel.rhs }}[k*{{ item.kernel.columns }}+j]; r{{ item.destination }}[i*{{ item.kernel.columns }}+j]=sum; }
