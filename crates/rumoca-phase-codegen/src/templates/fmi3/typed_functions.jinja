{#- Plan-only fragments: each takes the issued print projection, or one of
    its items, and nothing else; element and name spellings are issued
    tokens. -#}
{%- macro plan_frame(plan) -%}
{% for item in plan.slots -%}
{% if item.kind == "argument_view" -%}
const {{ element(item.element) }}* s{{ item.slot }} = in[{{ item.argument }}]; (void)s{{ item.slot }};
{% elif item.kind == "frame_from_argument" -%}
{{ element(item.element) }} s{{ item.slot }}[{{ item.extent }}]; (void)s{{ item.slot }};
memcpy(s{{ item.slot }}, in[{{ item.argument }}], sizeof(s{{ item.slot }}));
{% else -%}
{{ element(item.element) }} s{{ item.name.id }}[{{ item.extent }}]; (void)s{{ item.name.id }};
{% endif -%}
{% endfor -%}
{% for item in plan.registers %}{{ element(item.element) }} r{{ item.name.id }}[{{ item.extent }}]; (void)r{{ item.name.id }};{% endfor %}
{% endmacro %}
{%- macro plan_item(item) -%}{% if item.kind == "view" %}const {{ element(item.element) }}* r{{ item.register }} = s{{ item.slot }}; (void)r{{ item.register }};
{% elif item.kind == "copy" %}memcpy({{ storage_name(item.destination) }}, {{ storage_name(item.source) }}, sizeof({{ storage_name(item.destination) }}));
{% elif item.kind == "constant" %}r{{ item.destination }}[0] = {% if item.value.kind == "real64" %}rumoca_real64(UINT64_C({{ item.value.bits }})){% elif item.value.kind == "int64" %}{{ integer_literal(item.value.value) }}{% elif item.value.value %}true{% else %}false{% endif %};
{% elif item.kind == "select" %}memcpy(r{{ item.destination }}, (r{{ item.condition }}[0] ? r{{ item.if_true }} : r{{ item.if_false }}), sizeof(r{{ item.destination }}));
{% elif item.kind == "elementwise" %}{{ elementwise(item) }}{% elif item.kind == "convert" %}{{ convert(item) }}{% elif item.kind == "tensor" %}{{ tensor_item(item) }}{% endif %}{%- endmacro %}
{%- macro plan_outputs(plan) -%}
{% for item in plan.outputs -%}
if (out[{{ item.output }}]) memcpy(out[{{ item.output }}], s{{ item.slot }}, sizeof(s{{ item.slot }}));
{% endfor -%}
{% endmacro %}

{%- macro definition(program, name, prefix="rumoca_pure_", assertion_outputs=[], source_predicate_outputs={}) -%}
